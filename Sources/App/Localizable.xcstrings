    "%@ uses %@, which refines, but refinement isn't set up" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ usa %2$@, que refina, pero el refinamiento no está configurado"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ はモード「%2$@」を使用します。このモードは整形を行いますが、整形が設定されていません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 使用“%@”模式，该模式会润色，但润色尚未设置"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 使用「%@」模式，此模式會潤稿，但潤稿尚未設定"
          }
        }
      }
    },
    "%@ uses %@, whose speech API key is missing or locked" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ usa %2$@, cuya clave de API de voz falta o está bloqueada"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ はモード「%2$@」を使用しますが、その音声 API キーが見つからないかロックされています"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 使用“%@”模式，其语音 API 密钥缺失或已锁定"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 使用「%@」模式，其語音 API 金鑰遺失或已鎖定"
          }
        }
      }
    },
    "%@ uses %@, whose speech endpoint needs checking" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
