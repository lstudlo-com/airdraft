    "Affects all AI profiles. Removing rules may reduce accuracy or make AI answer your dictation. Defaults can be restored." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afecta a todos los perfiles de IA. Quitar reglas puede reducir la precisión o hacer que la IA responda a tu dictado. Puedes restaurar los valores predeterminados."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての AI モードに影響します。ルールを削除すると精度が下がったり、AI が音声入力の内容に答えてしまったりすることがあります。デフォルトに戻せます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会影响所有 AI 模式。移除规则可能降低准确率，或让 AI 回答你的听写内容。可随时恢复默认设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會影響所有 AI 模式。移除規則可能降低準確度，或讓 AI 回答你的聽寫內容。可隨時還原為預設值。"
          }
        }
      }
    },
