    "Try a message you might send today. Speak naturally, with pauses if you like." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba con un mensaje que podrías enviar hoy. Habla con naturalidad, con pausas si quieres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日送りそうなメッセージを話してみましょう。自然に、間を置きながらでもかまいません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试着说一条你今天可能会发送的消息。自然地说，停顿也没关系。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試著說一則你今天可能會傳送的訊息。自然地說，停頓也沒關係。"
          }
        }
      }
    },
