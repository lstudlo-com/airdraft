    "Cancel the current dictation and discard its unsaved audio. Text delivery cannot be cancelled once it begins." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela el dictado actual y descarta su audio sin guardar. La entrega del texto no se puede cancelar una vez iniciada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の音声入力をキャンセルし、保存されていない音声を破棄します。テキストの入力が始まった後はキャンセルできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消当前听写并丢弃未保存的音频。文字一旦开始发送便无法取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消目前的聽寫並捨棄未儲存的音訊。文字一旦開始送出便無法取消。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batalkan dikte saat ini dan buang audionya yang belum disimpan. Pengiriman teks tidak dapat dibatalkan setelah dimulai."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отменить текущую диктовку и удалить её несохранённое аудио. Вставку текста нельзя отменить после начала."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela o ditado atual e descarta o áudio não salvo. A entrega do texto não pode ser cancelada depois de iniciada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annule la dictée en cours et supprime son audio non enregistré. L’envoi du texte ne peut plus être annulé une fois commencé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा डिक्टेशन रद्द करें और उसका बिना सहेजा ऑडियो त्याग दें। टेक्स्ट भेजना शुरू होने के बाद रद्द नहीं किया जा सकता।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُلغي الإملاء الحالي ويتجاهل صوته غير المحفوظ. لا يمكن إلغاء تسليم النص بعد بدئه."
          }
        }
      }
    },
    "Cantonese fine-tune of SenseVoice. Weak with English; no Japanese or Korean." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste de SenseVoice para cantonés. Débil con el inglés; sin japonés ni coreano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SenseVoice の広東語向けファインチューン版。英語は苦手で、日本語と韓国語には対応していません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SenseVoice 的粤语微调版本。英语较弱；不支持日语和韩语。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SenseVoice 的粵語微調版本。英文較弱；不支援日文與韓文。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyetelan SenseVoice untuk bahasa Kanton. Lemah dalam bahasa Inggris; tanpa Jepang atau Korea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кантонская доработка SenseVoice. Слаба в английском; без японского и корейского."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste fino do SenseVoice para cantonês. Fraco em inglês; sem japonês nem coreano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variante de SenseVoice affinée pour le cantonais. Faible en anglais ; ni japonais ni coréen."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SenseVoice का कैंटोनीज़ फ़ाइन-ट्यून। अंग्रेज़ी में कमज़ोर; जापानी या कोरियाई नहीं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخة SenseVoice المضبوطة للكانتونية. ضعيفة في الإنجليزية؛ لا يابانية ولا كورية."
          }
        }
      }
    },
    "Can’t write %@ yet; your words may stay as you said them" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no puede escribir en %@; tus palabras pueden quedar tal como las dijiste"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ%@を書けません。話した言葉がそのまま残ることがあります"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时无法书写%@；你说的话可能会保持原样"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫時無法書寫%@；你說的話可能會保持原樣"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum dapat menulis %@; kata-kata Anda mungkin tetap seperti yang diucapkan"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока не поддерживает %@; слова могут остаться как сказаны"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não escreve em %@; suas palavras podem ficar como você as disse"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne peut pas encore écrire en %@ ; vos mots peuvent rester tels quels"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी %@ नहीं लिख सकता; आपके शब्द वैसे ही रह सकते हैं जैसे आपने बोले"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن الكتابة بـ%@ بعد؛ قد تبقى كلماتك كما قلتها"
          }
        }
      }
    },
    "Catalog unavailable; showing saved choices. Try Refresh." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catálogo no disponible; se muestran las opciones guardadas. Prueba a actualizar."
          }
