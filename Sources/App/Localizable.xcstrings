    "Permission granted, but the shortcut monitor is unavailable. Quit and reopen Airdraft." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permiso concedido, pero el monitor del atajo no está disponible. Sal y vuelve a abrir Airdraft."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "権限は許可されましたが、ショートカットの監視を使用できません。Airdraft を終了して開き直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已授予权限，但快捷键监听不可用。请退出并重新打开 Airdraft。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已授予權限，但快速鍵監聽無法使用。請結束並重新打開 Airdraft。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izin diberikan, tetapi pemantau pintasan tidak tersedia. Keluar dan buka kembali Airdraft."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешение получено, но отслеживание сочетаний клавиш недоступно. Закройте и снова откройте Airdraft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permissão concedida, mas o monitor de atalhos está indisponível. Encerre e abra o Airdraft novamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisation accordée, mais la surveillance du raccourci est indisponible. Quittez et rouvrez Airdraft."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुमति मिल गई, लेकिन शॉर्टकट मॉनिटर उपलब्ध नहीं है। Airdraft से बाहर निकलकर फिर से खोलें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم منح الإذن، لكن مراقب الاختصارات غير متاح. أنهِ Airdraft وأعد فتحه."
          }
        }
      }
    },
