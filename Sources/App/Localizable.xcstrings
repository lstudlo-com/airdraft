    "Turn on Apple Intelligence in System Settings, then come back here. Or set it up later in Models." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Apple Intelligence en Ajustes del Sistema y vuelve aquí. O configúralo más tarde en Modelos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定で Apple Intelligence をオンにしてから、ここに戻ってください。あとで「モデル」で設定することもできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置”中开启 Apple Intelligence，然后回到这里。也可以以后在“模型”中设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「系統設定」中開啟 Apple Intelligence，然後回到這裡。也可以之後在「模型」中設定。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyalakan Apple Intelligence di Pengaturan Sistem, lalu kembali ke sini. Atau siapkan nanti di Model."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите Apple Intelligence в Системных настройках и вернитесь сюда. Или настройте позже в «Моделях»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a Apple Intelligence nos Ajustes do Sistema e volte para cá. Ou configure-a depois em Modelos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Apple Intelligence dans Réglages Système, puis revenez ici. Vous pouvez aussi le configurer plus tard dans Modèles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम सेटिंग्ज़ में Apple Intelligence चालू करें, फिर यहाँ वापस आएँ। या बाद में मॉडल में इसे सेट अप करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل Apple Intelligence في إعدادات النظام، ثم عد إلى هنا. أو أعدّه لاحقًا في النماذج."
          }
        }
      }
    },
    "Turn on Keep Recordings to save future dictations." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Conservar grabaciones para guardar los dictados futuros."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後の音声入力を保存するには「録音を保存」をオンにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“保留录音”即可保存以后的听写。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「保留錄音」即可儲存之後的聽寫。"
          }
