    "WER is word error rate; lower is better." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WER es la tasa de error de palabras; cuanto menor, mejor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WER は単語誤り率で、低いほど良好です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WER 是词错误率；越低越好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WER 是字詞錯誤率；越低越好。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WER adalah tingkat kesalahan kata; lebih rendah lebih baik."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WER — доля ошибок в словах; чем меньше, тем лучше."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WER é a taxa de erro de palavras; quanto menor, melhor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le WER est le taux d’erreur de mots ; plus il est bas, mieux c’est."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WER शब्द त्रुटि दर है; कम बेहतर है।"
