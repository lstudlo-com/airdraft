    "Another app copy may be changing local data, or the data folder is unavailable. Quit other copies, check folder access, then reopen Airdraft." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que otra copia de la app esté cambiando los datos locales o que la carpeta de datos no esté disponible. Cierra las demás copias, revisa el acceso a la carpeta y vuelve a abrir Airdraft."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のアプリのコピーがローカルデータを変更しているか、データフォルダが使用できない可能性があります。ほかのコピーを終了し、フォルダへのアクセス権を確認してから Airdraft を開き直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能有另一份 App 正在更改本地数据，或数据文件夹不可用。请退出其他副本、检查文件夹访问权限，然后重新打开 Airdraft。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能有另一份 App 正在變更本機資料，或資料夾無法使用。請結束其他副本、檢查資料夾存取權限，然後重新打開 Airdraft。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan app lain mungkin sedang mengubah data lokal, atau folder data tidak tersedia. Keluar dari salinan lain, periksa akses folder, lalu buka kembali Airdraft."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другая копия приложения, возможно, изменяет локальные данные, или папка данных недоступна. Закройте другие копии, проверьте доступ к папке и снова откройте Airdraft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra cópia do app pode estar alterando os dados locais, ou a pasta de dados está indisponível. Encerre as outras cópias, verifique o acesso à pasta e abra o Airdraft novamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre copie de l’app modifie peut-être les données locales, ou le dossier de données est indisponible. Quittez les autres copies, vérifiez l’accès au dossier, puis rouvrez Airdraft."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हो सकता है ऐप की कोई दूसरी कॉपी लोकल डेटा बदल रही हो, या डेटा फ़ोल्डर उपलब्ध न हो। दूसरी कॉपी से बाहर निकलें, फ़ोल्डर ऐक्सेस जाँचें, फिर Airdraft दोबारा खोलें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما تغيّر نسخة أخرى من التطبيق البيانات المحلية، أو أن مجلد البيانات غير متاح. أنهِ النسخ الأخرى، وتحقق من صلاحية الوصول إلى المجلد، ثم أعد فتح Airdraft."
          }
        }
      }
    },
    "Another copy is running. Quit it before changing permissions:" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay otra copia en ejecución. Ciérrala antes de cambiar los permisos:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のコピーが実行中です。権限を変更する前に終了してください："
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一份 Airdraft 正在运行。更改权限前请先退出它："
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一份 Airdraft 正在執行。變更權限前請先結束它："
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salinan lain sedang berjalan. Keluar darinya sebelum mengubah izin:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запущена другая копия. Закройте её, прежде чем менять разрешения:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra cópia está em execução. Encerre-a antes de alterar as permissões:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre copie est ouverte. Quittez-la avant de modifier les autorisations :"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक दूसरी कॉपी चल रही है। अनुमतियाँ बदलने से पहले उससे बाहर निकलें:"
          }
        },
        "ar" : {
