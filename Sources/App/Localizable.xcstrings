            "state" : "translated",
            "value" : "此音訊檔案已無法使用。"
          }
        }
      }
    },
    "This build can’t start a trial or accept a purchase. Contact Airdraft support for a configured build." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
