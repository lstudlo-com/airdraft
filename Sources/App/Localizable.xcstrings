    "One shortcut starts dictation in every app. Practice it here; nothing is recorded on this step." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo atajo inicia el dictado en cualquier app. Practícalo aquí; en este paso no se graba nada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 つのショートカットで、どのアプリでも音声入力を開始できます。ここで練習してください。この手順では何も録音されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个快捷键就能在所有 App 中开始听写。在这里练习一下；此步骤不会录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個快速鍵就能在所有 App 中開始聽寫。在這裡練習吧；此步驟不會錄音。"
          }
        }
      }
    },
    "One timer setting for every preset. Sonic shows only the animated ribbons." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo ajuste de temporizador para todos los estilos. Sónico solo muestra las cintas animadas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマーの設定はすべてのスタイルで共通です。「ソニック」ではアニメーションするリボンだけが表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有样式共用一个计时器设置。“声波”只显示动态丝带。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
