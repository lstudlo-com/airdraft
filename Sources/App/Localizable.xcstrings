    "Buy or activate a license to keep dictating. Your history and settings stay available." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compra o activa una licencia para seguir dictando. Tu historial y tus ajustes siguen disponibles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力を続けるには、ライセンスを購入またはアクティベートしてください。履歴と設定は引き続き使用できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买或激活许可证即可继续听写。你的历史记录和设置仍可使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購買或啟用授權即可繼續聽寫。你的記錄與設定仍可使用。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beli atau aktifkan lisensi untuk terus mendikte. Riwayat dan pengaturan Anda tetap tersedia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Купите или активируйте лицензию, чтобы продолжить диктовку. История и настройки остаются доступны."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compre ou ative uma licença para continuar ditando. Seu histórico e seus ajustes continuam disponíveis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achetez ou activez une licence pour continuer à dicter. Votre historique et vos réglages restent accessibles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिक्टेट करते रहने के लिए लाइसेंस ख़रीदें या सक्रिय करें। आपका इतिहास और सेटिंग्ज़ उपलब्ध रहती हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشترِ ترخيصًا أو فعّله لمواصلة الإملاء. يبقى سجلك وإعداداتك متاحين."
          }
        }
      }
