    "%lld unfinished recording(s) could not be read. Check folder access. Other recordings can still be recovered; Remove Audio Files in Settings clears unreadable drafts too." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer %lld grabaciones sin terminar. Revisa el acceso a la carpeta. Las demás grabaciones aún se pueden recuperar; Eliminar archivos de audio en Ajustes también borra los borradores ilegibles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件の未完了の録音を読み取れませんでした。フォルダへのアクセス権を確認してください。ほかの録音は引き続き復元できます。「設定」の「音声ファイルを削除」を実行すると、読み取れない下書きも消去されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 个未完成的录音无法读取。请检查文件夹访问权限。其他录音仍可恢复；在“设置”中执行“移除音频文件”也会清除无法读取的草稿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 個未完成的錄音無法讀取。請檢查資料夾存取權限。其他錄音仍可復原；在「設定」中執行「移除音訊檔案」也會清除無法讀取的草稿。"
          }
        }
      }
    },
