    "Speaker labels are estimates. Assign each passage below to correct them. Saved names stay on this Mac as suggestions." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las etiquetas de hablante son estimaciones. Asigna cada fragmento de abajo para corregirlas. Los nombres guardados se quedan en este Mac como sugerencias."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話者ラベルは推定です。下の各区間に話者を割り当てて修正してください。保存した名前は候補としてこの Mac にのみ残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发言人标签仅为估计。请为下方各段落指定发言人以更正。保存的名称只会作为建议保留在这台 Mac 上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "講者標籤僅為估計。請為下方各段落指定講者以修正。儲存的名稱只會保留在這台 Mac 上作為建議。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Label pembicara adalah perkiraan. Tetapkan setiap bagian di bawah untuk memperbaikinya. Nama yang disimpan tetap di Mac ini sebagai saran."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Метки спикеров приблизительны. Чтобы исправить их, назначьте каждый фрагмент ниже. Сохранённые имена остаются на этом Mac как подсказки."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os rótulos de falantes são estimativas. Atribua cada trecho abaixo para corrigi-los. Os nomes salvos ficam neste Mac como sugestões."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les étiquettes d’intervenants sont des estimations. Attribuez chaque passage ci-dessous pour les corriger. Les noms enregistrés restent sur ce Mac comme suggestions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वक्ता लेबल अनुमान हैं। उन्हें ठीक करने के लिए नीचे हर अंश को असाइन करें। सहेजे गए नाम सुझाव के रूप में इसी Mac पर रहते हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسميات المتحدثين تقديرية. عيّن كل مقطع أدناه لتصحيحها. تبقى الأسماء المحفوظة على هذا الـ Mac كاقتراحات."
          }
        }
      }
    },
    "Speakers" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hablantes"
          }
