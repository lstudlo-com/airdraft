    "One shortcut starts dictation in every app. Practice it here; nothing is recorded on this step." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo atajo inicia el dictado en cualquier app. Practícalo aquí; en este paso no se graba nada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 つのショートカットで、どのアプリでも音声入力を開始できます。ここで練習してください。この手順では何も録音されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个快捷键就能在所有 App 中开始听写。在这里练习一下；此步骤不会录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個快速鍵就能在所有 App 中開始聽寫。在這裡練習吧；此步驟不會錄音。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu pintasan memulai dikte di setiap app. Latih di sini; tidak ada yang direkam pada langkah ini."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одно сочетание клавиш запускает диктовку в любом приложении. Потренируйтесь здесь — на этом шаге ничего не записывается."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um atalho inicia o ditado em qualquer app. Pratique aqui; nada é gravado nesta etapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul raccourci lance la dictée dans toutes les apps. Entraînez-vous ici ; rien n’est enregistré à cette étape."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक शॉर्टकट हर ऐप में डिक्टेशन शुरू करता है। यहाँ अभ्यास करें; इस चरण में कुछ भी रिकॉर्ड नहीं होता।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختصار واحد يبدأ الإملاء في كل تطبيق. تدرّب عليه هنا؛ لا يُسجَّل شيء في هذه الخطوة."
          }
        }
      }
    },
    "One timer setting for every preset. Sonic shows only the animated ribbons." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo ajuste de temporizador para todos los estilos. Sónico solo muestra las cintas animadas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマーの設定はすべてのスタイルで共通です。「ソニック」ではアニメーションするリボンだけが表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有样式共用一个计时器设置。“声波”只显示动态丝带。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有樣式共用一個計時器設定。「聲波」只顯示動態絲帶。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu pengaturan timer untuk setiap preset. Sonik hanya menampilkan pita animasi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одна настройка таймера для всех стилей. «Соник» показывает только анимированные ленты."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um único ajuste de cronômetro para todos os estilos. Sônico mostra apenas as fitas animadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul réglage de minuteur pour tous les styles. Sonic n’affiche que les rubans animés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर प्रीसेट के लिए एक टाइमर सेटिंग। सोनिक केवल एनिमेटेड रिबन दिखाता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعداد مؤقت واحد لكل الأشكال. يعرض «صوتي» الأشرطة المتحركة فقط."
          }
        }
      }
    },
