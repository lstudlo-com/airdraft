    "Checks API access without sending audio. Transcription permissions and billing are not tested." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba el acceso a la API sin enviar audio. No se prueban los permisos de transcripción ni la facturación."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
