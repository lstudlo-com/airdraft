    "%@ %@, speak, then %@. Your words appear where you were typing." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@, speak, then %3$@. Your words appear where you were typing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@, habla y luego %3$@. Tus palabras aparecen donde estabas escribiendo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ を%1$@して話し、%3$@。入力していた場所に文字が表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ 并说话，然后%3$@。文字会出现在你正在输入的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ 並說話，然後%3$@。文字會出現在你正在輸入的位置。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@, bicaralah, lalu %3$@. Kata-kata Anda muncul di tempat Anda mengetik."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@, говорите, затем %3$@. Текст появится там, где вы печатали."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@, fale e depois %3$@. Suas palavras aparecem onde você estava digitando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@, parlez, puis %3$@. Vos mots apparaissent là où vous tapiez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ %1$@, बोलें, फिर %3$@। आपके शब्द वहीं दिखेंगे जहाँ आप टाइप कर रहे थे।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@، وتحدّث، ثم %3$@. تظهر كلماتك حيث كنت تكتب."
          }
        }
      }
    },
