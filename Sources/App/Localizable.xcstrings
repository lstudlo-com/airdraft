    "Your progress is saved. Reopen it from the Airdraft menu with Set Up Airdraft." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu progreso está guardado. Vuelve a abrirlo desde el menú de Airdraft con Configurar Airdraft."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進行状況は保存されています。Airdraft のメニューの「Airdraft を設定」からもう一度開けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的进度已保存。可从 Airdraft 菜单中的“设置 Airdraft”重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的進度已儲存。可從 Airdraft 選單中的「設定 Airdraft」重新打開。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemajuan Anda disimpan. Buka kembali dari menu Airdraft dengan Siapkan Airdraft."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогресс сохранён. Откройте снова через меню Airdraft → «Настроить Airdraft»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu progresso foi salvo. Abra novamente pelo menu do Airdraft, em Configurar o Airdraft."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre progression est enregistrée. Rouvrez la configuration depuis le menu Airdraft avec Configurer Airdraft."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी प्रगति सहेजी गई है। Airdraft मेनू में Airdraft सेट अप करें से इसे फिर से खोलें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
