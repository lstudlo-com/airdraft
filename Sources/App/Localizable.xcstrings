    "An app rule chooses the %@ profile, which uses this model. Choose another model in Profiles before deleting it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una regla de app elige el perfil %@, que usa este modelo. Elige otro modelo en Perfiles antes de eliminarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリルールで選ばれるプロファイル「%@」がこのモデルを使用しています。削除する前に「プロファイル」で別のモデルを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 规则选择的“%@”模式使用此模型。删除前，请先在“模式”中选择其他模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 規則選擇的「%@」模式使用這個模型。刪除前，請先在「模式」中選擇其他模型。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aturan app memilih profil %@, yang memakai model ini. Pilih model lain di Profil sebelum menghapusnya."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правило приложения выбирает профиль «%@», который использует эту модель. Выберите другую модель в «Профилях», прежде чем удалять её."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma regra de app escolhe o perfil %@, que usa este modelo. Escolha outro modelo em Perfis antes de apagá-lo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une règle d’app choisit le profil %@, qui utilise ce modèle. Choisissez un autre modèle dans Profils avant de le supprimer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक ऐप नियम %@ प्रोफ़ाइल चुनता है, जो इस मॉडल का उपयोग करती है। इसे डिलीट करने से पहले प्रोफ़ाइल में दूसरा मॉडल चुनें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تختار قاعدة تطبيق النمط «%@» الذي يستخدم هذا النموذج. اختر نموذجًا آخر في الأنماط قبل حذفه."
          }
        }
      }
    },
    "An app's own rule comes before its family's" : {
