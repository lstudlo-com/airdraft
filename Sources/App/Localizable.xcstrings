    "Airdraft is quitting. Reopen it before running this action." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft se está cerrando. Vuelve a abrirlo antes de ejecutar esta acción."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft を終了しています。この操作を実行する前にもう一度開いてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 正在退出。请重新打开后再执行此操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 正在結束。請重新打開後再執行此動作。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft sedang keluar. Buka kembali sebelum menjalankan tindakan ini."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft завершает работу. Откройте его снова, чтобы выполнить это действие."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Airdraft está sendo encerrado. Abra-o novamente antes de executar esta ação."
          }
        },
        "fr" : {
          "stringUnit" : {
