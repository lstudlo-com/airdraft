    "This build can’t start a trial or accept a purchase. Contact Airdraft support for a configured build." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta compilación no puede iniciar una prueba ni aceptar compras. Contacta con el soporte de Airdraft para obtener una compilación configurada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビルドでは試用の開始や購入ができません。設定済みのビルドについては Airdraft のサポートにお問い合わせください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本无法开始试用或接受购买。请联系 Airdraft 支持以获取已配置的版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本無法開始試用或接受購買。請聯絡 Airdraft 支援以取得已設定的版本。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build ini tidak dapat memulai uji coba atau menerima pembelian. Hubungi dukungan Airdraft untuk build yang telah dikonfigurasi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта сборка не может начать пробный период или принять покупку. Обратитесь в поддержку Airdraft за настроенной сборкой."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão não pode iniciar um teste nem aceitar compras. Entre em contato com o suporte do Airdraft para obter uma versão configurada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version ne peut ni démarrer d’essai ni accepter d’achat. Contactez l’assistance Airdraft pour obtenir une version configurée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह बिल्ड ट्रायल शुरू नहीं कर सकता या ख़रीदारी स्वीकार नहीं कर सकता। कॉन्फ़िगर किए गए बिल्ड के लिए Airdraft सहायता से संपर्क करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لهذا الإصدار بدء فترة تجريبية أو قبول عملية شراء. تواصل مع دعم Airdraft للحصول على إصدار مضبوط."
          }
        }
      }
    },
