    },
    "Airdraft's relative guidance for local models. Actual speed depends on your Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientación relativa de Airdraft para modelos locales. La velocidad real depende de tu Mac."
