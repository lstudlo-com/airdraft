    },
    "macOS also uses the fn key. Set “Press 🌐 key to” to Do Nothing so it starts Airdraft instead." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS también usa la tecla fn. Ajusta “Pulsar la tecla 🌐 para” en No hacer nada para que inicie Airdraft."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS も fn キーを使用します。「🌐キーを押して」を「何もしない」に設定すると、Airdraft を起動するようになります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 也会使用 fn 键。请将“按下 🌐 键以”设为“不执行任何操作”，让它改为启动 Airdraft。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 也會使用 fn 鍵。請將「按下 🌐 鍵來」設為「不執行任何動作」，讓它改為啟動 Airdraft。"
          }
        }
      }
    },
    "macOS asks once. Airdraft only records while you use your shortcut." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS lo pregunta una vez. Airdraft solo graba mientras usas tu atajo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS からの確認は 1 回だけです。Airdraft はショートカットを使っている間だけ録音します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 只会询问一次。Airdraft 只会在你使用快捷键时录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 只會詢問一次。Airdraft 只會在你使用快速鍵時錄音。"
          }
        }
      }
    },
    "macOS has not granted this running copy access. An enabled switch for another copy or an older build does not confirm access for this one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no ha concedido acceso a esta copia en ejecución. Un interruptor activado para otra copia o una compilación anterior no confirma el acceso para esta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS は実行中のこのコピーにアクセスを許可していません。別のコピーや古いビルドのスイッチがオンでも、このコピーのアクセスは確認されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 尚未授予这份正在运行的 Airdraft 访问权限。其他副本或旧版本的开关已打开，并不代表这一份已获得访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 尚未授予這份正在執行的 Airdraft 存取權。其他副本或舊版本的開關已開啟，並不代表這一份已取得存取權。"
          }
        }
      }
    },
    "macOS manages language assets." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS gestiona los recursos de idioma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語アセットは macOS が管理します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语言资源由 macOS 管理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語言資源由 macOS 管理。"
          }
        }
      }
    },
    "macOS may retain old Accessibility entries. Remove obsolete Airdraft entries with the minus button in System Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que macOS conserve entradas antiguas de Accesibilidad. Elimina las entradas obsoletas de Airdraft con el botón de menos en Ajustes del Sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS に古い「アクセシビリティ」の項目が残っている場合があります。システム設定でマイナスボタンを使い、不要になった Airdraft の項目を削除してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 可能保留旧的“辅助功能”条目。请在“系统设置”中用减号按钮移除过时的 Airdraft 条目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 可能保留舊的「輔助使用」項目。請在「系統設定」中用減號按鈕移除過時的 Airdraft 項目。"
          }
        }
      }
    },
    "macOS now grants this running copy Accessibility access." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ya concede acceso de Accesibilidad a esta copia en ejecución."
