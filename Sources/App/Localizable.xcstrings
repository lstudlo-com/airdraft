          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve na memória e reconhece muitos idiomas. A primeira inicialização pode levar um minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Léger en mémoire et reconnaît de nombreuses langues. Le premier démarrage peut prendre une minute."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम मेमोरी लेता है और कई भाषाएँ पहचानता है। पहली बार शुरू होने में एक मिनट लग सकता है।"
