    "Loaded in RAM. Stays loaded until you unload it, switch models, or quit the app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cargado en la RAM. Sigue cargado hasta que lo descargues de memoria, cambies de modelo o salgas de la app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
