        }
      }
    },
    "Uses your selected refinement provider and may send transcript text to that service. Provider charges may apply. Replaces the current summary; the original transcript is kept." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el proveedor de refinamiento seleccionado y puede enviar el texto de la transcripción a ese servicio. Pueden aplicarse cargos del proveedor. Sustituye el resumen actual; la transcripción original se conserva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した整形プロバイダを使用し、文字起こしのテキストをそのサービスに送信する場合があります。プロバイダの料金がかかることがあります。現在の要約は置き換えられ、元の文字起こしは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你所选的润色提供商，可能会将转录文本发送到该服务，并可能产生提供商费用。会替换当前摘要；原始转录文本会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你選取的潤稿供應商，可能會將逐字稿文字傳送到該服務，並可能產生供應商費用。會取代目前的摘要；原始逐字稿會保留。"
          }
        }
      }
    },
