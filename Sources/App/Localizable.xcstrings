    "Cancel the current dictation and discard its unsaved audio. Text delivery cannot be cancelled once it begins." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela el dictado actual y descarta su audio sin guardar. La entrega del texto no se puede cancelar una vez iniciada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の音声入力をキャンセルし、保存されていない音声を破棄します。テキストの入力が始まった後はキャンセルできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消当前听写并丢弃未保存的音频。文字一旦开始发送便无法取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消目前的聽寫並捨棄未儲存的音訊。文字一旦開始送出便無法取消。"
          }
        }
      }
    },
    "Cantonese fine-tune of SenseVoice. Weak with English; no Japanese or Korean." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
