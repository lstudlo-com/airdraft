    "Airdraft" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft"
          }
        }
      }
    },
    "Airdraft E2E Menu" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft E2E 選單"
          }
        }
      }
    },
    "Airdraft and Debug share local data and provider keys. Preferences for Airdraft, Debug and legacy Transcribar will be reset. Permission target: %@. Old Accessibility entries may need removal in System Settings." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 與 Debug 版共用本機資料與供應商金鑰。Airdraft、Debug 版與舊版 Transcribar 的偏好設定都會重置。權限對象：%@。舊的「輔助使用」項目可能需要在「系統設定」中移除。"
          }
        }
      }
    },
    "Airdraft can hear you." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 聽得到你的聲音。"
          }
        }
      }
    },
    "Airdraft is quitting. Reopen it before running this action." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 正在結束。請重新打開後再執行此動作。"
          }
        }
      }
    },
    "Airdraft license key" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 授權碼"
          }
        }
      }
    },
    "Airdraft lives in the menu bar" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 位於選單列"
          }
        }
      }
    },
    "Airdraft records only while you use your shortcut, and never reads your screen unless you turn that on." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 只會在你使用快速鍵時錄音，且除非你開啟該功能，否則絕不讀取你的螢幕。"
          }
        }
      }
    },
    "Airdraft startup timed out. Open Airdraft, then try this action again." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 啟動逾時。請打開 Airdraft，然後再試一次。"
          }
        }
      }
    },
    "Airdraft turns speech into text in any app: email, chat, notes and documents. Setup takes about three minutes, and you can stop at any time." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 能在任何 App 中把語音轉成文字：郵件、聊天、備忘錄和文件。設定約需三分鐘，隨時都可以中止。"
          }
        }
      }
    },
    "Airdraft will stop and save the meeting before quitting. If saving fails, captured audio remains available for recovery in Meetings." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 會在結束前停止並儲存會議。若儲存失敗，已錄製的音訊仍可在「會議」中復原。"
          }
        }
      }
    },
    "Airdraft works anywhere you can type. Here is how to make it part of your day." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要能打字的地方，Airdraft 都能使用。以下是讓它融入日常的方法。"
          }
        }
      }
    },
    "Airdraft's relative guidance for local models." : {
      "localizations" : {
        "zh-Hant" : {
