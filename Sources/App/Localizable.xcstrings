          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет доступных приложений. Откройте приложение и обновите или выберите «Все приложения»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum app disponível. Abra um app e atualize, ou escolha Todos os apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune app disponible. Ouvrez une app et actualisez, ou choisissez Toutes les apps."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई ऐप उपलब्ध नहीं। कोई ऐप खोलकर रिफ़्रेश करें, या सभी ऐप चुनें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تطبيقات متاحة. افتح تطبيقًا وحدّث، أو اختر «كل التطبيقات»."
          }
        }
      }
    },
    "No audio was received for 15 seconds. Check app audio and microphone permissions." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se recibió audio durante 15 segundos. Revisa los permisos de audio de apps y del micrófono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15 秒間音声を受信していません。アプリの音声とマイクの権限を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有 15 秒没有收到音频。请检查 App 音频和麦克风权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有 15 秒沒有收到音訊。請檢查 App 音訊與麥克風權限。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada audio diterima selama 15 detik. Periksa izin audio app dan mikrofon."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звук не поступал 15 секунд. Проверьте разрешения для звука приложений и микрофона."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum áudio foi recebido por 15 segundos. Verifique as permissões de áudio do app e do microfone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun audio reçu depuis 15 secondes. Vérifiez les autorisations d’audio des apps et du micro."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15 सेकंड तक कोई ऑडियो नहीं मिला। ऐप ऑडियो और माइक्रोफ़ोन अनुमतियाँ जाँचें।"
          }
        },
        "ar" : {
          "stringUnit" : {
