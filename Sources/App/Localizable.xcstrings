    "A previous attempt may have used a device slot. Remove “%@” in your customer portal, then confirm." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un intento anterior puede haber usado una plaza de dispositivo. Elimina “%@” en tu portal de cliente y luego confirma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前の試行でデバイス枠が使用された可能性があります。カスタマーポータルで「%@」を削除してから確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之前的尝试可能已占用一个设备名额。请在客户门户中移除“%@”，然后确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先前的嘗試可能已占用一個裝置名額。請在客戶入口網站移除「%@」，然後確認。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upaya sebelumnya mungkin memakai slot perangkat. Hapus “%@” di portal pelanggan Anda, lalu konfirmasi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предыдущая попытка могла занять слот устройства. Удалите «%@» на портале клиента, затем подтвердите."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma tentativa anterior pode ter ocupado uma vaga de dispositivo. Remova “%@” no portal do cliente e confirme."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une tentative précédente a peut-être occupé un emplacement d’appareil. Supprimez « %@ » dans votre portail client, puis confirmez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हो सकता है पिछली कोशिश में एक डिवाइस स्लॉट इस्तेमाल हुआ हो। अपने ग्राहक पोर्टल में “%@” हटाएँ, फिर पुष्टि करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما استخدمت محاولة سابقة خانة جهاز. أزل «%@» من بوابة العملاء، ثم أكّد."
          }
        }
      }
    },
