    "Hold to record; release to stop" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado para grabar; suelta para parar"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長押しで録音、離すと停止"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住即可录音；松开即停止"
