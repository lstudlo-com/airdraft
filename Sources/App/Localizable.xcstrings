            "value" : "Airdraft 对本地模型的相对参考。实际速度取决于你的 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 對本機模型的相對參考。實際速度取決於你的 Mac。"
          }
        },
        "id" : {
          "stringUnit" : {
