    },
    "Airdraft records only while you use your shortcut, and never reads your screen unless you turn that on." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft solo graba mientras usas tu atajo y nunca lee tu pantalla a menos que lo actives."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft はショートカットを使っている間だけ録音し、オンにしない限り画面を読み取ることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 只会在你使用快捷键时录音，且除非你开启该功能，否则绝不读取你的屏幕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 只會在你使用快速鍵時錄音，且除非你開啟該功能，否則絕不讀取你的螢幕。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft hanya merekam saat Anda memakai pintasan, dan tidak pernah membaca layar Anda kecuali Anda mengaktifkannya."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft записывает, только пока вы используете сочетание клавиш, и не читает экран, если вы это не включите."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Airdraft só grava enquanto você usa seu atalho e nunca lê sua tela, a menos que você ative essa opção."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft n’enregistre qu’avec votre raccourci et ne lit jamais votre écran, sauf si vous l’activez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft केवल तभी रिकॉर्ड करता है जब आप अपना शॉर्टकट इस्तेमाल करते हैं, और जब तक आप चालू न करें, आपकी स्क्रीन कभी नहीं पढ़ता।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يسجّل Airdraft إلا أثناء استخدامك للاختصار، ولا يقرأ شاشتك أبدًا ما لم تفعّل ذلك."
          }
        }
      }
    },
    "Airdraft startup timed out. Open Airdraft, then try this action again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se agotó el tiempo de inicio de Airdraft. Abre Airdraft y vuelve a intentar esta acción."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft の起動がタイムアウトしました。Airdraft を開いてから、もう一度この操作を実行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 启动超时。请打开 Airdraft，然后重试此操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 啟動逾時。請打開 Airdraft，然後再試一次。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu mulai Airdraft habis. Buka Airdraft, lalu coba tindakan ini lagi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время запуска Airdraft истекло. Откройте Airdraft и повторите действие."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A inicialização do Airdraft expirou. Abra o Airdraft e tente esta ação novamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le démarrage d’Airdraft a expiré. Ouvrez Airdraft, puis réessayez cette action."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft शुरू होने का समय समाप्त हो गया। Airdraft खोलें, फिर यह कार्रवाई दोबारा आज़माएँ।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت مهلة بدء تشغيل Airdraft. افتح Airdraft، ثم أعد محاولة هذا الإجراء."
          }
        }
      }
    },
    "Airdraft turns speech into text in any app: email, chat, notes and documents. Setup takes about three minutes, and you can stop at any time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft convierte la voz en texto en cualquier app: correo, chat, notas y documentos. La configuración dura unos tres minutos y puedes parar cuando quieras."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft は、メール、チャット、メモ、書類など、どのアプリでも音声をテキストに変換します。設定は約 3 分で、いつでも中断できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 能在任何 App 中把语音转成文字：邮件、聊天、备忘录和文档。设置约需三分钟，随时可以停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 能在任何 App 中把語音轉成文字：郵件、聊天、備忘錄和文件。設定約需三分鐘，隨時都可以中止。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft mengubah ucapan menjadi teks di app apa pun: email, obrolan, catatan, dan dokumen. Penyiapan memakan sekitar tiga menit, dan Anda dapat berhenti kapan saja."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft превращает речь в текст в любом приложении: почте, чате, заметках и документах. Настройка займёт около трёх минут, и её можно прервать в любой момент."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Airdraft transforma fala em texto em qualquer app: e-mail, chat, notas e documentos. A configuração leva cerca de três minutos, e você pode parar a qualquer momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft transforme la parole en texte dans n’importe quelle app : e-mails, messagerie, notes et documents. La configuration prend environ trois minutes et vous pouvez l’interrompre à tout moment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft किसी भी ऐप में बोली को टेक्स्ट में बदलता है: ईमेल, चैट, नोट्स और दस्तावेज़। सेटअप में लगभग तीन मिनट लगते हैं, और आप कभी भी रुक सकते हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحوّل Airdraft الكلام إلى نص في أي تطبيق: البريد والدردشة والملاحظات والمستندات. يستغرق الإعداد نحو ثلاث دقائق، ويمكنك التوقف في أي وقت."
          }
        }
      }
    },
    "Airdraft will stop and save the meeting before quitting. If saving fails, captured audio remains available for recovery in Meetings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft detendrá y guardará la reunión antes de salir. Si no se puede guardar, el audio capturado seguirá disponible para recuperarlo en Reuniones."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft は終了する前に会議を停止して保存します。保存できなかった場合でも、録音した音声は「会議」から復元できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 会在退出前停止并保存会议。如果保存失败，已录制的音频仍可在“会议”中恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 會在結束前停止並儲存會議。若儲存失敗，已錄製的音訊仍可在「會議」中復原。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft akan menghentikan dan menyimpan rapat sebelum keluar. Jika penyimpanan gagal, audio yang terekam tetap dapat dipulihkan di Rapat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед выходом Airdraft остановит и сохранит встречу. Если сохранить не удастся, записанный звук можно будет восстановить во «Встречах»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Airdraft vai parar e salvar a reunião antes de encerrar. Se o salvamento falhar, o áudio capturado continuará disponível para recuperação em Reuniões."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft arrêtera et sauvegardera la réunion avant de quitter. Si la sauvegarde échoue, l’audio capturé reste récupérable dans Réunions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाहर निकलने से पहले Airdraft मीटिंग रोककर सहेज देगा। सहेजना विफल होने पर कैप्चर किया गया ऑडियो मीटिंग्स में रिकवरी के लिए उपलब्ध रहेगा।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيوقف Airdraft الاجتماع ويحفظه قبل الإنهاء. إذا فشل الحفظ، يبقى الصوت الملتقط متاحًا للاسترداد في الاجتماعات."
          }
        }
      }
    },
    "Airdraft works anywhere you can type. Here is how to make it part of your day." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft funciona en cualquier lugar donde puedas escribir. Así puedes integrarlo en tu día a día."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft は文字を入力できる場所ならどこでも使えます。日常で活用する方法を紹介します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要能打字的地方，Airdraft 都能用。下面介绍如何让它融入你的日常。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要能打字的地方，Airdraft 都能使用。以下是讓它融入日常的方法。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft bekerja di mana pun Anda mengetik. Begini cara memakainya sehari-hari."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft работает везде, где можно печатать. Вот как сделать его частью дня."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Airdraft funciona onde você digita. Veja como usá-lo no dia a dia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft fonctionne partout où vous pouvez taper du texte. Voici comment l’intégrer à votre quotidien."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft हर उस जगह काम करता है जहाँ आप टाइप कर सकते हैं। इसे अपनी दिनचर्या का हिस्सा ऐसे बनाएँ।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل Airdraft في أي مكان يمكنك الكتابة فيه. إليك كيف تجعله جزءًا من يومك."
          }
        }
      }
    },
    "Airdraft's relative guidance for local models." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientación relativa de Airdraft para modelos locales."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルモデルに関する Airdraft の相対的な目安です。"
          }
        },
        "zh-Hans" : {
