    "Hold while you speak, then let go." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenlo pulsado mientras hablas y luego suéltalo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話している間は押したままにし、話し終えたら離します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
