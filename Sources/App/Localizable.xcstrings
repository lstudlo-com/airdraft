            "value" : "這台 Mac：%@"
          }
        }
      }
    },
    "This activation is no longer valid" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此啟用已失效"
