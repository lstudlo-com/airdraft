        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вот и всё. Нажмите для начала и ещё раз, чтобы вставить."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É isso. Pressione para iniciar e pressione de novo para inserir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est tout. Appuyez pour démarrer, puis à nouveau pour insérer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बस इतना ही। शुरू करने के लिए दबाएँ, डालने के लिए फिर से दबाएँ।"
