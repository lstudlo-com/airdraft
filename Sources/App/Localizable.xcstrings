    "Hello! I’m trying Airdraft for the first time, and it’s writing what I say." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola! Estoy probando Airdraft por primera vez y está escribiendo lo que digo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは。Airdraft を初めて試しています。話したことが文字になっています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你好！我第一次试用 Airdraft，它正在写下我说的话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "哈囉！我第一次試用 Airdraft，它正在寫下我說的話。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halo! Saya baru pertama kali mencoba Airdraft, dan ia menuliskan apa yang saya ucapkan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привет! Я впервые пробую Airdraft, и он записывает то, что я говорю."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá! Estou usando o Airdraft pela primeira vez e ele escreve o que eu digo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour ! J’essaie Airdraft pour la première fois, et il écrit ce que je dis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नमस्ते! मैं पहली बार Airdraft आज़मा रहा हूँ, और यह वही लिख रहा है जो मैं बोलता हूँ।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرحبًا! أجرّب Airdraft لأول مرة، وهو يكتب ما أقوله."
          }
        }
      }
    },
