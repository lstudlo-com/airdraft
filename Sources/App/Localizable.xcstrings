        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправлять разработчику анонимную статистику использования и отчёты о сбоях. Ничего не отправляется, пока вы не решите."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe contagens de uso anônimas e relatórios de falhas com o desenvolvedor. Nada é enviado até você escolher."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez des statistiques d’utilisation anonymes et des rapports de plantage avec le développeur. Rien n’est envoyé tant que vous n’avez pas choisi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेवलपर के साथ गुमनाम उपयोग गिनती और क्रैश रिपोर्ट साझा करें। आपके चुनने तक कुछ भी नहीं भेजा जाता।"
          }
