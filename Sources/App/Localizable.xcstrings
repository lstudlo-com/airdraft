        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说话时按住。适合简短消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說話時按住。適合簡短訊息。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan sambil berbicara. Cocok untuk pesan singkat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте, пока говорите. Удобно для коротких сообщений."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure enquanto fala. Bom para mensagens curtas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez pendant que vous parlez. Idéal pour les messages courts."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोलते समय दबाकर रखें। छोटे संदेशों के लिए अच्छा।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مع الاستمرار أثناء التحدث. مناسب للرسائل القصيرة."
          }
        }
      }
    },
