    "%lld unfinished recording(s) could not be read. Check folder access. Other recordings can still be recovered; Remove Audio Files in Settings clears unreadable drafts too." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer %lld grabaciones sin terminar. Revisa el acceso a la carpeta. Las demás grabaciones aún se pueden recuperar; Eliminar archivos de audio en Ajustes también borra los borradores ilegibles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件の未完了の録音を読み取れませんでした。フォルダへのアクセス権を確認してください。ほかの録音は引き続き復元できます。「設定」の「音声ファイルを削除」を実行すると、読み取れない下書きも消去されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 个未完成的录音无法读取。请检查文件夹访问权限。其他录音仍可恢复；在“设置”中执行“移除音频文件”也会清除无法读取的草稿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 個未完成的錄音無法讀取。請檢查資料夾存取權限。其他錄音仍可復原；在「設定」中執行「移除音訊檔案」也會清除無法讀取的草稿。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld rekaman yang belum selesai tidak dapat dibaca. Periksa akses folder. Rekaman lain masih dapat dipulihkan; Hapus File Audio di Pengaturan juga membersihkan draf yang tidak terbaca."
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Не удалось прочитать %lld незавершённую запись. Проверьте доступ к папке. Остальные записи можно восстановить; «Удалить аудиофайлы» в Настройках также удаляет нечитаемые черновики."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Не удалось прочитать %lld незавершённые записи. Проверьте доступ к папке. Остальные записи можно восстановить; «Удалить аудиофайлы» в Настройках также удаляет нечитаемые черновики."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Не удалось прочитать %lld незавершённых записей. Проверьте доступ к папке. Остальные записи можно восстановить; «Удалить аудиофайлы» в Настройках также удаляет нечитаемые черновики."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Не удалось прочитать незавершённые записи (%lld). Проверьте доступ к папке. Остальные записи можно восстановить; «Удалить аудиофайлы» в Настройках также удаляет нечитаемые черновики."
                }
              }
            }
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler %lld gravação(ões) inacabada(s). Verifique o acesso à pasta. As outras gravações ainda podem ser recuperadas; Remover arquivos de áudio, em Ajustes, também limpa rascunhos ilegíveis."
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Impossible de lire %lld enregistrement inachevé. Vérifiez l’accès au dossier. Les autres enregistrements restent récupérables ; Supprimer les fichiers audio, dans Réglages, efface aussi les brouillons illisibles."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Impossible de lire %lld enregistrements inachevés. Vérifiez l’accès au dossier. Les autres enregistrements restent récupérables ; Supprimer les fichiers audio, dans Réglages, efface aussi les brouillons illisibles."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Impossible de lire %lld enregistrements inachevés. Vérifiez l’accès au dossier. Les autres enregistrements restent récupérables ; Supprimer les fichiers audio, dans Réglages, efface aussi les brouillons illisibles."
                }
              }
            }
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld अधूरी रिकॉर्डिंग पढ़ी नहीं जा सकीं। फ़ोल्डर ऐक्सेस जाँचें। बाकी रिकॉर्डिंग अब भी रिकवर की जा सकती हैं; सेटिंग्ज़ में ऑडियो फ़ाइलें हटाएँ से न पढ़े जा सकने वाले ड्राफ़्ट भी हट जाते हैं।"
          }
        },
        "ar" : {
          "variations" : {
            "plural" : {
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تعذّرت قراءة تسجيلات غير مكتملة. تحقق من صلاحية الوصول إلى المجلد. لا يزال بالإمكان استرداد التسجيلات الأخرى؛ ويؤدي «إزالة الملفات الصوتية» في الإعدادات إلى مسح المسودات غير المقروءة أيضًا."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تعذّرت قراءة تسجيل واحد غير مكتمل. تحقق من صلاحية الوصول إلى المجلد. لا يزال بالإمكان استرداد التسجيلات الأخرى؛ ويؤدي «إزالة الملفات الصوتية» في الإعدادات إلى مسح المسودات غير المقروءة أيضًا."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تعذّرت قراءة تسجيلين غير مكتملين. تحقق من صلاحية الوصول إلى المجلد. لا يزال بالإمكان استرداد التسجيلات الأخرى؛ ويؤدي «إزالة الملفات الصوتية» في الإعدادات إلى مسح المسودات غير المقروءة أيضًا."
