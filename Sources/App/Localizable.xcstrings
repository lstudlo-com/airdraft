    "This profile skips tidying. To tidy words, set up refinement in Models and use a profile that refines." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil no pule el texto. Para pulirlo, configura el refinamiento en Modelos y usa un perfil que refine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このモードではテキストを整えません。整えるには「モデル」で整形を設定し、整形するモードを使用してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此模式不整理文字。如需整理文字，请在“模型”中设置润色，并使用会润色的模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個模式不整理文字。若要整理文字，請在「模型」中設定潤稿，並使用會潤稿的模式。"
          }
        }
      }
    },
    "This recording is no longer available. Refresh History to update the list." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta grabación ya no está disponible. Actualiza el Historial para refrescar la lista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この録音は使用できなくなりました。「履歴」を更新して一覧を最新にしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此录音已不可用。请刷新“历史记录”以更新列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此錄音已無法使用。請重新整理「記錄」以更新列表。"
          }
        }
      }
    },
    "This release uses ad-hoc signing. macOS may require these steps again after an update." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión usa firma ad hoc. Puede que macOS vuelva a pedir estos pasos tras una actualización."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリリースはアドホック署名を使用しています。アップデート後に macOS からこの手順を再度求められる場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本使用临时签名。更新后 macOS 可能会要求你再次执行这些步骤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本使用臨時簽署。更新後 macOS 可能會要求再次執行這些步驟。"
          }
        }
      }
    },
    "This releases its device slot. Your history, models and provider keys stay on this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto libera su plaza de dispositivo. Tu historial, tus modelos y tus claves de proveedores se quedan en este Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス枠が解放されます。履歴、モデル、プロバイダのキーはこの Mac に残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会释放设备名额。你的历史记录、模型和提供商密钥会留在这台 Mac 上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會釋放裝置名額。你的記錄、模型與供應商金鑰會留在這台 Mac 上。"
          }
        }
      }
    },
    "This shortcut is already used by another shortcut." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otro atajo ya usa esta combinación."
