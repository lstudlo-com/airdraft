    "Supported on-device models favor your spellings. Online services always receive them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos compatibles en el dispositivo priorizan tus grafías. Los servicios en línea siempre las reciben."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応しているデバイス上のモデルでは、登録した表記が優先されます。オンラインサービスには常に送信されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持的设备端模型会优先采用你的写法。在线服务始终会收到这些词汇。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支援的裝置端模型會優先採用你的拼寫。線上服務一律會收到這些詞彙。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model di perangkat yang didukung mengutamakan ejaan Anda. Layanan online selalu menerimanya."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддерживаемые локальные модели учитывают ваши написания. Онлайн-сервисы получают их всегда."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelos no dispositivo compatíveis priorizam suas grafias. Serviços online sempre as recebem."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles sur l’appareil compatibles privilégient vos orthographes. Les services en ligne les reçoivent toujours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समर्थित ऑन-डिवाइस मॉडल आपकी वर्तनी को प्राथमिकता देते हैं। ऑनलाइन सेवाओं को ये हमेशा भेजी जाती हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفضّل النماذج المدعومة على الجهاز تهجئاتك. تتلقاها الخدمات عبر الإنترنت دائمًا."
          }
        }
      }
    },
    "Supports %@ only." : {
      "localizations" : {
