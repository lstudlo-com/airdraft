    },
    "Uses your selected refinement provider and may send transcript text to that service. Provider charges may apply. Replaces the current summary; the original transcript is kept." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el proveedor de refinamiento seleccionado y puede enviar el texto de la transcripción a ese servicio. Pueden aplicarse cargos del proveedor. Sustituye el resumen actual; la transcripción original se conserva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した整形プロバイダを使用し、文字起こしのテキストをそのサービスに送信する場合があります。プロバイダの料金がかかることがあります。現在の要約は置き換えられ、元の文字起こしは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你所选的润色提供商，可能会将转录文本发送到该服务，并可能产生提供商费用。会替换当前摘要；原始转录文本会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你選取的潤稿供應商，可能會將逐字稿文字傳送到該服務，並可能產生供應商費用。會取代目前的摘要；原始逐字稿會保留。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memakai penyedia penyempurnaan pilihan Anda dan dapat mengirim teks transkrip ke layanan tersebut. Biaya penyedia mungkin berlaku. Menggantikan ringkasan saat ini; transkrip asli tetap disimpan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует выбранного провайдера доработки и может отправлять ему текст расшифровки. Провайдер может взимать плату. Заменяет текущую сводку; исходная расшифровка сохраняется."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o provedor de refinamento selecionado e pode enviar o texto da transcrição a esse serviço. Pode haver cobrança do provedor. Substitui o resumo atual; a transcrição original é mantida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise votre fournisseur d’affinage sélectionné, qui peut recevoir le texte de la transcription. Des frais du fournisseur peuvent s’appliquer. Remplace le résumé actuel ; la transcription originale est conservée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके चुने गए सुधार प्रदाता का उपयोग करता है और ट्रांसक्रिप्ट का टेक्स्ट उस सेवा को भेज सकता है। प्रदाता शुल्क लग सकते हैं। मौजूदा सारांश बदल देता है; मूल ट्रांसक्रिप्ट रखा जाता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم مزوّد التحسين المحدد وقد يرسل نص النص المكتوب إلى تلك الخدمة. قد تُطبَّق رسوم المزوّد. يستبدل الملخص الحالي؛ ويُحتفظ بالنص المكتوب الأصلي."
          }
        }
      }
    },
    "Uses your selected refinement provider and may send transcript text to that service. Provider charges may apply. The original transcript is kept." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el proveedor de refinamiento seleccionado y puede enviar el texto de la transcripción a ese servicio. Pueden aplicarse cargos del proveedor. La transcripción original se conserva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した整形プロバイダを使用し、文字起こしのテキストをそのサービスに送信する場合があります。プロバイダの料金がかかることがあります。元の文字起こしは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你所选的润色提供商，可能会将转录文本发送到该服务，并可能产生提供商费用。原始转录文本会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你選取的潤稿供應商，可能會將逐字稿文字傳送到該服務，並可能產生供應商費用。原始逐字稿會保留。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memakai penyedia penyempurnaan pilihan Anda dan dapat mengirim teks transkrip ke layanan tersebut. Biaya penyedia mungkin berlaku. Transkrip asli tetap disimpan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует выбранного провайдера доработки и может отправлять ему текст расшифровки. Провайдер может взимать плату. Исходная расшифровка сохраняется."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o provedor de refinamento selecionado e pode enviar o texto da transcrição a esse serviço. Pode haver cobrança do provedor. A transcrição original é mantida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise votre fournisseur d’affinage sélectionné, qui peut recevoir le texte de la transcription. Des frais du fournisseur peuvent s’appliquer. La transcription originale est conservée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके चुने गए सुधार प्रदाता का उपयोग करता है और ट्रांसक्रिप्ट का टेक्स्ट उस सेवा को भेज सकता है। प्रदाता शुल्क लग सकते हैं। मूल ट्रांसक्रिप्ट रखा जाता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم مزوّد التحسين المحدد وقد يرسل نص النص المكتوب إلى تلك الخدمة. قد تُطبَّق رسوم المزوّد. يُحتفظ بالنص المكتوب الأصلي."
          }
        }
      }
    },
