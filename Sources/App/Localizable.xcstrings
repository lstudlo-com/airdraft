      }
    },
    "This release uses ad-hoc signing. macOS may require these steps again after an update." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión usa firma ad hoc. Puede que macOS vuelva a pedir estos pasos tras una actualización."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリリースはアドホック署名を使用しています。アップデート後に macOS からこの手順を再度求められる場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本使用临时签名。更新后 macOS 可能会要求你再次执行这些步骤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本使用臨時簽署。更新後 macOS 可能會要求再次執行這些步驟。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilis ini memakai penandatanganan ad-hoc. macOS mungkin memerlukan langkah-langkah ini lagi setelah pembaruan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот выпуск подписан ad-hoc. После обновления macOS может снова потребовать эти шаги."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versão usa assinatura ad hoc. O macOS pode exigir estas etapas novamente após uma atualização."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version utilise une signature ad hoc. macOS peut demander à nouveau ces étapes après une mise à jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह रिलीज़ ऐड-हॉक साइनिंग का उपयोग करती है। अपडेट के बाद macOS ये चरण फिर से माँग सकता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم هذا الإصدار توقيعًا مخصصًا (ad-hoc). قد يطلب macOS هذه الخطوات مجددًا بعد التحديث."
          }
        }
      }
    },
    "This releases its device slot. Your history, models and provider keys stay on this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto libera su plaza de dispositivo. Tu historial, tus modelos y tus claves de proveedores se quedan en este Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス枠が解放されます。履歴、モデル、プロバイダのキーはこの Mac に残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会释放设备名额。你的历史记录、模型和提供商密钥会留在这台 Mac 上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會釋放裝置名額。你的記錄、模型與供應商金鑰會留在這台 Mac 上。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini melepaskan slot perangkatnya. Riwayat, model, dan kunci penyedia Anda tetap di Mac ini."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это освободит слот устройства. История, модели и ключи провайдеров останутся на этом Mac."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso libera a vaga do dispositivo. Seu histórico, seus modelos e suas chaves de provedores permanecem neste Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela libère son emplacement d’appareil. Votre historique, vos modèles et les clés des fournisseurs restent sur ce Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे इसका डिवाइस स्लॉट खाली हो जाता है। आपका इतिहास, मॉडल और प्रदाता की इसी Mac पर रहती हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحرّر هذا خانة الجهاز. يبقى سجلك ونماذجك ومفاتيح المزوّدين على هذا الـ Mac."
          }
        }
      }
    },
