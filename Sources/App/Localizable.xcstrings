    "This only clears the saved activation on this Mac. It cannot release a device slot in Polar. For a rotated key, use Update Key instead." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto solo borra la activación guardada en este Mac. No puede liberar una plaza de dispositivo en Polar. Si cambiaste la clave, usa Actualizar clave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac に保存されたアクティベーション情報を消去するだけで、Polar のデバイス枠は解放されません。キーを変更した場合は「キーを更新」を使用してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这只会清除这台 Mac 上已保存的激活信息，无法释放 Polar 中的设备名额。如果已更换许可证密钥，请改用“更新密钥”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這只會清除這台 Mac 上已儲存的啟用資訊，無法釋放 Polar 中的裝置名額。若已更換授權碼，請改用「更新授權碼」。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini hanya menghapus aktivasi tersimpan di Mac ini. Ini tidak dapat melepaskan slot perangkat di Polar. Untuk kunci yang diganti, gunakan Perbarui Kunci."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это только удаляет сохранённую активацию на этом Mac и не освобождает слот устройства в Polar. Если вы сменили ключ, используйте «Обновить ключ»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso só limpa a ativação salva neste Mac. Não libera uma vaga de dispositivo no Polar. Se você trocou a chave, use Atualizar chave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci efface seulement l’activation enregistrée sur ce Mac. Cela ne peut pas libérer d’emplacement d’appareil dans Polar. Pour une clé changée, utilisez plutôt Mettre à jour la clé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह केवल इस Mac पर सहेजे गए सक्रियण को साफ़ करता है। यह Polar में डिवाइस स्लॉट खाली नहीं कर सकता। बदली गई की के लिए, इसके बजाय की अपडेट करें का उपयोग करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمسح هذا التفعيل المحفوظ على هذا الـ Mac فقط. لا يمكنه تحرير خانة جهاز في Polar. إذا غيّرت مفتاحك، فاستخدم «تحديث المفتاح» بدلًا من ذلك."
          }
        }
      }
    },
    "This profile keeps your exact words" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil conserva tus palabras exactas"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロファイルは話した言葉をそのまま残します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此模式会保留你说的每个字"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個模式會保留你說的每個字"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil ini mempertahankan kata-kata persis Anda"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот профиль сохраняет ваши слова в точности"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil mantém suas palavras exatas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil conserve vos mots exacts"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह प्रोफ़ाइल आपके शब्द ज्यों के त्यों रखती है"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ هذا النمط بكلماتك كما قلتها"
          }
        }
      }
    },
    "This profile skips tidying. %@ tidies profiles that use refinement." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil no pule el texto. %@ pule los perfiles que usan refinamiento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロファイルではテキストを整えません。整形を使うプロファイルでは %@ がテキストを整えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此模式不整理文字。%@ 会整理使用润色的模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個模式不整理文字。%@ 會整理使用潤稿的模式。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil ini tidak merapikan teks. %@ merapikan profil yang memakai penyempurnaan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот профиль не дорабатывает текст. %@ дорабатывает профили с доработкой."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil não organiza o texto. %@ organiza os perfis que usam refinamento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil ne met pas en forme. %@ met en forme les profils qui utilisent l’affinage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह प्रोफ़ाइल सुधार नहीं करती। सुधार का उपयोग करने वाली प्रोफ़ाइल में %@ शब्द सुधारता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتخطى هذا النمط التنقيح. ينقّح %@ الأنماط التي تستخدم التحسين."
          }
        }
      }
    },
    "This profile skips tidying. Apple Intelligence can tidy profiles that use refinement, on this Mac with no key." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este perfil no pule el texto. Apple Intelligence puede pulir los perfiles que usan refinamiento, en este Mac y sin clave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロファイルではテキストを整えません。整形を使うプロファイルでは、Apple Intelligence がこの Mac 上でキーなしでテキストを整えられます。"
          }
        },
        "zh-Hans" : {
