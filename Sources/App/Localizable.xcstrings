          }
        }
      }
    },
    "Your speed, words and time saved appear here after you dictate." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu velocidad, tus palabras y el tiempo ahorrado aparecen aquí después de dictar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力すると、ここに速度、語数、節約した時間が表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "听写后，这里会显示你的速度、字数和节省的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聽寫後，這裡會顯示你的速度、字數和節省的時間。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kecepatan, kata, dan waktu yang dihemat muncul di sini setelah Anda mendikte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скорость, слова и сэкономленное время появятся после диктовки."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velocidade, palavras e tempo poupado aparecem aqui após você ditar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre vitesse, vos mots et le temps gagné apparaîtront ici après votre dictée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिक्टेट करने के बाद आपकी गति, शब्द और बचा समय यहाँ दिखते हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هنا سرعتك وكلماتك والوقت الموفَّر بعد الإملاء."
          }
        }
      }
    },
    "Your speed, words and time saved return when History can be read." : {
      "localizations" : {
