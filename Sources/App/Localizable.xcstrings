    "No apps available. Open an app and refresh, or choose All Apps." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay apps disponibles. Abre una app y actualiza, o elige Todas las apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用できるアプリがありません。アプリを開いて更新するか、「すべてのアプリ」を選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有可用的 App。请打开一个 App 并刷新，或选择“所有 App”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有可用的 App。請打開一個 App 並重新整理，或選擇「所有 App」。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
