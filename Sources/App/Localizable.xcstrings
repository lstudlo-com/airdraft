    "This only clears the saved activation on this Mac. It cannot release a device slot in Polar. For a rotated key, use Update Key instead." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto solo borra la activación guardada en este Mac. No puede liberar una plaza de dispositivo en Polar. Si cambiaste la clave, usa Actualizar clave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac に保存されたアクティベーション情報を消去するだけで、Polar のデバイス枠は解放されません。キーを変更した場合は「キーを更新」を使用してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这只会清除这台 Mac 上已保存的激活信息，无法释放 Polar 中的设备名额。如果已更换许可证密钥，请改用“更新密钥”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這只會清除這台 Mac 上已儲存的啟用資訊，無法釋放 Polar 中的裝置名額。若已更換授權碼，請改用「更新授權碼」。"
          }
        }
      }
    },
    "This profile keeps your exact words" : {
      "localizations" : {
        "es" : {
