    "It worked. The small window at the bottom of your screen shows when Airdraft is listening." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funcionó. La pequeña ventana de la parte inferior de la pantalla indica cuándo te escucha Airdraft."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "うまくいきました。Airdraft が聞き取っている間は、画面下部に小さなウインドウが表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成功了！Airdraft 收听时，屏幕底部会显示这个小窗口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成功了！螢幕底部的小視窗會在 Airdraft 聆聽時顯示。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berhasil. Jendela kecil di bagian bawah layar menunjukkan kapan Airdraft mendengarkan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получилось. Маленькое окно внизу экрана показывает, когда Airdraft слушает."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funcionou. A pequena janela na parte inferior da tela aparece quando o Airdraft está ouvindo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça marche. La petite fenêtre en bas de votre écran indique quand Airdraft écoute."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह काम कर गया। आपकी स्क्रीन के नीचे की छोटी विंडो दिखाती है कि Airdraft कब सुन रहा है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نجح الأمر. تظهر النافذة الصغيرة أسفل شاشتك عندما يستمع Airdraft."
          }
        }
      }
    },
    "Its app rules are removed too. This cannot be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se eliminan sus reglas de apps. Esta acción no se puede deshacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのアプリルールも削除されます。この操作は取り消せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的 App 规则也会一并移除。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的 App 規則也會一併移除。此動作無法復原。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aturan app-nya juga dihapus. Ini tidak dapat diurungkan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его правила приложений тоже будут удалены. Это действие нельзя отменить."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As regras de app dele também serão removidas. Isso não pode ser desfeito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses règles d’app sont aussi supprimées. Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके ऐप नियम भी हटा दिए जाते हैं। इसे पहले जैसा नहीं किया जा सकता।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُزال قواعد التطبيقات الخاصة به أيضًا. لا يمكن التراجع عن هذا."
          }
        }
      }
    },
