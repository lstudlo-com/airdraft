          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторная попытка до удаления может занять ещё один слот устройства."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tentar novamente antes de removê-la pode ocupar outra vaga de dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réessayer avant de la supprimer peut occuper un autre emplacement d’appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे हटाए बिना फिर से कोशिश करने पर एक और डिवाइस स्लॉट इस्तेमाल हो सकता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تستخدم المحاولة مجددًا قبل إزالته خانة جهاز أخرى."
          }
        }
      }
    },
