        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте, пока говорите, затем отпустите."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure enquanto fala e depois solte."
          }
