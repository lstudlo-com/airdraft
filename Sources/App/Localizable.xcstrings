    "Now %@ your shortcut and speak." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora %@ tu atajo y habla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットを%@して話してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在%@快捷键并说话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在%@快速鍵並說話。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekarang %@ pintasan Anda dan berbicaralah."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш черёд. %@ сочетание клавиш и говорите."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora %@ seu atalho e fale."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenant, %@ votre raccourci et parlez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अब अपना शॉर्टकट %@ और बोलें।"
