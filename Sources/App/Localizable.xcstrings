    "Apple Intelligence can’t write %@ yet, so your words may stay as you said them. You can change this in Models." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence aún no puede escribir en %@, así que tus palabras pueden quedar tal como las dijiste. Puedes cambiarlo en Modelos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence はまだ%@を書けないため、話した言葉がそのまま残ることがあります。「モデル」で変更できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 暂时无法书写%@，你说的话可能会保持原样。你可以在“模型”中更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 暫時無法書寫%@，你說的話可能會保持原樣。你可以在「模型」中更改。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence belum dapat menulis %@, jadi kata-kata Anda mungkin tetap seperti yang Anda ucapkan. Anda dapat mengubahnya di Model."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence пока не поддерживает %@, поэтому слова могут остаться как сказаны. Это можно изменить в «Моделях»."
