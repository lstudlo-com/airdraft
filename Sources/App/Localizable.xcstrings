    "Save or approve access to the Soniox key that owns these uploads, then retry cleanup." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda o aprueba el acceso a la clave de Soniox a la que pertenecen estas subidas y vuelve a intentar la limpieza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのアップロードを所有する Soniox のキーを保存するかアクセスを許可してから、クリーンアップを再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
