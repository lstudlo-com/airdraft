    },
    "Another app copy may be changing local data, or the data folder is unavailable. Quit other copies, check folder access, then reopen Airdraft." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能有另一份 App 正在更改本地数据，或数据文件夹不可用。请退出其他副本、检查文件夹访问权限，然后重新打开 Airdraft。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
