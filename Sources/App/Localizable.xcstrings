    "Share anonymous usage counts and crash reports with the developer. Nothing is sent until you choose." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte recuentos de uso anónimos e informes de fallos con el desarrollador. No se envía nada hasta que elijas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匿名の使用回数とクラッシュレポートを開発者と共有します。選択するまでは何も送信されません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与开发者分享匿名的使用次数和崩溃报告。在你做出选择之前，不会发送任何数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與開發者分享匿名的使用次數與當機報告。在你做出選擇之前，不會傳送任何資料。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagikan jumlah penggunaan anonim dan laporan kerusakan dengan pengembang. Tidak ada yang dikirim sampai Anda memilih."
