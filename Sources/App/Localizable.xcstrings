    "Press once to start and again to stop. Good for longer thoughts." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa una vez para empezar y otra para parar. Ideal para ideas más largas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 回押すと開始、もう一度押すと停止します。長めの内容に便利です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
