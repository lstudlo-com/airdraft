    "This Mac can’t run Apple Intelligence. You can set up another way to tidy your words in Models." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac no puede usar Apple Intelligence. Puedes configurar otra forma de pulir tus palabras en Modelos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac では Apple Intelligence を使用できません。「モデル」でテキストを整える別の方法を設定できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 无法运行 Apple Intelligence。你可以在“模型”中设置其他整理文字的方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台 Mac 無法執行 Apple Intelligence。你可以在「模型」中設定其他整理文字的方式。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac ini tidak dapat menjalankan Apple Intelligence. Anda dapat menyiapkan cara lain untuk merapikan kata-kata Anda di Model."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Mac не поддерживает Apple Intelligence. В «Моделях» можно настроить другой способ доработки текста."
          }
