    "Try the keys first, or continue when you are ready." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba primero las teclas o continúa cuando quieras."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まずキーを押してみるか、準備ができたら次へ進んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
