    "Restores built-in profiles and the base system prompt, and removes app rules. Profiles you created will be deleted." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura los perfiles integrados y el prompt de sistema base, y elimina las reglas de apps. Se eliminarán los perfiles que creaste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内蔵のプロファイルと基本システムプロンプトを元に戻し、アプリのルールを削除します。作成したプロファイルは削除されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复内置模式和基础系统提示词，并移除 App 规则。你创建的模式将被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還原內建模式與基本系統提示詞，並移除 App 規則。你建立的模式將被刪除。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memulihkan profil bawaan dan prompt sistem dasar, serta menghapus aturan app. Profil yang Anda buat akan dihapus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстанавливает встроенные профили и базовый системный промпт и удаляет правила приложений. Созданные вами профили будут удалены."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura os perfis integrados e o prompt de sistema base e remove as regras de apps. Os perfis que você criou serão apagados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaure les profils intégrés et le prompt système de base, et supprime les règles d’app. Les profils que vous avez créés seront supprimés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिल्ट-इन प्रोफ़ाइल और आधार सिस्टम प्रॉम्प्ट फिर से लाता है, और ऐप नियम हटाता है। आपकी बनाई प्रोफ़ाइल डिलीट हो जाएँगी।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستعيد الأنماط المضمّنة وموجّه النظام الأساسي، ويزيل قواعد التطبيقات. ستُحذف الأنماط التي أنشأتها."
          }
        }
      }
    },
