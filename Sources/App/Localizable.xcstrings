    "This is a real dictation with your chosen model. It also appears in History." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es un dictado real con el modelo que elegiste. También aparece en el Historial."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したモデルによる実際の音声入力です。「履歴」にも表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是使用你所选模型的真实听写，也会出现在“历史记录”中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是使用你所選模型的真實聽寫，也會出現在「記錄」中。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini dikte sungguhan dengan model pilihan Anda. Dikte ini juga muncul di Riwayat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это настоящая диктовка с выбранной моделью. Она также появится в «Истории»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É um ditado real com o modelo escolhido e também aparece no Histórico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’agit d’une vraie dictée avec le modèle choisi. Elle apparaît aussi dans Historique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आपके चुने मॉडल के साथ असली डिक्टेशन है। यह इतिहास में भी दिखता है।"
