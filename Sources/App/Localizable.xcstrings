    "Light on memory and recognizes many languages. Its first start can take a minute." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa poca memoria y reconoce muchos idiomas. El primer inicio puede tardar un minuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリ使用量が少なく、多くの言語を認識します。初回の起動には 1 分ほどかかることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "占用内存少，可识别多种语言。首次启动可能需要一分钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很省記憶體，可辨識多種語言。第一次啟動可能要一分鐘左右。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemat memori dan mengenali banyak bahasa. Saat pertama dijalankan, model ini bisa butuh satu menit."
