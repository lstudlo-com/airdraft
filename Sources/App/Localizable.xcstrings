    "Self-built editions update from source. Official downloads use a separate paid license." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ediciones compiladas por ti se actualizan desde el código fuente. Las descargas oficiales usan una licencia de pago aparte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分でビルドした版はソースコードから更新します。公式ダウンロード版は別途有料のライセンスを使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自行构建版从源代码更新。官方下载版使用单独付费的许可证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自行建置版從原始碼更新。官方下載版使用另外付費的授權。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edisi rakitan sendiri diperbarui dari kode sumber. Unduhan resmi memakai lisensi berbayar terpisah."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Самостоятельные сборки обновляются из исходного кода. Официальные сборки используют отдельную платную лицензию."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edições compiladas por você são atualizadas a partir do código-fonte. Os downloads oficiais usam uma licença paga separada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éditions compilées localement se mettent à jour depuis les sources. Les téléchargements officiels utilisent une licence payante distincte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ख़ुद बनाए संस्करण सोर्स से अपडेट होते हैं। आधिकारिक डाउनलोड के लिए अलग सशुल्क लाइसेंस है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتحدّث الإصدارات المبنية ذاتيًا من المصدر. تستخدم التنزيلات الرسمية ترخيصًا مدفوعًا منفصلًا."
          }
        }
      }
    },
    "Sends window title, nearby text and selection to AI. Skips password fields and managers." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía a la IA el título de la ventana, el texto cercano y la selección. Omite los campos de contraseña y los gestores de contraseñas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウのタイトル、周辺のテキスト、選択範囲を AI に送信します。パスワード欄とパスワード管理アプリは除外されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会将窗口标题、附近的文本和所选内容发送给 AI。会跳过密码字段和密码管理器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "會將視窗標題、鄰近文字與選取內容傳送給 AI。會略過密碼欄位與密碼管理工具。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengirim judul jendela, teks di sekitar, dan pilihan ke AI. Melewati bidang kata sandi dan pengelola kata sandi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет ИИ заголовок окна, текст рядом и выделение. Пропускает поля паролей и менеджеры паролей."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia o título da janela, o texto próximo e a seleção para a IA. Ignora campos de senha e gerenciadores de senhas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie à l’IA le titre de la fenêtre, le texte proche et la sélection. Ignore les champs de mot de passe et les gestionnaires de mots de passe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विंडो शीर्षक, आस-पास का टेक्स्ट और चयन AI को भेजता है। पासवर्ड फ़ील्ड और पासवर्ड मैनेजर छोड़ देता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل عنوان النافذة والنص المجاور والتحديد إلى الذكاء الاصطناعي. يتخطى حقول كلمات السر وتطبيقات إدارتها."
          }
        }
      }
    },
