    "Allow access to read your saved license. A locked license never restarts your trial." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso para leer tu licencia guardada. Una licencia bloqueada nunca reinicia tu prueba."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されたライセンスを読み取るため、アクセスを許可してください。ライセンスがロックされていても、試用期間がやり直しになることはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请允许访问以读取已保存的许可证。许可证被锁定时绝不会重新开始试用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請允許存取以讀取已儲存的授權。授權被鎖定時，絕不會重新開始試用期。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan akses untuk membaca lisensi tersimpan Anda. Lisensi yang terkunci tidak pernah memulai ulang uji coba Anda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к сохранённой лицензии. Заблокированная лицензия никогда не перезапускает пробный период."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o acesso para ler sua licença salva. Uma licença bloqueada nunca reinicia seu teste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès à votre licence enregistrée. Une licence verrouillée ne relance jamais votre essai."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना सहेजा गया लाइसेंस पढ़ने का ऐक्सेस दें। लॉक लाइसेंस से आपका ट्रायल कभी दोबारा शुरू नहीं होता।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول لقراءة ترخيصك المحفوظ. الترخيص المقفل لا يعيد بدء فترتك التجريبية أبدًا."
          }
        }
      }
    },
