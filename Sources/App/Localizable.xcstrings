    "Hold %@ and speak. Each dictation adds a bar." : {
      "comment" : "%@ is the shortcut, drawn as key caps",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado %@ y habla. Cada dictado añade una barra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を押したまま話します。音声入力するたびにバーが 1 本増えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 %@ 并说话。每次听写都会增加一个柱条。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 %@ 並說話。每次聽寫都會增加一條長條。"
          }
        }
      }
    },
    "Hold %@ and speak. Let go to insert." : {
