    "The smaller model comes first because this Mac has 8 GB of memory or less." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo más pequeño aparece primero porque este Mac tiene 8 GB de memoria o menos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac のメモリは 8 GB 以下なので、小さいモデルを先に表示しています。"
          }
