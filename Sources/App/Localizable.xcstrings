    "Open History, Settings or switch microphones from the icon at the top of your screen." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Historial, Ajustes o cambia de micrófono desde el icono en la parte superior de la pantalla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面上部のアイコンから「履歴」や「設定」を開いたり、マイクを切り替えたりできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从屏幕顶部的图标打开“历史记录”“设置”或切换麦克风。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從螢幕頂端的圖像打開「記錄」、「設定」或切換麥克風。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka Riwayat, Pengaturan, atau ganti mikrofon dari ikon di bagian atas layar Anda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывайте «Историю», «Настройки» или меняйте микрофон через значок вверху экрана."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra Histórico, Ajustes ou troque de microfone pelo ícone no topo da tela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Historique, Réglages ou changez de micro depuis l’icône en haut de votre écran."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी स्क्रीन के ऊपर वाले आइकन से इतिहास, सेटिंग्ज़ खोलें या माइक्रोफ़ोन बदलें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح السجل أو الإعدادات أو بدّل الميكروفون من الأيقونة أعلى شاشتك."
          }
        }
      }
    },
