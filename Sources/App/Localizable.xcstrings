    "Nice. Continue when you’re ready, or keep practicing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien. Continúa cuando quieras o sigue practicando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いいですね。準備ができたら次へ進むか、練習を続けてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很好！准备好了就继续，或者再练习一下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很好！準備好就繼續，或繼續練習。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagus. Lanjutkan saat Anda siap, atau terus berlatih."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отлично. Продолжайте, когда будете готовы, или потренируйтесь ещё."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ótimo. Continue quando estiver pronto ou continue praticando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien. Continuez quand vous êtes prêt, ou poursuivez l’entraînement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
