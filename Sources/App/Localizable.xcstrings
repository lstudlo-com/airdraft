    "Provider benchmarks: speed = audio ÷ processing time; accuracy = 1 − WER. Your results may vary." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pruebas del proveedor: velocidad = audio ÷ tiempo de procesamiento; precisión = 1 − WER. Tus resultados pueden variar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダのベンチマーク：速度 = 音声の長さ ÷ 処理時間、精度 = 1 − WER。実際の結果は異なる場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供商基准测试：速度 = 音频时长 ÷ 处理时间；准确率 = 1 − WER。实际结果可能不同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供應商基準測試：速度 = 音訊長度 ÷ 處理時間；準確度 = 1 − WER。實際結果可能不同。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tolok ukur penyedia: kecepatan = audio ÷ waktu pemrosesan; akurasi = 1 − WER. Hasil Anda dapat berbeda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тесты провайдера: скорость = длительность аудио ÷ время обработки; точность = 1 − WER. Ваши результаты могут отличаться."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benchmarks do provedor: velocidade = áudio ÷ tempo de processamento; precisão = 1 − WER. Seus resultados podem variar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesures du fournisseur : vitesse = audio ÷ temps de traitement ; précision = 1 − WER. Vos résultats peuvent varier."
          }
        },
