    "Local playback and retry. Off deletes audio, keeps text." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducción local y reintento. Desactivado elimina el audio y conserva el texto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルでの再生と再試行用。オフにすると音声は削除され、テキストは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于本地播放和重试；关闭只删除音频"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供本機播放與重試；關閉只刪除音訊"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemutaran lokal dan coba lagi. Nonaktif menghapus audio, teks tetap disimpan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Локальное воспроизведение и повтор. «Выкл.» удаляет аудио, текст остаётся."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprodução local e nova tentativa. Desativar apaga o áudio e mantém o texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture locale et nouvelle tentative. Désactivé : l’audio est supprimé, le texte conservé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लोकल प्लेबैक और फिर से कोशिश। बंद करने पर ऑडियो डिलीट होता है, टेक्स्ट रहता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للتشغيل المحلي وإعادة المحاولة. الإيقاف يحذف الصوت ويُبقي النص."
          }
        }
      }
    },
