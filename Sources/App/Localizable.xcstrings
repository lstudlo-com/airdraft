    },
    "Trying again before removing it may use another device slot." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volver a intentarlo antes de eliminarlo puede usar otra plaza de dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除する前にもう一度試すと、別のデバイス枠が使われる場合があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除前再次尝试，可能会再占用一个设备名额。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除前再次嘗試，可能會再占用一個裝置名額。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
