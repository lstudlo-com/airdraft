{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Airdraft uses the microphone for dictation and audio recordings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Airdraft usa el micrófono para el dictado y las grabaciones de audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Airdraft は音声入力と音声の録音にマイクを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Airdraft 使用麦克风进行听写和录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Airdraft 會使用麥克風進行聽寫與錄音。"
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription": {
      "comment": "Privacy - Audio Capture Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Airdraft records audio from the app you choose for transcription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Airdraft graba el audio de la app que elijas para transcribirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Airdraft は、選択した App の音声を文字起こしのために録音します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Airdraft 会录制你选择的 App 的音频，用于转录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Airdraft 會錄下您選擇的 App 音訊，用於轉錄。"
          }
        }
      }
    }
  }
}
