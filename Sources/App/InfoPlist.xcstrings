{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Airdraft uses the microphone for dictation and meeting recordings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Airdraft 使用麦克风进行听写和会议录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Airdraft 會使用麥克風進行聽寫與會議錄音。"
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription": {
      "comment": "Privacy - Audio Capture Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Airdraft records audio from the meeting app you choose for transcription."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Airdraft 会录制你选择的会议 App 的音频，用于转录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Airdraft 會錄下您選擇的會議 App 音訊，用於轉錄。"
          }
        }
      }
    }
  }
}
