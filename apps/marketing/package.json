{
  "name": "@airdraft/marketing",
  "description": "AirDraft's Astro marketing site, served by Cloudflare Workers.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "check": "astro check && prettier --check .",
    "format": "prettier --write .",
    "preview": "wrangler dev --ip 127.0.0.1",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:check": "pnpm run build && wrangler deploy --dry-run",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.3.3",
    "gsap": "3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.13.5",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.0.1",
    "typescript": "5.9.3",
    "wrangler": "4.135.0"
  }
}
