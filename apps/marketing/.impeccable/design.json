  "components": [
    {
      "name": "Brand mark",
      "kind": "nav",
      "refersTo": "brand",
      "description": "The app sidebar's SidebarBrandMark without lettering: a capsule whose face is the chrome, lifted by soft outer shadows, with carved waveform grooves and a caret.",
      "html": "<a class=\"ds-brand\" href=\"#\" aria-label=\"Airdraft home\"><span class=\"ds-mark\" role=\"img\" aria-label=\"Airdraft\"><i style=\"height:6.4px\"></i><i style=\"height:11.7px\"></i><i style=\"height:17.7px\"></i><i style=\"height:12.8px\"></i><i style=\"height:8.5px\"></i><i style=\"height:19.4px\"></i></span></a>",
      "css": ".ds-brand{display:inline-flex;align-items:center;min-height:44px;background:#f2f2f2;padding:8px}.ds-brand:focus-visible{outline:2px solid #222;outline-offset:3px}.ds-mark{display:inline-flex;align-items:center;justify-content:center;gap:2.8px;width:69.5px;height:34px;border-radius:999px;box-shadow:1.7px 2.67px 6.3px rgb(0 0 0 / .2),-1.46px -1.94px 6.3px rgb(255 255 255 / .95)}.ds-mark i{width:3.55px;border-radius:999px;background:#ccc;box-shadow:inset .73px .97px 1.94px rgb(0 0 0 / .35),inset -.61px -.73px 1.46px rgb(255 255 255 / .9)}.ds-mark i:last-child{margin-left:1.87px}"
