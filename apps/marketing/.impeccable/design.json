      "html": "<div class=\"ds-hud\"><span class=\"ds-hud-well\"><i style=\"height:6px\"></i><i style=\"height:12px\"></i><i style=\"height:18px\"></i><i style=\"height:10px\"></i><i style=\"height:20px\"></i><i style=\"height:14px\"></i><i style=\"height:8px\"></i><i style=\"height:16px\"></i><i style=\"height:11px\"></i><i style=\"height:5px\"></i></span><span>0:03.5</span></div>",
      "css": ".ds-hud{display:inline-flex;align-items:center;gap:10px;padding:6px 14px 6px 6px;border-radius:20px;color:rgb(255 255 255 / .95);background:linear-gradient(135deg,#2b2b2b,#1a1a1a);box-shadow:inset 1px 1px 0 rgb(255 255 255 / .2),2px 3px 8px rgb(0 0 0 / .3);font:500 .9375rem/1 ui-rounded,-apple-system,sans-serif;font-variant-numeric:tabular-nums}.ds-hud-well{display:flex;align-items:center;gap:2.5px;height:28px;padding:0 8px;border-radius:999px;background:#141414;box-shadow:inset 1px 1.5px 3px rgb(0 0 0 / .65),inset -1px -1px 3px rgb(255 255 255 / .1)}.ds-hud-well i{width:3px;border-radius:2px;background:rgb(255 255 255 / .92)}"
