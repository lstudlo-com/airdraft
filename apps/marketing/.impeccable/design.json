      "css": ".ds-brand{display:inline-flex;align-items:center;color:#263146;text-decoration:none;transition:color .2s}.ds-brand:hover{color:#3b4bd0}.ds-wordmark{display:block;height:27px;width:auto}.ds-brand:focus-visible{outline:2px solid #3b4bd0;outline-offset:3px;border-radius:6px}"
    },
    {
      "name": "Primary key",
      "kind": "button",
      "refersTo": "key-primary",
      "description": "The one filled action per screen; leads to the source repository.",
      "html": "<a class=\"ds-key-primary\" href=\"#\">View source on GitHub <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" style=\"rotate:-45deg\"><path d=\"M5 12h14m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a>",
      "css": ".ds-key-primary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 20px;border:0;border-radius:12px;font-family:\"Manrope Variable\",sans-serif;font-size:.9375rem;font-weight:700;letter-spacing:-.01em;text-decoration:none;cursor:pointer;transition:box-shadow 180ms cubic-bezier(.16,1,.3,1),transform 180ms cubic-bezier(.16,1,.3,1);min-height:52px;padding:0 24px;color:#fff;background:linear-gradient(180deg,#5462ef,#4150da);box-shadow:inset 0 1px 0 rgb(255 255 255/.28),inset 0 -1px 0 rgb(24 32 120/.3),0 1px 1px rgb(40 52 150/.35),0 10px 22px -8px rgb(70 84 225/.6)}.ds-key-primary:hover{background:linear-gradient(180deg,#5d6bf5,#4655e0)}.ds-key-primary:active{transform:translateY(1px);box-shadow:inset 0 2px 5px rgb(20 28 110/.45)}.ds-key-primary:focus-visible{outline:2px solid #3b4bd0;outline-offset:3px}"
    },
    {
      "name": "Silver key",
      "kind": "button",
      "refersTo": "key",
      "description": "Secondary actions, Run sample, and the header's GitHub icon key.",
      "html": "<a class=\"ds-key\" href=\"#\">Build instructions <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" style=\"rotate:-45deg\"><path d=\"M5 12h14m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a>",
      "css": ".ds-key{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:0 20px;border:0;border-radius:12px;font-family:\"Manrope Variable\",sans-serif;font-size:.9375rem;font-weight:700;letter-spacing:-.01em;text-decoration:none;cursor:pointer;transition:box-shadow 180ms cubic-bezier(.16,1,.3,1),transform 180ms cubic-bezier(.16,1,.3,1);color:#263146;background:linear-gradient(180deg,#f5f7fa,#e2e7ee);box-shadow:inset 0 1px 0 rgb(255 255 255), 0 1px 1px rgb(112 126 156 / 0.3), 0 5px 12px -4px rgb(112 126 156 / 0.5), -4px -4px 10px -6px rgb(255 255 255)}.ds-key:hover{color:#3b4bd0;background:linear-gradient(180deg,#f9fafc,#e6eaf0)}.ds-key:active{transform:translateY(1px);box-shadow:inset 0 2px 4px rgb(112 126 156 / 0.38), inset 0 -1px 0 rgb(255 255 255 / 0.8)}.ds-key:focus-visible{outline:2px solid #3b4bd0;outline-offset:3px}"
    },
    {
      "name": "Raised panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "The icon body: sample, pipeline stages and requirements.",
      "html": "<article class=\"ds-panel\"><h3>Speech to text</h3><p>On this Mac</p></article>",
      "css": ".ds-panel{font-family:\"Manrope Variable\",sans-serif;width:280px;padding:28px;border-radius:20px;color:#263146;background:linear-gradient(165deg,#f1f4f9 0%,#e8ecf2 55%,#dce1e9 100%);box-shadow:inset 0 1px 0 rgb(255 255 255 / 0.9), 0 1px 2px rgb(112 126 156 / 0.18), 0 14px 28px -14px rgb(112 126 156 / 0.45), 0 36px 72px -36px rgb(112 126 156 / 0.5), -12px -12px 28px -18px rgb(255 255 255)}.ds-panel h3{margin:0;font-size:1.375rem;font-weight:650;letter-spacing:-.02em}.ds-panel p{margin:18px 0 0;font-size:.8125rem;font-weight:650;color:#505c73}"
    },
    {
      "name": "Well",
      "kind": "card",
      "refersTo": "well",
      "description": "The icon's pressed track: spoken text, privacy, questions, support.",
      "html": "<div class=\"ds-well\"><span>What you said</span><p>“Um, let Maya know I’ll send the draft tomorrow morning.”</p></div>",
      "css": ".ds-well{font-family:\"Manrope Variable\",sans-serif;width:320px;padding:22px;border-radius:14px;color:#263146;background:linear-gradient(180deg,#d9dee7,#e3e7ee);box-shadow:inset 0 2px 3px rgb(112 126 156 / 0.3), inset 0 12px 20px -14px rgb(112 126 156 / 0.45), inset 0 -1px 0 rgb(255 255 255 / 0.9)}.ds-well span{font-size:.8125rem;font-weight:650;color:#505c73}.ds-well p{margin:10px 0 0;font-size:1.0625rem;font-weight:500;line-height:1.7}"
    },
    {
      "name": "Provider chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Recessed, non-interactive provider and requirement names.",
      "html": "<span class=\"ds-chip\">Qwen3-ASR</span> <span class=\"ds-chip\">Whisper Large v3 Turbo</span>",
      "css": ".ds-chip{font-family:\"Manrope Variable\",sans-serif;display:inline-block;padding:6px 10px;border-radius:8px;background:linear-gradient(180deg,#d9dee7,#e3e7ee);box-shadow:inset 0 1px 2px rgb(112 126 156 / 0.34), inset 0 -1px 0 rgb(255 255 255 / 0.85);font-size:.8125rem;font-weight:600;color:#263146}"
    },
    {
      "name": "Profile picker",
      "kind": "custom",
      "refersTo": "profile-selected",
      "description": "Recessed track with a raised selected profile.",
      "html": "<div class=\"ds-picker\" role=\"group\"><button aria-pressed=\"true\">Clean</button><button aria-pressed=\"false\">Concise</button><button aria-pressed=\"false\">Summary</button></div>",
      "css": ".ds-picker{display:inline-flex;gap:2px;padding:4px;border-radius:12px;background:linear-gradient(180deg,#d9dee7,#e3e7ee);box-shadow:inset 0 1px 2px rgb(112 126 156 / 0.34), inset 0 -1px 0 rgb(255 255 255 / 0.85)}.ds-picker button{font-family:\"Manrope Variable\",sans-serif;min-height:34px;padding:0 14px;border:0;border-radius:8px;background:transparent;color:#505c73;font-size:.8125rem;font-weight:650;cursor:pointer}.ds-picker button:hover{color:#263146}.ds-picker button[aria-pressed=true]{color:#3b4bd0;background:linear-gradient(180deg,#f5f7fa,#e2e7ee);box-shadow:inset 0 1px 0 #fff,0 1px 2px rgb(112 126 156/.35),0 3px 6px -2px rgb(112 126 156/.4)}.ds-picker button:focus-visible{outline:2px solid #3b4bd0;outline-offset:3px}"
    },
    {
      "name": "Recording HUD",
      "kind": "custom",
      "refersTo": "hud",
      "description": "Copy of the app's IndicatorPanel: waveform, then timer, Decoding or Refining.",
      "html": "<div class=\"ds-hud\"><span class=\"ds-hud-bars\"><i style=\"transform:scaleY(0.3)\"></i><i style=\"transform:scaleY(0.6)\"></i><i style=\"transform:scaleY(0.9)\"></i><i style=\"transform:scaleY(0.5)\"></i><i style=\"transform:scaleY(1)\"></i><i style=\"transform:scaleY(0.7)\"></i><i style=\"transform:scaleY(0.4)\"></i><i style=\"transform:scaleY(0.8)\"></i><i style=\"transform:scaleY(0.55)\"></i><i style=\"transform:scaleY(0.3)\"></i></span><span>0:03.5</span></div>",
      "css": ".ds-hud{font-family:\"Manrope Variable\",sans-serif;display:inline-flex;align-items:center;gap:12px;height:40px;padding:0 16px 0 14px;border-radius:999px;color:#fff;background:linear-gradient(180deg,#2b303a,#1f232b);box-shadow:inset 0 1px 0 rgb(255 255 255/.1),0 8px 18px -8px rgb(20 24 34/.55);font-size:.8125rem;font-weight:650;font-variant-numeric:tabular-nums}.ds-hud-bars{display:flex;align-items:center;gap:3px;height:22px}.ds-hud-bars i{display:block;width:3px;height:22px;border-radius:2px;background:#fff}"
    },
    {
      "name": "Keycap",
      "kind": "custom",
      "description": "Shortcut glyphs in the system face.",
      "html": "<span class=\"ds-keys\"><kbd>⌃</kbd><kbd>⌥</kbd></span>",
      "css": ".ds-keys{display:inline-flex;gap:4px}.ds-keys kbd{display:inline-grid;place-items:center;min-width:26px;height:24px;padding:0 6px;border-radius:6px;background:linear-gradient(180deg,#f5f7fa,#e2e7ee);box-shadow:inset 0 1px 0 #fff,0 1px 1px rgb(112 126 156/.4),0 2px 4px -1px rgb(112 126 156/.45);color:#263146;font:500 .9375rem/1 -apple-system,BlinkMacSystemFont,sans-serif}"
    },
    {
      "name": "Disabled key",
      "kind": "button",
      "refersTo": "key",
      "description": "An action that isn't available yet: pressed in, muted, not focusable.",
      "html": "<span class=\"ds-key-disabled\" aria-disabled=\"true\">Not set up yet</span>",
      "css": ".ds-key-disabled{font-family:\"Manrope Variable\",sans-serif;display:inline-flex;align-items:center;min-height:48px;padding:0 20px;border-radius:12px;background:linear-gradient(180deg,#d9dee7,#e3e7ee);box-shadow:inset 0 1px 2px rgb(112 126 156/.34),inset 0 -1px 0 rgb(255 255 255/.85);color:#505c73;font-size:.9375rem;font-weight:700;cursor:not-allowed}"
    },
    {
      "name": "Tag",
      "kind": "chip",
      "description": "Small recessed label, such as Sample.",
      "html": "<span class=\"ds-tag\">Sample</span>",
      "css": ".ds-tag{font-family:\"Manrope Variable\",sans-serif;display:inline-block;padding:3px 8px;border-radius:8px;background:linear-gradient(180deg,#d9dee7,#e3e7ee);box-shadow:inset 0 1px 2px rgb(112 126 156/.34),inset 0 -1px 0 rgb(255 255 255/.85);color:#505c73;font-size:.8125rem;font-weight:600}"
    },
    {
      "name": "Disclosure",
      "kind": "custom",
      "description": "Question rows in a well, divided by grooves.",
      "html": "<div class=\"ds-q\"><details open><summary>Is the open-source build limited?</summary><p>No. There are no locked features.</p></details><details><summary>Do I need an API key?</summary><p>Only for cloud providers.</p></details></div>",
      "css": ".ds-q{font-family:\"Manrope Variable\",sans-serif;width:420px;padding:4px 24px;border-radius:14px;background:linear-gradient(180deg,#d9dee7,#e3e7ee);box-shadow:inset 0 2px 3px rgb(112 126 156/.3),inset 0 -1px 0 rgb(255 255 255/.9);color:#263146}.ds-q details+details{box-shadow:inset 0 1px 0 rgb(112 126 156/.26),inset 0 2px 0 rgb(255 255 255/.9)}.ds-q summary{padding:16px 0;font-size:1.0625rem;font-weight:650;cursor:pointer;list-style:none}.ds-q summary:hover{color:#3b4bd0}.ds-q p{margin:0 0 16px;font-size:.9375rem;line-height:1.7;color:#505c73}"
    }
  ],
  "narrative": {
    "northStar": "The icon, built out into a page",
    "overview": "Every surface on the site comes from the app icon rendered by\n`scripts/render-app-icon.swift`: a silver body lit from the upper left, a raised\npill with a pressed track inside it, a waveform warming from gray to violet, and\na glowing caret where text lands. The page reuses those objects literally. Panels\nare the body, wells are the track, keys are the pill, and the violet-to-cyan\ngradient appears only where the icon uses it: the caret and waveform.\n\nDepth carries meaning. What you said sits in a well; what Airdraft inserts is\npressed in while it waits and lifts out once it is typed. The one filled blue key\non each screen is the one action that matters. The HUD in the sample is a copy of\nthe app's own recording indicator, not an illustration.\n\nThis covers `apps/marketing`. Tokens live in `src/styles/global.css`; the sidecar\n`.impeccable/design.json` carries shadows, motion, breakpoints and component\npreviews.",
    "keyCharacteristics": [
      "One light source, upper left, on every raised and recessed surface.",
      "Layered shadows: a top-edge highlight, a contact shadow, a key shadow and an ambient shadow. Never the symmetric twin-shadow recipe.",
      "Curved fills: raised surfaces are lighter at the top, wells darker at the top.",
      "A single filled blue key for the primary action; everything else is silver.",
      "Engraved grooves, never flat hairlines, to divide content."
    ],
    "rules": [
      {
        "name": "The one-light rule",
        "body": "Every raised and recessed surface is lit from the upper left, as in the icon.",
        "section": "elevation"
      },
      {
        "name": "The one-key rule",
        "body": "Exactly one filled blue key in view; everything else is silver.",
        "section": "colors"
      },
      {
        "name": "The 13px floor",
        "body": "Seven type steps; nothing below 0.8125rem.",
        "section": "typography"
      },
      {
        "name": "The groove rule",
        "body": "Divide with an engraved groove or with space, never a flat hairline.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do take new colors, light and shapes from the icon renderer.",
      "Do keep exactly one filled blue key in view at a time.",
      "Do use the seven type steps and the `0.8125rem` floor.",
      "Do keep sample, pricing, license and download claims factual. Hide anything unconfirmed."
    ],
    "donts": [
      "Don't use the symmetric `9px 9px 24px` twin-shadow recipe, or a 1px border under a soft shadow.",
      "Don't color non-interactive text blue.",
      "Don't divide content with flat hairlines; use the groove or space.",
      "Don't repeat a two-tone headline pattern or add eyebrow labels above headings.",
      "Don't publish app renders that contain personal profiles, device names or usage counts.",
      "Don't add copy that restates a heading, narrates the page, or labels the obvious. If a line doesn't change a decision, cut it.",
      "Don't hand-roll a key or section; extend the component instead.",
      "Don't put more than one line of text in a bento tile, or a graphic that isn't built from the system's parts.",
      "Don't animate anything that has no resting state in CSS, or ignore reduced motion."
    ]
  }
}
