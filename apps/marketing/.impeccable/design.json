      "css": ".ds-chip{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;font-family:-apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"Inter Variable\",sans-serif;font-size:.8125rem;font-weight:500;color:#5c5c5c;background:#e3e3e3;box-shadow:inset 1px 1.5px 3px rgb(0 0 0 / .22),inset -1px -1.5px 3px #fff}.ds-chip i{width:8px;height:8px;border-radius:50%;background:#ff9500}"
