    {
      "name": "Primary key",
      "kind": "button",
      "refersTo": "key-primary",
      "description": "The one primary action per screen: graphite, like the recording pill (light key in dark mode).",
      "html": "<a class=\"ds-key-primary\" href=\"#\">Get Airdraft <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a>",
      "css": ".ds-key-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 24px;border-radius:999px;font-family:-apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"Inter Variable\",sans-serif;font-size:.9375rem;font-weight:600;text-decoration:none;color:rgb(255 255 255 / .95);background:linear-gradient(135deg,#2b2b2b,#1a1a1a);box-shadow:inset 1px 1px 0 rgb(255 255 255 / .2),2.5px 3px 8px rgb(0 0 0 / .27),-2px -2.5px 8px #fff}.ds-key-primary:hover{background:linear-gradient(135deg,#363636,#222)}.ds-key-primary:active{background:#1a1a1a;box-shadow:inset 2px 3px 6px rgb(0 0 0 / .55)}.ds-key-primary:focus-visible{outline:2px solid #222;outline-offset:3px}"
    },
    {
      "name": "Key",
      "kind": "button",
      "refersTo": "key",
      "description": "SoftButtonStyle: a raised gray capsule that sinks into a well while pressed.",
      "html": "<a class=\"ds-key\" href=\"#\">Build instructions <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" style=\"rotate:-45deg\"><path d=\"M5 12h14m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a>",
      "css": ".ds-key{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 20px;border-radius:999px;font-family:-apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"Inter Variable\",sans-serif;font-size:.9375rem;font-weight:500;text-decoration:none;color:#222;background:linear-gradient(135deg,#ededed,#e3e3e3);box-shadow:inset 1px 1px 0 rgb(255 255 255 / .27),inset 0 0 0 .5px rgb(0 0 0 / .035),2.5px 3px 8px rgb(0 0 0 / .27),-2px -2.5px 8px #fff}.ds-key:hover{background:linear-gradient(135deg,#f2f2f2,#e3e3e3)}.ds-key:active{background:#dedede;box-shadow:inset 3px 4px 8px rgb(0 0 0 / .27),inset -2.5px -3px 8px #fff}.ds-key:focus-visible{outline:2px solid #222;outline-offset:3px}"
    },
    {
      "name": "Raised panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "SoftRaisedSurface at card elevation: tiles, plans, lists and tables.",
      "html": "<div class=\"ds-panel\">Panel</div>",
      "css": ".ds-panel{padding:28px;border-radius:18px;font-family:-apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"Inter Variable\",sans-serif;color:#222;background:linear-gradient(135deg,#e8e8e8,#e3e3e3);box-shadow:inset 1px 1px 0 rgb(255 255 255 / .27),inset 0 0 0 .5px rgb(0 0 0 / .035),4px 5px 14px rgb(0 0 0 / .27),-3.5px -4px 14px #fff}"
    },
    {
      "name": "Well",
      "kind": "card",
      "refersTo": "well",
      "description": "A recessed surface: art wells, the waiting result, unavailable plans.",
      "html": "<div class=\"ds-well\">Well</div>",
      "css": ".ds-well{padding:28px;border-radius:12px;font-family:-apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"Inter Variable\",sans-serif;color:#222;background:#e3e3e3;box-shadow:inset 2px 2.5px 5px rgb(0 0 0 / .22),inset -2px -2.5px 5px #fff}"
    },
    {
      "name": "Waveform",
      "kind": "custom",
      "refersTo": "waveform",
      "description": "Home's waveform: raised gray bars in a pressed capsule well, ending in the graphite caret.",
      "html": "<div class=\"ds-wave\"><i style=\"height:20px\"></i><i style=\"height:30px\"></i><i style=\"height:44px\"></i><i style=\"height:28px\"></i><i style=\"height:36px\"></i><i style=\"height:48px\"></i><i style=\"height:32px\"></i><i style=\"height:24px\"></i><i style=\"height:40px\"></i><i style=\"height:26px\"></i><b></b></div>",
      "css": ".ds-wave{display:flex;align-items:center;justify-content:center;gap:10px;height:104px;padding:0 40px;border-radius:999px;background:#d9d9d9;box-shadow:inset 4px 5px 12px rgb(0 0 0 / .32),inset -4px -5px 12px #fff}.ds-wave i{width:7px;border-radius:999px;background:linear-gradient(135deg,#c9c9c9,#8a8a8a);box-shadow:1.5px 2.5px 5px rgb(0 0 0 / .32),-1px -1.5px 4px #fff}.ds-wave b{width:8px;height:60px;margin-left:6px;border-radius:4px;background:linear-gradient(135deg,#858585,#4d4d4d);box-shadow:1.5px 2.5px 5px rgb(0 0 0 / .32),-1px -1.5px 4px #fff}"
    },
    {
      "name": "Segmented picker",
      "kind": "custom",
      "refersTo": "segmented",
      "description": "SoftSegmentedPicker: a raised thumb on a recessed capsule track.",
      "html": "<div class=\"ds-seg\"><span class=\"on\">Clean</span><span>Concise</span><span>Summary</span></div>",
      "css": ".ds-seg{display:inline-flex;padding:3px;border-radius:999px;background:#d9d9d9;box-shadow:inset 1.5px 2px 5px rgb(0 0 0 / .3),inset -1.5px -2px 5px rgb(255 255 255 / .9);font-family:-apple-system,BlinkMacSystemFont,\"SF Pro Text\",\"Inter Variable\",sans-serif;font-size:.8125rem}.ds-seg span{display:grid;place-items:center;min-height:32px;padding:0 14px;border-radius:999px;color:#5c5c5c}.ds-seg .on{color:#222;font-weight:600;background:linear-gradient(135deg,#ededed,#e3e3e3);box-shadow:inset 1px 1px 0 rgb(255 255 255 / .27),1.5px 2px 4px rgb(0 0 0 / .27),-1px -1.5px 4px #fff}"
    },
    {
      "name": "Chip",
      "kind": "chip",
