---
import Layout from "./Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import GuideLinks from "../components/GuideLinks.astro";
import GuideToc from "../components/GuideToc.astro";
import Section from "../components/ui/Section.astro";
import type { Guide } from "../data/guides";
import { localeOf, localizedPath } from "../i18n";
import { firstCommitted, lastCommitted } from "../lib/source-dates.mjs";
import { pages } from "../locales";
import "../styles/guides.css";

/**
 * A guide page in any language: breadcrumbs, the title alone (no intro line
 * under it), then the guide's sections (GuideSection: a numbered heading and
 * its content on the island) beside "On this page" (GuideToc), then the
 * other guides.
 */
interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const locale = localeOf(guide.href);
const copy = pages[locale].chrome;
const breadcrumbs = [
  { name: copy.home, path: localizedPath("/", locale) },
  { name: copy.guides, path: localizedPath("/guides/", locale) },
  { name: guide.title, path: guide.href },
];
// The guide's body file dates it (Article data, og:type article).
const source = `src/locales/${locale}/guides/${guide.slug}.astro`;
const article = {
  published: firstCommitted(source),
  modified: lastCommitted([source]),
};
const body = await Astro.slots.render("default");
---

<Layout
  title={guide.metaTitle ?? `${guide.title} | Airdraft`}
  description={guide.description}
  breadcrumbs={breadcrumbs}
  article={article}
>
  <SiteHeader />
  <main id="main" class="island subpage">
    <Section id="guide" level={1} first title={guide.title}>
      <nav class="guide-breadcrumbs" aria-label={copy.breadcrumb}>
        <ol>
          {breadcrumbs.map((item, index) => (
            <li>
              {index === breadcrumbs.length - 1 ? (
                <span aria-current="page">{item.name}</span>
              ) : (
                <a href={item.path}>{item.name}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
      <div class="guide-layout">
        <GuideToc html={body} label={copy.onThisPage} />
        <article class="guide-article" aria-label={guide.title}>
          <Fragment set:html={body} />
        </article>
      </div>
    </Section>
    <Section id="related" title={copy.related}>
      <GuideLinks exclude={guide.slug} locale={locale} />
    </Section>
  </main>
  <SiteFooter />
</Layout>

<script>
  import "../scripts/guide-toc";
</script>
