---
import Layout from "./Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import GuideLinks from "../components/GuideLinks.astro";
import Section from "../components/ui/Section.astro";
import type { Guide } from "../data/guides";
import { localeOf, localizedPath } from "../i18n";
import { pages } from "../locales";
import "../styles/guides.css";

/**
 * A guide page in any language: breadcrumbs, the title alone (no intro line
 * under it), then the guide's sections (GuideSection: a heading on the
 * island over a recessed well), then the other guides.
 */
interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const locale = localeOf(guide.href);
const copy = pages[locale].chrome;
const breadcrumbs = [
  { name: copy.home, path: localizedPath("/", locale) },
  { name: copy.guides, path: localizedPath("/guides/", locale) },
  { name: guide.title, path: guide.href },
];
---

<Layout
  title={`${guide.title} | Airdraft`}
  description={guide.description}
  breadcrumbs={breadcrumbs}
>
  <SiteHeader />
  <main id="main" class="island subpage">
    <Section id="guide" level={1} first title={guide.title}>
      <nav class="guide-breadcrumbs" aria-label={copy.breadcrumb}>
        <ol>
          {breadcrumbs.map((item, index) => (
            <li>
              {index === breadcrumbs.length - 1 ? (
                <span aria-current="page">{item.name}</span>
              ) : (
                <a href={item.path}>{item.name}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
      <article class="guide-article" aria-label={guide.title}>
        <slot />
      </article>
    </Section>
    <Section id="related" title={copy.related}>
      <GuideLinks exclude={guide.slug} locale={locale} />
    </Section>
  </main>
  <SiteFooter />
</Layout>
