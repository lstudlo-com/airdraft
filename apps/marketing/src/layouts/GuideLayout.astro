---
import Layout from "./Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import GuideLinks from "../components/GuideLinks.astro";
import Section from "../components/ui/Section.astro";
import type { Guide } from "../data/guides";
import { localeOf, type GuideLocale } from "../i18n";
import "../styles/guides.css";

interface Props {
  guide: Guide;
  intro: string;
}

const { guide, intro } = Astro.props;
const locale = localeOf(guide.href) as GuideLocale;
// The English guides have a hub; the translated guides hang from the
// translated homepage until there is a translated hub.
const breadcrumbs =
  locale === "zh-tw"
    ? [
        { name: "首頁", path: "/zh-tw/" },
        { name: guide.title, path: guide.href },
      ]
    : [
        { name: "Home", path: "/" },
        { name: "Guides", path: "/guides/" },
        { name: guide.title, path: guide.href },
      ];
const copy = {
  en: { breadcrumb: "Breadcrumb", related: "Related guides" },
  "zh-tw": { breadcrumb: "麵包屑導覽", related: "相關指南" },
}[locale];
---

<Layout
  title={`${guide.title} | Airdraft`}
  description={guide.description}
  breadcrumbs={breadcrumbs}
>
  <SiteHeader />
  <main id="main" class="island subpage">
    <Section id="guide" level={1} first title={guide.title} intro={intro}>
      <nav class="guide-breadcrumbs" aria-label={copy.breadcrumb}>
        <ol>
          {breadcrumbs.map((item, index) => (
            <li>
              {index === breadcrumbs.length - 1 ? (
                <span aria-current="page">{item.name}</span>
              ) : (
                <a href={item.path}>{item.name}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
      <article class="guide-article" aria-label={guide.title}>
        <slot />
      </article>
    </Section>
    <Section id="related" title={copy.related}>
      <GuideLinks exclude={guide.slug} locale={locale} />
      {locale === "zh-tw" && (
        <p class="guide-hub-note">
          設定、本機與雲端資料去向，以及自行編譯或官方版的比較，請看
          <a href="/guides/" hreflang="en">
            英文指南
          </a>
          。
        </p>
      )}
    </Section>
  </main>
  <SiteFooter />
</Layout>
