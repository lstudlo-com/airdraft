---
// SF Pro comes from the system on Apple devices; Inter is only downloaded where
// the system face is missing.
import "@fontsource-variable/inter";
import "../styles/global.css";
import "../styles/motion.css";
import Analytics from "../components/Analytics.astro";
import {
  canonicalURL,
  defaultDescription,
  defaultTitle,
  pageStructuredData,
  serializeStructuredData,
  siteName,
  socialImageAlt,
  type Breadcrumb,
} from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  breadcrumbs?: Breadcrumb[];
}
const {
  title = defaultTitle,
  description = defaultDescription,
  noindex = false,
  breadcrumbs = [],
} = Astro.props;
const canonical =
  Astro.site && !noindex
    ? canonicalURL(Astro.url.pathname, Astro.site)
    : undefined;
const socialImage = Astro.site
  ? new URL("/social-card.png", Astro.site)
  : undefined;
const structuredData = canonical
  ? pageStructuredData({ canonical, title, description, breadcrumbs })
  : undefined;
const googleVerification = import.meta.env.GOOGLE_SITE_VERIFICATION?.trim();
const bingVerification = import.meta.env.BING_SITE_VERIFICATION?.trim();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content="#f2f2f2"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#363636"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="robots"
      content={noindex ? "noindex" : "max-image-preview:large"}
    />
    {canonical && <link rel="canonical" href={canonical} />}
    {googleVerification && (
      <meta name="google-site-verification" content={googleVerification} />
    )}
    {bingVerification && (
      <meta name="msvalidate.01" content={bingVerification} />
    )}
    <link rel="icon" type="image/png" href="/favicon.png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/airdraft-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Airdraft releases"
      href="/changelog.xml"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && (
      <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={socialImageAlt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && <meta name="twitter:image:alt" content={socialImageAlt} />}
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={serializeStructuredData(structuredData)}
      ></script>
    )}
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
      // Between two pages linked in the header, the selection well slides
      // instead of fading (see the view transition in global.css). This must
      // run before the first render, where "pagereveal" fires.
      addEventListener("pagereveal", (event) => {
        if (!event.viewTransition) return;
        const linked = ["/pricing", "/support", "/changelog"];
        const page = (url) => {
          try {
            return new URL(url).pathname.replace(/\/$/, "");
          } catch {
            return "";
          }
        };
        const from = page(
          window.navigation?.activation?.from?.url ?? document.referrer,
        );
        const to = page(location.href);
        if (from !== to && linked.includes(from) && linked.includes(to)) {
          event.viewTransition.types.add("nav-slide");
        }
      });
    </script>
  </head>
  <body>
    <!--
    THESIS: Speech becomes tidy text at the cursor with one held shortcut.
    OWN-WORLD: The app window's own material: neutral gray chrome around a rounded island, raised cards and keys, pressed wells.
    STORY: See it run, choose where each stage runs, learn what leaves the Mac, then get the source.
    FIRST VIEWPORT: A plain promise, the actions, and Home's waveform card from the app.
    FORM: Achromatic neumorphism lit from the top left, in light and dark; one graphite key for the primary action.
    FINISH: No invented release, price, license or measurement. Visible focus, reduced motion, useful without JavaScript.
    -->
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
    <Analytics />
    <script>
      import "../scripts/segmented";
      import "../scripts/island";
    </script>
  </body>
</html>
