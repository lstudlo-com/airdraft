---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import { localizedPath, type Locale } from "../../../i18n";
import { siteLinks } from "../../../data/site";
import {
  ejaAsrMetric,
  ejaAsrResults,
  ejaAsrStudy,
  type EjaAsrResult,
  type EjaError,
  type EjaLanguage,
} from "../../../data/eja-asr";

const locale: Locale = "es";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "offline-dictation-on-mac",
)!;
// English, Japanese and Korean results come from src/data/eja-asr.ts
// (eval/eja-asr in the repository), quoted as Airdraft's own measurement on
// one Mac with its method and limits. The SenseVoice rows come from the
// same-day follow-up of the original model; SenseVoice Cantonese is the
// fine-tune that 0.11.0 and earlier installed.
const study = ejaAsrStudy;
const languages = (
  [
    ["en", "Inglés"],
    ["ja", "Japonés"],
    ["ko", "Coreano"],
  ] as [EjaLanguage, string][]
).map(([code, name]) => ({
  code,
  name,
  label: name.toLowerCase(),
  unit:
    ejaAsrMetric[code] === "WER"
      ? "tasa de error de palabras (WER)"
      : "tasa de error de caracteres (CER)",
}));
const columns = [
  "Modelo",
  "Errores, «Detectar automáticamente»",
  "Errores, idioma fijado",
  "Tiempo mediano",
  "Descarga",
];
// The data's row notes are English; these are their Spanish wording.
const notes: Record<string, string> = {
  "Original multilingual model": "Modelo multilingüe original",
  "0.11.0 and earlier": "0.11.0 y anteriores",
};
const rate = (error: EjaError) =>
  `${error.value.toFixed(1)}% (${error.ci[0].toFixed(1)}–${error.ci[1].toFixed(1)})`;
const about = (ms: number) => `${Math.round(ms / 10) * 10} ms`;
const [parakeet, qwen] = ["Parakeet TDT v2", "Qwen3-ASR 1.7B"].map((model) =>
  ejaAsrResults.en.find((row) => row.model === model)!,
);
const [senseVoice, cantonese] = ["SenseVoice", "SenseVoice Cantonese"].map(
  (model) =>
    (["en", "ja", "ko"] as EjaLanguage[]).map((code) =>
      ejaAsrResults[code].find((row) => row.model === model)!,
    ),
);
const autoRate = (row: EjaAsrResult) => `${row.auto.value.toFixed(1)}%`;
const cells = (row: EjaAsrResult) => [
  rate(row.auto),
  row.explicit ? rate(row.explicit) : "Este modelo no lo usa",
  `${row.medianMs} ms`,
  row.download,
];
const mixedGuide = localizedPath(
  "/guides/mixed-chinese-english-dictation/",
  locale,
);
---

<GuideLayout guide={guide}>
  <GuideSection id="requirements" title="Qué necesitas">
    <ul>
      <li>Un Mac con Apple silicon y macOS 15 o posterior.</li>
      <li>
        Airdraft instalado, con los permisos de Micrófono y Accesibilidad.
      </li>
      <li>Conexión a internet para las primeras descargas de modelos.</li>
    </ul>
    <p>
      Apple SpeechAnalyzer y Apple Intelligence necesitan macOS 26 o posterior.
      Apple Intelligence también tiene que estar disponible en tu Mac. Los demás
      modelos de voz locales no necesitan Apple Intelligence.
    </p>
    <p>
      Empieza por las{" "}
      <a href={siteLinks.build}>instrucciones para compilar desde el código</a>.
      La <a href={localizedPath("/pricing/", locale)}>página de precios</a>{" "}
      indica la disponibilidad actual de la app oficial.
    </p>
  </GuideSection>

  <GuideSection id="setup" title="Configura tu primer dictado local">
    <ol class="guide-steps">
      <li>
        <h3>Permite grabar e insertar texto</h3>
        <p>
          Concede el acceso al micrófono cuando se te pida. Activa Airdraft en
          Ajustes del Sistema → Privacidad y seguridad → Accesibilidad para que
          pueda insertar texto.
        </p>
      </li>
      <li>
        <h3>Descarga y elige un modelo de voz local</h3>
        <p>
          Abre Modelos y elige un modelo local que admita tu idioma. Airdraft
          solo descarga modelos cuando se lo pides. Un modelo instalado se carga
          solo cuando empiezas a dictar.
        </p>
      </li>
      <li>
        <h3>Elige una limpieza local, u omítela</h3>
        <p>
          En Modelos → Refinamiento, elige Apple Intelligence en un sistema
          compatible, o conecta LM Studio u Ollama ejecutándose en este Mac.
          Para pasar de voz a texto sin limpieza con IA, desactiva «Refinar
          transcripción» en tu perfil activo, en Perfiles.
        </p>
      </li>
      <li>
        <h3>Revisa el perfil activo</h3>
        <p>
          Un perfil puede tener su propio modelo de voz. En Perfiles → «Modelo
          de voz», elige un modelo local o «Predeterminado de la app» para
          seguir lo que indique Modelos. Un modelo de voz en la nube asignado al
          perfil seguiría enviando el audio a ese proveedor.
        </p>
      </li>
      <li>
        <h3>Mantén pulsado, habla y suelta</h3>
        <p>
          Pon el cursor en un campo de texto. Mantén pulsado Control + Option,
          habla y suelta. Airdraft transcribe y refina cuando termina la
          grabación y luego inserta el resultado. Puedes cambiar el atajo en
          Ajustes.
        </p>
      </li>
    </ol>
  </GuideSection>

  <GuideSection id="languages" title="¿Qué modelo elijo?">
    <p>
      Los idiomas admitidos dependen del modelo. La configuración inicial
      recomienda uno según el idioma del sistema y la memoria de tu Mac, y para
      inglés, japonés, coreano y chino ofrece una alternativa:
    </p>
    <dl class="guide-decisions">
      <div>
        <dt>Inglés: Parakeet TDT v2</dt>
        <dd>
          Solo reconoce inglés. En la medición de Airdraft sus errores quedaron
          dentro del margen de los de Qwen3-ASR 1.7B, y fue mucho más rápido. La
          configuración ofrece Qwen3-ASR 1.7B como alternativa si también hablas
          otros idiomas; usa unos 3 GB de memoria.
        </dd>
      </div>
      <div>
        <dt>Japonés y coreano: Qwen3-ASR 1.7B</dt>
        <dd>
          Whisper Large v3 Turbo es la alternativa que usa menos memoria y
          aparece primero en un Mac con 8 GB de memoria o menos. Su primer
          arranque puede tardar un minuto.
        </dd>
      </div>
      <div>
        <dt>Chino: Qwen3-ASR 1.7B</dt>
        <dd>
          SenseVoice es la alternativa más pequeña y rápida, y aparece primero
          en un Mac con 8 GB de memoria o menos. Las{" "}
          <a href={mixedGuide}>mediciones de Airdraft con idiomas mezclados</a>{" "}
          muestran las ventajas y desventajas. Elige la escritura de salida en
          Modelos → Opciones de voz → Escritura china.
        </dd>
      </div>
      <div>
        <dt>Otros idiomas: Whisper Large v3 Turbo</dt>
        <dd>
          Parakeet TDT v3 admite inglés y otros 24 idiomas europeos, pero no
          mandarín ni cantonés.
        </dd>
      </div>
    </dl>
    <p>
      La 0.11.0 y anteriores recomendaban SenseVoice para inglés, japonés y
      coreano, y la 0.10.2 también lo sugería en un Mac en chino. Esas versiones
      instalaban como SenseVoice un ajuste fino para cantonés. Si lo tienes,
      sigue funcionando y Modelos lo muestra como SenseVoice Cantonese; una
      descarga nueva de SenseVoice es el modelo multilingüe original, que la
      página Modelos describe como «Pequeño y rápido. Más débil con términos en
      inglés dentro del chino».
    </p>
    <p>
      Los tiempos de carga y de transcripción dependen del modelo y de tu Mac;
      el ejemplo de la página de inicio es una ilustración, no una prueba de
      velocidad.
    </p>
  </GuideSection>

  <GuideSection id="measured" title="Medido en inglés, japonés y coreano">
    {languages.map((language) => (
      <div
        class="guide-table-scroll"
        tabindex="0"
        role="region"
        aria-label={`Resultados de los modelos locales en ${language.label}`}
      >
        <table class="guide-table guide-table-wide" role="table">
          <caption>
            {language.name}, {language.unit}. Medición propia de Airdraft,{" "}
            {study.date}, en un Apple M4 Pro, sin refinamiento. Cuanto más bajo,
            mejor; intervalos del 95 % entre paréntesis.
          </caption>
          <thead role="rowgroup">
            <tr role="row">
              {columns.map((column) => (
                <th scope="col" role="columnheader">
                  {column}
                </th>
              ))}
            </tr>
          </thead>
          <tbody role="rowgroup">
            {ejaAsrResults[language.code].map((row) => (
              <tr role="row">
                <th scope="row" role="rowheader">
                  {row.model}
                  {row.note && (
                    <span class="row-note">{notes[row.note] ?? row.note}</span>
                  )}
                </th>
                {cells(row).map((cell, index) => (
                  <td role="cell">
                    <span class="cell-label" aria-hidden="true">
                      {columns[index + 1]}
                    </span>
                    {cell}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
    <p>
      En inglés se cuentan errores de palabra; en japonés y coreano, errores de
      carácter, sin contar los espacios. En inglés, Parakeet TDT v2 y Qwen3-ASR
      1.7B empatan estadísticamente, y Parakeet tardó unos{" "}
      {about(parakeet.medianMs)} por clip frente a unos {about(qwen.medianMs)}.
      En japonés y coreano, Qwen3-ASR 1.7B y Whisper Large v3 Turbo se solapan
      con «Idioma» en «Detectar automáticamente». Fijar «Idioma» en japonés o
      coreano redujo los errores de Qwen3-ASR 1.7B en 1,7 y 1,8 puntos.
    </p>
    <p>
      SenseVoice Cantonese, que la 0.11.0 y anteriores instalaban como
      SenseVoice, perdió todos los kana en los 60 clips en japonés y la mayor
      parte del texto en 50 de los 60 clips en coreano. El SenseVoice original
      que la app instala ahora tuvo {autoRate(senseVoice[0])} de errores de
      palabra en inglés, {autoRate(senseVoice[1])} de errores de carácter en
      japonés y {autoRate(senseVoice[2])} en coreano, frente a{" "}
      {autoRate(cantonese[0])}, {autoRate(cantonese[1])} y{" "}
      {autoRate(cantonese[2])} del ajuste fino, con «Idioma» en «Detectar
      automáticamente». En japonés y coreano quedó dentro del margen de
      Qwen3-ASR 1.7B; aun así, la configuración sigue recomendando Qwen3-ASR
      1.7B y Whisper Large v3 Turbo para esos idiomas. La{" "}
      <a href={mixedGuide}>guía de chino e inglés mezclados</a> compara los dos
      modelos SenseVoice con habla mezclada.
    </p>
    <p>
      El tiempo mediano es el de transcripción una vez cargado el modelo, medido
      mientras el Mac también compilaba, así que compara los modelos solo entre
      sí. El pico de memoria medido de Qwen3-ASR 1.7B fue de unos 3 GB, y el de
      SenseVoice de unos 0,9 GB. Parakeet TDT v2 y Whisper se ejecutan con Core
      ML y mantienen parte de su memoria fuera del proceso de la app, así que su
      memoria no es comparable. Los tamaños de descarga son los totales que
      indica la página Modelos, no transferencias medidas.
    </p>
    <h3>Límites de esta medición</h3>
    <ul>
      <li>
        Los clips son {study.utterancesPerLanguage} frases de Wikipedia leídas
        por idioma, de Google FLEURS, no dictados: frases más largas, muchos
        nombres y números, pocas vacilaciones. FLEURS no publica identificadores
        de hablante.
      </li>
      <li>
        {study.utterancesPerLanguage} clips por idioma dan intervalos amplios.
        No se normalizan los números ni la escritura en kana o kanji, y algunas
        referencias en coreano contienen glosas entre corchetes que nadie
        pronuncia.
      </li>
      <li>
        Se ejecutó en un solo M4 Pro con 48 GB. No se midieron Macs con 8 GB de
        memoria o menos.
      </li>
      <li>
        Los resultados son la salida de voz sin refinamiento, antes de la
        conversión de escritura china. En la 0.11.0 y anteriores, la escritura
        tradicional predeterminada también convertía los kanji del texto
        japonés, como 国 en 國, lo que añadía unos 2 puntos de errores; ahora el
        texto que contiene kana no se modifica.
      </li>
      <li>
        Compara los modelos de Airdraft entre sí, no Airdraft con otras apps de
        dictado.
      </li>
    </ul>
    <p>
      Método, selección del corpus y scripts:{" "}
      <a href={study.methodURL}>eval/eja-asr en el repositorio del código</a>,
      medido en el commit {study.sourceCommit}. El SenseVoice original se midió
      con los mismos clips el {study.followup.date}, con una compilación basada
      en {study.followup.sourceCommit}, después de que la descarga de la propia
      app comprobara su tamaño y su SHA-256.
    </p>
  </GuideSection>

  <GuideSection id="offline-scope" title="¿Qué abarca «sin conexión»?">
    <p>
      La voz y el refinamiento locales no necesitan ningún modelo en la nube
      para procesar tu dictado. Las primeras descargas, las actualizaciones de
      la app y la licencia de la app oficial son actividades de red aparte. Un
      endpoint personalizado en otro equipo no es procesamiento en este Mac.
    </p>
    <p>
      Lee{" "}
      <a href={localizedPath("/guides/local-vs-cloud-dictation/", locale)}>
        qué envía cada opción de modelo
      </a>{" "}
      antes de combinar motores locales y en la nube.
    </p>
    <div class="guide-actions">
      <Button href={localizedPath("/support/", locale)} icon="right">
        Solucionar problemas
      </Button>
      <Button href={siteLinks.build} variant="quiet" icon="external">
        Instrucciones de compilación
      </Button>
    </div>
  </GuideSection>
</GuideLayout>
