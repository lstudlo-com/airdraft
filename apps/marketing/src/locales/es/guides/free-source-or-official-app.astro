---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import { localizedPath, type Locale } from "../../../i18n";
import { messages } from "../../../i18n/messages";
import { licenses, siteLinks } from "../../../data/site";

const locale: Locale = "es";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "free-source-or-official-app",
)!;
const onSale = Boolean(siteLinks.checkout);
const plans = messages[locale].license.plans;
const usd = (price: string) => `${price.replace("$", "")} US$`;
const pricing = localizedPath("/pricing/", locale);
---

<GuideLayout guide={guide}>
  <GuideSection id="availability" title="¿Qué puedo conseguir ahora?">
    {onSale ? (
      <p>
        Puedes compilar Airdraft desde el código o elegir una licencia de la app
        oficial en la <a href={pricing}>página de precios</a>.
      </p>
    ) : (
      <p>
        La <a href={siteLinks.build}>versión compilada desde el código</a> está
        disponible ya. La app oficial aún no está a la venta. Las versiones de
        uso personal publicadas hasta ahora están firmadas con Apple Development
        y no están notarizadas; no son un instalador público con soporte.
      </p>
    )}
    <p>
      Las dos opciones necesitan un Mac con Apple silicon y macOS 15 o
      posterior. Apple SpeechAnalyzer y Apple Intelligence necesitan macOS 26 o
      posterior.
    </p>
  </GuideSection>

  <GuideSection id="compare" title="¿En qué se diferencian las dos opciones?">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="Compara la versión compilada desde el código y la app oficial"
    >
      <table class="guide-table">
        <caption>
          Versión compilada desde el código y licencia de la app oficial
        </caption>
        <thead>
          <tr>
            <th scope="col">Opción</th>
            <th scope="col">Versión gratuita desde el código</th>
            <th scope="col">App oficial</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Precio</th>
            <td>0 US$</td>
            <td>
              {licenses
                .map((plan) => `${usd(plan.price)} para ${plans[plan.id].macs}`)
                .join("; ")}
              . Pago único, en dólares estadounidenses e impuestos aparte.
            </td>
          </tr>
          <tr>
            <th scope="row">Funciones</th>
            <td>Todas las funciones, sin niveles bloqueados.</td>
            <td>Las mismas funciones, lista para usar.</td>
          </tr>
          <tr>
            <th scope="row">Instalación</th>
            <td>
              Se compila con Xcode siguiendo las instrucciones del repositorio.
            </td>
            <td>Sin Xcode ni paso de compilación.</td>
          </tr>
          <tr>
            <th scope="row">Actualizaciones</th>
            <td>Descarga los cambios del código y vuelve a compilar.</td>
            <td>Incluye las actualizaciones de la versión que compras.</td>
          </tr>
          <tr>
            <th scope="row">Prueba</th>
            <td>Sin límite de prueba.</td>
            <td>
              Una prueba de 14 días con todas las funciones, que empieza cuando
              tú decides.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </GuideSection>

  <GuideSection id="license" title="¿La app oficial es una suscripción?">
    <p>
      No. La licencia personal es un pago único y no caduca. Los planes solo se
      diferencian en cuántos Macs pueden estar activos a la vez. Puedes
      desactivar un Mac para pasar la licencia a otro.
    </p>
    <p>
      El código se publica bajo la licencia{" "}
      <a href={`${siteLinks.source}/blob/main/LICENSE`}>GPL-3.0-only</a>. La
      licencia del repositorio cubre el código; las condiciones de compra de la
      app oficial describen su licencia personal.
    </p>
  </GuideSection>

  <GuideSection id="model-costs" title="¿También pago por los modelos?">
    <p>
      La voz y el refinamiento locales no tienen cargos de API. Los proveedores
      en la nube te cobran directamente, uses la edición que uses.
    </p>
    <p>
      Consulta la{" "}
      <a href={`${pricing}#provider-costs`}>
        comparación de costos fechada y sus supuestos de uso
      </a>
      , o elige una{" "}
      <a href={localizedPath("/guides/offline-dictation-on-mac/", locale)}>
        configuración local
      </a>
      .
    </p>
    <div class="guide-actions">
      <Button href={siteLinks.build} icon="external">
        Compilar desde el código
      </Button>
      <Button href={pricing} variant="quiet" icon="right">
        Ver precios
      </Button>
    </div>
  </GuideSection>
</GuideLayout>
