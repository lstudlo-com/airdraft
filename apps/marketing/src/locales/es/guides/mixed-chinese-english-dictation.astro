---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import {
  mixedAsrFollowup,
  mixedAsrResults,
  mixedAsrStudy,
  type MixedAsrDelta,
} from "../../../data/mixed-asr";
import { href, type Locale } from "../../../i18n";

/**
 * Mixed Chinese–English dictation, in each language. The numbers come from
 * src/data/mixed-asr.ts (eval/mixed-asr in the repository) and are presented
 * as Airdraft's own measurement on one Mac, with its method and limits; the
 * SenseVoice row is the 2026-10-24 follow-up of the original model, and the
 * earlier row of the Cantonese fine-tune stays as dated history. App
 * behavior follows SpeechLanguagePolicy, ChineseScriptConverter, PromptBuilder
 * and the current onboarding recommendation (AD-083 for English, Japanese and
 * Korean); 0.11.0's and 0.10.2's recommendations are named only where they
 * differ. App labels are the app's es catalog values, quoted with «».
 */
const locale: Locale = "es";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "mixed-chinese-english-dictation",
)!;
const study = mixedAsrStudy;
const followup = mixedAsrFollowup;
const percent = (value: number) => `${value.toFixed(1)}%`;
const points = (value: number) => Math.abs(value).toFixed(1);
const signed = (value: number) =>
  `${value < 0 ? "−" : "+"}${Math.abs(value).toFixed(1)}`;
const interval = (delta: MixedAsrDelta) =>
  `intervalo del 95 %: de ${signed(delta.ci[0])} a ${signed(delta.ci[1])}`;
const qwenGap = followup.qwenVsSenseVoice;
const tie = followup.originalVsCantonese;
const [qwenRow, senseVoiceRow, cantoneseRow] = [
  "Qwen3-ASR 1.7B",
  "SenseVoice",
  "SenseVoice Cantonese",
].map((model) => mixedAsrResults.find((row) => row.model === model)!);
// The follow-up's SenseVoice Cantonese rows equal AD-074's to three decimals,
// so the dated history row also serves the paired comparison.
// Sentences with several numbers are assembled here so the page's line
// breaks never put spaces inside the parentheses.
const qwenGapText = `Qwen3-ASR 1.7B cometió menos errores que SenseVoice (${percent(qwenRow.mer)} frente a ${percent(senseVoiceRow.mer)}, una diferencia de ${signed(qwenGap.errors.points)} puntos, ${interval(qwenGap.errors)}) y conservó ${points(qwenGap.englishKept.points)} puntos más de palabras en inglés.`;
const caseText = `La app ahora devuelve a mayúsculas y minúsculas normales el inglés que SenseVoice y FireRedASR2 escriben todo en mayúsculas; por eso la fila del ${study.followup.date} conserva más inglés con su uso original de mayúsculas. El cambio viene de la app, no del modelo: el ajuste fino midió ${followup.cantoneseCaseKeptWithGuards}% en la misma ejecución. La fila de FireRedASR2 es anterior a este cambio.`;
const tieText = `${percent(senseVoiceRow.mer)} frente a ${percent(cantoneseRow.mer)} en habla real (${signed(tie.realErrors.points)} puntos, ${interval(tie.realErrors)}) y ${percent(senseVoiceRow.ttsMer)} frente a ${percent(cantoneseRow.ttsMer)} en las frases al estilo de Taiwán (${signed(tie.ttsErrors.points)} puntos, ${interval(tie.ttsErrors)}).`;
const columns = [
  "Modelo",
  "Errores, habla mezclada real",
  "Palabras en inglés conservadas",
  "Errores, frases al estilo de Taiwán",
  "Mayúsculas del inglés conservadas",
  "Tiempo mediano",
  "Descarga",
  "Pico de memoria medido",
];
const cells = (row: (typeof mixedAsrResults)[number]) => [
  percent(row.mer),
  `${row.englishKept}%`,
  percent(row.ttsMer),
  `${row.ttsCaseKept}%`,
  `${row.medianMs} ms`,
  row.download,
  row.memory ?? "No comparable",
];
---

<GuideLayout guide={guide}>
  <GuideSection id="choose" title="¿Qué modelo elijo?">
    <dl class="guide-decisions">
      <div>
        <dt>Qwen3-ASR 1.7B: la mayoría de los Macs con 16 GB o más</dt>
        <dd>
          Fue el que menos errores cometió en nuestra medición, conservó más
          términos en inglés con sus mayúsculas originales y añade puntuación.
          Es una descarga de 2,44 GB, y su pico de memoria medido al transcribir
          fue de unos 2,4 GB.
        </dd>
      </div>
      <div>
        <dt>
          SenseVoice: Macs con 8 GB, o junto a un modelo de refinamiento local
        </dt>
        <dd>
          Es una descarga de 163 MB, su pico de memoria medido fue de unos 0,9
          GB y fue el más rápido. Es más débil con los términos en inglés: en
          habla mezclada real conservó el {senseVoiceRow.englishKept}% de ellos,
          frente al {qwenRow.englishKept}% de Qwen3-ASR 1.7B.
        </dd>
      </div>
      <div>
        <dt>No recomendados para habla mezclada</dt>
        <dd>
          Con «Idioma» en «Detectar automáticamente», Whisper Large v3 Turbo
          tradujo al inglés 5 de 100 frases mezcladas reales y, en todas las
          ejecuciones, no devolvió texto en 6 de 360 primeros intentos.
          Qwen3-ASR 0.6B repitió una frase en un clip degradado hasta llegar a
          su límite, con un pico de unos 18,5 GB de memoria. FireRedASR2 se
          acerca a Qwen3-ASR 1.7B en chino, pero está entre los más lentos y fue
          el que más memoria usó. Parakeet no admite chino.
        </dd>
      </div>
    </dl>
  </GuideSection>

  <GuideSection id="app-recommendation" title="¿Qué recomienda la app?">
    <p>
      La configuración inicial recomienda Qwen3-ASR 1.7B en un Mac en chino. En
      un Mac con 8 GB de memoria o menos recomienda SenseVoice y sigue
      ofreciendo Qwen3-ASR 1.7B. Para inglés propone Parakeet TDT v2, con
      Qwen3-ASR 1.7B como alternativa multilingüe. Para japonés y coreano,
      Qwen3-ASR 1.7B, con Whisper Large v3 Turbo como alternativa que usa menos
      memoria y que aparece primero en un Mac con 8 GB o menos. Para otros
      idiomas, Whisper Large v3 Turbo. La página Modelos etiqueta Qwen3-ASR 1.7B
      como «Ideal para chino e inglés mezclados» y describe SenseVoice como
      «Pequeño y rápido. Más débil con términos en inglés dentro del chino». No
      se descarga nada hasta que haces clic en «Descargar».
    </p>
    <p>
      La 0.11.0 y anteriores recomendaban SenseVoice para inglés, japonés y
      coreano, y la 0.10.2 también lo sugería en un Mac en chino. Esas versiones
      instalaban como SenseVoice un ajuste fino para cantonés. Si lo tienes,
      sigue funcionando y Modelos lo muestra como SenseVoice Cantonese; una
      descarga nueva de SenseVoice es el modelo multilingüe original. La{" "}
      <a href={href("/guides/offline-dictation-on-mac/#measured", locale)}>
        medición de Airdraft en inglés, japonés y coreano
      </a>{" "}
      está en la guía de configuración sin conexión.
    </p>
  </GuideSection>

  <GuideSection id="results" title="Resultados medidos">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="Resultados de los modelos locales con chino e inglés mezclados"
    >
      <table class="guide-table guide-table-wide" role="table">
        <caption>
          Medición propia de Airdraft en un Apple M4 Pro,{study.date}, y{" "}
          {study.followup.date}para SenseVoice. «Idioma» en «Detectar
          automáticamente», escritura tradicional, sin refinamiento. Cuantos
          menos errores, mejor.
        </caption>
        <thead role="rowgroup">
          <tr role="row">
            {columns.map((column) => (
              <th scope="col" role="columnheader">
                {column}
              </th>
            ))}
          </tr>
        </thead>
        <tbody role="rowgroup">
          {mixedAsrResults.map((row) => (
            <tr role="row">
              <th scope="row" role="rowheader">
                {row.model}
                {row.note && <span class="row-note">{row.note[locale]}</span>}
              </th>
              {cells(row).map((cell, index) => (
                <td role="cell">
                  <span class="cell-label" aria-hidden="true">
                    {columns[index + 1]}
                  </span>
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      La tasa de error cuenta cada carácter chino y cada palabra en inglés de la
      referencia como una unidad y mide la proporción que necesitó una
      corrección. En habla mezclada real, {qwenGapText} Las frases al estilo de
      Taiwán apuntan en la misma dirección. Para Qwen3-ASR 1.7B, fijar «Idioma»
      en «Detectar automáticamente» o en «Chino mandarín» no supuso una
      diferencia medible en habla real.
    </p>
    <p>
      La 0.11.0 y anteriores instalaban con ese nombre un ajuste fino de
      SenseVoice para cantonés, y las cifras de SenseVoice del {study.date} en
      esta guía venían de él: la fila SenseVoice Cantonese. Medidos de nuevo el{" "}
      {study.followup.date}, el modelo original y el ajuste fino empataron
      estadísticamente en habla mezclada: {tieText} {caseText}
    </p>
    <p>
      El tiempo mediano es el de transcripción una vez cargado el modelo, para
      clips de 2,5 a 15 segundos, medido mientras el Mac también compilaba, así
      que compara los modelos solo entre sí. Whisper se ejecuta en el Neural
      Engine y mantiene parte de su memoria fuera del proceso de la app, así que
      su memoria no es comparable.
    </p>
    <p>
      Los tamaños de descarga son los totales que indica la página Modelos para
      los archivos fijados de cada modelo, en unidades decimales, no
      transferencias medidas. La memoria es la mediana del pico medido en el
      proceso de la app al transcribir; la de SenseVoice viene de las
      ejecuciones con habla leída del mismo día.
    </p>
  </GuideSection>

  <GuideSection id="method" title="Cómo medimos">
    <ul>
      <li>
        Cada clip pasó por la propia cadena de transcripción de la app (una
        compilación Debug con datos aislados), con el refinamiento y el contexto
        de la app desactivados, el vocabulario vacío y la escritura tradicional
        predeterminada.
      </li>
      <li>
        Habla real: {study.realUtterances} frases mezcladas en conversación del
        conjunto de datos ASCEND (CAiRE, CC BY-SA 4.0), de cinco hablantes de
        Hong Kong y China continental.
      </li>
      <li>
        Estilo de Taiwán: {study.ttsSentences} frases de trabajo y de
        desarrollo, como «我等一下把 PR merge 到 main branch», dichas por la voz
        Meijia zh_TW de macOS.
      </li>
      <li>
        La escritura, las mayúsculas y la puntuación se normalizaron antes de
        comparar; la proporción de palabras en inglés con sus mayúsculas
        originales se cuenta aparte.
      </li>
      <li>
        El {study.followup.date}, SenseVoice y SenseVoice Cantonese se midieron
        de nuevo con la misma cadena. El modelo original se instaló con la
        descarga de la propia app, que comprueba su tamaño y su SHA-256.
      </li>
    </ul>
    <p>
      El método completo, los resultados por frase y los pasos para
      reproducirlos están en{" "}
      <a href={study.methodURL}>eval/mixed-asr en el repositorio del código</a>,
      medido en el commit {study.sourceCommit}; la nueva medición de SenseVoice
      usó una compilación basada en {study.followup.sourceCommit}.
    </p>
  </GuideSection>

  <GuideSection id="limits" title="Límites de esta medición">
    <ul>
      <li>
        El habla real viene de cinco hablantes con acento de Hong Kong y de
        China continental, en conversación. El acento taiwanés solo está
        cubierto por una voz sintética, con audio limpio, sin vacilaciones y con
        una pronunciación del inglés de manual.
      </li>
      <li>
        Se ejecutó en un solo M4 Pro con 48 GB. No se midieron Macs de gama más
        baja, y Qwen3-ASR será bastante más lento en Macs con GPU más pequeñas.
      </li>
      <li>
        Airdraft descarga Qwen3-ASR y Whisper de revisiones fijas de Hugging
        Face y comprueba el tamaño y el SHA-256 de cada archivo antes de
        instalarlo. Los archivos de modelo medidos tienen los mismos resúmenes
        SHA-256, así que los resultados se aplican a los archivos que instala la
        app. La 0.10.2 y anteriores descargaban lo que hubiera en los
        repositorios en ese momento.
      </li>
      <li>
        Los resultados son la salida de voz sin refinamiento. Cohere Transcribe
        no se probó.
      </li>
      <li>
        Compara los modelos de Airdraft entre sí, no Airdraft con otras apps de
        dictado.
      </li>
    </ul>
  </GuideSection>

  <GuideSection id="setup" title="Configúralo">
    <ol class="guide-steps">
      <li>
        <h3>Descarga un modelo</h3>
        <p>
          En Modelos → «Voz en este Mac», descarga y elige Qwen3-ASR 1.7B o
          SenseVoice. Los modelos solo se descargan cuando lo pides y luego se
          ejecutan en tu Mac.
        </p>
      </li>
      <li>
        <h3>Elige el idioma y la escritura</h3>
        <p>
          En «Opciones de voz», fija «Idioma» en «Detectar automáticamente» o en
          «Chino mandarín». «Escritura china» sigue el primer idioma chino de tu
          Mac (简体中文 para chino simplificado y 繁體中文 en los demás casos)
          hasta que elijas 繁體中文, 简体中文 o «Auto»; solo convierte
          caracteres, así que no cambia la elección de palabras, como 软件 por
          軟體.
        </p>
      </li>
      <li>
        <h3>Activa el refinamiento si lo quieres</h3>
        <p>
          El refinamiento mantiene mezclados el chino y el inglés y nunca
          traduce; con la escritura tradicional también usa vocabulario de
          Taiwán. Si falla o se agota el tiempo, se inserta la transcripción sin
          procesar. Añade al Vocabulario los nombres y términos que usas a
          menudo.
        </p>
      </li>
    </ol>
    <div class="guide-actions">
      <Button href={href("/pricing/", locale)} icon="right">
        Ver precios
      </Button>
      <Button
        href={href("/guides/dictate-to-claude-code-and-terminals/", locale)}
        variant="quiet"
        icon="right"
      >
        Dictar en Claude Code y terminales
      </Button>
    </div>
  </GuideSection>
</GuideLayout>
