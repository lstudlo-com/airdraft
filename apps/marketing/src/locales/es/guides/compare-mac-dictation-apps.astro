---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import { licenses } from "../../../data/site";
import { href, type Locale } from "../../../i18n";

/**
 * A dated comparison with VoiceInk, Handy, Typeless and Apple Dictation.
 * Competitor facts come from each product's own pages and the sources listed
 * at the end, checked on the stated dates (vault: Research/Competitors).
 * Recheck every row and date before changing them. Unknown cells say so;
 * never fill them with assumptions, rankings or benchmark claims.
 */
const locale: Locale = "es";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "compare-mac-dictation-apps",
)!;
const [oneMac, threeMacs] = licenses;
const usd = (price: string) => `${price.replace("$", "")} US$`;

type Row = {
  name: string;
  price: string;
  /** Whether a visitor can download and try it today. */
  available: string;
  source: string;
  speech: string;
  cleanup: string;
  meetings: string;
  platforms: string;
};

const rows: Row[] = [
  {
    name: "Airdraft",
    price: `Gratis si la compilas desde el código; app oficial por ${usd(oneMac.price)} para un Mac o ${usd(threeMacs.price)} para tres, pago único, aún no a la venta`,
    available:
      "No: la app oficial no está a la venta ni notarizada; la versión desde el código necesita Xcode",
    source: "Código abierto (GPL-3.0)",
    speech: "En tu Mac, o proveedores en la nube con tu propia clave",
    cleanup:
      "Local, en la nube con tu propia clave, o Claude Code y Codex con tu plan",
    meetings:
      "Graba el audio de las apps y el micrófono; importa archivos; etiquetas de hablante opcionales; exporta SRT y VTT",
    platforms: "Mac (Apple silicon, macOS 15 o posterior)",
  },
  {
    name: "VoiceInk",
    price:
      "25, 39 o 49 US$, pago único, para 1, 2 o 3 Macs; reembolso en 14 días",
    available:
      "Sí: descarga de prueba gratuita (no indica la duración de la prueba)",
    source: "Código abierto (GPL-3.0)",
    speech: "En tu Mac, o proveedores en la nube con tu propia clave",
    cleanup:
      "El proveedor que elijas, con plantillas de CLI locales para Claude Code y Codex",
    meetings:
      "Pone en cola archivos de audio y vídeo para transcribirlos; el historial guarda TXT o Markdown y exporta CSV",
    platforms: "Mac; app de iOS aparte",
  },
  {
    name: "Handy",
    price: "Gratis, con donaciones",
    available: "Sí: descarga gratuita",
    source: "Código abierto (MIT)",
    speech:
      "En tu dispositivo, con Qwen3-ASR 0.6B y 1.7B y SenseVoice Small, entre otros",
    cleanup:
      "Posprocesado opcional, en local o mediante una API que configures",
    meetings: "Sin comprobar",
    platforms: "Mac, Windows, Linux",
  },
  {
    name: "Typeless",
    price:
      "Gratis con un límite semanal de palabras; Pro por 30 US$ al mes o 144 US$ al año",
    available: "Sí: descarga del plan gratuito",
    source: "Código cerrado",
    speech: "Servicio alojado en la nube",
    cleanup: "Alojado: diccionario personal, tono y limpieza",
    meetings: "Sin comprobar",
    platforms: "Mac, Windows, Linux, iOS, Android",
  },
  {
    name: "Dictado de Apple (macOS 27)",
    price: "Incluido en macOS",
    available: "Sí: integrado en macOS",
    source: "Código cerrado",
    speech:
      "Integrado; el procesamiento en el dispositivo o en el servidor depende del idioma, los ajustes y el hardware",
    cleanup:
      "macOS 27 añade dictado con texto pulido; las funciones avanzadas necesitan un Mac con M3 o posterior y 12 GB de memoria",
    meetings: "Sin comprobar",
    platforms: "Integrado en las plataformas de Apple",
  },
];

const columns = [
  "Producto",
  "Precio",
  "Descargar y probar hoy",
  "Código",
  "Reconocimiento de voz",
  "Limpieza del texto",
  "Reuniones y archivos",
  "Plataformas",
];

// Each source with the date its facts were checked.
// The cells after the product name, in column order.
const cells = (row: Row) => [
  row.price,
  row.available,
  row.source,
  row.speech,
  row.cleanup,
  row.meetings,
  row.platforms,
];

const sources = [
  {
    label: "Precios de VoiceInk",
    url: "https://tryvoiceink.com/pricing",
    checked: "2026-10-21",
  },
  {
    label: "Código de VoiceInk",
    url: "https://github.com/Beingpax/VoiceInk",
    checked: "2026-10-21",
  },
  {
    label: "Documentación de la CLI local de VoiceInk",
    url: "https://tryvoiceink.com/docs/local-cli",
    checked: "2026-10-21",
  },
  {
    label: "Transcripción de archivos en VoiceInk",
    url: "https://tryvoiceink.com/docs/transcribe-audio-files",
    checked: "2026-10-21",
  },
  {
    label: "Código de VoiceInk: guardado del historial",
    url: "https://github.com/Beingpax/VoiceInk/blob/main/VoiceInk/Features/History/Components/SaveIconButton.swift",
    checked: "2026-10-21",
  },
  {
    label: "Código de VoiceInk: exportación CSV",
    url: "https://github.com/Beingpax/VoiceInk/blob/main/VoiceInk/Features/History/Export/VoiceInkCSVExportService.swift",
    checked: "2026-10-21",
  },
  {
    label: "Handy",
    url: "https://handy.computer/",
    checked: "2026-10-21",
  },
  {
    label: "Posprocesado en Handy",
    url: "https://handy.computer/docs/post-processing",
    checked: "2026-09-26",
  },
  {
    label: "Versión v0.9.8 de Handy",
    url: "https://github.com/cjpais/Handy/releases/tag/v0.9.8",
    checked: "2026-10-21",
  },
  {
    label: "Código de Handy: catálogo de modelos de la v0.9.8",
    url: "https://github.com/cjpais/Handy/blob/v0.9.8/src-tauri/src/catalog/catalog.json",
    checked: "2026-10-24",
  },
  {
    label: "Precios de Typeless",
    url: "https://www.typeless.com/pricing",
    checked: "2026-10-21",
  },
  {
    label: "Notas de las versiones de Typeless",
    url: "https://www.typeless.com/help/release-notes",
    checked: "2026-09-26",
  },
  {
    label:
      "Reseña de métodos de entrada por voz en chino tradicional (Taneverse)",
    url: "https://taneverse.com/posts/three-traditional-chinese-voice-input-methods/",
    checked: "2026-10-21",
  },
  {
    label: "Ayuda del Dictado de Apple",
    url: "https://support.apple.com/guide/mac-help/use-dictation-mh40584/mac",
    checked: "2026-09-26",
  },
  {
    label: "Macworld: macOS 27",
    url: "https://www.macworld.com/article/3139330/macos-27-mac-features-siri-apple-intelligence-release-date-compatibility.html",
    checked: "2026-10-21",
  },
  {
    label: "9to5Mac: macOS 27",
    url: "https://9to5mac.com/2026/09/14/macos-27-golden-gate-now-available-here-is-everything-new/",
    checked: "2026-10-21",
  },
];
---

<GuideLayout guide={guide}>
  <GuideSection id="glance" title="De un vistazo">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="Compara apps de dictado"
    >
      <table class="guide-table guide-table-wide" role="table">
        <caption>
          Comprobado el 21 de octubre de 2026, y los modelos de voz de Handy el
          24 de octubre. «Sin comprobar» no significa que falte.
        </caption>
        <thead role="rowgroup">
          <tr role="row">
            {columns.map((column) => (
              <th scope="col" role="columnheader">
                {column}
              </th>
            ))}
          </tr>
        </thead>
        <tbody role="rowgroup">
          {rows.map((row) => (
            <tr role="row">
              <th scope="row" role="rowheader">
                {row.name}
              </th>
              {cells(row).map((cell, index) => (
                <td role="cell">
                  <span class="cell-label" aria-hidden="true">
                    {columns[index + 1]}
                  </span>
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </GuideSection>

  <GuideSection id="better" title="En qué son mejores los demás">
    <dl class="guide-decisions">
      <div>
        <dt>VoiceInk</dt>
        <dd>
          Cuesta menos para un Mac (25 US$ frente a 29 US$), ofrece una licencia
          para dos Macs, publica un reembolso en 14 días y ya está a la venta.
          Puede poner archivos en cola para transcribirlos por lotes, mientras
          que Airdraft procesa un archivo cada vez, y tiene app de iOS.
        </dd>
      </div>
      <div>
        <dt>Handy</dt>
        <dd>
          Es gratis, tiene licencia MIT y también funciona en Windows y Linux.
          Su comunidad es mucho mayor: unas 34&nbsp;200 estrellas en GitHub el
          21 de octubre de 2026. La versión 0.9.8 añadió la elección de
          escritura china.
        </dd>
      </div>
      <div>
        <dt>Typeless</dt>
        <dd>
          No hay modelos ni claves que configurar, y funciona en teléfonos y
          otros equipos. Las reseñas taiwanesas de entrada por voz en chino
          tradicional suelen recomendarla (consulta Taneverse).
        </dd>
      </div>
      <div>
        <dt>Dictado de Apple</dt>
        <dd>
          Es gratis, no necesita instalación y forma parte del sistema. macOS 27
          añade dictado con texto pulido; no hemos comprobado si admite chino.
        </dd>
      </div>
    </dl>
  </GuideSection>

  <GuideSection id="airdraft" title="En qué se diferencia Airdraft">
    <ul>
      <li>
        La voz y el refinamiento se ejecutan cada uno en local o en la nube, así
        que puedes dejar el audio en local y usar igualmente un modelo de texto
        en la nube.
      </li>
      <li>
        Modelos locales para chino (Qwen3-ASR, SenseVoice, FireRedASR2), con
        salida en escritura tradicional o simplificada. Desde la 0.11.0, la
        configuración inicial recomienda Qwen3-ASR 1.7B en un Mac en chino,
        etiquetado en Modelos como «Ideal para chino e inglés mezclados», con
        SenseVoice como opción más pequeña y rápida; en un Mac con 8 GB de
        memoria o menos recomienda primero SenseVoice y sigue ofreciendo
        Qwen3-ASR 1.7B. El catálogo de modelos de Handy v0.9.8 también ofrece
        Qwen3-ASR 0.6B y 1.7B y SenseVoice Small en local. Consulta las{" "}
        <a href={href("/guides/mixed-chinese-english-dictation/", locale)}>
          mediciones de modelos con idiomas mezclados
        </a>
        .
      </li>
      <li>
        Claude Code o Codex pueden refinar el texto con el plan de Claude o
        ChatGPT que ya pagas, y puedes dictar prompts directamente a agentes de
        programación en una terminal. Consulta{" "}
        <a href={href("/guides/dictate-to-claude-code-and-terminals/", locale)}>
          cómo dictar en Claude Code y terminales
        </a>
        .
      </li>
      <li>
        <a href={href("/guides/private-meeting-transcription/", locale)}>
          Grabación y transcripción de reuniones
        </a>
        : audio de las apps y micrófono, etiquetas de hablante y exportación de
        subtítulos.
      </li>
    </ul>
  </GuideSection>

  <GuideSection id="gaps" title="Lo que le falta hoy a Airdraft">
    <ul>
      <li>
        La app oficial no está a la venta y todavía no hay un instalador público
        notarizado.
      </li>
      <li>Solo funciona en Mac, sin app para el teléfono.</li>
      <li>
        Hay muchas opciones, y la primera configuración implica elegir modelos.
      </li>
      <li>
        Airdraft solo ha publicado sus propias pruebas de sus modelos locales,
        con chino e inglés mezclados y con habla leída en inglés, japonés y
        coreano (un Mac en cada caso); no hay comparación de precisión ni de
        velocidad con otras apps.
      </li>
      <li>La grabación de reuniones no tiene cancelación de eco.</li>
    </ul>
    <div class="guide-actions">
      <Button href={href("/pricing/", locale)} icon="right">
        Ver precios
      </Button>
    </div>
  </GuideSection>

  <GuideSection id="sources" title="Fuentes y fechas de comprobación">
    <ul class="guide-sources">
      {sources.map((source) => (
        <li>
          <a href={source.url}>{source.label}</a>, comprobado el{" "}
          <time datetime={source.checked}>{source.checked}</time>
        </li>
      ))}
    </ul>
  </GuideSection>
</GuideLayout>
