---
import GuideSection from "../../components/GuideSection.astro";
import Button from "../../components/ui/Button.astro";
import Disclosure from "../../components/ui/Disclosure.astro";
import { siteLinks } from "../../data/site";
import { localizedPath, type Locale } from "../../i18n";

const locale: Locale = "es";
---

<GuideSection id="problems" title="Problemas habituales">
  <div class="question-list">
    <Disclosure summary="No aparece nada al soltar">
      <p>
        Airdraft necesita Accesibilidad para insertar texto. Actívala en Ajustes
        del Sistema ▸ Privacidad y seguridad ▸ Accesibilidad.
      </p>
      <p>
        Si volviste a compilar la app con otra firma, el permiso anterior ya no
        sirve. Ejecuta{" "}
        <code>tccutil reset Accessibility com.lstudlo.app.airdraft</code> y
        vuelve a concederlo.
      </p>
    </Disclosure>
    <Disclosure summary="No se graba nada">
      <p>
        Permite el micrófono cuando macOS lo pida. Elige la entrada en la barra
        de herramientas de la ventana, en la barra de menús o en Ajustes ▸
        Micrófono.
      </p>
    </Disclosure>
    <Disclosure summary="El primer dictado tarda un minuto">
      <p>
        Después de descargar un modelo, la primera vez que se usa se compila
        para el Neural Engine. La ventana de grabación muestra «Cargando» hasta
        que está listo.
      </p>
    </Disclosure>
    <Disclosure summary="El refinamiento local es lento">
      <p>
        Los modelos de razonamiento pueden pensar de 10 a 60 segundos antes de
        limpiar una sola línea. Deja «Esfuerzo de razonamiento» en «Desactivado»
        en Modelos ▸ Refinamiento.
      </p>
    </Disclosure>
    <Disclosure summary="La tecla fn no funciona como atajo">
      <p>
        En Ajustes del Sistema ▸ Teclado, ajusta «Pulsar la tecla 🌐 para» en
        «No hacer nada». Los atajos de una sola tecla modificadora también
        necesitan Accesibilidad.
      </p>
    </Disclosure>
    <Disclosure summary="El chino sale con la escritura equivocada">
      <p>Elige la escritura en Modelos ▸ Opciones de voz ▸ Escritura china.</p>
    </Disclosure>
  </div>
</GuideSection>

<GuideSection id="report" title="¿Sigues sin solucionarlo?">
  <p>
    Abre una incidencia con tu versión de macOS y los modelos de voz y de
    refinamiento que usas.
  </p>
  <div class="support-actions">
    <Button href={siteLinks.issues} icon="external">
      Abrir una incidencia
    </Button>
    <Button
      href={localizedPath("/guides/offline-dictation-on-mac/", locale)}
      variant="quiet"
      icon="right"
    >
      Guía de configuración local
    </Button>
    <Button href={siteLinks.build} variant="quiet" icon="external">
      Instrucciones de compilación
    </Button>
  </div>
</GuideSection>
