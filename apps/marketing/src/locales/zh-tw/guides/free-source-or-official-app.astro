---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import { href, type Locale } from "../../../i18n";
import { messages } from "../../../i18n/messages";
import { licenses, siteLinks } from "../../../data/site";

const locale: Locale = "zh-tw";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "free-source-or-official-app",
)!;
const onSale = Boolean(siteLinks.checkout);
// Prices stay the US-dollar strings from src/data/site.ts; the Mac counts
// are this language's license names.
const plans = messages[locale].license.plans;
---

<GuideLayout guide={guide}>
  <GuideSection id="availability" title="現在能取得哪一種？">
    {onSale ? (
      <p>
        你可以從原始碼自行編譯 Airdraft，或在
        <a href={href("/pricing/", locale)}>價格頁面</a>選購官方版授權。
      </p>
    ) : (
      <p>
        <a href={siteLinks.build}>原始碼版本</a>
        現在就能取得，官方版則尚未開賣。目前已有的個人使用版本以 Apple
        Development 簽署、未經公證，並不是正式支援的公開安裝檔。
      </p>
    )}
    <p>
      兩種都需要搭載 Apple 晶片、macOS 15 以上的 Mac。Apple SpeechAnalyzer 與
      Apple Intelligence 需要 macOS 26 以上。
    </p>
  </GuideSection>

  <GuideSection id="compare" title="兩者有什麼不同？">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="原始碼版本與官方版比較"
    >
      <table class="guide-table">
        <caption>原始碼版本與官方版授權</caption>
        <thead>
          <tr>
            <th scope="col">項目</th>
            <th scope="col">免費原始碼版本</th>
            <th scope="col">官方版 App</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">價格</th>
            <td>$0</td>
            <td>
              {licenses
                .map((plan) => `${plans[plan.id].macs} ${plan.price}`)
                .join("；")}
              。一次買斷，以美元計價，未含稅。
            </td>
          </tr>
          <tr>
            <th scope="row">功能</th>
            <td>所有功能，沒有鎖住的等級。</td>
            <td>相同的功能，裝好就能用。</td>
          </tr>
          <tr>
            <th scope="row">安裝</th>
            <td>依儲存庫的說明用 Xcode 編譯。</td>
            <td>不需要 Xcode，也不用編譯。</td>
          </tr>
          <tr>
            <th scope="row">更新</th>
            <td>拉取原始碼更新後重新編譯。</td>
            <td>包含所購版本的後續更新。</td>
          </tr>
          <tr>
            <th scope="row">試用</th>
            <td>沒有試用限制。</td>
            <td>14 天全功能試用，由你決定何時開始。</td>
          </tr>
        </tbody>
      </table>
    </div>
  </GuideSection>

  <GuideSection id="license" title="官方版是訂閱制嗎？">
    <p>
      不是。個人授權一次買斷，永不到期。方案之間只差在同時可以啟用幾台
      Mac。把某台 Mac 停用，就能把授權移到另一台。
    </p>
    <p>
      原始碼以{" "}
      <a href={`${siteLinks.source}/blob/main/LICENSE`}>GPL-3.0-only</a>{" "}
      授權。儲存庫的授權條款涵蓋原始碼；官方版的個人授權則依其購買條款。
    </p>
  </GuideSection>

  <GuideSection id="model-costs" title="模型也要另外付費嗎？">
    <p>
      本機語音辨識與潤稿沒有 API
      費用。雲端供應商會直接向你收費，不論你用哪個版本。
    </p>
    <p>
      請看
      <a href={href("/pricing/#provider-costs", locale)}>
        附日期的費用比較與用量假設
      </a>
      ，或改用
      <a href={href("/guides/offline-dictation-on-mac/", locale)}>本機設定</a>。
    </p>
    <div class="guide-actions">
      <Button href={siteLinks.build} icon="external">
        從原始碼編譯
      </Button>
      <Button href={href("/pricing/", locale)} variant="quiet" icon="right">
        查看價格
      </Button>
    </div>
  </GuideSection>
</GuideLayout>
