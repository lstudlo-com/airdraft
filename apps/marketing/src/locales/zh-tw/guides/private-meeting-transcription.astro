---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import { href, type Locale } from "../../../i18n";

/**
 * Private meeting transcription, in each language. Every statement follows
 * docs/meeting-recording.md and docs/media-transcription.md. Button and
 * setting names are the app's own in the page's language: the zh-Hant values
 * in its string catalogs, quoted with 「」. Builds through 0.10.2 show
 * English labels, and the zh-TW intro says so. Keep both languages
 * aligned.
 */
const locale: Locale = "zh-tw";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "private-meeting-transcription",
)!;
---

<GuideLayout guide={guide}>
  <GuideSection id="requirements" title="需要準備什麼？">
    <ul>
      <li>搭載 Apple 晶片、macOS 15 以上的 Mac。</li>
      <li>
        錄會議需要「螢幕與系統音訊錄製」權限；開啟「包含麥克風」時才會要求麥克風權限。
      </li>
      <li>已安裝的本機語音模型，或雲端轉錄用的 Soniox API 金鑰。</li>
      <li>Airdraft 沒有回音消除；麥克風可能收到喇叭聲時，請戴耳機。</li>
    </ul>
  </GuideSection>

  <GuideSection id="record" title="錄製會議">
    <ol class="guide-steps">
      <li>
        <h3>開啟「錄製會議」</h3>
        <p>在「會議」頁按「錄製會議」，也可以從選單列開啟。</p>
      </li>
      <li>
        <h3>選擇錄音來源</h3>
        <p>
          「App 音訊」可選「所有 App」或某個正在執行的
          App；選瀏覽器會錄下它所有分頁的聲音。「包含麥克風」使用側邊欄目前選定的麥克風。只錄聲音，不錄畫面。
        </p>
      </li>
      <li>
        <h3>開始錄音，並告知與會者</h3>
        <p>
          按「開始錄音」，並讓與會者知道你正在錄音。離開「會議」頁也會繼續錄；要結束時，在「會議」頁或選單列按「停止並儲存」。
        </p>
      </li>
      <li>
        <h3>先存檔，之後再轉錄</h3>
        <p>
          錄音會連同日期與長度出現在列表中，此時尚未轉錄，也沒有上傳任何資料。
        </p>
      </li>
    </ol>
  </GuideSection>

  <GuideSection id="import" title="或匯入檔案">
    <p>
      在「會議」頁按「匯入⋯」，或直接把檔案拖進來。音訊或影片最長兩小時，且只能有一條音軌；多音軌檔案請先匯出需要的那一軌。Airdraft
      會另存一份 16 kHz 副本，不會更動原始檔案。
    </p>
  </GuideSection>

  <GuideSection id="transcribe" title="轉成標出講者的逐字稿">
    <p>
      在錄音上按「轉錄⋯」，選擇模型與語言，需要時開啟「辨識講者」。講者辨識在本機執行；第一次使用時，在同一個視窗按「下載」取得所需模型。
    </p>
    <ul>
      <li>
        講者標籤是估計值，顯示為「講者 1」、「講者
        2」，不會猜測人名；你可以改名或重新指派。重疊的說話聲不會被分開。
      </li>
      <li>
        Whisper
        提供逐字時間，其他本機模型提供段落時間。轉錄中斷後可按「繼續」，從上次完成的段落接著做。
      </li>
      <li>
        Parakeet 不支援中文；中文或中英混說請選支援的模型，例如 Qwen3-ASR。
      </li>
    </ul>
  </GuideSection>

  <GuideSection id="privacy" title="哪些資料會離開 Mac？">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="會議資料去向比較"
    >
      <table class="guide-table">
        <caption>每個步驟送出的資料</caption>
        <thead>
          <tr>
            <th scope="col">步驟</th>
            <th scope="col">送出的資料</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">錄音</th>
            <td>不送出，音訊存在這台 Mac。</td>
          </tr>
          <tr>
            <th scope="row">本機模型轉錄</th>
            <td>不送出，講者辨識也在本機。</td>
          </tr>
          <tr>
            <th scope="row">Soniox 轉錄</th>
            <td>
              按下「上傳並轉錄」後，音訊以你的 API 金鑰上傳到
              Soniox，可能產生費用；本機仍保留一份 WAV。
            </td>
          </tr>
          <tr>
            <th scope="row">製作摘要</th>
            <td>
              按「製作摘要⋯」並確認後，逐字稿會送到你選的潤稿供應商；選用本機潤稿則留在
              Mac。
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </GuideSection>

  <GuideSection id="export" title="編輯與匯出">
    <p>
      修改內容與原文並存，可在「已編輯」與「原始」之間切換；「拷貝」與「匯出」使用目前顯示的版本。可匯出
      TXT、JSON、SRT 或
      VTT，字幕檔保留每段的時間與講者。點選時間戳記即可從該處播放錄音。
    </p>
    <p>
      會議錄音不受聽寫的錄音保留設定影響，會保留到你自行刪除音訊為止；刪除逐字稿不會刪除錄音。
    </p>
  </GuideSection>

  <GuideSection id="limits" title="限制">
    <ul>
      <li>每段錄音或檔案最長兩小時。</li>
      <li>開始錄音需要約 2 GB 可用空間；連續 15 秒收不到音訊時會停止錄音。</li>
      <li>長檔案的講者辨識需要足夠的可用記憶體，執行前會先檢查。</li>
      <li>
        Airdraft
        尚未公布會議轉錄或講者辨識的準確度測量，請先用自己的錄音試試看。
      </li>
    </ul>
    <div class="guide-actions">
      <Button href={href("/pricing/", locale)} icon="right">
        查看價格
      </Button>
      <Button
        href={href("/guides/compare-mac-dictation-apps/", locale)}
        variant="quiet"
        icon="right"
      >
        與其他 App 比較
      </Button>
    </div>
  </GuideSection>
</GuideLayout>
