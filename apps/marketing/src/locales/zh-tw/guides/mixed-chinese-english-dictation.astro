---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import {
  mixedAsrFollowup,
  mixedAsrResults,
  mixedAsrStudy,
  type MixedAsrDelta,
} from "../../../data/mixed-asr";
import { href, type Locale } from "../../../i18n";

/**
 * Mixed Chinese–English dictation, in each language. The numbers come from
 * src/data/mixed-asr.ts (eval/mixed-asr in the repository) and are presented
 * as Airdraft's own measurement on one Mac, with its method and limits; the
 * SenseVoice row is the 2026-10-24 follow-up of the original model, and the
 * earlier row of the Cantonese fine-tune stays as dated history. App
 * behavior follows SpeechLanguagePolicy, ChineseScriptConverter, PromptBuilder
 * and the current onboarding recommendation (AD-083 for English, Japanese and
 * Korean); 0.11.0's and 0.10.2's recommendations are named only where they
 * differ. App labels in the zh-TW page are the app's
 * zh-Hant catalog values, quoted with 「」.
 */
const locale: Locale = "zh-tw";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "mixed-chinese-english-dictation",
)!;
const study = mixedAsrStudy;
const followup = mixedAsrFollowup;
const percent = (value: number) => `${value.toFixed(1)}%`;
const points = (value: number) => Math.abs(value).toFixed(1);
const signed = (value: number) =>
  `${value < 0 ? "−" : "+"}${Math.abs(value).toFixed(1)}`;
const interval = (delta: MixedAsrDelta) =>
  `95% 區間 ${signed(delta.ci[0])} 到 ${signed(delta.ci[1])}`;
const qwenGap = followup.qwenVsSenseVoice;
const tie = followup.originalVsCantonese;
const [qwenRow, senseVoiceRow, cantoneseRow] = [
  "Qwen3-ASR 1.7B",
  "SenseVoice",
  "SenseVoice Cantonese",
].map((model) => mixedAsrResults.find((row) => row.model === model)!);
// The follow-up's SenseVoice Cantonese rows equal AD-074's to three decimals,
// so the dated history row also serves the paired comparison.
// Sentences with several numbers are assembled here so the page's line
// breaks never put spaces inside the parentheses.
const qwenGapText = `Qwen3-ASR 1.7B 的錯誤比 SenseVoice 少（${percent(qwenRow.mer)} 對 ${percent(senseVoiceRow.mer)}，差 ${signed(qwenGap.errors.points)} 個百分點，${interval(qwenGap.errors)}），英文詞保留率高 ${points(qwenGap.englishKept.points)} 個百分點。`;
const caseText = `App 現在會把 SenseVoice 與 FireRedASR2 輸出的全大寫英文改回一般大小寫，因此 ${study.followup.date} 那一列的英文大小寫正確率較高；這是 App 的處理，不是模型差異：同一次測量中，粵語微調版為 ${followup.cantoneseCaseKeptWithGuards}%。FireRedASR2 那一列測於這項改動之前。`;
const tieText = `真實語音 ${percent(senseVoiceRow.mer)} 對 ${percent(cantoneseRow.mer)}（${signed(tie.realErrors.points)} 個百分點，${interval(tie.realErrors)}），台灣用語句子 ${percent(senseVoiceRow.ttsMer)} 對 ${percent(cantoneseRow.ttsMer)}（${signed(tie.ttsErrors.points)} 個百分點，${interval(tie.ttsErrors)}）。`;
const columns = [
  "模型",
  "錯誤率（真實語音）",
  "英文詞保留率",
  "錯誤率（台灣用語句）",
  "英文大小寫正確率",
  "轉錄時間中位數",
  "下載大小",
  "實測記憶體峰值",
];
const cells = (row: (typeof mixedAsrResults)[number]) => [
  percent(row.mer),
  `${row.englishKept}%`,
  percent(row.ttsMer),
  `${row.ttsCaseKept}%`,
  `${row.medianMs} ms`,
  row.download,
  row.memory ?? "無法比較",
];
---

<GuideLayout guide={guide}>
  <GuideSection id="choose" title="該選哪個模型？">
    <dl class="guide-decisions">
      <div>
        <dt>Qwen3-ASR 1.7B：多數 16 GB 以上的 Mac</dt>
        <dd>
          實測錯誤最少，保留較多英文詞且維持原本大小寫，也會加標點。下載 2.44
          GB，轉錄時記憶體峰值約 2.4 GB。
        </dd>
      </div>
      <div>
        <dt>SenseVoice：8 GB 的 Mac，或同時要跑本機潤稿模型時</dt>
        <dd>
          下載 163 MB，記憶體峰值約 0.9
          GB，速度最快；但英文詞較弱：真實中英混說保留了{" "}
          {senseVoiceRow.englishKept}% 的英文詞，Qwen3-ASR 1.7B 為{" "}
          {qwenRow.englishKept}%。
        </dd>
      </div>
      <div>
        <dt>不建議用於中英混說</dt>
        <dd>
          Whisper Large v3 Turbo：「語言」設為「自動偵測」時，100
          句真實中英混說有 5 句被翻成英文；全部測試的 360 次首次嘗試中，有 6
          次沒有輸出文字。Qwen3-ASR
          0.6B：在一段音質很差的音檔上不斷重複同一句直到上限，記憶體峰值約 18.5
          GB。FireRedASR2：中文表現接近 Qwen3-ASR
          1.7B，但屬最慢的一群，記憶體用量也最大。Parakeet 不支援中文。
        </dd>
      </div>
    </dl>
  </GuideSection>

  <GuideSection id="app-recommendation" title="App 會推薦哪一個？">
    <p>
      系統語言為中文的 Mac，首次設定推薦 Qwen3-ASR 1.7B；記憶體 8 GB 以下改推薦
      SenseVoice，仍可選 Qwen3-ASR 1.7B。英文推薦 Parakeet TDT
      v2，另提供支援多語言的 Qwen3-ASR 1.7B；日文與韓文推薦 Qwen3-ASR
      1.7B，另提供較省記憶體的 Whisper Large v3 Turbo（8 GB 以下的 Mac
      優先推薦它）；其他語言推薦 Whisper Large v3 Turbo。「模型」頁在 Qwen3-ASR
      1.7B 標示「最適合中英夾雜」，並說明
      SenseVoice「小巧快速。中文夾雜英文詞時較弱。」按下「下載」前不會下載任何模型。
    </p>
    <p>
      0.11.0 及更早版本為英文、日文與韓文推薦 SenseVoice；0.10.2
      在中文系統上也建議 SenseVoice。這些版本以 SenseVoice
      名稱安裝的其實是粵語微調版：已安裝的會繼續運作，「模型」頁顯示為
      SenseVoice Cantonese；新下載的 SenseVoice
      則是原始多語言模型。英文、日文與韓文的測量結果請看
      <a href={href("/guides/offline-dictation-on-mac/#measured", locale)}>
        離線聽寫指南
      </a>
      。
    </p>
  </GuideSection>

  <GuideSection id="results" title="測量結果">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="中英混說本機模型測量結果"
    >
      <table class="guide-table guide-table-wide" role="table">
        <caption>
          Airdraft 自行測量，Apple M4 Pro，{study.date}（SenseVoice 為{" "}
          {study.followup.date}
          ）。「語言」設為「自動偵測」、輸出繁體中文、關閉潤稿。錯誤率越低越好。
        </caption>
        <thead role="rowgroup">
          <tr role="row">
            {columns.map((column) => (
              <th scope="col" role="columnheader">
                {column}
              </th>
            ))}
          </tr>
        </thead>
        <tbody role="rowgroup">
          {mixedAsrResults.map((row) => (
            <tr role="row">
              <th scope="row" role="rowheader">
                {row.model}
                {row.note && <span class="row-note">{row.note[locale]}</span>}
              </th>
              {cells(row).map((cell, index) => (
                <td role="cell">
                  <span class="cell-label" aria-hidden="true">
                    {columns[index + 1]}
                  </span>
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      錯誤率以參考文字中的每個中文字與英文詞為一個單位，計算需要修改的比例。真實中英混說上，
      {qwenGapText}台灣用語句子的結果方向一致。Qwen3-ASR 1.7B
      的「語言」設為「自動偵測」或「中文（華語）」，在真實語音上沒有可分辨的差異。
    </p>
    <p>
      本指南 {study.date} 的 SenseVoice 數字，測的是 0.11.0 及更早版本以
      SenseVoice 名稱安裝的粵語微調版，也就是表中的 SenseVoice Cantonese。
      {study.followup.date}{" "}
      重新測量後，原始模型與粵語微調版在中英混說上沒有可分辨的差異：
      {tieText}
      {caseText}
    </p>
    <p>
      轉錄時間是模型載入後，把每段 2.5 到 15 秒語音轉成文字的時間；測量時這台
      Mac 同時在編譯其他程式，數字只適合模型之間互相比較。Whisper 在 Neural
      Engine 上執行，部分記憶體不在 App 的行程內，因此記憶體無法比較。
    </p>
    <p>
      下載大小取自「模型」頁，是各模型固定版本檔案的總和（十進位單位），不是實測傳輸量。記憶體是轉錄時
      App 行程峰值的中位數；SenseVoice 的數字來自同一天的朗讀語音測量。
    </p>
  </GuideSection>

  <GuideSection id="method" title="怎麼測的">
    <ul>
      <li>
        每段語音都經過 App 本身的轉錄流程（Debug 版、獨立測試資料），關閉潤稿與
        App 情境，詞彙清單為空，輸出預設的繁體中文。
      </li>
      <li>
        真實語音：取自 ASCEND 資料集（CAiRE，CC BY-SA 4.0）的{" "}
        {study.realUtterances} 句中英混說對話，共五位香港與中國大陸的說話者。
      </li>
      <li>
        台灣用語：{study.ttsSentences}{" "}
        句台灣職場與開發者常說的句子，例如「我等一下把 PR merge 到 main
        branch」，由 macOS 的 zh_TW 美佳語音念出。
      </li>
      <li>比較前統一字形、大小寫與標點；英文大小寫正確率另外計算。</li>
      <li>
        {study.followup.date} 以同樣流程重新測量 SenseVoice 與 SenseVoice
        Cantonese；原始模型經由 App 本身的下載功能安裝，安裝前會核對大小與
        SHA-256。
      </li>
    </ul>
    <p>
      完整方法、逐句結果與重現步驟見
      <a href={study.methodURL}>原始碼儲存庫的 eval/mixed-asr</a>
      ，測量版本為 {study.sourceCommit}；SenseVoice 的後續測量以{" "}
      {study.followup.sourceCommit} 為基礎。
    </p>
  </GuideSection>

  <GuideSection id="limits" title="這次測量的限制">
    <ul>
      <li>
        真實語音只有五位說話者，都是香港與中國大陸口音的對話；台灣口音只以合成語音代替，音質乾淨、沒有贅詞，英文發音標準。
      </li>
      <li>
        只在一台 M4 Pro（48 GB）上測量，沒有測試較低階的 Mac；Qwen3-ASR 在 GPU
        較弱的 Mac 上會明顯變慢。
      </li>
      <li>
        Airdraft 從 Hugging Face 的固定版本下載 Qwen3-ASR 與
        Whisper，安裝前逐一核對檔案大小與
        SHA-256。測量用的模型檔與這些固定版本的 SHA-256 一致，結果即對應 App
        安裝的檔案。0.10.2 及更早版本則下載當時儲存庫裡的最新檔案。
      </li>
      <li>結果為未經潤稿的辨識輸出；Cohere Transcribe 未納入測試。</li>
      <li>這是 Airdraft 模型之間的比較，不是與其他聽寫 App 的比較。</li>
    </ul>
  </GuideSection>

  <GuideSection id="setup" title="設定方式">
    <ol class="guide-steps">
      <li>
        <h3>下載模型</h3>
        <p>
          在「模型」的「這台 Mac 上的語音」下載並選用 Qwen3-ASR 1.7B 或
          SenseVoice。模型只在你要求時下載，之後在本機執行。
        </p>
      </li>
      <li>
        <h3>選擇語言與字體</h3>
        <p>
          在「語音選項」把「語言」設為「自動偵測」或「中文（華語）」。「中文字體」預設跟隨
          Mac
          的第一個中文偏好語言（簡體中文系統為「简体中文」，其他為「繁體中文」），也可改選「繁體中文」、「简体中文」或「自動」；它只轉換字形、不改用詞，例如不會把「软件」改成「軟體」。
        </p>
      </li>
      <li>
        <h3>需要時開啟潤稿</h3>
        <p>
          潤稿保留中英混說、不會翻譯；輸出繁體時也會改用台灣用語。潤稿失敗或逾時，會直接貼上原始逐字稿。常用的人名與術語可加到「詞彙」。
        </p>
      </li>
    </ol>
    <div class="guide-actions">
      <Button href={href("/pricing/", locale)} icon="right">
        查看價格
      </Button>
      <Button
        href={href("/guides/dictate-to-claude-code-and-terminals/", locale)}
        variant="quiet"
        icon="right"
      >
        Claude Code 與終端機聽寫
      </Button>
    </div>
  </GuideSection>
</GuideLayout>
