---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import { licenses } from "../../../data/site";
import { href, type Locale } from "../../../i18n";

/**
 * A dated comparison with VoiceInk, Handy, Typeless and Apple Dictation.
 * Competitor facts come from each product's own pages and the sources listed
 * at the end, checked on the stated dates (vault: Research/Competitors).
 * Recheck every row and date before changing them. Unknown cells say so;
 * never fill them with assumptions, rankings or benchmark claims.
 */
const locale: Locale = "zh-tw";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "compare-mac-dictation-apps",
)!;
const zh = locale === "zh-tw";
const [oneMac, threeMacs] = licenses;

type Row = {
  name: string;
  price: string;
  /** Whether a visitor can download and try it today. */
  available: string;
  source: string;
  speech: string;
  cleanup: string;
  meetings: string;
  platforms: string;
};

const rows: Row[] = zh
  ? [
      {
        name: "Airdraft",
        price: `自行編譯免費；官方版一次買斷，一台 Mac US${oneMac.price}、三台 US${threeMacs.price}（尚未開賣）`,
        available: "否：官方版尚未開賣、未經公證；可用 Xcode 自行編譯",
        source: "開放原始碼（GPL-3.0）",
        speech: "在 Mac 上，或用自己金鑰的雲端服務",
        cleanup: "本機、自備金鑰的雲端，或透過 Claude Code、Codex 沿用訂閱",
        meetings: "錄 App 音訊與麥克風、匯入檔案、可選講者標籤、匯出 SRT／VTT",
        platforms: "Mac（Apple 晶片、macOS 15 以上）",
      },
      {
        name: "VoiceInk",
        price: "一次買斷：1／2／3 台 Mac 為 US$25／US$39／US$49；14 天退款",
        available: "可以：官網提供試用版下載（未載明試用天數）",
        source: "開放原始碼（GPL-3.0）",
        speech: "在 Mac 上，或用自己金鑰的雲端服務",
        cleanup: "可選供應商，含 Claude Code、Codex 等本機 CLI 範本",
        meetings:
          "可批次轉錄音訊與影片檔；記錄可存成 TXT 或 Markdown，並匯出 CSV",
        platforms: "Mac；另有 iOS App",
      },
      {
        name: "Handy",
        price: "免費，接受贊助",
        available: "可以：免費下載",
        source: "開放原始碼（MIT）",
        speech: "在裝置上執行，包括 Qwen3-ASR 0.6B、1.7B 與 SenseVoice Small",
        cleanup: "可選用後處理，在本機或透過你設定的 API",
        meetings: "未查核",
        platforms: "Mac、Windows、Linux",
      },
      {
        name: "Typeless",
        price: "免費版每週字數有限；Pro 每月 US$30 或每年 US$144",
        available: "可以：免費版可下載",
        source: "非開源",
        speech: "代管雲端服務",
        cleanup: "代管：個人字典、語氣與整理",
        meetings: "未查核",
        platforms: "Mac、Windows、Linux、iOS、Android",
      },
      {
        name: "Apple 聽寫（macOS 27）",
        price: "macOS 內建",
        available: "可以：macOS 內建",
        source: "非開源",
        speech: "系統內建；在裝置上或伺服器處理，視語言、設定與硬體而定",
        cleanup:
          "macOS 27 加入潤飾文字的聽寫；進階功能需要 M3 以上、12 GB 記憶體的 Mac",
        meetings: "未查核",
        platforms: "Apple 平台內建",
      },
    ]
  : [
      {
        name: "Airdraft",
        price: `Source build free; official app ${oneMac.price} for one Mac or ${threeMacs.price} for three, one-time, not on sale yet`,
        available:
          "No: the official app is not on sale or notarized; the source build needs Xcode",
        source: "Open source (GPL-3.0)",
        speech: "On your Mac, or cloud providers on your own key",
        cleanup:
          "Local, cloud on your own key, or Claude Code and Codex on your plan",
        meetings:
          "Records app audio and microphone; imports files; optional speaker labels; SRT and VTT export",
        platforms: "Mac (Apple silicon, macOS 15+)",
      },
      {
        name: "VoiceInk",
        price: "$25, $39 or $49 one-time for 1, 2 or 3 Macs; 14-day refund",
        available: "Yes: free trial download (trial length not stated)",
        source: "Open source (GPL-3.0)",
        speech: "On your Mac, or cloud providers on your own key",
        cleanup:
          "Provider of your choice, including local CLI templates for Claude Code and Codex",
        meetings:
          "Queues audio and video files for transcription; history saves TXT or Markdown and exports CSV",
        platforms: "Mac; separate iOS app",
      },
      {
        name: "Handy",
        price: "Free, with donations",
        available: "Yes: free download",
        source: "Open source (MIT)",
        speech:
          "On your device, including Qwen3-ASR 0.6B and 1.7B and SenseVoice Small",
        cleanup: "Optional post-processing, locally or through an API you set",
        meetings: "Not checked",
        platforms: "Mac, Windows, Linux",
      },
      {
        name: "Typeless",
        price: "Free with a weekly word limit; Pro $30 a month or $144 a year",
        available: "Yes: free plan download",
        source: "Closed source",
        speech: "Hosted cloud service",
        cleanup: "Hosted: personal dictionary, tone and cleanup",
        meetings: "Not checked",
        platforms: "Mac, Windows, Linux, iOS, Android",
      },
      {
        name: "Apple Dictation (macOS 27)",
        price: "Included with macOS",
        available: "Yes: built into macOS",
        source: "Closed source",
        speech:
          "Built in; on-device or server processing depends on language, settings and hardware",
        cleanup:
          "macOS 27 adds polished-text dictation; advanced features need an M3 or later Mac with 12 GB of memory",
        meetings: "Not checked",
        platforms: "Built into Apple platforms",
      },
    ];

const columns = zh
  ? [
      "產品",
      "價格",
      "現在能下載試用",
      "原始碼",
      "語音辨識",
      "文字整理",
      "會議與檔案",
      "平台",
    ]
  : [
      "Product",
      "Price",
      "Download and try today",
      "Source",
      "Speech recognition",
      "Text cleanup",
      "Meetings and files",
      "Platforms",
    ];

// Each source with the date its facts were checked.
// The cells after the product name, in column order.
const cells = (row: Row) => [
  row.price,
  row.available,
  row.source,
  row.speech,
  row.cleanup,
  row.meetings,
  row.platforms,
];

const sources = [
  {
    label: zh ? "VoiceInk 價格" : "VoiceInk pricing",
    url: "https://tryvoiceink.com/pricing",
    checked: "2026-10-21",
  },
  {
    label: zh ? "VoiceInk 原始碼" : "VoiceInk source",
    url: "https://github.com/Beingpax/VoiceInk",
    checked: "2026-10-21",
  },
  {
    label: zh ? "VoiceInk 本機 CLI 文件" : "VoiceInk local CLI documentation",
    url: "https://tryvoiceink.com/docs/local-cli",
    checked: "2026-10-21",
  },
  {
    label: zh ? "VoiceInk 檔案轉錄文件" : "VoiceInk file transcription",
    url: "https://tryvoiceink.com/docs/transcribe-audio-files",
    checked: "2026-10-21",
  },
  {
    label: zh ? "VoiceInk 原始碼：記錄存檔" : "VoiceInk source: history save",
    url: "https://github.com/Beingpax/VoiceInk/blob/main/VoiceInk/Features/History/Components/SaveIconButton.swift",
    checked: "2026-10-21",
  },
  {
    label: zh ? "VoiceInk 原始碼：CSV 匯出" : "VoiceInk source: CSV export",
    url: "https://github.com/Beingpax/VoiceInk/blob/main/VoiceInk/Features/History/Export/VoiceInkCSVExportService.swift",
    checked: "2026-10-21",
  },
  {
    label: "Handy",
    url: "https://handy.computer/",
    checked: "2026-10-21",
  },
  {
    label: zh ? "Handy 後處理文件" : "Handy post-processing",
    url: "https://handy.computer/docs/post-processing",
    checked: "2026-09-26",
  },
  {
    label: zh ? "Handy v0.9.8 發布" : "Handy v0.9.8 release",
    url: "https://github.com/cjpais/Handy/releases/tag/v0.9.8",
    checked: "2026-10-21",
  },
  {
    label: zh
      ? "Handy 原始碼：v0.9.8 的模型清單"
      : "Handy source: v0.9.8 model catalog",
    url: "https://github.com/cjpais/Handy/blob/v0.9.8/src-tauri/src/catalog/catalog.json",
    checked: "2026-10-24",
  },
  {
    label: zh ? "Typeless 價格" : "Typeless pricing",
    url: "https://www.typeless.com/pricing",
    checked: "2026-10-21",
  },
  {
    label: zh ? "Typeless 各平台版本紀錄" : "Typeless release notes",
    url: "https://www.typeless.com/help/release-notes",
    checked: "2026-09-26",
  },
  {
    label: zh
      ? "台灣繁體中文語音輸入評測（Taneverse）"
      : "Traditional Chinese voice input review (Taneverse)",
    url: "https://taneverse.com/posts/three-traditional-chinese-voice-input-methods/",
    checked: "2026-10-21",
  },
  {
    label: zh ? "Apple 聽寫說明" : "Apple Dictation help",
    url: "https://support.apple.com/guide/mac-help/use-dictation-mh40584/mac",
    checked: "2026-09-26",
  },
  {
    label: "Macworld: macOS 27",
    url: "https://www.macworld.com/article/3139330/macos-27-mac-features-siri-apple-intelligence-release-date-compatibility.html",
    checked: "2026-10-21",
  },
  {
    label: "9to5Mac: macOS 27",
    url: "https://9to5mac.com/2026/09/14/macos-27-golden-gate-now-available-here-is-everything-new/",
    checked: "2026-10-21",
  },
];
---

<GuideLayout guide={guide}>
  <GuideSection id="glance" title="一覽表">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="聽寫 App 比較表"
    >
      <table class="guide-table guide-table-wide" role="table">
        <caption>
          2026 年 10 月 21 日查核（Handy 語音模型為 10 月 24
          日）；「未查核」不代表沒有該功能
        </caption>
        <thead role="rowgroup">
          <tr role="row">
            {columns.map((column) => (
              <th scope="col" role="columnheader">
                {column}
              </th>
            ))}
          </tr>
        </thead>
        <tbody role="rowgroup">
          {rows.map((row) => (
            <tr role="row">
              <th scope="row" role="rowheader">
                {row.name}
              </th>
              {cells(row).map((cell, index) => (
                <td role="cell">
                  <span class="cell-label" aria-hidden="true">
                    {columns[index + 1]}
                  </span>
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </GuideSection>

  <GuideSection id="better" title="別人比較好的地方">
    <dl class="guide-decisions">
      <div>
        <dt>VoiceInk</dt>
        <dd>
          單台 Mac 較便宜（US$25 對 US$29），有兩台 Mac 方案、明列 14
          天退款，而且現在就買得到。它能批次轉錄多個檔案，Airdraft
          一次只處理一個；另有 iOS App。
        </dd>
      </div>
      <div>
        <dt>Handy</dt>
        <dd>
          完全免費、採 MIT 授權，也支援 Windows 與 Linux。社群規模大得多：2026
          年 10 月 21 日約有 34,200 個 GitHub 星號。v0.9.8
          也加入了中文字形選項。
        </dd>
      </div>
      <div>
        <dt>Typeless</dt>
        <dd>
          不必選模型或設定金鑰，手機與其他電腦也能用。台灣的繁體中文語音輸入評測常推薦它（例如
          Taneverse）。
        </dd>
      </div>
      <div>
        <dt>Apple 聽寫</dt>
        <dd>
          免費、免安裝，系統內建。macOS 27
          加入可潤飾文字的聽寫；是否支援中文，我們尚未查證。
        </dd>
      </div>
    </dl>
  </GuideSection>

  <GuideSection id="airdraft" title="Airdraft 的不同之處">
    <ul>
      <li>語音辨識和潤稿各自選本機或雲端，例如本機辨識加上雲端潤稿。</li>
      <li>
        提供本機中文模型（Qwen3-ASR、SenseVoice、FireRedASR2），可輸出繁體或簡體。從
        0.11.0 起，中文系統的首次設定推薦 Qwen3-ASR
        1.7B（「模型」頁標示「最適合中英夾雜」），SenseVoice
        則是較小、較快的選擇；記憶體 8 GB 以下的 Mac 優先推薦 SenseVoice，仍可選
        Qwen3-ASR 1.7B。Handy v0.9.8 的模型清單同樣有本機 Qwen3-ASR 0.6B、1.7B
        與 SenseVoice Small。見
        <a href={href("/guides/mixed-chinese-english-dictation/", locale)}>
          中英混說的模型測量
        </a>
        。
      </li>
      <li>
        可透過 Claude Code 或 Codex，沿用已付費的 Claude 或 ChatGPT
        訂閱潤稿，也能直接對終端機裡的程式助理聽寫。見{" "}
        <a href={href("/guides/dictate-to-claude-code-and-terminals/", locale)}>
          Claude Code 與終端機聽寫
        </a>
        。
      </li>
      <li>
        <a href={href("/guides/private-meeting-transcription/", locale)}>
          會議錄音與逐字稿
        </a>
        ：錄 App 音訊與麥克風、標出講者、匯出字幕。
      </li>
    </ul>
  </GuideSection>

  <GuideSection id="gaps" title="Airdraft 目前還缺什麼">
    <ul>
      <li>官方版尚未開賣，也還沒有經過公證的公開安裝檔。</li>
      <li>只支援 Mac，沒有手機版。</li>
      <li>選項多，第一次設定就得挑模型。</li>
      <li>
        目前公布的只有 Airdraft
        自己對本機模型的測量：中英混說，以及英、日、韓朗讀語音（各在一台 Mac
        上），沒有與其他 App 比較過準確度或速度。
      </li>
      <li>會議錄音沒有回音消除。</li>
    </ul>
    <div class="guide-actions">
      <Button href={href("/pricing/", locale)} icon="right">
        查看價格
      </Button>
    </div>
  </GuideSection>

  <GuideSection id="sources" title="來源與查核日期">
    <ul class="guide-sources">
      {sources.map((source) => (
        <li>
          <a href={source.url}>{source.label}</a>，查核於{" "}
          <time datetime={source.checked}>{source.checked}</time>
        </li>
      ))}
    </ul>
  </GuideSection>
</GuideLayout>
