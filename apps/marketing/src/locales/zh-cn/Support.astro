---
import GuideSection from "../../components/GuideSection.astro";
import Button from "../../components/ui/Button.astro";
import Disclosure from "../../components/ui/Disclosure.astro";
import { siteLinks } from "../../data/site";
import { localizedPath, type Locale } from "../../i18n";

const locale: Locale = "zh-cn";
---

<GuideSection id="problems" title="常见问题">
  <div class="question-list">
    <Disclosure summary="松开快捷键后什么都没出现">
      <p>
        Airdraft
        需要辅助功能权限才能插入文字。请在「系统设置」▸「隐私与安全性」▸「辅助功能」中开启。
      </p>
      <p>
        如果你用不同的签名重新编译了 App，之前授予的权限就不再适用。请运行{" "}
        <code>tccutil reset Accessibility com.lstudlo.app.airdraft</code>
        ，然后重新授权。
      </p>
    </Disclosure>
    <Disclosure summary="什么都没录到">
      <p>
        macOS
        询问时请允许使用麦克风。可以在窗口工具栏、菜单栏或「设置」▸「麦克风」中选择输入设备。
      </p>
    </Disclosure>
    <Disclosure summary="第一次听写要等一分钟">
      <p>
        模型下载后第一次运行时，会先为 Neural Engine
        编译。准备好之前，录音胶囊会显示「加载中」。
      </p>
    </Disclosure>
    <Disclosure summary="本机润色很慢">
      <p>
        推理模型在一行简单整理之前可能要思考 10 到 60
        秒。请在「模型」▸「润色」中把「思考强度」保持为「关闭」。
      </p>
    </Disclosure>
    <Disclosure summary="fn 键不能当快捷键">
      <p>
        在「系统设置」▸「键盘」中，把「按下 🌐
        键以」设为「不执行任何操作」。只用单个修饰键的快捷键也需要辅助功能权限。
      </p>
    </Disclosure>
    <Disclosure summary="中文输出成了另一种字形">
      <p>在「模型」▸「语音选项」▸「中文简繁体」中选择简体或繁体。</p>
    </Disclosure>
  </div>
</GuideSection>

<GuideSection aside id="report" title="还是没解决？">
  <p>请提交一个 issue，写明你的 macOS 版本，以及所用的语音识别和润色模型。</p>
  <div class="support-actions">
    <Button href={siteLinks.issues} icon="external">
      提交 Issue
    </Button>
    <Button
      href={localizedPath("/guides/offline-dictation-on-mac/", locale)}
      variant="quiet"
      icon="right"
    >
      本机设置指南
    </Button>
    <Button href={siteLinks.build} variant="quiet" icon="external">
      编译说明
    </Button>
  </div>
</GuideSection>
