---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import { localizedPath, type Locale } from "../../../i18n";
import { messages } from "../../../i18n/messages";
import { licenses, siteLinks } from "../../../data/site";

const locale: Locale = "zh-cn";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "free-source-or-official-app",
)!;
const onSale = Boolean(siteLinks.checkout);
const plans = messages[locale].license.plans;
---

<GuideLayout guide={guide}>
  <GuideSection id="availability" title="现在能拿到什么？">
    {onSale ? (
      <p>
        你可以从源代码自行编译 Airdraft，也可以在
        <a href={localizedPath("/pricing/", locale)}>价格页面</a>
        购买官方版许可证。
      </p>
    ) : (
      <p>
        <a href={siteLinks.build}>源代码编译</a>现在就能用。官方版尚未开售。
        现有的个人使用版安装包以 Apple Development
        签名，未经公证，不是正式支持的公开安装包。
      </p>
    )}
    <p>
      两种方式都需要 macOS 15 或更高版本、搭载 Apple 芯片的 Mac。Apple
      SpeechAnalyzer 和 Apple Intelligence 需要 macOS 26 或更高版本。
    </p>
  </GuideSection>

  <GuideSection id="compare" title="两种方式有什么不同？">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="比较源代码编译与官方版"
    >
      <table class="guide-table">
        <caption>源代码编译与官方版许可证</caption>
        <thead>
          <tr>
            <th scope="col">项目</th>
            <th scope="col">免费源代码编译</th>
            <th scope="col">官方版</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">价格</th>
            <td>$0</td>
            <td>
              {licenses
                .map((plan) => `${plans[plan.id].macs} ${plan.price}`)
                .join("；")}
              。一次付清，以美元计价，不含税。
            </td>
          </tr>
          <tr>
            <th scope="row">功能</th>
            <td>全部功能，没有锁定的等级。</td>
            <td>功能相同，下载即可使用。</td>
          </tr>
          <tr>
            <th scope="row">安装</th>
            <td>按代码仓库的说明用 Xcode 编译。</td>
            <td>不需要 Xcode，也不用编译。</td>
          </tr>
          <tr>
            <th scope="row">更新</th>
            <td>拉取源代码更新后重新编译。</td>
            <td>包含所购版本的更新。</td>
          </tr>
          <tr>
            <th scope="row">试用</th>
            <td>没有试用限制。</td>
            <td>14 天全功能试用，由你决定何时开始。</td>
          </tr>
        </tbody>
      </table>
    </div>
  </GuideSection>

  <GuideSection id="license" title="官方版是订阅制吗？">
    <p>
      不是。个人许可证一次买断，永不过期。两种方案的差别只在于同时可启用几台
      Mac。停用一台 Mac，就能把许可证转到另一台。
    </p>
    <p>
      源代码采用{" "}
      <a href={`${siteLinks.source}/blob/main/LICENSE`}>GPL-3.0-only</a>{" "}
      许可。代码仓库的许可协议适用于源代码；官方版的个人许可证则以购买条款为准。
    </p>
  </GuideSection>

  <GuideSection id="model-costs" title="模型还要另外付费吗？">
    <p>
      本机语音识别和润色没有 API
      费用。云端服务商会直接向你收费，与你用哪个版本无关。
    </p>
    <p>
      请看
      <a href={`${localizedPath("/pricing/", locale)}#provider-costs`}>
        附日期的费用比较与用量假设
      </a>
      ，或者选择
      <a href={localizedPath("/guides/offline-dictation-on-mac/", locale)}>
        本机设置
      </a>
      。
    </p>
    <div class="guide-actions">
      <Button href={siteLinks.build} icon="external">
        从源代码编译
      </Button>
      <Button
        href={localizedPath("/pricing/", locale)}
        variant="quiet"
        icon="right"
      >
        查看价格
      </Button>
    </div>
  </GuideSection>
</GuideLayout>
