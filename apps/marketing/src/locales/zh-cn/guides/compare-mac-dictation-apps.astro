---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import { licenses } from "../../../data/site";
import { href, type Locale } from "../../../i18n";

/**
 * A dated comparison with VoiceInk, Handy, Typeless and Apple Dictation.
 * Competitor facts come from each product's own pages and the sources listed
 * at the end, checked on the stated dates (vault: Research/Competitors).
 * Recheck every row and date before changing them. Unknown cells say so;
 * never fill them with assumptions, rankings or benchmark claims.
 */
const locale: Locale = "zh-cn";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "compare-mac-dictation-apps",
)!;
const [oneMac, threeMacs] = licenses;

type Row = {
  name: string;
  price: string;
  /** Whether a visitor can download and try it today. */
  available: string;
  source: string;
  speech: string;
  cleanup: string;
  meetings: string;
  platforms: string;
};

const rows: Row[] = [
  {
    name: "Airdraft",
    price: `自行编译免费；官方版一次买断，一台 Mac US${oneMac.price}、三台 US${threeMacs.price}（尚未开售）`,
    available: "否：官方版尚未开售、未经公证；可用 Xcode 自行编译",
    source: "开源（GPL-3.0）",
    speech: "在 Mac 上运行，或用你自己密钥的云端服务",
    cleanup: "本机、自备密钥的云端，或通过 Claude Code、Codex 沿用订阅套餐",
    meetings: "录制 App 音频和麦克风、导入文件、可选发言人标签、导出 SRT／VTT",
    platforms: "Mac（Apple 芯片、macOS 15 及以上）",
  },
  {
    name: "VoiceInk",
    price: "一次买断：1／2／3 台 Mac 为 US$25／US$39／US$49；14 天退款",
    available: "可以：官网提供试用版下载（未注明试用天数）",
    source: "开源（GPL-3.0）",
    speech: "在 Mac 上运行，或用你自己密钥的云端服务",
    cleanup: "可选服务商，含 Claude Code、Codex 等本机 CLI 模板",
    meetings:
      "可批量转录音频和视频文件；历史记录可存为 TXT 或 Markdown，并导出 CSV",
    platforms: "Mac；另有 iOS App",
  },
  {
    name: "Handy",
    price: "免费，接受捐助",
    available: "可以：免费下载",
    source: "开源（MIT）",
    speech: "在设备上运行，包括 Qwen3-ASR 0.6B、1.7B 和 SenseVoice Small",
    cleanup: "可选后处理，在本机或通过你设置的 API",
    meetings: "未核查",
    platforms: "Mac、Windows、Linux",
  },
  {
    name: "Typeless",
    price: "免费版每周字数有限；Pro 每月 US$30 或每年 US$144",
    available: "可以：免费版可下载",
    source: "闭源",
    speech: "托管的云端服务",
    cleanup: "托管：个人词典、语气和整理",
    meetings: "未核查",
    platforms: "Mac、Windows、Linux、iOS、Android",
  },
  {
    name: "Apple 听写（macOS 27）",
    price: "macOS 自带",
    available: "可以：macOS 自带",
    source: "闭源",
    speech: "系统自带；在设备上还是服务器上处理，取决于语言、设置和硬件",
    cleanup:
      "macOS 27 加入润色文字的听写；高级功能需要 M3 或更新、12 GB 内存的 Mac",
    meetings: "未核查",
    platforms: "Apple 平台自带",
  },
];

const columns = [
  "产品",
  "价格",
  "现在能下载试用",
  "源代码",
  "语音识别",
  "文字整理",
  "录音与文件转录",
  "平台",
];

// Each source with the date its facts were checked.
// The cells after the product name, in column order.
const cells = (row: Row) => [
  row.price,
  row.available,
  row.source,
  row.speech,
  row.cleanup,
  row.meetings,
  row.platforms,
];

const sources = [
  {
    label: "VoiceInk 价格",
    url: "https://tryvoiceink.com/pricing",
    checked: "2026-10-21",
  },
  {
    label: "VoiceInk 源代码",
    url: "https://github.com/Beingpax/VoiceInk",
    checked: "2026-10-21",
  },
  {
    label: "VoiceInk 本机 CLI 文档",
    url: "https://tryvoiceink.com/docs/local-cli",
    checked: "2026-10-21",
  },
  {
    label: "VoiceInk 文件转录文档",
    url: "https://tryvoiceink.com/docs/transcribe-audio-files",
    checked: "2026-10-21",
  },
  {
    label: "VoiceInk 源代码：历史记录保存",
    url: "https://github.com/Beingpax/VoiceInk/blob/main/VoiceInk/Features/History/Components/SaveIconButton.swift",
    checked: "2026-10-21",
  },
  {
    label: "VoiceInk 源代码：CSV 导出",
    url: "https://github.com/Beingpax/VoiceInk/blob/main/VoiceInk/Features/History/Export/VoiceInkCSVExportService.swift",
    checked: "2026-10-21",
  },
  {
    label: "Handy",
    url: "https://handy.computer/",
    checked: "2026-10-21",
  },
  {
    label: "Handy 后处理文档",
    url: "https://handy.computer/docs/post-processing",
    checked: "2026-09-26",
  },
  {
    label: "Handy v0.9.8 发布说明",
    url: "https://github.com/cjpais/Handy/releases/tag/v0.9.8",
    checked: "2026-10-21",
  },
  {
    label: "Handy 源代码：v0.9.8 的模型列表",
    url: "https://github.com/cjpais/Handy/blob/v0.9.8/src-tauri/src/catalog/catalog.json",
    checked: "2026-10-24",
  },
  {
    label: "Typeless 价格",
    url: "https://www.typeless.com/pricing",
    checked: "2026-10-21",
  },
  {
    label: "Typeless 版本更新记录",
    url: "https://www.typeless.com/help/release-notes",
    checked: "2026-09-26",
  },
  {
    label: "台湾繁体中文语音输入评测（Taneverse）",
    url: "https://taneverse.com/posts/three-traditional-chinese-voice-input-methods/",
    checked: "2026-10-21",
  },
  {
    label: "Apple 听写使用说明",
    url: "https://support.apple.com/guide/mac-help/use-dictation-mh40584/mac",
    checked: "2026-09-26",
  },
  {
    label: "Macworld: macOS 27",
    url: "https://www.macworld.com/article/3139330/macos-27-mac-features-siri-apple-intelligence-release-date-compatibility.html",
    checked: "2026-10-21",
  },
  {
    label: "9to5Mac: macOS 27",
    url: "https://9to5mac.com/2026/09/14/macos-27-golden-gate-now-available-here-is-everything-new/",
    checked: "2026-10-21",
  },
];
---

<GuideLayout guide={guide}>
  <GuideSection id="glance" title="一览表">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="听写 App 对比表"
    >
      <table class="guide-table guide-table-wide" role="table">
        <caption>
          2026 年 10 月 21 日核查（Handy 的语音模型为 10 月 24
          日）。「未核查」不代表没有该功能。
        </caption>
        <thead role="rowgroup">
          <tr role="row">
            {columns.map((column) => (
              <th scope="col" role="columnheader">
                {column}
              </th>
            ))}
          </tr>
        </thead>
        <tbody role="rowgroup">
          {rows.map((row) => (
            <tr role="row">
              <th scope="row" role="rowheader">
                {row.name}
              </th>
              {cells(row).map((cell, index) => (
                <td role="cell">
                  <span class="cell-label" aria-hidden="true">
                    {columns[index + 1]}
                  </span>
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </GuideSection>

  <GuideSection id="better" title="别人做得更好的地方">
    <dl class="guide-decisions">
      <div>
        <dt>VoiceInk</dt>
        <dd>
          单台 Mac 更便宜（US$25 对 US$29），有两台 Mac 的方案，明确提供 14
          天退款，而且现在就能买到。它可以批量转录多个文件，Airdraft
          一次只处理一个；另有 iOS App。
        </dd>
      </div>
      <div>
        <dt>Handy</dt>
        <dd>
          完全免费、采用 MIT 许可，也支持 Windows 和 Linux。社区规模大得多：2026
          年 10 月 21 日约有 34,200 个 GitHub 星标。v0.9.8
          还加入了中文简繁体选项。
        </dd>
      </div>
      <div>
        <dt>Typeless</dt>
        <dd>
          不用挑模型、不用设置密钥，手机和其他电脑上也能用。台湾的繁体中文语音输入评测常推荐它（例如
          Taneverse）。
        </dd>
      </div>
      <div>
        <dt>Apple 听写</dt>
        <dd>
          免费、无需安装，系统自带。macOS 27
          加入了可润色文字的听写；是否支持中文，我们尚未核实。
        </dd>
      </div>
    </dl>
  </GuideSection>

  <GuideSection id="airdraft" title="Airdraft 的不同之处">
    <ul>
      <li>
        语音识别和润色各自选择本机或云端，所以可以让音频留在本机，同时使用云端文字模型。
      </li>
      <li>
        提供本机中文模型（Qwen3-ASR、SenseVoice、FireRedASR2），可输出简体或繁体。从
        0.11.0 起，中文系统的首次设置推荐 Qwen3-ASR
        1.7B（「模型」页面标注「最适合中英混说」），SenseVoice
        是更小、更快的选择；内存 8 GB 及以下的 Mac 优先推荐 SenseVoice，仍可选
        Qwen3-ASR 1.7B。Handy v0.9.8 的模型列表同样提供本机 Qwen3-ASR 0.6B、1.7B
        和 SenseVoice Small。详见
        <a href={href("/guides/mixed-chinese-english-dictation/", locale)}>
          中英混说的模型测量
        </a>
        。
      </li>
      <li>
        可以通过 Claude Code 或 Codex，用你已付费的 Claude 或 ChatGPT
        套餐润色，也能直接对终端里的编程助手听写提示词。详见
        <a href={href("/guides/dictate-to-claude-code-and-terminals/", locale)}>
          在 Claude Code 和终端中听写
        </a>
        。
      </li>
      <li>
        「转录」页面可录制 App
        音频和麦克风或导入文件，标出发言人、生成摘要、导出字幕。详见
        <a href={href("/guides/private-meeting-transcription/", locale)}>
          会议转录指南
        </a>
        。
      </li>
    </ul>
  </GuideSection>

  <GuideSection id="gaps" title="Airdraft 目前还缺什么">
    <ul>
      <li>官方版尚未开售，也还没有经过公证的公开安装包。</li>
      <li>只支持 Mac，没有手机版。</li>
      <li>选项很多，第一次设置就得挑模型。</li>
      <li>
        目前公布的只有 Airdraft
        自己对本机模型的测试：中英混说，以及英语、日语、韩语朗读语音（各在一台
        Mac 上），没有与其他 App 比较过准确率或速度。
      </li>
      <li>「转录」页面的录音没有回声消除。</li>
    </ul>
    <div class="guide-actions">
      <Button href={href("/pricing/", locale)} icon="right">
        查看价格
      </Button>
    </div>
  </GuideSection>

  <GuideSection id="sources" title="来源与核查日期">
    <ul class="guide-sources">
      {sources.map((source) => (
        <li>
          <a href={source.url}>{source.label}</a>，核查于{" "}
          <time datetime={source.checked}>{source.checked}</time>
        </li>
      ))}
    </ul>
  </GuideSection>
</GuideLayout>
