---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import type { Locale } from "../../../i18n";
import { siteLinks } from "../../../data/site";
import {
  ejaAsrMetric,
  ejaAsrResults,
  ejaAsrStudy,
  type EjaAsrResult,
  type EjaError,
  type EjaLanguage,
} from "../../../data/eja-asr";

const locale: Locale = "zh-cn";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "offline-dictation-on-mac",
)!;
// English, Japanese and Korean results come from src/data/eja-asr.ts
// (eval/eja-asr in the repository), quoted as Airdraft's own measurement on
// one Mac with its method and limits. The SenseVoice rows come from the
// same-day follow-up of the original model; SenseVoice Cantonese is the
// fine-tune that 0.11.0 and earlier installed.
const study = ejaAsrStudy;
const languages = (
  [
    ["en", "English"],
    ["ja", "Japanese"],
    ["ko", "Korean"],
  ] as [EjaLanguage, string][]
).map(([code, name]) => ({
  code,
  name,
  unit:
    ejaAsrMetric[code] === "WER"
      ? "word error rate (WER)"
      : "character error rate (CER)",
}));
const columns = [
  "Model",
  "Errors, Detect Automatically",
  "Errors, language set",
  "Median time",
  "Download",
];
const rate = (error: EjaError) =>
  `${error.value.toFixed(1)}% (${error.ci[0].toFixed(1)}–${error.ci[1].toFixed(1)})`;
const about = (ms: number) => `${Math.round(ms / 10) * 10} ms`;
const [parakeet, qwen] = ["Parakeet TDT v2", "Qwen3-ASR 1.7B"].map((model) =>
  ejaAsrResults.en.find((row) => row.model === model)!,
);
const [senseVoice, cantonese] = ["SenseVoice", "SenseVoice Cantonese"].map(
  (model) =>
    (["en", "ja", "ko"] as EjaLanguage[]).map((code) =>
      ejaAsrResults[code].find((row) => row.model === model)!,
    ),
);
const autoRate = (row: EjaAsrResult) => `${row.auto.value.toFixed(1)}%`;
const cells = (row: EjaAsrResult) => [
  rate(row.auto),
  row.explicit ? rate(row.explicit) : "Not used by this model",
  `${row.medianMs} ms`,
  row.download,
];
---

<GuideLayout guide={guide}>
  <GuideSection id="requirements" title="What you need">
    <ul>
      <li>An Apple silicon Mac running macOS 15 or later.</li>
      <li>
        Airdraft installed, with Microphone and Accessibility permissions.
      </li>
      <li>An internet connection for the initial model downloads.</li>
    </ul>
    <p>
      Apple SpeechAnalyzer and Apple Intelligence need macOS 26 or later. Apple
      Intelligence also needs to be available on your Mac. Other local speech
      models do not require Apple Intelligence.
    </p>
    <p>
      Start with the <a href={siteLinks.build}>source build instructions</a>.
      The <a href="/pricing/">pricing page</a> lists current official-app
      availability.
    </p>
  </GuideSection>

  <GuideSection id="setup" title="Set up your first local dictation">
    <ol class="guide-steps">
      <li>
        <h3>Allow recording and text insertion</h3>
        <p>
          Grant Microphone when prompted. Enable Airdraft in System Settings →
          Privacy &amp; Security → Accessibility so it can insert text.
        </p>
      </li>
      <li>
        <h3>Download and select a local speech model</h3>
        <p>
          Open Models and choose a local model that supports your language.
          Airdraft downloads models only when you request them. An installed
          model loads automatically when you start dictating.
        </p>
      </li>
      <li>
        <h3>Choose local cleanup, or skip it</h3>
        <p>
          In Models → Refinement, choose Apple Intelligence on a supported
          system, or connect LM Studio or Ollama running locally on this Mac.
          For speech-to-text without AI cleanup, turn off Refine transcript for
          your active profile in Profiles.
        </p>
      </li>
      <li>
        <h3>Check the active profile</h3>
        <p>
          A profile can have its own speech model. In Profiles → Speech model,
          choose a local model or Use App Default to follow Models. A cloud
          speech binding would still send audio to that provider.
        </p>
      </li>
      <li>
        <h3>Hold, speak, release</h3>
        <p>
          Put your cursor in a text field. Hold Control + Option, speak, then
          release. Airdraft transcribes and refines after recording stops, then
          inserts the result. You can change the shortcut in Settings.
        </p>
      </li>
    </ol>
  </GuideSection>

  <GuideSection id="languages" title="Which model should I choose?">
    <p>
      Language support depends on the model. First-run setup recommends one from
      your Mac’s system language and memory, and for English, Japanese, Korean
      and Chinese offers one alternative:
    </p>
    <dl class="guide-decisions">
      <div>
        <dt>English: Parakeet TDT v2</dt>
        <dd>
          It recognizes English only. In Airdraft’s measurement its errors were
          within the margin of Qwen3-ASR 1.7B’s, and it was much faster. Setup
          offers Qwen3-ASR 1.7B as the alternative if you also speak other
          languages; it uses about 3 GB of memory.
        </dd>
      </div>
      <div>
        <dt>Japanese and Korean: Qwen3-ASR 1.7B</dt>
        <dd>
          Whisper Large v3 Turbo is the lower-memory alternative and comes first
          on a Mac with 8 GB of memory or less. Its first start can take a
          minute.
        </dd>
      </div>
      <div>
        <dt>Chinese: Qwen3-ASR 1.7B</dt>
        <dd>
          SenseVoice is the smaller, faster alternative and comes first on a Mac
          with 8 GB of memory or less. Airdraft’s{" "}
          <a href="/guides/mixed-chinese-english-dictation/">
            mixed-language measurements
          </a>{" "}
          show the trade-offs. Choose your output script under Models → Speech
          options → Chinese script.
        </dd>
      </div>
      <div>
        <dt>Other languages: Whisper Large v3 Turbo</dt>
        <dd>
          Parakeet TDT v3 supports English and 24 other European languages, but
          not Mandarin or Cantonese.
        </dd>
      </div>
    </dl>
    <p>
      0.11.0 and earlier recommended SenseVoice for English, Japanese and
      Korean, and 0.10.2 also suggested it on a Mac set to Chinese. Those
      versions installed a Cantonese fine-tune as SenseVoice. If you have it, it
      keeps working and Models lists it as SenseVoice Cantonese; a new
      SenseVoice download is the original multilingual model, which the Models
      page describes as “Small and fast. Weaker with English terms in Chinese
      speech.”
    </p>
    <p>
      Loading and transcription time vary with the model and your Mac; the
      homepage sample is an illustration, not a speed test.
    </p>
  </GuideSection>

  <GuideSection id="measured" title="Measured on English, Japanese and Korean">
    {languages.map((language) => (
      <div
        class="guide-table-scroll"
        tabindex="0"
        role="region"
        aria-label={`Local model results on ${language.name}`}
      >
        <table class="guide-table guide-table-wide" role="table">
          <caption>
            {language.name}, {language.unit}. Airdraft’s own measurement,{" "}
            {study.date}, on an Apple M4 Pro, refinement off. Lower is better;
            95% intervals in parentheses.
          </caption>
          <thead role="rowgroup">
            <tr role="row">
              {columns.map((column) => (
                <th scope="col" role="columnheader">
                  {column}
                </th>
              ))}
            </tr>
          </thead>
          <tbody role="rowgroup">
            {ejaAsrResults[language.code].map((row) => (
              <tr role="row">
                <th scope="row" role="rowheader">
                  {row.model}
                  {row.note && <span class="row-note">{row.note}</span>}
                </th>
                {cells(row).map((cell, index) => (
                  <td role="cell">
                    <span class="cell-label" aria-hidden="true">
                      {columns[index + 1]}
                    </span>
                    {cell}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
    <p>
      English counts word errors; Japanese and Korean count character errors,
      ignoring spaces. On English, Parakeet TDT v2 and Qwen3-ASR 1.7B are
      statistically tied, and Parakeet took about {about(parakeet.medianMs)} per
      clip instead of about {about(qwen.medianMs)}. On Japanese and Korean,
      Qwen3-ASR 1.7B and Whisper Large v3 Turbo overlap with Language set to
      Detect Automatically. Setting Language to Japanese or Korean lowered
      Qwen3-ASR 1.7B’s errors by 1.7 and 1.8 points.
    </p>
    <p>
      SenseVoice Cantonese, which 0.11.0 and earlier installed as SenseVoice,
      dropped every kana in all 60 Japanese clips and lost most of the text in
      50 of 60 Korean clips. The original SenseVoice that the app now installs
      made {autoRate(senseVoice[0])} word errors on English,{" "}
      {autoRate(senseVoice[1])} character errors on Japanese and{" "}
      {autoRate(senseVoice[2])} on Korean, against {autoRate(cantonese[0])},{" "}
      {autoRate(cantonese[1])} and {autoRate(cantonese[2])} for the fine-tune,
      with Language set to Detect Automatically. On Japanese and Korean it was
      within the margin of Qwen3-ASR 1.7B; setup still recommends Qwen3-ASR 1.7B
      and Whisper Large v3 Turbo for those languages. The{" "}
      <a href="/guides/mixed-chinese-english-dictation/">
        mixed Chinese and English guide
      </a>{" "}
      compares both SenseVoice models on mixed speech.
    </p>
    <p>
      Median time is transcription after loading, measured while the Mac was
      also running builds, so compare the models with each other only. Qwen3-ASR
      1.7B’s measured peak memory was about 3 GB, and SenseVoice’s about 0.9 GB.
      Parakeet TDT v2 and Whisper run through Core ML and keep part of their
      memory outside the app’s process, so their memory is not comparable.
      Download sizes are the totals the Models page lists, not measured
      transfers.
    </p>
    <h3>Limits of this measurement</h3>
    <ul>
      <li>
        The clips are {study.utterancesPerLanguage} read Wikipedia sentences per
        language from Google FLEURS, not dictation: longer sentences, many names
        and numbers, few hesitations. FLEURS publishes no speaker IDs.
      </li>
      <li>
        {study.utterancesPerLanguage} clips per language give wide intervals.
        Numbers and kana or kanji spellings are not normalized, and some Korean
        references contain bracketed glosses that nobody says.
      </li>
      <li>
        It ran on one M4 Pro with 48 GB. Macs with 8 GB of memory or less were
        not measured.
      </li>
      <li>
        The results are speech output without refinement, before the Chinese
        script conversion. In 0.11.0 and earlier the default Traditional script
        also converted kanji in Japanese text, such as 国 to 國, adding about 2
        points of errors; text that contains kana is now left unchanged.
      </li>
      <li>
        It compares Airdraft’s models with each other, not Airdraft with other
        dictation apps.
      </li>
    </ul>
    <p>
      Method, corpus selection and scripts:{" "}
      <a href={study.methodURL}>eval/eja-asr in the source repository</a>,
      measured at source commit {study.sourceCommit}. The original SenseVoice
      was measured on the same clips on {study.followup.date}, with a build
      based on {study.followup.sourceCommit}, after the app’s own download
      checked its size and SHA-256.
    </p>
  </GuideSection>

  <GuideSection id="offline-scope" title="What does offline cover?">
    <p>
      Local speech and local refinement do not need a cloud model to process
      your dictation. Initial downloads, app updates and official-app licensing
      are separate network activities. A custom endpoint on another computer is
      not processing on this Mac.
    </p>
    <p>
      Read{" "}
      <a href="/guides/local-vs-cloud-dictation/">
        what each model choice sends
      </a>{" "}
      before mixing local and cloud engines.
    </p>
    <div class="guide-actions">
      <Button href="/support/" icon="right">
        Troubleshoot Setup
      </Button>
      <Button href={siteLinks.build} variant="quiet" icon="external">
        Source Build Instructions
      </Button>
    </div>
  </GuideSection>
</GuideLayout>
