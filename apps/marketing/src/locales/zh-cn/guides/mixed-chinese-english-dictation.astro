---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import {
  mixedAsrFollowup,
  mixedAsrResults,
  mixedAsrStudy,
  type MixedAsrDelta,
} from "../../../data/mixed-asr";
import { href, type Locale } from "../../../i18n";

/**
 * Mixed Chinese–English dictation, in each language. The numbers come from
 * src/data/mixed-asr.ts (eval/mixed-asr in the repository) and are presented
 * as Airdraft's own measurement on one Mac, with its method and limits; the
 * SenseVoice row is the 2026-10-24 follow-up of the original model, and the
 * earlier row of the Cantonese fine-tune stays as dated history. App
 * behavior follows SpeechLanguagePolicy, ChineseScriptConverter, PromptBuilder
 * and the current onboarding recommendation (AD-083 for English, Japanese and
 * Korean); 0.11.0's and 0.10.2's recommendations are named only where they
 * differ. App labels in the zh-CN page are the app's
 * zh-Hans catalog values, quoted with 「」.
 */
const locale: Locale = "zh-cn";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "mixed-chinese-english-dictation",
)!;
const study = mixedAsrStudy;
const followup = mixedAsrFollowup;
const percent = (value: number) => `${value.toFixed(1)}%`;
const points = (value: number) => Math.abs(value).toFixed(1);
const signed = (value: number) =>
  `${value < 0 ? "−" : "+"}${Math.abs(value).toFixed(1)}`;
const interval = (delta: MixedAsrDelta) =>
  `95% 区间 ${signed(delta.ci[0])} 到 ${signed(delta.ci[1])}`;
const qwenGap = followup.qwenVsSenseVoice;
const tie = followup.originalVsCantonese;
const [qwenRow, senseVoiceRow, cantoneseRow] = [
  "Qwen3-ASR 1.7B",
  "SenseVoice",
  "SenseVoice Cantonese",
].map((model) => mixedAsrResults.find((row) => row.model === model)!);
// The follow-up's SenseVoice Cantonese rows equal AD-074's to three decimals,
// so the dated history row also serves the paired comparison.
// Sentences with several numbers are assembled here so the page's line
// breaks never put spaces inside the parentheses.
const qwenGapText = `Qwen3-ASR 1.7B 的错误比 SenseVoice 少（${percent(qwenRow.mer)} 对 ${percent(senseVoiceRow.mer)}，相差 ${signed(qwenGap.errors.points)} 个百分点，${interval(qwenGap.errors)}），英文词保留率高 ${points(qwenGap.englishKept.points)} 个百分点。`;
const caseText = `App 现在会把 SenseVoice 和 FireRedASR2 输出的全大写英文改回正常大小写，所以 ${study.followup.date} 那一行的英文大小写正确率更高；这是 App 的处理，不是模型本身的差异：同一次测量中，粤语微调版为 ${followup.cantoneseCaseKeptWithGuards}%。FireRedASR2 那一行是在这项改动之前测的。`;
const tieText = `真实语音 ${percent(senseVoiceRow.mer)} 对 ${percent(cantoneseRow.mer)}（${signed(tie.realErrors.points)} 个百分点，${interval(tie.realErrors)}），台湾用语句子 ${percent(senseVoiceRow.ttsMer)} 对 ${percent(cantoneseRow.ttsMer)}（${signed(tie.ttsErrors.points)} 个百分点，${interval(tie.ttsErrors)}）。`;
const columns = [
  "模型",
  "错误率（真实语音）",
  "英文词保留率",
  "错误率（台湾用语句子）",
  "英文大小写正确率",
  "转录时间中位数",
  "下载大小",
  "实测内存峰值",
];
const cells = (row: (typeof mixedAsrResults)[number]) => [
  percent(row.mer),
  `${row.englishKept}%`,
  percent(row.ttsMer),
  `${row.ttsCaseKept}%`,
  `${row.medianMs} ms`,
  row.download,
  row.memory ?? "无法比较",
];
---

<GuideLayout guide={guide}>
  <GuideSection id="choose" title="该选哪个模型？">
    <dl class="guide-decisions">
      <div>
        <dt>Qwen3-ASR 1.7B：大多数 16 GB 及以上的 Mac</dt>
        <dd>
          实测错误最少，保留的英文词更多且维持原本的大小写，还会加标点。下载
          2.44 GB，转录时内存峰值约 2.4 GB。
        </dd>
      </div>
      <div>
        <dt>SenseVoice：8 GB 的 Mac，或要同时运行本机润色模型时</dt>
        <dd>
          下载 163 MB，内存峰值约 0.9
          GB，速度最快；但英文词较弱：真实中英混说中保留了{" "}
          {senseVoiceRow.englishKept}% 的英文词，Qwen3-ASR 1.7B 为{" "}
          {qwenRow.englishKept}%。
        </dd>
      </div>
      <div>
        <dt>不推荐用于中英混说</dt>
        <dd>
          Whisper Large v3 Turbo：「语言」设为「自动检测」时，100
          句真实中英混说中有 5 句被翻译成英文；所有测试的 360 次首次尝试中，有 6
          次没有输出文字。Qwen3-ASR
          0.6B：在一段音质很差的音频上不断重复同一句话直到上限，内存峰值约 18.5
          GB。FireRedASR2：中文表现接近 Qwen3-ASR
          1.7B，但属于最慢的一批，内存占用也最大。Parakeet 不支持中文。
        </dd>
      </div>
    </dl>
  </GuideSection>

  <GuideSection id="app-recommendation" title="App 会推荐哪一个？">
    <p>
      系统语言为中文的 Mac，首次设置推荐 Qwen3-ASR 1.7B；内存 8 GB
      及以下时改为推荐 SenseVoice，仍可选 Qwen3-ASR 1.7B。英语推荐 Parakeet TDT
      v2，另提供支持多语言的 Qwen3-ASR 1.7B；日语和韩语推荐 Qwen3-ASR
      1.7B，另提供更省内存的 Whisper Large v3 Turbo（8 GB 及以下的 Mac
      优先推荐它）；其他语言推荐 Whisper Large v3 Turbo。「模型」页面给
      Qwen3-ASR 1.7B 标注「最适合中英混说」，并说明
      SenseVoice「小巧快速。中文夹杂英文词时较弱。」点按「下载」之前不会下载任何模型。
    </p>
    <p>
      0.11.0 及更早版本为英语、日语和韩语推荐 SenseVoice；0.10.2
      在中文系统上也建议使用 SenseVoice。这些版本以 SenseVoice
      名义安装的其实是粤语微调版：已安装的会继续工作，「模型」页面显示为
      SenseVoice Cantonese；新下载的 SenseVoice
      则是原始多语言模型。英语、日语和韩语的测量结果见
      <a href={href("/guides/offline-dictation-on-mac/#measured", locale)}>
        离线听写指南
      </a>
      。
    </p>
  </GuideSection>

  <GuideSection id="results" title="测量结果">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="中英混说本机模型测量结果"
    >
      <table class="guide-table guide-table-wide" role="table">
        <caption>
          Airdraft 自行测量，Apple M4 Pro，{study.date}（SenseVoice 为{" "}
          {study.followup.date}
          ）。「语言」设为「自动检测」，输出繁体中文，关闭润色。错误率越低越好。
        </caption>
        <thead role="rowgroup">
          <tr role="row">
            {columns.map((column) => (
              <th scope="col" role="columnheader">
                {column}
              </th>
            ))}
          </tr>
        </thead>
        <tbody role="rowgroup">
          {mixedAsrResults.map((row) => (
            <tr role="row">
              <th scope="row" role="rowheader">
                {row.model}
                {row.note && <span class="row-note">{row.note[locale]}</span>}
              </th>
              {cells(row).map((cell, index) => (
                <td role="cell">
                  <span class="cell-label" aria-hidden="true">
                    {columns[index + 1]}
                  </span>
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      错误率把参考文本中的每个汉字和每个英文词各算作一个单位，计算需要修改的比例。在真实中英混说上，
      {qwenGapText}台湾用语句子的结果方向一致。Qwen3-ASR 1.7B
      的「语言」设为「自动检测」或「中文（普通话）」，在真实语音上没有可分辨的差异。
    </p>
    <p>
      本指南 {study.date} 的 SenseVoice 数据，测的是 0.11.0 及更早版本以
      SenseVoice 名义安装的粤语微调版，也就是表中的 SenseVoice Cantonese。
      {study.followup.date}{" "}
      重新测量后，原始模型与粤语微调版在中英混说上没有可分辨的差异：
      {tieText}
      {caseText}
    </p>
    <p>
      转录时间是模型加载后，把每段 2.5 到 15
      秒的语音转成文字所用的时间；测量时这台 Mac
      同时在编译其他程序，数据只适合模型之间互相比较。Whisper 在 Neural Engine
      上运行，部分内存不在 App 的进程内，因此内存无法比较。
    </p>
    <p>
      下载大小取自「模型」页面，是各模型固定版本文件的总和（十进制单位），不是实测传输量。内存是转录时
      App 进程峰值的中位数；SenseVoice 的数据来自同一天的朗读语音测量。
    </p>
  </GuideSection>

  <GuideSection id="method" title="怎么测的">
    <ul>
      <li>
        每段语音都经过 App 自己的转录流程（Debug
        版本、独立测试数据），关闭润色和 App
        上下文，词汇表为空，输出默认的繁体中文。
      </li>
      <li>
        真实语音：取自 ASCEND 数据集（CAiRE，CC BY-SA 4.0）的{" "}
        {study.realUtterances}{" "}
        句中英混说对话，共五位来自香港和中国大陆的说话人。
      </li>
      <li>
        台湾用语：{study.ttsSentences}{" "}
        句台湾职场和开发者常说的句子，例如“我等一下把 PR merge 到 main
        branch”，由 macOS 的 zh_TW 美佳语音朗读。
      </li>
      <li>比较前统一字形、大小写和标点；英文大小写正确率单独计算。</li>
      <li>
        {study.followup.date} 用同样的流程重新测量 SenseVoice 和 SenseVoice
        Cantonese；原始模型通过 App 自带的下载功能安装，安装前会核对大小和
        SHA-256。
      </li>
    </ul>
    <p>
      完整方法、逐句结果和复现步骤见
      <a href={study.methodURL}>
        源代码仓库中的 eval/mixed-asr
      </a>，测量版本为 {study.sourceCommit}；SenseVoice 的后续测量基于{" "}
      {study.followup.sourceCommit}。
    </p>
  </GuideSection>

  <GuideSection id="limits" title="这次测量的局限">
    <ul>
      <li>
        真实语音只有五位说话人，都是香港和中国大陆口音的对话；台湾口音只用合成语音代替，音质干净、没有口头禅，英文发音标准。
      </li>
      <li>
        只在一台 M4 Pro（48 GB）上测量，没有测试低配 Mac；Qwen3-ASR 在 GPU
        较弱的 Mac 上会明显变慢。
      </li>
      <li>
        Airdraft 从 Hugging Face 的固定版本下载 Qwen3-ASR 和
        Whisper，安装前逐一核对文件大小和
        SHA-256。测量所用的模型文件与这些固定版本的 SHA-256 一致，因此结果对应
        App 安装的文件。0.10.2 及更早版本下载的是当时仓库里的最新文件。
      </li>
      <li>结果是未经润色的识别输出；Cohere Transcribe 未纳入测试。</li>
      <li>这是 Airdraft 内各模型之间的比较，不是与其他听写 App 的比较。</li>
    </ul>
  </GuideSection>

  <GuideSection id="setup" title="怎么设置">
    <ol class="guide-steps">
      <li>
        <h3>下载模型</h3>
        <p>
          在「模型」的「这台 Mac 上的语音」中下载并选用 Qwen3-ASR 1.7B 或
          SenseVoice。模型只在你要求时下载，之后在本机运行。
        </p>
      </li>
      <li>
        <h3>选择语言和简繁体</h3>
        <p>
          在「语音选项」中把「语言」设为「自动检测」或「中文（普通话）」。「中文简繁体」默认跟随系统首选的中文（简体中文系统为「简体中文」），也可以选「繁體中文」或「自动」；它只转换字形，不改用词，例如不会把“软件”改成“軟體”。
        </p>
      </li>
      <li>
        <h3>需要时开启润色</h3>
        <p>
          润色会保留中英混说，不会翻译；输出繁体时还会改用台湾用语。润色失败或超时，会直接粘贴原始转录文本。常用的人名和术语可以加到「词汇」。
        </p>
      </li>
    </ol>
    <div class="guide-actions">
      <Button href={href("/pricing/", locale)} icon="right">
        查看价格
      </Button>
      <Button
        href={href("/guides/dictate-to-claude-code-and-terminals/", locale)}
        variant="quiet"
        icon="right"
      >
        在 Claude Code 和终端中听写
      </Button>
    </div>
  </GuideSection>
</GuideLayout>
