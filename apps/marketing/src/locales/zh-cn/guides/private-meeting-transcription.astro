---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import { href, type Locale } from "../../../i18n";

/**
 * Private meeting transcription, in each language. Every statement follows
 * docs/meeting-recording.md and docs/media-transcription.md. Button and
 * setting names are the app's own in the page's language: the zh-Hans values
 * in its string catalogs, quoted with 「」. Keep every language aligned.
 */
const locale: Locale = "zh-cn";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "private-meeting-transcription",
)!;
---

<GuideLayout guide={guide}>
  <GuideSection id="requirements" title="需要准备什么？">
    <ul>
      <li>搭载 Apple 芯片、macOS 15 或更高版本的 Mac。</li>
      <li>
        录制会议需要「录屏与系统录音」权限；只有开启「包含麦克风」时才会请求麦克风权限。
      </li>
      <li>已安装的本机语音模型，或用于云端转录的 Soniox API 密钥。</li>
      <li>Airdraft 没有回声消除；麦克风可能收到扬声器的声音时，请戴耳机。</li>
    </ul>
  </GuideSection>

  <GuideSection id="record" title="录制会议">
    <ol class="guide-steps">
      <li>
        <h3>打开「录制会议」</h3>
        <p>在「会议」页面点按「录制会议」，也可以从菜单栏打开同样的流程。</p>
      </li>
      <li>
        <h3>选择录什么</h3>
        <p>
          「App 音频」可选「所有 App」或某个正在运行的
          App；选择浏览器会录下它的全部声音。「包含麦克风」使用侧边栏中选定的麦克风。只录声音，从不录画面。
        </p>
      </li>
      <li>
        <h3>开始录音，并告知所有人</h3>
        <p>
          点按「开始录音」，并让与会者知道你在录音。离开「会议」页面也会继续录；要结束时，在「会议」页面或菜单栏点按「停止并保存」。
        </p>
      </li>
      <li>
        <h3>先保存，再做别的</h3>
        <p>
          录音会带着日期和时长出现在列表中。此时还没有转录，也没有上传任何内容。
        </p>
      </li>
    </ol>
  </GuideSection>

  <GuideSection id="import" title="或者导入文件">
    <p>
      在「会议」页面点按「导入…」，或直接把文件拖进来。音频或视频最长两小时，且只能有一条音轨；多音轨文件请先导出需要的那一条。Airdraft
      会另存一份 16 kHz 副本，从不改动原始文件。
    </p>
  </GuideSection>

  <GuideSection id="transcribe" title="转录并标出发言人">
    <p>
      在录音上点按「转录…」，选择模型和语言；需要标签时开启「识别发言人」。发言人识别在你的
      Mac 上运行；第一次使用时，在同一个窗口中下载它的模型。
    </p>
    <ul>
      <li>
        发言人标签是估计结果，显示为「发言人 1」「发言人
        2」等，从不猜测人名；你可以改名或重新指定。重叠的说话声不会被分开。
      </li>
      <li>
        Whisper
        保留逐词时间，其他本机模型提供分段时间。转录中断后可以点按「继续」，从上次完成的分段接着处理。
      </li>
      <li>
        Parakeet 不支持中文。中文或中英混说，请选择支持的模型，例如 Qwen3-ASR。
      </li>
    </ul>
  </GuideSection>

  <GuideSection id="privacy" title="哪些会议数据会离开 Mac？">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="比较会议数据的去向"
    >
      <table class="guide-table">
        <caption>每个步骤发送的数据</caption>
        <thead>
          <tr>
            <th scope="col">步骤</th>
            <th scope="col">发送的内容</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">录音</th>
            <td>不发送，音频保存在这台 Mac 上。</td>
          </tr>
          <tr>
            <th scope="row">本机转录</th>
            <td>不发送，发言人识别也在本机运行。</td>
          </tr>
          <tr>
            <th scope="row">Soniox 转录</th>
            <td>
              点按「上传并转录」后，音频会使用你的 API 密钥上传到
              Soniox，可能产生费用；本机仍保留一份 WAV。
            </td>
          </tr>
          <tr>
            <th scope="row">生成摘要</th>
            <td>
              确认之后，转录文本会发送给你选择的润色服务商；使用本机润色则留在你的
              Mac 上。
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </GuideSection>

  <GuideSection id="export" title="编辑和导出">
    <p>
      你的修改与原文并存，可以在「已编辑」和「原始」之间切换；「复制」和「导出」使用当前显示的版本。可导出
      TXT、JSON、SRT 或
      VTT，字幕保留每段发言的时间和发言人。点选时间戳即可从那里播放录音。
    </p>
    <p>
      会议录音不受听写音频保留设置的影响，会一直保留到你删除音频为止；删除转录稿不会删除录音。
    </p>
  </GuideSection>

  <GuideSection id="limits" title="限制">
    <ul>
      <li>每段录音或文件最长两小时。</li>
      <li>开始录音需要约 2 GB 可用空间；连续 15 秒收不到音频时会停止录制。</li>
      <li>长文件的发言人识别需要足够的可用内存，开始前会先检查。</li>
      <li>
        Airdraft
        尚未公布会议转录或发言人标签的准确率测量，请用你自己的录音试一试。
      </li>
    </ul>
    <div class="guide-actions">
      <Button href={href("/pricing/", locale)} icon="right">
        查看价格
      </Button>
      <Button
        href={href("/guides/compare-mac-dictation-apps/", locale)}
        variant="quiet"
        icon="right"
      >
        与其他 App 比较
      </Button>
    </div>
  </GuideSection>
</GuideLayout>
