---
import GuideSection from "../../components/GuideSection.astro";
import Button from "../../components/ui/Button.astro";
import Disclosure from "../../components/ui/Disclosure.astro";
import { siteLinks } from "../../data/site";
import { localizedPath, type Locale } from "../../i18n";

const locale: Locale = "ja";
---

<GuideSection id="problems" title="よくある問題">
  <div class="question-list">
    <Disclosure summary="キーを離しても何も入力されない">
      <p>
        テキストを挿入するには、Airdraft
        にアクセシビリティの権限が必要です。「システム設定」▸「プライバシーとセキュリティ」▸「アクセシビリティ」でオンにしてください。
      </p>
      <p>
        別の署名でアプリをビルドし直した場合、以前の許可は適用されません。
        <code>tccutil reset Accessibility com.lstudlo.app.airdraft</code>
        を実行してから、もう一度許可してください。
      </p>
    </Disclosure>
    <Disclosure summary="何も録音されない">
      <p>
        macOS
        に確認されたらマイクを許可してください。入力はウインドウのツールバー、メニューバー、または「設定」▸「マイク」で選べます。
      </p>
    </Disclosure>
    <Disclosure summary="最初の音声入力に 1 分かかる">
      <p>
        モデルをダウンロードしたあとの初回の実行では、Neural Engine
        向けにモデルがコンパイルされます。準備ができるまで、録音ウインドウには「読み込み中」と表示されます。
      </p>
    </Disclosure>
    <Disclosure summary="ローカルの整形が遅い">
      <p>
        推論モデルは、1 行の整形の前に 10〜60
        秒考えることがあります。「モデル」▸「整形」の「推論の強度」は「オフ」のままにしてください。
      </p>
    </Disclosure>
    <Disclosure summary="fn キーがショートカットとして使えない">
      <p>
        「システム設定」▸「キーボード」▸「🌐キーを押して」を「何もしない」にしてください。修飾キーひとつだけのショートカットにも、アクセシビリティの権限が必要です。
      </p>
    </Disclosure>
    <Disclosure summary="中国語が意図しない表記で出力される">
      <p>
        「モデル」▸「音声のオプション」▸「中国語の表記」で表記を選んでください。
      </p>
    </Disclosure>
  </div>
</GuideSection>

<GuideSection id="report" title="それでも解決しない場合">
  <p>
    macOS のバージョンと、使っている音声モデルと整形のモデルを添えて、Issue
    を作成してください。
  </p>
  <div class="support-actions">
    <Button href={siteLinks.issues} icon="external">
      Issue を作成
    </Button>
    <Button
      href={localizedPath("/guides/offline-dictation-on-mac/", locale)}
      variant="quiet"
      icon="right"
    >
      ローカル設定ガイド
    </Button>
    <Button href={siteLinks.build} variant="quiet" icon="external">
      ビルド手順
    </Button>
  </div>
</GuideSection>
