---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import {
  mixedAsrFollowup,
  mixedAsrResults,
  mixedAsrStudy,
  type MixedAsrDelta,
} from "../../../data/mixed-asr";
import { href, type Locale } from "../../../i18n";

/**
 * Mixed Chinese–English dictation, in each language. The numbers come from
 * src/data/mixed-asr.ts (eval/mixed-asr in the repository) and are presented
 * as Airdraft's own measurement on one Mac, with its method and limits; the
 * SenseVoice row is the 2026-10-24 follow-up of the original model, and the
 * earlier row of the Cantonese fine-tune stays as dated history. App
 * behavior follows SpeechLanguagePolicy, ChineseScriptConverter, PromptBuilder
 * and the current onboarding recommendation (AD-083 for English, Japanese and
 * Korean); 0.11.0's and 0.10.2's recommendations are named only where they
 * differ. App labels are the app's ja catalog values,
 * quoted with 「」.
 */
const locale: Locale = "ja";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "mixed-chinese-english-dictation",
)!;
const study = mixedAsrStudy;
const followup = mixedAsrFollowup;
const percent = (value: number) => `${value.toFixed(1)}%`;
const points = (value: number) => Math.abs(value).toFixed(1);
const signed = (value: number) =>
  `${value < 0 ? "−" : "+"}${Math.abs(value).toFixed(1)}`;
const interval = (delta: MixedAsrDelta) =>
  `95% 区間 ${signed(delta.ci[0])}〜${signed(delta.ci[1])}`;
const qwenGap = followup.qwenVsSenseVoice;
const tie = followup.originalVsCantonese;
const [qwenRow, senseVoiceRow, cantoneseRow] = [
  "Qwen3-ASR 1.7B",
  "SenseVoice",
  "SenseVoice Cantonese",
].map((model) => mixedAsrResults.find((row) => row.model === model)!);
// The follow-up's SenseVoice Cantonese rows equal AD-074's to three decimals,
// so the dated history row also serves the paired comparison.
// Sentences with several numbers are assembled here so the page's line
// breaks never put spaces inside the parentheses.
const qwenGapText = `Qwen3-ASR 1.7B は SenseVoice より誤りが少なく（${percent(qwenRow.mer)} 対 ${percent(senseVoiceRow.mer)}、差は ${signed(qwenGap.errors.points)} ポイント、${interval(qwenGap.errors)}）、英単語を ${points(qwenGap.englishKept.points)} ポイント多く残しました。`;
const caseText = `現在のアプリは SenseVoice と FireRedASR2 がすべて大文字で出力した英語を通常の大文字・小文字に戻すため、${study.followup.date} の行では元の大文字・小文字のまま残る英語が多くなっています。これはモデルではなくアプリによる違いで、同じ計測でファインチューニング版は ${followup.cantoneseCaseKeptWithGuards}% でした。FireRedASR2 の行はこの変更より前の計測です。`;
const tieText = `実際の発話では ${percent(senseVoiceRow.mer)} 対 ${percent(cantoneseRow.mer)}（${signed(tie.realErrors.points)} ポイント、${interval(tie.realErrors)}）、台湾式の文では ${percent(senseVoiceRow.ttsMer)} 対 ${percent(cantoneseRow.ttsMer)}（${signed(tie.ttsErrors.points)} ポイント、${interval(tie.ttsErrors)}）でした。`;
const captionText = `Apple M4 Pro での Airdraft 独自の計測。${study.date}、SenseVoice は ${study.followup.date}。「言語」は「自動検出」、表記は繁体字、整形はオフ。誤り率は低いほど良い結果です。`;
const retestText = `${study.followup.date} に計測し直したところ、混在した発話では元のモデルとファインチューニング版は統計的に同等でした。`;
const keptText = `英語の用語には弱く、実際の混在発話で残せた英単語は ${senseVoiceRow.englishKept}% で、Qwen3-ASR 1.7B は ${qwenRow.englishKept}% でした。`;
const columns = [
  "モデル",
  "誤り率（実際の混在発話）",
  "英単語の保持率",
  "誤り率（台湾式の文）",
  "英語の大文字・小文字の保持率",
  "時間の中央値",
  "ダウンロード",
  "計測したピークメモリ",
];
const cells = (row: (typeof mixedAsrResults)[number]) => [
  percent(row.mer),
  `${row.englishKept}%`,
  percent(row.ttsMer),
  `${row.ttsCaseKept}%`,
  `${row.medianMs} ms`,
  row.download,
  row.memory ?? "比較できません",
];
---

<GuideLayout guide={guide}>
  <GuideSection id="choose" title="どのモデルを選べばいいですか？">
    <dl class="guide-decisions">
      <div>
        <dt>Qwen3-ASR 1.7B：メモリ 16 GB 以上のほとんどの Mac</dt>
        <dd>
          今回の計測で誤りが最も少なく、英語の用語を元の大文字・小文字のまま多く残し、句読点も付けます。ダウンロードは
          2.44 GB で、文字起こし中に計測したピークメモリは約 2.4 GB でした。
        </dd>
      </div>
      <div>
        <dt>
          SenseVoice：メモリ 8 GB の
          Mac、またはローカルの整形モデルと併用する場合
        </dt>
        <dd>
          ダウンロードは 163 MB、計測したピークメモリは約 0.9 GB
          で、最も高速でした。{keptText}
        </dd>
      </div>
      <div>
        <dt>混在した発話にはおすすめしません</dt>
        <dd>
          「言語」が「自動検出」のとき、Whisper Large v3 Turbo は実際の混在文
          100 件中 5 件を英語に翻訳し、すべての実行を通して初回の試行 360 回中 6
          回でテキストを返しませんでした。Qwen3-ASR 0.6B は音質の悪いクリップ 1
          件で同じフレーズを上限まで繰り返し、メモリは最大で約 18.5 GB
          に達しました。FireRedASR2 は中国語では Qwen3-ASR 1.7B
          に近いものの、最も遅い部類で、メモリの使用量も最大でした。Parakeet
          は中国語に対応していません。
        </dd>
      </div>
    </dl>
  </GuideSection>

  <GuideSection id="app-recommendation" title="アプリは何を勧めますか？">
    <p>
      初回設定では、中国語に設定した Mac に Qwen3-ASR 1.7B を勧めます。メモリが
      8 GB 以下の Mac では SenseVoice を勧め、Qwen3-ASR 1.7B
      も候補として示します。英語には Parakeet TDT v2 を勧め、多言語の候補として
      Qwen3-ASR 1.7B を示します。日本語と韓国語には Qwen3-ASR 1.7B
      を勧め、メモリが少なくて済む候補として Whisper Large v3 Turbo
      を示します。メモリが 8 GB 以下の Mac
      ではこちらが先です。そのほかの言語には Whisper Large v3 Turbo
      を勧めます。「モデル」ページでは Qwen3-ASR 1.7B
      に「中国語と英語の混在に最適」と表示され、SenseVoice
      は「小さく高速。中国語に混ざる英単語は苦手です。」と説明されています。「ダウンロード」をクリックするまで、何もダウンロードされません。
    </p>
    <p>
      0.11.0 以前は英語、日本語、韓国語に SenseVoice を勧め、0.10.2
      では中国語に設定した Mac にも勧めていました。これらのバージョンが
      SenseVoice
      としてインストールしていたのは、広東語向けのファインチューニング版です。お持ちの場合はそのまま使え、「モデル」では
      SenseVoice Cantonese と表示されます。新しくダウンロードする SenseVoice
      は元の多言語モデルです。Airdraft による
      <a href={href("/guides/offline-dictation-on-mac/#measured", locale)}>
        英語、日本語、韓国語の計測
      </a>
      は、オフライン設定ガイドにあります。
    </p>
  </GuideSection>

  <GuideSection id="results" title="計測結果">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="中国語と英語の混在でのローカルモデルの結果"
    >
      <table class="guide-table guide-table-wide" role="table">
        <caption>{captionText}</caption>
        <thead role="rowgroup">
          <tr role="row">
            {columns.map((column) => (
              <th scope="col" role="columnheader">
                {column}
              </th>
            ))}
          </tr>
        </thead>
        <tbody role="rowgroup">
          {mixedAsrResults.map((row) => (
            <tr role="row">
              <th scope="row" role="rowheader">
                {row.model}
                {row.note && <span class="row-note">{row.note[locale]}</span>}
              </th>
              {cells(row).map((cell, index) => (
                <td role="cell">
                  <span class="cell-label" aria-hidden="true">
                    {columns[index + 1]}
                  </span>
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      誤り率は、正解テキストの中国語 1 文字と英単語 1 語をそれぞれ 1
      単位として、修正が必要だった割合を計測したものです。実際の混在発話では、
      {qwenGapText}台湾式の文でも同じ傾向でした。Qwen3-ASR 1.7B
      では、「言語」を「自動検出」にしても「標準中国語」にしても、実際の発話で計測できるほどの差はありませんでした。
    </p>
    <p>
      0.11.0 以前は SenseVoice
      という名前で広東語向けのファインチューニング版をインストールしており、このガイドの
      {study.date} の SenseVoice の数値はそのモデルのもの、つまり SenseVoice
      Cantonese の行です。{retestText}
      {tieText}
      {caseText}
    </p>
    <p>
      時間の中央値は、2.5〜15
      秒のクリップを読み込み後に文字起こしした時間で、Mac
      がビルドも実行している間に計測したため、モデル同士の比較にだけ使ってください。Whisper
      は Neural Engine
      で動作し、メモリの一部をアプリのプロセスの外に置くため、メモリは比較できません。
    </p>
    <p>
      ダウンロードサイズは、「モデル」ページに表示される各モデルの固定ファイルの合計（10
      進単位）で、実際の転送量を計測したものではありません。メモリは文字起こし中のアプリのプロセスのピークの中央値です。SenseVoice
      の値は、同じ日の読み上げ音声での実行から取っています。
    </p>
  </GuideSection>

  <GuideSection id="method" title="計測の方法">
    <ul>
      <li>
        各クリップは、アプリ自身の文字起こしパイプライン（データを分離した Debug
        ビルド）で処理しました。整形とアプリのコンテキストはオフ、語彙は空、表記はデフォルトの繁体字です。
      </li>
      <li>
        実際の発話：ASCEND データセット（CAiRE、CC BY-SA 4.0）の会話の混在文
        {study.realUtterances} 件。話者は香港と中国本土の 5 人です。
      </li>
      <li>
        台湾式：「我等一下把 PR merge 到 main branch」のような職場や開発者の文
        {study.ttsSentences} 件を、macOS の zh_TW の Meijia
        の声で読み上げました。
      </li>
      <li>
        比較の前に表記、大文字・小文字、句読点を正規化し、元の大文字・小文字のまま残った英単語の割合は別に数えました。
      </li>
      <li>
        {study.followup.date} に、SenseVoice と SenseVoice Cantonese
        を同じパイプラインで計測し直しました。元のモデルは、サイズと SHA-256
        を確認するアプリ自身のダウンロードでインストールしました。
      </li>
    </ul>
    <p>
      方法の全体、文ごとの結果、再現の手順は
      <a href={study.methodURL}>ソースリポジトリの eval/mixed-asr</a>
      にあります。ソースのコミット {study.sourceCommit} で計測し、SenseVoice
      の追加計測には {study.followup.sourceCommit}{" "}
      をもとにしたビルドを使いました。
    </p>
  </GuideSection>

  <GuideSection id="limits" title="この計測の限界">
    <ul>
      <li>
        実際の発話は、香港と中国本土のなまりがある 5
        人の会話です。台湾のなまりは合成音声でしか扱っておらず、その音声はクリアで、言いよどみがなく、英語の発音も教科書どおりです。
      </li>
      <li>
        計測はメモリ 48 GB の M4 Pro 1 台で行いました。下位の Mac
        は計測しておらず、GPU が小さい Mac では Qwen3-ASR
        の処理がはっきり遅くなります。
      </li>
      <li>
        Airdraft は Qwen3-ASR と Whisper を Hugging Face
        の固定されたリビジョンからダウンロードし、インストールする前にすべてのファイルのサイズと
        SHA-256 を確認します。計測したモデルファイルの SHA-256
        は同じなので、結果はアプリがインストールするファイルに当てはまります。0.10.2
        以前は、その時点でリポジトリにあったファイルをダウンロードしていました。
      </li>
      <li>
        結果は整形前の音声認識の出力です。Cohere Transcribe
        はテストしていません。
      </li>
      <li>
        比較しているのは Airdraft のモデル同士で、Airdraft
        とほかの音声入力アプリではありません。
      </li>
    </ul>
  </GuideSection>

  <GuideSection id="setup" title="設定する">
    <ol class="guide-steps">
      <li>
        <h3>モデルをダウンロードする</h3>
        <p>
          「モデル」→「この Mac での音声認識」で、Qwen3-ASR 1.7B または
          SenseVoice
          をダウンロードして選びます。モデルは操作したときだけダウンロードされ、Mac
          上で動作します。
        </p>
      </li>
      <li>
        <h3>言語と表記を選ぶ</h3>
        <p>
          「音声のオプション」で「言語」を「自動検出」または「標準中国語」にします。「中国語の表記」は、未設定のときは
          Mac の優先する言語のうち最初の中国語に従います（zh-CN
          なら简体中文、それ以外は繁體中文、中国語が一覧にないときは「自動」）。简体中文（簡体字）、繁體中文（繁体字）、「自動」から選べます。変換するのは文字だけなので、软件
          を 軟體 にするような語の選び方は変わりません。
        </p>
      </li>
      <li>
        <h3>必要なら整形をオンにする</h3>
        <p>
          整形は中国語と英語が混ざった文を混ざったまま残し、翻訳はしません。繁体字では台湾の語彙も使います。整形が失敗したりタイムアウトしたりした場合は、元の文字起こしが入力されます。よく使う名前や用語は「語彙」に追加してください。
        </p>
      </li>
    </ol>
    <div class="guide-actions">
      <Button href={href("/pricing/", locale)} icon="right">
        価格を見る
      </Button>
      <Button
        href={href("/guides/dictate-to-claude-code-and-terminals/", locale)}
        variant="quiet"
        icon="right"
      >
        Claude Code やターミナルに音声入力する
      </Button>
    </div>
  </GuideSection>
</GuideLayout>
