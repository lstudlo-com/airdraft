---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import { href, type Locale } from "../../../i18n";

/**
 * Private meeting transcription, in each language. Every statement follows
 * docs/meeting-recording.md and docs/media-transcription.md. Button and
 * setting names are the app's own in the page's language: the ja values in
 * its string catalogs, quoted with 「」.
 */
const locale: Locale = "ja";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "private-meeting-transcription",
)!;
---

<GuideLayout guide={guide}>
  <GuideSection id="requirements" title="必要なものは？">
    <ul>
      <li>macOS 15 以降を搭載した Apple シリコンの Mac。</li>
      <li>
        会議を録音するための「画面とシステムオーディオ収録」の権限。マイクへのアクセスは、マイクを含めるときだけ求められます。
      </li>
      <li>
        インストール済みのローカル音声モデル、またはクラウドで文字起こしする場合は
        Soniox の API キー。
      </li>
      <li>
        マイクがスピーカーの音を拾う可能性がある場合はヘッドフォン。エコーキャンセルはありません。
      </li>
    </ul>
  </GuideSection>

  <GuideSection id="record" title="会議を録音する">
    <ol class="guide-steps">
      <li>
        <h3>「会議を録音」を開く</h3>
        <p>
          「会議」ページで「会議を録音」を選びます。メニューバーからも同じ手順を開けます。
        </p>
      </li>
      <li>
        <h3>録音する音声を選ぶ</h3>
        <p>
          「アプリの音声」で「すべてのアプリ」か、実行中のアプリをひとつ選びます。ブラウザを選ぶと、そのすべての音声が含まれます。「マイクを含める」では、サイドバーで選んだマイクを使います。取り込むのは音声だけで、画面の映像は記録しません。
        </p>
      </li>
      <li>
        <h3>開始して、参加者に伝える</h3>
        <p>
          「録音を開始」を選び、録音していることを参加者に伝えます。「会議」ページを離れても録音は続きます。止めるには「会議」ページかメニューバーで「停止して保存」を選びます。
        </p>
      </li>
      <li>
        <h3>まず保存される</h3>
        <p>
          録音は日付と長さとともに表示されます。この時点では、まだ文字起こしもアップロードもされていません。
        </p>
      </li>
    </ol>
  </GuideSection>

  <GuideSection id="import" title="ファイルを読み込む">
    <p>
      「会議」で「読み込む…」を選ぶか、ファイルをドロップします。音声と動画のファイルは最長
      2
      時間で、音声トラックがちょうどひとつのものに限ります。複数のトラックがあるファイルは、先に必要なトラックを書き出してください。Airdraft
      は 16 kHz のコピーを保存し、元のファイルは変更しません。
    </p>
  </GuideSection>

  <GuideSection id="transcribe" title="話者つきで文字起こしする">
    <p>
      録音で「文字起こし…」を選び、モデルと言語を選びます。ラベルが必要なら「話者を識別」をオンにします。話者の識別は
      Mac
      上で行われます。初回は同じシートから話者モデルをダウンロードしてください。
    </p>
    <ul>
      <li>
        話者ラベルは推定で、「話者 1」「話者
        2」のように表示され、名前を推測することはありません。名前の変更や割り当て直しができます。重なった声は分離しません。
      </li>
      <li>
        Whisper
        は単語ごとのタイミングを残し、ほかのローカルモデルは区間ごとのタイミングを出します。中断した文字起こしは、最後に完了した区間から「再開」できます。
      </li>
      <li>
        Parakeet
        は中国語に対応していません。中国語や、中国語と英語が混ざる会議には、Qwen3-ASR
        など対応しているモデルを選んでください。
      </li>
    </ul>
  </GuideSection>

  <GuideSection id="privacy" title="Mac の外に出るものは？">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="会議のデータの送信先の比較"
    >
      <table class="guide-table">
        <caption>各ステップで送信されるデータ</caption>
        <thead>
          <tr>
            <th scope="col">ステップ</th>
            <th scope="col">送信される内容</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">録音</th>
            <td>なし。音声はこの Mac に保存されます。</td>
          </tr>
          <tr>
            <th scope="row">ローカルでの文字起こし</th>
            <td>なし。話者の識別もローカルで行われます。</td>
          </tr>
          <tr>
            <th scope="row">Soniox での文字起こし</th>
            <td>
              「アップロードして文字起こし」を選ぶと、音声がお使いの API キーで
              Soniox に送られ、料金がかかることがあります。ローカルの WAV
              は残ります。
            </td>
          </tr>
          <tr>
            <th scope="row">要約</th>
            <td>
              確認すると、文字起こしが選択中の整形のプロバイダに送られます。ローカルの整形なら
              Mac の外には出ません。
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </GuideSection>

  <GuideSection id="export" title="編集して書き出す">
    <p>
      編集した内容は元の内容と並べて保存されます。「編集済み」と「元の内容」を切り替えられ、「コピー」と「書き出す」は表示中のほうを使います。TXT、JSON、SRT、VTT
      で書き出せ、字幕には発言ごとの時刻と話者が残ります。タイムスタンプを選ぶと、そこから録音を再生できます。
    </p>
    <p>
      会議の録音は音声入力の音声の保存設定とは関係なく、音声を削除するまで残ります。文字起こしを削除しても録音は残ります。
    </p>
  </GuideSection>

  <GuideSection id="limits" title="制限">
    <ul>
      <li>録音やファイルは、それぞれ最長 2 時間です。</li>
      <li>
        録音を始めるには約 2 GB の空き容量が必要です。音声を 15
        秒間受け取らないと、録音は停止します。
      </li>
      <li>
        長いファイルの話者の識別には十分な空きメモリが必要で、開始前に確認されます。
      </li>
      <li>
        Airdraft
        は会議の文字起こしや話者ラベルの精度の計測結果を公開していません。お使いの録音で試してください。
      </li>
    </ul>
    <div class="guide-actions">
      <Button href={href("/pricing/", locale)} icon="right">
        価格を見る
      </Button>
      <Button
        href={href("/guides/compare-mac-dictation-apps/", locale)}
        variant="quiet"
        icon="right"
      >
        ほかのアプリと比べる
      </Button>
    </div>
  </GuideSection>
</GuideLayout>
