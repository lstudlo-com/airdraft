---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import { licenses } from "../../../data/site";
import { href, type Locale } from "../../../i18n";

/**
 * A dated comparison with VoiceInk, Handy, Typeless and Apple Dictation.
 * Competitor facts come from each product's own pages and the sources listed
 * at the end, checked on the stated dates (vault: Research/Competitors).
 * Recheck every row and date before changing them. Unknown cells say so;
 * never fill them with assumptions, rankings or benchmark claims.
 */
const locale: Locale = "ja";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "compare-mac-dictation-apps",
)!;
const [oneMac, threeMacs] = licenses;

type Row = {
  name: string;
  price: string;
  /** Whether a visitor can download and try it today. */
  available: string;
  source: string;
  speech: string;
  cleanup: string;
  meetings: string;
  platforms: string;
};

const rows: Row[] = [
  {
    name: "Airdraft",
    price: `ソースからのビルドは無料。公式アプリは買い切りで Mac 1 台 ${oneMac.price}、3 台 ${threeMacs.price}（まだ販売していません）`,
    available:
      "いいえ：公式アプリは未販売で、公証も受けていません。ソースからのビルドには Xcode が必要",
    source: "オープンソース（GPL-3.0）",
    speech: "Mac 上、または自分のキーでクラウドのプロバイダ",
    cleanup:
      "ローカル、自分のキーでクラウド、または契約中のプランで Claude Code と Codex",
    meetings:
      "アプリの音声とマイクを録音、ファイルの読み込み、任意の話者ラベル、SRT と VTT の書き出し",
    platforms: "Mac（Apple シリコン、macOS 15 以降）",
  },
  {
    name: "VoiceInk",
    price: "買い切りで Mac 1 台、2 台、3 台に $25、$39、$49。14 日間の返金保証",
    available: "はい：無料試用版をダウンロード可能（試用期間の記載なし）",
    source: "オープンソース（GPL-3.0）",
    speech: "Mac 上、または自分のキーでクラウドのプロバイダ",
    cleanup:
      "好きなプロバイダ。Claude Code と Codex 用のローカル CLI テンプレートもあり",
    meetings:
      "音声と動画のファイルをまとめて文字起こし。履歴は TXT か Markdown で保存し、CSV で書き出し",
    platforms: "Mac。別に iOS アプリあり",
  },
  {
    name: "Handy",
    price: "無料（寄付を受け付け）",
    available: "はい：無料でダウンロード",
    source: "オープンソース（MIT）",
    speech:
      "デバイス上で処理。Qwen3-ASR 0.6B と 1.7B、SenseVoice Small も利用可能",
    cleanup: "任意の後処理。ローカルまたは設定した API で",
    meetings: "未確認",
    platforms: "Mac、Windows、Linux",
  },
  {
    name: "Typeless",
    price: "無料版は週あたりの語数に上限あり。Pro は月 $30 または年 $144",
    available: "はい：無料プランをダウンロード可能",
    source: "非公開",
    speech: "提供元がホストするクラウドサービス",
    cleanup: "ホスト型：個人辞書、口調、整え",
    meetings: "未確認",
    platforms: "Mac、Windows、Linux、iOS、Android",
  },
  {
    name: "Apple の音声入力（macOS 27）",
    price: "macOS に付属",
    available: "はい：macOS に内蔵",
    source: "非公開",
    speech:
      "システムに内蔵。デバイス上かサーバでの処理かは、言語、設定、ハードウェアによる",
    cleanup:
      "macOS 27 で整えたテキストの音声入力を追加。高度な機能にはメモリ 12 GB の M3 以降の Mac が必要",
    meetings: "未確認",
    platforms: "Apple のプラットフォームに内蔵",
  },
];

const columns = [
  "製品",
  "価格",
  "いまダウンロードして試せるか",
  "ソース",
  "音声認識",
  "テキストの整え",
  "会議とファイル",
  "プラットフォーム",
];

// Each source with the date its facts were checked.
// The cells after the product name, in column order.
const cells = (row: Row) => [
  row.price,
  row.available,
  row.source,
  row.speech,
  row.cleanup,
  row.meetings,
  row.platforms,
];

const sources = [
  {
    label: "VoiceInk の価格",
    url: "https://tryvoiceink.com/pricing",
    checked: "2026-10-21",
  },
  {
    label: "VoiceInk のソース",
    url: "https://github.com/Beingpax/VoiceInk",
    checked: "2026-10-21",
  },
  {
    label: "VoiceInk のローカル CLI のドキュメント",
    url: "https://tryvoiceink.com/docs/local-cli",
    checked: "2026-10-21",
  },
  {
    label: "VoiceInk のファイルの文字起こし",
    url: "https://tryvoiceink.com/docs/transcribe-audio-files",
    checked: "2026-10-21",
  },
  {
    label: "VoiceInk のソース：履歴の保存",
    url: "https://github.com/Beingpax/VoiceInk/blob/main/VoiceInk/Features/History/Components/SaveIconButton.swift",
    checked: "2026-10-21",
  },
  {
    label: "VoiceInk のソース：CSV の書き出し",
    url: "https://github.com/Beingpax/VoiceInk/blob/main/VoiceInk/Features/History/Export/VoiceInkCSVExportService.swift",
    checked: "2026-10-21",
  },
  {
    label: "Handy",
    url: "https://handy.computer/",
    checked: "2026-10-21",
  },
  {
    label: "Handy の後処理",
    url: "https://handy.computer/docs/post-processing",
    checked: "2026-09-26",
  },
  {
    label: "Handy v0.9.8 のリリース",
    url: "https://github.com/cjpais/Handy/releases/tag/v0.9.8",
    checked: "2026-10-21",
  },
  {
    label: "Handy のソース：v0.9.8 のモデル一覧",
    url: "https://github.com/cjpais/Handy/blob/v0.9.8/src-tauri/src/catalog/catalog.json",
    checked: "2026-10-24",
  },
  {
    label: "Typeless の価格",
    url: "https://www.typeless.com/pricing",
    checked: "2026-10-21",
  },
  {
    label: "Typeless のリリースノート",
    url: "https://www.typeless.com/help/release-notes",
    checked: "2026-09-26",
  },
  {
    label: "繁体字中国語の音声入力のレビュー（Taneverse）",
    url: "https://taneverse.com/posts/three-traditional-chinese-voice-input-methods/",
    checked: "2026-10-21",
  },
  {
    label: "Apple の音声入力のヘルプ",
    url: "https://support.apple.com/guide/mac-help/use-dictation-mh40584/mac",
    checked: "2026-09-26",
  },
  {
    label: "Macworld: macOS 27",
    url: "https://www.macworld.com/article/3139330/macos-27-mac-features-siri-apple-intelligence-release-date-compatibility.html",
    checked: "2026-10-21",
  },
  {
    label: "9to5Mac: macOS 27",
    url: "https://9to5mac.com/2026/09/14/macos-27-golden-gate-now-available-here-is-everything-new/",
    checked: "2026-10-21",
  },
];
---

<GuideLayout guide={guide}>
  <GuideSection id="glance" title="ひと目で比較">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="音声入力アプリの比較"
    >
      <table class="guide-table guide-table-wide" role="table">
        <caption>
          2026 年 10 月 21 日に確認（Handy の音声モデルは 10 月 24
          日）。「未確認」は機能がないという意味ではありません。
        </caption>
        <thead role="rowgroup">
          <tr role="row">
            {columns.map((column) => (
              <th scope="col" role="columnheader">
                {column}
              </th>
            ))}
          </tr>
        </thead>
        <tbody role="rowgroup">
          {rows.map((row) => (
            <tr role="row">
              <th scope="row" role="rowheader">
                {row.name}
              </th>
              {cells(row).map((cell, index) => (
                <td role="cell">
                  <span class="cell-label" aria-hidden="true">
                    {columns[index + 1]}
                  </span>
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </GuideSection>

  <GuideSection id="better" title="ほかのアプリのほうが優れている点">
    <dl class="guide-decisions">
      <div>
        <dt>VoiceInk</dt>
        <dd>
          Mac 1 台なら安く（$25 対 $29）、Mac 2 台向けのライセンスがあり、14
          日間の返金保証を公表していて、いますぐ購入できます。複数のファイルをまとめて文字起こしでき（Airdraft
          は 1 ファイルずつ）、iOS アプリもあります。
        </dd>
      </div>
      <div>
        <dt>Handy</dt>
        <dd>
          無料で MIT ライセンス、Windows と Linux
          でも動きます。コミュニティもずっと大きく、2026 年 10 月 21 日時点で
          GitHub のスターは約 34,200 でした。バージョン 0.9.8
          で中国語の表記を選べるようになりました。
        </dd>
      </div>
      <div>
        <dt>Typeless</dt>
        <dd>
          モデルやキーの設定が不要で、スマートフォンやほかのコンピュータでも使えます。台湾の繁体字中国語の音声入力のレビューでよく勧められています（Taneverse
          を参照）。
        </dd>
      </div>
      <div>
        <dt>Apple の音声入力</dt>
        <dd>
          無料でインストールも不要で、システムに組み込まれています。macOS 27
          で整えたテキストの音声入力が加わりましたが、中国語に対応しているかは確認していません。
        </dd>
      </div>
    </dl>
  </GuideSection>

  <GuideSection id="airdraft" title="Airdraft が違う点">
    <ul>
      <li>
        音声認識と整形をそれぞれローカルかクラウドで動かせるので、音声はローカルに残しつつ、クラウドのテキストモデルを使えます。
      </li>
      <li>
        中国語のローカルモデル（Qwen3-ASR、SenseVoice、FireRedASR2）があり、繁体字か簡体字で出力できます。0.11.0
        以降、初回設定では中国語に設定した Mac に Qwen3-ASR 1.7B
        を勧め、「モデル」では「中国語と英語の混在に最適」と表示されます。より小さく高速な選択肢は
        SenseVoice で、メモリが 8 GB 以下の Mac では SenseVoice
        を先に勧め、Qwen3-ASR 1.7B も候補として示します。Handy v0.9.8
        のモデル一覧にも、ローカルの Qwen3-ASR 0.6B と 1.7B、SenseVoice Small
        があります。
        <a href={href("/guides/mixed-chinese-english-dictation/", locale)}>
          混在言語でのモデルの計測
        </a>
        をご覧ください。
      </li>
      <li>
        Claude Code や Codex を使えば、契約中の Claude や ChatGPT
        のプランでテキストを整形でき、ターミナルのコーディングエージェントにプロンプトを直接音声入力できます。
        <a href={href("/guides/dictate-to-claude-code-and-terminals/", locale)}>
          Claude Code やターミナルへの音声入力
        </a>
        をご覧ください。
      </li>
      <li>
        <a href={href("/guides/private-meeting-transcription/", locale)}>
          会議の録音と文字起こし
        </a>
        ：アプリの音声とマイク、話者ラベル、字幕の書き出し。
      </li>
    </ul>
  </GuideSection>

  <GuideSection id="gaps" title="Airdraft にいま足りないもの">
    <ul>
      <li>
        公式アプリはまだ販売しておらず、公証を受けた一般向けのインストーラもまだありません。
      </li>
      <li>動作するのは Mac だけで、スマートフォンのアプリはありません。</li>
      <li>選択肢が多く、最初の設定ではモデルを選ぶ必要があります。</li>
      <li>
        Airdraft
        が公開しているのは、ローカルモデルの自社テストだけです（中国語と英語の混在、英語・日本語・韓国語の読み上げ、それぞれ
        Mac 1 台）。ほかのアプリとの精度や速度の比較はありません。
      </li>
      <li>会議の録音にエコーキャンセルはありません。</li>
    </ul>
    <div class="guide-actions">
      <Button href={href("/pricing/", locale)} icon="right">
        価格を見る
      </Button>
    </div>
  </GuideSection>

  <GuideSection id="sources" title="出典と確認日">
    <ul class="guide-sources">
      {sources.map((source) => (
        <li>
          <a href={source.url}>{source.label}</a>（
          <time datetime={source.checked}>{source.checked}</time> に確認）
        </li>
      ))}
    </ul>
  </GuideSection>
</GuideLayout>
