---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import { ejaAsrResults } from "../../../data/eja-asr";
import { href, type Locale } from "../../../i18n";

/**
 * Dictating prompts into Claude Code, Codex and terminals, in each language.
 * Delivery follows TextInserter (selfDrawingEditorBundlePrefixes, read-back
 * confirmation, explicit-retry copy), destination rules follow AppFamily and
 * the app-context setting, and CLI refinement follows CLIRefiner and the root
 * README. Behavior described is 0.11.0's, plus the AD-083 speech
 * recommendation; 0.11.0, 0.10.2 and earlier are named only where they differ.
 * Speech numbers come from src/data/eja-asr.ts (eval/eja-asr). App labels are
 * the app's ja catalog values, quoted with 「」; labels without a catalog entry
 * (Claude Code, Codex) stay as the app shows them.
 */
const locale: Locale = "ja";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "dictate-to-claude-code-and-terminals",
)!;
const english = ejaAsrResults.en;
const parakeet = english.find((row) => row.model === "Parakeet TDT v2")!;
const qwen = english.find((row) => row.model === "Qwen3-ASR 1.7B")!;
const percent = (value: number) => `${value.toFixed(1)}%`;
const about = (ms: number) => `${Math.round(ms / 10) * 10} ms`;
---

<GuideLayout guide={guide}>
  <GuideSection
    id="delivery"
    title="テキストはどうやってターミナルに届きますか？"
  >
    <ul>
      <li>
        Airdraft は音声入力したウインドウに戻り、テキストを 1
        回だけペーストします。Return は押しません。
      </li>
      <li>
        Terminal と iTerm2 はカーソルとテキストを公開しているので、Airdraft
        はほかのエディタと同じようにペーストした内容を読み返して確認します。
      </li>
      <li>
        Warp、Ghostty、kitty、Alacritty、WezTerm と Zed
        エディタは自前でテキストを描画し、読み返せるテキストを公開していません。Airdraft
        は同じアプリとウインドウが前面にあることを確かめてから 1
        回だけペーストし、繰り返すことはありません。
      </li>
      <li>
        0.11.0
        以降、これらの音声入力は「履歴」でエラーなしの「ペースト済み（未確認）」と表示され、クリップボードはいつもより少し遅れて元に戻ります。0.10.2
        では、テキストが届いていても「Paste couldn’t be
        confirmed」と表示され、テキストはクリップボードに残ります。
      </li>
      <li>
        録音のあとにウインドウやフィールドが変わった場合、Airdraft
        はほかの場所にペーストせず、テキストをコピーします。保存された録音を明示的に再試行した場合も、これらのアプリにはペーストせずにコピーします。テキストがどこに入るかを確認する手段がないためです。
      </li>
    </ul>
  </GuideSection>

  <GuideSection id="cli-refinement" title="契約中のプランで整形する">
    <ol class="guide-steps">
      <li>
        <h3>CLI をインストールしてサインインする</h3>
        <p>
          Airdraft は
          ~/.local/bin、/opt/homebrew/bin、/usr/local/bin、~/.bun/bin、~/.npm-global/bin
          から claude または codex
          コマンドを探し、サインイン中のアカウントを使います。API
          キーは必要ありません。
        </p>
      </li>
      <li>
        <h3>「モデル」で選ぶ</h3>
        <p>
          「モデル」→「整形」で Claude Code または Codex
          を選びます。モデルの一覧はインストール済みの CLI
          から取得され、その横に「推論の強度」があります。低いほど速く、プランの使用量も少なくなります。
        </p>
      </li>
      <li>
        <h3>話して離す</h3>
        <p>
          Claude Code
          は話している間に起動するので、起動時間は気になりません。Codex
          は話し終えてから起動するため、時間が長くかかります。整形が失敗したりタイムアウトしたりした場合は、元の文字起こしが入力されます。
        </p>
      </li>
    </ol>
    <p>
      Airdraft は CLI を一時フォルダで非対話的に実行し、ツール、MCP
      サーバ、スラッシュコマンド、保存されたセッションを使わないため、CLI
      はテキストを返すことしかできません。CLI
      のログインや設定は変更しません。使用量はプランの上限に数えられます。
    </p>
  </GuideSection>

  <GuideSection id="prompt-style" title="プロンプトはプロンプトのまま">
    <p>
      「設定」→「動作」で「アプリのコンテキストを読み取る」をオンにすると、Airdraft
      は Terminal、iTerm2、Warp、Ghostty、kitty
      をターミナルとして扱います。話した内容は Markdown
      なしの文章のままで、フラグやパスを正確に残すのはコマンドを音声入力したときだけです。VS
      Code、Cursor、Xcode、JetBrains IDE、Zed
      などのコードエディタでは、技術用語の表記を直し、識別子やパスはそのまま残します。
    </p>
    <p>
      「アプリのコンテキストを読み取る」はデフォルトでオフです。その場合
      Airdraft
      は入力先がわからないため、一般的なルールを使います。言葉どおりに入力したいときは、整形をしない「逐語」モードを使ってください。プロジェクト名や用語は「語彙」に追加します。
    </p>
  </GuideSection>

  <GuideSection id="privacy" title="Mac の外に出るものは？">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="プロンプトの音声入力データの送信先"
    >
      <table class="guide-table">
        <caption>各ステップで送信される内容</caption>
        <thead>
          <tr>
            <th scope="col">ステップ</th>
            <th scope="col">送信される内容</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">ローカルの音声モデル</th>
            <td>なし。録音はこの Mac に残ります。</td>
          </tr>
          <tr>
            <th scope="row">クラウド音声認識</th>
            <td>音声が選んだプロバイダに送られます。</td>
          </tr>
          <tr>
            <th scope="row">Claude Code または Codex による整形</th>
            <td>
              文字起こし、モードの指示、語彙が CLI のアカウントを通じて
              Anthropic または OpenAI
              に送られます。「アプリのコンテキストを読み取る」がオンの場合は、アプリ名、ウインドウのタイトル、選択したテキスト、カーソル付近のテキスト、同じアプリでの最近の音声入力に含まれる用語も送られます。CLI
              は Mac 上で動きますが、そのモデルは Mac 上では動きません。
            </td>
          </tr>
          <tr>
            <th scope="row">ローカルの整形</th>
            <td>
              Apple Intelligence、またはこの Mac で動いている LM Studio や
              Ollama：なし。
            </td>
          </tr>
          <tr>
            <th scope="row">プロンプトで Return を押す</th>
            <td>
              キーボードで入力したときと同じく、Claude Code や Codex
              がプロンプトをそのプロバイダに送ります。Airdraft は関与しません。
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>
      Codex のバージョンによっては、整形のリクエストにグローバルの AGENTS.md
      が追加されます。それが問題になる場合は、Claude Code
      かローカルの整形を使うか、そのモードの「文字起こしを整形」をオフにしてください。
    </p>
  </GuideSection>

  <GuideSection id="speech" title="どの音声モデルを使いますか？">
    <p>
      英語だけのプロンプトなら Parakeet TDT v2 を選びます。英語に設定した Mac
      では、初回設定でこのモデルが勧められます。認識するのは英語だけです。英語の読み上げでの
      Airdraft 独自の計測では、単語誤り率は {percent(parakeet.auto.value)}、1
      クリップあたり約 {about(parakeet.medianMs)} で、Qwen3-ASR 1.7B の{" "}
      {percent(qwen.auto.value)} と誤差の範囲内でした。Qwen3-ASR 1.7B
      はほかの言語も認識し、メモリを約 3 GB
      使います。クリップはプロンプトではなく Wikipedia
      の文の読み上げです。方法と限界は
      <a href={href("/guides/offline-dictation-on-mac/#measured", locale)}>
        オフライン設定ガイド
      </a>
      をご覧ください。0.11.0 以前は、当時インストールしていた SenseVoice
      を勧めていました。これは広東語向けのファインチューニング版で、現在は
      SenseVoice Cantonese と表示されます。
    </p>
    <p>
      Parakeet TDT v3 は英語とほかのヨーロッパの 24
      言語に対応しますが、中国語には対応しません。プロンプトに中国語と英語が混ざる場合は、
      <a href={href("/guides/mixed-chinese-english-dictation/", locale)}>
        混在言語でのモデルの計測
      </a>
      をご覧ください。
    </p>
    <div class="guide-actions">
      <Button href={href("/pricing/", locale)} icon="right">
        価格を見る
      </Button>
      <Button
        href={href("/guides/local-vs-cloud-dictation/", locale)}
        variant="quiet"
        icon="right"
      >
        ローカルとクラウドを比べる
      </Button>
    </div>
  </GuideSection>
</GuideLayout>
