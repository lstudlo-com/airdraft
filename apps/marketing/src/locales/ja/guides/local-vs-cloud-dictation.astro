---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import { localizedPath, type Locale } from "../../../i18n";
import { siteLinks } from "../../../data/site";

const locale: Locale = "ja";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "local-vs-cloud-dictation",
)!;
---

<GuideLayout guide={guide}>
  <GuideSection id="data-flow" title="Mac の外に出るものは？">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="ローカルとクラウドのデータの流れの比較"
    >
      <table class="guide-table">
        <caption>組み合わせごとの音声入力の処理</caption>
        <thead>
          <tr>
            <th scope="col">音声認識</th>
            <th scope="col">整形</th>
            <th scope="col">モデルのプロバイダに送られるもの</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">ローカル</th>
            <td>ローカルまたはオフ</td>
            <td>音声も文字起こしもクラウドのモデルには送られません。</td>
          </tr>
          <tr>
            <th scope="row">ローカル</th>
            <td>クラウド</td>
            <td>文字起こしと整形のプロンプト。音声はローカルに残ります。</td>
          </tr>
          <tr>
            <th scope="row">クラウド</th>
            <td>ローカルまたはオフ</td>
            <td>
              文字起こしのために、音声が音声認識のプロバイダに送られます。
            </td>
          </tr>
          <tr>
            <th scope="row">クラウド</th>
            <td>クラウド</td>
            <td>
              音声は音声認識のプロバイダに、テキストとそのプロンプトは整形のプロバイダに送られます。
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>
      音声認識のプロバイダによっては、文字起こしの精度を上げるために、選んだ言語や語彙の用語も受け取ります。
    </p>
    <p>
      ここでいうローカルとは、モデルがこの Mac
      上で動くことです。この表はモデルによる処理についてのもので、ダウンロード、ソフトウェアのアップデート、ライセンスのリクエストは含みません。
    </p>
  </GuideSection>

  <GuideSection
    id="refinement-context"
    title="整形のプロンプトには何が入りますか？"
  >
    <p>
      整形には、文字起こし、モードの指示、語彙を使います。「アプリのコンテキストを読み取る」をオンにすると、使用中のアプリ、ウインドウのタイトル、URL、選択したテキスト、カーソル付近のテキスト、同じアプリでの最近の音声入力に含まれる用語も、取得できる範囲で含まれます。
    </p>
    <p>
      これらを含めたくない場合は、「設定」で「アプリのコンテキストを読み取る」をオフにします。Claude
      Code と Codex による整形も外部のサービスを使います。CLI は Mac
      上で動きますが、そのモデルは Mac 上では動きません。
    </p>
  </GuideSection>

  <GuideSection id="choose" title="どの構成が合っていますか？">
    <dl class="guide-decisions">
      <div>
        <dt>音声入力の処理をこの Mac の中で完結させる</dt>
        <dd>
          ローカルの音声モデルとローカルの整形を選ぶか、整形をオフにします。必要なモデルを先にインストールしてください。手順は
          <a href={localizedPath("/guides/offline-dictation-on-mac/", locale)}>
            オフライン設定ガイド
          </a>
          をご覧ください。
        </dd>
      </div>
      <div>
        <dt>音声はローカルに残し、テキストはクラウドのモデルで整える</dt>
        <dd>
          ローカルの音声認識とクラウドの整形を組み合わせます。共有されるのは文字起こしとそのプロンプトで、録音はクラウドの音声認識サービスに送られません。
        </dd>
      </div>
      <div>
        <dt>ローカルモデルをダウンロードしない</dt>
        <dd>
          クラウドの音声認識とクラウドの整形を選びます。インターネット接続と各プロバイダが求める認証情報が必要で、その利用料金は
          Airdraft のライセンスとは別です。
        </dd>
      </div>
    </dl>
    <p>
      使用中のモードも確認してください。モードに設定した音声モデルは「モデル」のアプリのデフォルトより優先され、デフォルトを変えても置き換わりません。
    </p>
  </GuideSection>

  <GuideSection id="storage" title="キーと履歴はどこに保存されますか？">
    <p>
      プロバイダの API キーは macOS
      のキーチェーンに保存されます。音声入力の履歴はローカルにあり、検索できます。音声の保存は任意で、保存期間は
      1 日、7 日、30
      日、または削除するまでから選べます。音声の保存をオフにすると、保存済みの音声は削除され、テキストの履歴は残ります。
    </p>
    <p>
      クラウドのプロバイダには、それぞれのデータポリシーと料金が適用されます。「履歴」にローカルのコピーがあっても、すでにプロバイダに送ったリクエストは取り消せません。
    </p>
    <div class="guide-actions">
      <Button
        href={localizedPath("/pricing/", locale) + "#provider-costs"}
        icon="right"
      >
        構成ごとの費用を比べる
      </Button>
      <Button href={siteLinks.source} variant="quiet" icon="external">
        ソースを確認する
      </Button>
    </div>
  </GuideSection>
</GuideLayout>
