---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import type { Locale } from "../../../i18n";
import { siteLinks } from "../../../data/site";

const locale: Locale = "en";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "local-vs-cloud-dictation",
)!;
---

<GuideLayout guide={guide}>
  <GuideSection id="data-flow" title="What leaves your Mac?">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="Compare local and cloud data flow"
    >
      <table class="guide-table">
        <caption>Dictation processing with each combination</caption>
        <thead>
          <tr>
            <th scope="col">Speech</th>
            <th scope="col">Refinement</th>
            <th scope="col">Sent to model providers</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Local</th>
            <td>Local or off</td>
            <td>No audio or transcript is sent to a cloud model.</td>
          </tr>
          <tr>
            <th scope="row">Local</th>
            <td>Cloud</td>
            <td>The transcript and refinement prompt. Audio stays local.</td>
          </tr>
          <tr>
            <th scope="row">Cloud</th>
            <td>Local or off</td>
            <td>Audio goes to your speech provider for transcription.</td>
          </tr>
          <tr>
            <th scope="row">Cloud</th>
            <td>Cloud</td>
            <td>
              Audio goes to the speech provider; text and its prompt go to the
              refinement provider.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <p>
      Some speech providers also receive your language selection and vocabulary
      terms to guide transcription.
    </p>
    <p>
      Here, local means the model runs on this Mac. The table covers model
      processing, not downloads, software updates or license requests.
    </p>
  </GuideSection>

  <GuideSection
    id="refinement-context"
    title="What is in the refinement prompt?"
  >
    <p>
      Refinement uses the transcript, profile instructions and vocabulary. With
      Read app context enabled, available context can also include the active
      app, window title, URL, selected text, text near the cursor and terms from
      recent dictations in the same app.
    </p>
    <p>
      Turn off Read app context in Settings to leave that context out. Claude
      Code and Codex refinement also use an external service: the CLI runs on
      your Mac, its model does not.
    </p>
  </GuideSection>

  <GuideSection id="choose" title="Which setup fits my needs?">
    <dl class="guide-decisions">
      <div>
        <dt>Keep dictation processing on this Mac</dt>
        <dd>
          Choose a local speech model and local refinement, or turn refinement
          off. Install the required models first. Follow the{" "}
          <a href="/guides/offline-dictation-on-mac/">offline setup guide</a>.
        </dd>
      </div>
      <div>
        <dt>Keep audio local and use a cloud text model</dt>
        <dd>
          Combine local speech with cloud refinement. This shares the transcript
          and its prompt while keeping the recording out of the cloud speech
          service.
        </dd>
      </div>
      <div>
        <dt>Avoid local model downloads</dt>
        <dd>
          Choose cloud speech and cloud refinement. You need connectivity and
          the providers' required credentials; their usage charges are separate
          from Airdraft's license.
        </dd>
      </div>
    </dl>
    <p>
      Check your active profile too: a profile's own speech model overrides the
      app default in Models, and changing the default does not replace it.
    </p>
  </GuideSection>

  <GuideSection id="storage" title="Where are keys and history stored?">
    <p>
      Provider API keys are stored in the macOS Keychain. Dictation history is
      local and searchable. Audio history is opt-in, with retention choices of
      1, 7 or 30 days, or until deleted. Turning audio retention off removes
      saved audio while keeping the text history.
    </p>
    <p>
      Cloud providers apply their own data policies and billing. A local copy in
      History does not undo a request already sent to a provider.
    </p>
    <div class="guide-actions">
      <Button href="/pricing/#provider-costs" icon="right">
        Compare Setup Costs
      </Button>
      <Button href={siteLinks.source} variant="quiet" icon="external">
        Inspect the Source
      </Button>
    </div>
  </GuideSection>
</GuideLayout>
