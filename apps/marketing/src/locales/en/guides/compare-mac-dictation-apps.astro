---
import GuideLayout from "../../../layouts/GuideLayout.astro";
import GuideSection from "../../../components/GuideSection.astro";
import Button from "../../../components/ui/Button.astro";
import { guidesFor } from "../../../data/guides";
import { licenses } from "../../../data/site";
import { href, type Locale } from "../../../i18n";

/**
 * A dated comparison with VoiceInk, Handy, Typeless and Apple Dictation.
 * Competitor facts come from each product's own pages and the sources listed
 * at the end, checked on the stated dates (vault: Research/Competitors).
 * Recheck every row and date before changing them. Unknown cells say so;
 * never fill them with assumptions, rankings or benchmark claims.
 */
const locale: Locale = "en";
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "compare-mac-dictation-apps",
)!;
const [oneMac, threeMacs] = licenses;

type Row = {
  name: string;
  price: string;
  /** Whether a visitor can download and try it today. */
  available: string;
  source: string;
  speech: string;
  cleanup: string;
  meetings: string;
  platforms: string;
};

const rows: Row[] = [
  {
    name: "Airdraft",
    price: `Source build free; official app ${oneMac.price} for one Mac or ${threeMacs.price} for three, one-time, not on sale yet`,
    available:
      "No: the official app is not on sale or notarized; the source build needs Xcode",
    source: "Open source (GPL-3.0)",
    speech: "On your Mac, or cloud providers on your own key",
    cleanup:
      "Local, cloud on your own key, or Claude Code and Codex on your plan",
    meetings:
      "Records app audio and microphone; imports files; optional speaker labels; SRT and VTT export",
    platforms: "Mac (Apple silicon, macOS 15+)",
  },
  {
    name: "VoiceInk",
    price: "$25, $39 or $49 one-time for 1, 2 or 3 Macs; 14-day refund",
    available: "Yes: free trial download (trial length not stated)",
    source: "Open source (GPL-3.0)",
    speech: "On your Mac, or cloud providers on your own key",
    cleanup:
      "Provider of your choice, including local CLI templates for Claude Code and Codex",
    meetings:
      "Queues audio and video files for transcription; history saves TXT or Markdown and exports CSV",
    platforms: "Mac; separate iOS app",
  },
  {
    name: "Handy",
    price: "Free, with donations",
    available: "Yes: free download",
    source: "Open source (MIT)",
    speech:
      "On your device, including Qwen3-ASR 0.6B and 1.7B and SenseVoice Small",
    cleanup: "Optional post-processing, locally or through an API you set",
    meetings: "Not checked",
    platforms: "Mac, Windows, Linux",
  },
  {
    name: "Typeless",
    price: "Free with a weekly word limit; Pro $30 a month or $144 a year",
    available: "Yes: free plan download",
    source: "Closed source",
    speech: "Hosted cloud service",
    cleanup: "Hosted: personal dictionary, tone and cleanup",
    meetings: "Not checked",
    platforms: "Mac, Windows, Linux, iOS, Android",
  },
  {
    name: "Apple Dictation (macOS 27)",
    price: "Included with macOS",
    available: "Yes: built into macOS",
    source: "Closed source",
    speech:
      "Built in; on-device or server processing depends on language, settings and hardware",
    cleanup:
      "macOS 27 adds polished-text dictation; advanced features need an M3 or later Mac with 12 GB of memory",
    meetings: "Not checked",
    platforms: "Built into Apple platforms",
  },
];

const columns = [
  "Product",
  "Price",
  "Download and try today",
  "Source",
  "Speech recognition",
  "Text cleanup",
  "Meetings and files",
  "Platforms",
];

// Each source with the date its facts were checked.
// The cells after the product name, in column order.
const cells = (row: Row) => [
  row.price,
  row.available,
  row.source,
  row.speech,
  row.cleanup,
  row.meetings,
  row.platforms,
];

const sources = [
  {
    label: "VoiceInk pricing",
    url: "https://tryvoiceink.com/pricing",
    checked: "2026-10-21",
  },
  {
    label: "VoiceInk source",
    url: "https://github.com/Beingpax/VoiceInk",
    checked: "2026-10-21",
  },
  {
    label: "VoiceInk local CLI documentation",
    url: "https://tryvoiceink.com/docs/local-cli",
    checked: "2026-10-21",
  },
  {
    label: "VoiceInk file transcription",
    url: "https://tryvoiceink.com/docs/transcribe-audio-files",
    checked: "2026-10-21",
  },
  {
    label: "VoiceInk source: history save",
    url: "https://github.com/Beingpax/VoiceInk/blob/main/VoiceInk/Features/History/Components/SaveIconButton.swift",
    checked: "2026-10-21",
  },
  {
    label: "VoiceInk source: CSV export",
    url: "https://github.com/Beingpax/VoiceInk/blob/main/VoiceInk/Features/History/Export/VoiceInkCSVExportService.swift",
    checked: "2026-10-21",
  },
  {
    label: "Handy",
    url: "https://handy.computer/",
    checked: "2026-10-21",
  },
  {
    label: "Handy post-processing",
    url: "https://handy.computer/docs/post-processing",
    checked: "2026-09-26",
  },
  {
    label: "Handy v0.9.8 release",
    url: "https://github.com/cjpais/Handy/releases/tag/v0.9.8",
    checked: "2026-10-21",
  },
  {
    label: "Handy source: v0.9.8 model catalog",
    url: "https://github.com/cjpais/Handy/blob/v0.9.8/src-tauri/src/catalog/catalog.json",
    checked: "2026-10-24",
  },
  {
    label: "Typeless pricing",
    url: "https://www.typeless.com/pricing",
    checked: "2026-10-21",
  },
  {
    label: "Typeless release notes",
    url: "https://www.typeless.com/help/release-notes",
    checked: "2026-09-26",
  },
  {
    label: "Traditional Chinese voice input review (Taneverse)",
    url: "https://taneverse.com/posts/three-traditional-chinese-voice-input-methods/",
    checked: "2026-10-21",
  },
  {
    label: "Apple Dictation help",
    url: "https://support.apple.com/guide/mac-help/use-dictation-mh40584/mac",
    checked: "2026-09-26",
  },
  {
    label: "Macworld: macOS 27",
    url: "https://www.macworld.com/article/3139330/macos-27-mac-features-siri-apple-intelligence-release-date-compatibility.html",
    checked: "2026-10-21",
  },
  {
    label: "9to5Mac: macOS 27",
    url: "https://9to5mac.com/2026/09/14/macos-27-golden-gate-now-available-here-is-everything-new/",
    checked: "2026-10-21",
  },
];
---

<GuideLayout guide={guide}>
  <GuideSection id="glance" title="At a glance">
    <div
      class="guide-table-scroll"
      tabindex="0"
      role="region"
      aria-label="Compare dictation apps"
    >
      <table class="guide-table guide-table-wide" role="table">
        <caption>
          Checked October 21, 2026, and Handy’s speech models October 24. “Not
          checked” does not mean missing.
        </caption>
        <thead role="rowgroup">
          <tr role="row">
            {columns.map((column) => (
              <th scope="col" role="columnheader">
                {column}
              </th>
            ))}
          </tr>
        </thead>
        <tbody role="rowgroup">
          {rows.map((row) => (
            <tr role="row">
              <th scope="row" role="rowheader">
                {row.name}
              </th>
              {cells(row).map((cell, index) => (
                <td role="cell">
                  <span class="cell-label" aria-hidden="true">
                    {columns[index + 1]}
                  </span>
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </GuideSection>

  <GuideSection id="better" title="Where the others are better">
    <dl class="guide-decisions">
      <div>
        <dt>VoiceInk</dt>
        <dd>
          It costs less for one Mac ($25 against $29), offers a two-Mac license,
          publishes a 14-day refund and is on sale today. It can queue files for
          batch transcription, where Airdraft handles one file at a time, and it
          has an iOS app.
        </dd>
      </div>
      <div>
        <dt>Handy</dt>
        <dd>
          It is free, MIT-licensed and runs on Windows and Linux too. Its
          community is far larger: about 34,200 GitHub stars on October 21,
          2026. Version 0.9.8 added a Chinese script choice.
        </dd>
      </div>
      <div>
        <dt>Typeless</dt>
        <dd>
          There are no models or keys to set up, and it works on phones and
          other computers. Taiwanese reviews of Traditional Chinese voice input
          often recommend it (see Taneverse).
        </dd>
      </div>
      <div>
        <dt>Apple Dictation</dt>
        <dd>
          It is free, needs no installation and is part of the system. macOS 27
          adds polished-text dictation; we have not verified whether it supports
          Chinese.
        </dd>
      </div>
    </dl>
  </GuideSection>

  <GuideSection id="airdraft" title="Where Airdraft is different">
    <ul>
      <li>
        Speech and refinement each run locally or in the cloud, so you can keep
        audio local and still use a cloud text model.
      </li>
      <li>
        Local Chinese models (Qwen3-ASR, SenseVoice, FireRedASR2), with
        Traditional or Simplified output. From 0.11.0, first-run setup
        recommends Qwen3-ASR 1.7B on a Mac set to Chinese, labelled “Best for
        mixed Chinese and English” in Models, with SenseVoice as the smaller,
        faster option; on a Mac with 8 GB of memory or less it recommends
        SenseVoice first and still offers Qwen3-ASR 1.7B. Handy v0.9.8’s model
        catalog also offers local Qwen3-ASR 0.6B and 1.7B and SenseVoice Small.
        See the{" "}
        <a href={href("/guides/mixed-chinese-english-dictation/", locale)}>
          mixed-language model measurements
        </a>
        .
      </li>
      <li>
        Claude Code or Codex can refine text on the Claude or ChatGPT plan you
        already pay for, and you can dictate prompts straight into coding agents
        in a terminal. See{" "}
        <a href={href("/guides/dictate-to-claude-code-and-terminals/", locale)}>
          dictating into Claude Code and terminals
        </a>
        .
      </li>
      <li>
        <a href={href("/guides/private-meeting-transcription/", locale)}>
          Meeting recording and transcripts
        </a>
        : app audio and microphone, speaker labels and subtitle export.
      </li>
    </ul>
  </GuideSection>

  <GuideSection id="gaps" title="What Airdraft lacks today">
    <ul>
      <li>
        The official app is not on sale, and there is no notarized public
        installer yet.
      </li>
      <li>It runs only on the Mac, with no phone app.</li>
      <li>There are many choices, and first setup means picking models.</li>
      <li>
        Airdraft has published only its own tests of its local models, on mixed
        Chinese and English and on English, Japanese and Korean read speech (one
        Mac each); there is no accuracy or speed comparison with other apps.
      </li>
      <li>Meeting recording has no echo cancellation.</li>
    </ul>
    <div class="guide-actions">
      <Button href={href("/pricing/", locale)} icon="right">
        See Pricing
      </Button>
    </div>
  </GuideSection>

  <GuideSection id="sources" title="Sources and check dates">
    <ul class="guide-sources">
      {sources.map((source) => (
        <li>
          <a href={source.url}>{source.label}</a>, checked{" "}
          <time datetime={source.checked}>{source.checked}</time>
        </li>
      ))}
    </ul>
  </GuideSection>
</GuideLayout>
