---
import LicenseCard from "./LicenseCard.astro";
import Button from "./ui/Button.astro";
import Surface from "./ui/Surface.astro";
import { siteLinks } from "../data/site";

/**
 * The close: the two ways to get Airdraft, side by side. Build it yourself
 * for free, or a one-time license for the ready-to-run app (LicenseCard,
 * shared with the pricing page; prices come from src/data/site.ts).
 */
---

<section
  class="section wrap section-space get"
  id="get-airdraft"
  aria-labelledby="get-heading"
>
  <div class="section-heading">
    <h2 id="get-heading">Get Airdraft</h2>
    <p>
      Free to build from source, or a one-time license for the ready-to-run app.
    </p>
  </div>

  <div class="offers">
    <Surface as="article" class="offer" data-offer="">
      <h3>Build it yourself</h3>
      <p class="offer-price">Free</p>
      <p class="offer-note">
        Every feature. Needs Xcode on an Apple silicon Mac.
      </p>
      <Button href={siteLinks.build} icon="external" class="offer-action">
        Build instructions
      </Button>
    </Surface>

    <LicenseCard name="offer-macs" />
  </div>
</section>
