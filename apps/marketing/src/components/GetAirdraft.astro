---
import LicenseCard from "./LicenseCard.astro";
import Button from "./ui/Button.astro";
import Surface from "./ui/Surface.astro";
import { siteLinks } from "../data/site";
import type { Locale } from "../i18n";

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const onSale = Boolean(siteLinks.checkout);
const copy =
  locale === "zh-tw"
    ? {
        title: "取得 Airdraft",
        intro: `從原始碼自行編譯免費；現成可用的官方版一次買斷。${onSale ? "" : "目前尚未開賣。"}`,
        build: "自行編譯",
        free: "免費",
        note: "所有功能，需在 Apple 晶片 Mac 上用 Xcode 編譯。",
        action: "編譯說明",
      }
    : {
        title: "Get Airdraft",
        intro: `Free to build from source, or a one-time license for the ready-to-run app.${onSale ? "" : " The official app isn’t on sale yet."}`,
        build: "Build it yourself",
        free: "Free",
        note: "Every feature. Needs Xcode on an Apple silicon Mac.",
        action: "Build instructions",
      };

/**
 * The close: the two ways to get Airdraft, side by side. Build it yourself
 * for free, or a one-time license for the ready-to-run app (LicenseCard,
 * shared with the pricing page; prices come from src/data/site.ts). Both
 * cards have the same four rows (title, price, note, action), which share
 * the grid's tracks so they line up across the cards.
 */
---

<section
  class="section wrap section-space get"
  id="get-airdraft"
  aria-labelledby="get-heading"
>
  <div class="section-heading">
    <h2 id="get-heading">{copy.title}</h2>
    <p>{copy.intro}</p>
  </div>

  <div class="offers">
    <Surface as="article" class="offer" data-offer="">
      <div class="offer-head">
        <h3>{copy.build}</h3>
      </div>
      <p class="offer-price">{copy.free}</p>
      <p class="offer-note">{copy.note}</p>
      <div class="offer-foot">
        <Button href={siteLinks.build} size="lg" icon="external">
          {copy.action}
        </Button>
      </div>
    </Surface>

    <LicenseCard name="offer-macs" locale={locale} />
  </div>
</section>
