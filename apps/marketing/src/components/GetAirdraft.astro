---
import LicenseCard from "./LicenseCard.astro";
import NotifyRow from "./NotifyRow.astro";
import Button from "./ui/Button.astro";
import Surface from "./ui/Surface.astro";
import { siteLinks } from "../data/site";
import type { Locale } from "../i18n";
import { messages } from "../i18n/messages";

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const onSale = Boolean(siteLinks.checkout);
const text = messages[locale];
const copy = text.get;

/**
 * The close: the two ways to get Airdraft, side by side. Build it yourself
 * for free, or a one-time license for the ready-to-run app (LicenseCard,
 * shared with the pricing page; prices come from src/data/site.ts). Both
 * cards have the same four rows (title, price, note, action), which share
 * the grid's tracks so they line up across the cards. Until checkout opens
 * the source build is the one primary key, since it is the path available
 * today, and NotifyRow says how to hear when the app goes on sale.
 */
---

<section
  class="section wrap section-space get"
  id="get-airdraft"
  aria-labelledby="get-heading"
>
  <div class="section-heading">
    <h2 id="get-heading">{copy.title}</h2>
  </div>

  <div class="offers">
    <Surface as="article" class="offer" data-offer="">
      <div class="offer-head">
        <h3>{copy.build}</h3>
      </div>
      <p class="price">{copy.free}</p>
      <p class="offer-note">{copy.note}</p>
      <div class="offer-foot">
        <Button
          href={siteLinks.build}
          variant={onSale ? "secondary" : "primary"}
          size="lg"
          icon="external"
        >
          {copy.action}
        </Button>
      </div>
    </Surface>

    <LicenseCard name="offer-macs" locale={locale} />
  </div>
  <NotifyRow locale={locale} />
</section>
