---
import Hud from "./ui/Hud.astro";
import Keys from "./ui/Keys.astro";
import { languageTag, type Locale } from "../i18n";
import { story } from "../i18n/story";
import "../styles/story.css";

/**
 * The homepage's scroll story: one dictation in four steps. With motion
 * allowed and JavaScript (src/scripts/scrolly.ts) the section pins while the
 * visitor scrolls through it: the keys sink, the pill records, the spoken
 * words arrive, the fillers are struck out and fold away, and the result
 * types in at the caret, scrubbed by the scroll position in both directions.
 * The steps beside it follow, with a progress rail in the accent. Without
 * JavaScript or with reduced motion it is a short section showing every
 * step and the final frame.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = story[locale];
const spaced = !/^(ja|zh)/.test(languageTag[locale]);
// Words (with their leading space) in spaced scripts; two characters at a
// time in Chinese and Japanese.
const split = (text: string) =>
  spaced
    ? (text.match(/\s*\S+/g) ?? [])
    : Array.from(text).reduce<string[]>((chunks, char, index) => {
        if (index % 2 === 0) chunks.push(char);
        else chunks[chunks.length - 1] += char;
        return chunks;
      }, []);
const heard = copy.spoken.flatMap((part) =>
  typeof part === "string"
    ? split(part).map((text) => ({ text, filler: false }))
    : split(part.filler).map((text) => ({ text, filler: true })),
);
const written = split(copy.written);
const levels = Array.from({ length: 14 }, () => 0.14);
---

<section
  class="story wrap section-space"
  id="how-it-works"
  aria-labelledby="story-heading"
  data-story
>
  <div class="story-pin">
    <div class="story-copy">
      <h2 id="story-heading" class="story-title">
        {copy.title}
      </h2>
      <div class="story-progress">
        <span class="story-rail" aria-hidden="true">
          <i data-rail></i>
        </span>
        <ol class="story-steps">
          {copy.steps.map(([title, line], index) => (
            <li class="story-step" data-step={index}>
              <span class="story-index" aria-hidden="true">
                {index + 1}
              </span>
              <div>
                <h3>{title}</h3>
                <p>{line}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
    <div class="story-stage panel" aria-hidden="true">
      <div class="story-field" data-field>
        <p>
          {written.map((text) => (
            <span data-word>{text}</span>
          ))}
          <span class="caret"></span>
        </p>
      </div>
      <div class="story-heard well" data-heard>
        <p>
          {heard.map((token) => (
            <span
              class:list={["story-token", token.filler && "filler struck"]}
              data-token
              data-filler={token.filler ? "" : undefined}
            >
              {token.text}
            </span>
          ))}
        </p>
      </div>
      <div class="story-controls">
        <Keys keys={["⌃", "⌥"]} label="Control Option" size="lg" />
        <Hud class="story-hud" levels={levels} locale={locale} />
      </div>
    </div>
  </div>
</section>

<script>
  import "../scripts/scrolly";
</script>
