---
import BentoTile from "./ui/BentoTile.astro";
import Keys from "./ui/Keys.astro";
import Section from "./ui/Section.astro";
import "../styles/interface.css";
import { appLabels } from "../data/app";
import type { Locale } from "../i18n";

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;

/**
 * The interface section: the real app window, then three live specimens.
 *
 * The window is the Settings page rendered from a Debug build with an
 * isolated empty data directory (scripts/render-app-window.sh), so it shows
 * no history, usage counts or personal settings. Both appearances are
 * stacked; a divider compares them. The callouts mark where each material
 * from the app's design system appears, at the window's own coordinates
 * (points on its 784 × 1000 frame). The specimens are built from the site's
 * parts and respond to the pointer (src/scripts/interface.ts).
 *
 * Published builds through 0.10.2 are English only; the Traditional Chinese
 * interface ships from the next release and follows the macOS language. The
 * screenshots are English renders, so the translated alt text and caption
 * say so. The specimens' sidebar and segmented labels are the
 * app's own in the page's language (src/data/app.ts).
 */
const width = 784;
const height = 1000;
const zh = locale === "zh-tw";
const app = appLabels[locale];
const copy = zh
  ? {
      title: "打開就想用的介面",
      intro: "凸起的按鍵、壓下的凹槽、刻出的分隔線，淺色深色都一樣。",
      alt: "Airdraft 淺色模式的 Settings 頁面，截圖為英文介面：側邊欄旁是麥克風、外觀與鍵盤快速鍵的凸起卡片。",
      compare: "比較淺色與深色外觀",
      half: "一半淺色，一半深色",
      allLight: "全部淺色",
      allDark: "全部深色",
      mixed: "{light}% 淺色，{dark}% 深色",
      materials: "視窗中的材質",
      caption:
        "以 Graphite 強調色從 App 算繪，畫面為英文介面。下一個版本起支援英文與繁體中文介面，跟隨 macOS 的語言設定。",
      drag: "拖曳即可比較淺色與深色。",
      press: ["按得下去的鍵", "在鍵盤上按住 ⌃⌥，它們也會跟著壓下。"],
      select: ["會滑動的選取", "凹槽先移動，圖示底座隨後跟上。"],
      travel: ["有行程的控制項", "旋鈕與滑塊在軌道裡滑動。"],
      keysLabel: "Control Option",
    }
  : {
      title: "An interface you’ll love to open",
      intro:
        "Raised keys, pressed wells and carved grooves, in light and dark.",
      alt: "Airdraft’s Settings page in light mode: a sidebar beside raised cards for the microphone, appearance and keyboard shortcuts.",
      compare: "Compare light and dark appearance",
      half: "Half light, half dark",
      allLight: "All light",
      allDark: "All dark",
      mixed: "{light}% light, {dark}% dark",
      materials: "Materials in the window",
      caption: "Rendered from the app with the Graphite accent.",
      drag: "Drag to compare light and dark.",
      press: ["Keys that press in", "Hold ⌃⌥ on your keyboard to press them."],
      select: [
        "Selection that slides",
        "The well moves first; the icon’s island follows.",
      ],
      travel: [
        "Controls with travel",
        "Knobs and thumbs slide inside their tracks.",
      ],
      keysLabel: "Control Option",
    };
const calloutText: Record<string, [string, string]> = zh
  ? {
      "Carved mark": ["刻出的標誌", "波形是刻進去的。"],
      "Pressed well": ["壓下的凹槽", "目前的頁面沉進去。"],
      "Raised button": ["凸起的按鈕", "控制項站起來等你按。"],
      "Raised card": ["凸起的卡片", "每個區塊浮在頁面上。"],
      "Engraved divider": ["刻線分隔", "各列以溝槽分開。"],
      "Reactive capsules": ["會反應的膠囊", "五種樣式跟著你的聲音動。"],
    }
  : {};
const callouts = [
  {
    side: "left",
    x: 24,
    y: 68,
    title: "Carved mark",
    line: "Its waveform is cut in.",
  },
  {
    side: "left",
    x: 16,
    y: 351,
    title: "Pressed well",
    line: "The current page sinks in.",
  },
  {
    side: "left",
    x: 16,
    y: 929,
    title: "Raised button",
    line: "Controls stand up to press.",
  },
  {
    side: "right",
    x: 749,
    y: 168,
    title: "Raised card",
    line: "Each section lifts off the page.",
  },
  {
    side: "right",
    x: 734,
    y: 392,
    title: "Engraved divider",
    line: "Rows split by a groove.",
  },
  {
    side: "right",
    x: 664,
    y: 606,
    title: "Reactive capsules",
    line: "Five styles follow your voice.",
  },
];
const shown = callouts.map((callout) => {
  const [title, line] = calloutText[callout.title] ?? [
    callout.title,
    callout.line,
  ];
  return { ...callout, title, line };
});
const percent = (value: number, of: number) =>
  `${((value / of) * 100).toFixed(2)}%`;

// SF Symbols from the app's sidebar, drawn as 24-point outlines.
const destinations = [
  {
    name: app.home,
    path: "M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1Z",
  },
  {
    name: app.profiles,
    path: "M12.5 5H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-6.5M17.6 3.9a1.6 1.6 0 0 1 2.3 2.3L12.5 13.6 9.5 14.5l.9-3Z",
  },
  {
    name: app.vocabulary,
    path: "M6 4.5h11.5V18H7.25A1.75 1.75 0 0 0 5.5 19.75M5.5 19.75A1.75 1.75 0 0 0 7.25 21.5H17.5M5.5 19.75V5.5a1 1 0 0 1 1-1M9 4.5V12",
  },
  {
    name: app.history,
    path: "M12 7v5l3.2 2M20.5 12a8.5 8.5 0 1 1-17 0 8.5 8.5 0 0 1 17 0Z",
  },
];
---

<Section id="interface" class="interface" title={copy.title} intro={copy.intro}>
  <figure class="showcase">
    <div class="showcase-frame" data-reveal>
      <div
        class="app-window"
        style={`aspect-ratio: ${width} / ${height};`}
        data-compare
      >
        {(["light", "dark"] as const).map((appearance) => (
          <div class={`window-face window-${appearance}`}>
            <img
              src={`/app/configuration-${appearance}.webp`}
              width={width * 2}
              height={height * 2}
              alt={appearance === "light" ? copy.alt : ""}
              loading="lazy"
              decoding="async"
              draggable="false"
            />
            <span class="window-buttons" aria-hidden="true">
              <i />
              <i />
            </span>
          </div>
        ))}
        <span class="window-divider" aria-hidden="true">
          <span class="window-knob">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
              <path
                d="M9.5 7.5 5 12l4.5 4.5M14.5 7.5 19 12l-4.5 4.5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </span>
        </span>
        <input
          class="window-range"
          type="range"
          min="0"
          max="100"
          value="50"
          aria-label={copy.compare}
          aria-valuetext={copy.half}
          data-all-light={copy.allLight}
          data-all-dark={copy.allDark}
          data-mixed={copy.mixed}
          data-compare-range
          hidden
        />
      </div>

      <ul class="callouts" aria-label={copy.materials}>
        {shown.map((callout, index) => (
          <li
            class={`callout callout-${callout.side}`}
            style={`--x: ${percent(callout.x, width)}; --y: ${percent(callout.y, height)}; --i: ${index};`}
          >
            <span class="callout-text">
              <b>{callout.title}</b>
              <span>{callout.line}</span>
            </span>
            <i class="callout-line" aria-hidden="true" />
            <i class="callout-stud" aria-hidden="true" />
          </li>
        ))}
      </ul>
    </div>
    <figcaption>
      {copy.caption}
      {zh ? "" : " "}
      <span class="js-only">{copy.drag}</span>
    </figcaption>
  </figure>

  <div class="bento specimens">
    <BentoTile art="press" title={copy.press[0]} caption={copy.press[1]}>
      <div class="spec-press" data-spec-press>
        <Keys keys={["⌃", "⌥"]} label={copy.keysLabel} size="xl" />
      </div>
    </BentoTile>

    <BentoTile art="select" title={copy.select[0]} caption={copy.select[1]}>
      <div class="spec-sidebar" data-spec-sidebar>
        <span class="spec-well" data-spec-well>
          <span class="spec-island" data-spec-island></span>
        </span>
        {destinations.map((destination, index) => (
          <button
            type="button"
            tabindex="-1"
            class:list={["spec-row", index === 0 && "is-selected"]}
            data-spec-row
          >
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none">
              <path
                d={destination.path}
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span>{destination.name}</span>
          </button>
        ))}
      </div>
    </BentoTile>

    <BentoTile art="switch" title={copy.travel[0]} caption={copy.travel[1]}>
      <div class="spec-controls" data-spec-controls>
        <button
          type="button"
          tabindex="-1"
          class="spec-switch is-on"
          data-spec-switch
        >
          <span></span>
        </button>
        <ul class="segmented" data-spec-segmented>
          <li class="is-selected">{app.holdToTalk}</li>
          <li>{app.toggle}</li>
        </ul>
      </div>
    </BentoTile>
  </div>
</Section>

<script>
  import "../scripts/interface";
</script>
