---
import Brand from "./ui/Brand.astro";
import Button from "./ui/Button.astro";
import { siteLinks } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "");
const links = [
  { href: "/pricing/", label: "Pricing", hideOnPhone: true },
  { href: "/support/", label: "Support", hideOnPhone: true },
  { href: "/changelog/", label: "Changelog", hideOnPhone: true },
];
---

<header class="site-header wrap">
  <a class="brand" href="/" aria-label="Airdraft home">
    <Brand />
  </a>
  <nav aria-label="Main navigation">
    {links.map((link) => (
      <a
        class:list={["nav-link", link.hideOnPhone && "nav-link-wide"]}
        href={link.href}
        aria-current={
          path === link.href.replace(/\/$/, "") ? "page" : undefined
        }
      >
        {link.label}
      </a>
    ))}
    <Button href={siteLinks.source} iconOnly label="Airdraft on GitHub">
      <svg
        slot="icon"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12 .75a11.25 11.25 0 0 0-3.558 21.923c.563.104.768-.244.768-.542 0-.267-.01-.974-.015-1.912-3.13.68-3.79-1.51-3.79-1.51-.512-1.3-1.25-1.646-1.25-1.646-1.022-.7.078-.685.078-.685 1.13.08 1.725 1.16 1.725 1.16 1.005 1.723 2.637 1.225 3.28.937.102-.728.393-1.225.715-1.507-2.499-.284-5.126-1.25-5.126-5.565 0-1.23.439-2.234 1.16-3.022-.116-.285-.503-1.43.11-2.98 0 0 .945-.302 3.094 1.155A10.8 10.8 0 0 1 12 6.177c.957.004 1.921.13 2.822.38 2.148-1.457 3.092-1.155 3.092-1.155.615 1.55.228 2.695.112 2.98.722.788 1.158 1.793 1.158 3.022 0 4.326-2.63 5.278-5.138 5.557.404.35.765 1.042.765 2.1 0 1.516-.014 2.74-.014 3.11 0 .3.203.652.774.542A11.252 11.252 0 0 0 12 .75Z"></path>
      </svg>
    </Button>
    <Button href="/pricing/" variant="primary" class="nav-cta">
      Get Airdraft
    </Button>
  </nav>
</header>
