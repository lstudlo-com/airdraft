---
import Brand from "./ui/Brand.astro";
import Arrow from "./Arrow.astro";
import Button from "./ui/Button.astro";
import LanguageMenu from "./LanguageMenu.astro";
import { siteLinks } from "../data/site";
import {
  href,
  languageChoices,
  languageTag,
  localeOf,
  localizedPath,
} from "../i18n";
import { messages } from "../i18n/messages";

const locale = localeOf(Astro.url.pathname);
const path = Astro.url.pathname.replace(/\/$/, "");
const copy = messages[locale].header;
// An English page linked from a translated one says so ("（英文）",
// " (inglés)"…).
const english = messages[locale].english;
const links = [
  { target: "/pricing/", label: copy.pricing },
  { target: "/support/", label: copy.support },
  { target: "/changelog/", label: copy.changelog },
].map(({ target, label }) => {
  const link = href(target, locale);
  return {
    href: link,
    label,
    hreflang: localeOf(link) === locale ? undefined : "en",
    note: localeOf(link) === locale ? "" : english,
  };
});

// Chinese and Japanese mark English pages in four characters; the other
// languages' marks need the wider header layout (languages.css).
const compactNotes = ["zh-tw", "zh-cn", "ja"].includes(locale);
const languages = languageChoices(Astro.url.pathname);
const currentLanguage = languages.find((entry) => entry.current)!;
// The globe-and-letter mark on the language key and menu row.
const languagePath =
  "M12 3.25a8.75 8.75 0 1 0 0 17.5 8.75 8.75 0 0 0 0-17.5Zm0 0c-2.3 2.4-3.45 5.32-3.45 8.75S9.7 18.35 12 20.75m0-17.5c2.3 2.4 3.45 5.32 3.45 8.75S14.3 18.35 12 20.75M3.6 9.25h16.8M3.6 14.75h16.8";
const current = links.findIndex(
  (link) => path === link.href.replace(/\/$/, ""),
);
const githubPath =
  "M12 .75a11.25 11.25 0 0 0-3.558 21.923c.563.104.768-.244.768-.542 0-.267-.01-.974-.015-1.912-3.13.68-3.79-1.51-3.79-1.51-.512-1.3-1.25-1.646-1.25-1.646-1.022-.7.078-.685.078-.685 1.13.08 1.725 1.16 1.725 1.16 1.005 1.723 2.637 1.225 3.28.937.102-.728.393-1.225.715-1.507-2.499-.284-5.126-1.25-5.126-5.565 0-1.23.439-2.234 1.16-3.022-.116-.285-.503-1.43.11-2.98 0 0 .945-.302 3.094 1.155A10.8 10.8 0 0 1 12 6.177c.957.004 1.921.13 2.822.38 2.148-1.457 3.092-1.155 3.092-1.155.615 1.55.228 2.695.112 2.98.722.788 1.158 1.793 1.158 3.022 0 4.326-2.63 5.278-5.138 5.557.404.35.765 1.042.765 2.1 0 1.516-.014 2.74-.014 3.11 0 .3.203.652.774.542A11.252 11.252 0 0 0 12 .75Z";
---

<!-- Sticky, with the app's progressive header blur behind it: six stacked
     backdrop blurs (1 to 32px), each masked to the band where the app's
     quadratic radius ramp (ProgressiveHeaderBlur.swift) reaches it. The
     labels and controls stay sharp above it. -->
<header
  class:list={[
    "site-header",
    links.some((link) => link.note) && "site-header-long",
    links.some((link) => link.note) && !compactNotes && "site-header-longer",
  ]}
>
  <div class="header-blur" aria-hidden="true">
    <i></i>
    <i></i>
    <i></i>
    <i></i>
    <i></i>
    <i></i>
  </div>
  <div class="site-header-inner wrap">
    <a class="brand" href={localizedPath("/", locale)} aria-label={copy.home}>
      <Brand />
    </a>
    <!-- The links sit at the window's true centre, not halfway between the
         mark and the keys: the row is a grid with equal outer columns.
         The current page's recessed well is one element in the links' grid
         cell, so a cross-document view transition slides it to the next
         page's link (global.css, Layout.astro), like the app's sidebar. -->
    <nav class="header-links" aria-label={copy.nav}>
      {current >= 0 && (
        <span
          class="nav-well"
          style={`--well-column: ${current + 1}`}
          aria-hidden="true"
        />
      )}
      {links.map((link, index) => (
        <a
          class="nav-link"
          href={link.href}
          hreflang={link.hreflang}
          aria-current={index === current ? "page" : undefined}
        >
          {link.label}
          {link.note && <span class="nav-note">{link.note}</span>}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <!-- The language menu: a native popover listing every language in
           its own name (LanguageMenu.astro), so it works without
           JavaScript; the footer lists the same links. -->
      <Button
        iconOnly
        label={`${copy.language}: ${currentLanguage.label}`}
        class="header-language"
        popovertarget="language-menu"
      >
        <svg
          slot="icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d={languagePath}
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          ></path>
        </svg>
      </Button>
      <Button
        href={siteLinks.source}
        iconOnly
        label={copy.github}
        class="header-source"
      >
        <svg
          slot="icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={githubPath}></path>
        </svg>
      </Button>
      <Button
        href={href("/pricing/", locale)}
        variant="primary"
        class="nav-cta"
      >
        {copy.get}
      </Button>
      <!-- Phones: the links and GitHub fold into a menu that pulls the
           header's blur down over them. The key stays sunk while it is open
           and its two strokes cross. A native popover, so it opens,
           dismisses on Escape or an outside tap, and returns focus without
           JavaScript. -->
      <Button
        iconOnly
        label={copy.menu}
        class="menu-key"
        popovertarget="site-menu"
      >
        <span slot="icon" class="menu-glyph" aria-hidden="true">
          <i></i>
          <i></i>
        </span>
      </Button>
    </div>
  </div>
  <nav id="site-menu" class="site-menu" popover aria-label={copy.nav}>
    {links.map((link, index) => (
      <a
        class="menu-link"
        href={link.href}
        hreflang={link.hreflang}
        style={`--i: ${index}`}
        aria-current={index === current ? "page" : undefined}
      >
        <span>
          {link.label}
          {link.note && <span class="nav-note">{link.note}</span>}
        </span>
      </a>
    ))}
    <span class="menu-groove" style="--i: 3" aria-hidden="true"></span>
    <a class="menu-link" href={siteLinks.source} style="--i: 4">
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d={githubPath}></path>
      </svg>
      {copy.source}
      <Arrow direction="external" />
    </a>
    <button
      type="button"
      class="menu-link menu-language"
      popovertarget="language-menu"
      style="--i: 5"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d={languagePath}
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        ></path>
      </svg>
      <span>
        {copy.language}
        <span class="nav-note" lang={languageTag[locale]}>
          {" · "}
          {currentLanguage.label}
        </span>
      </span>
    </button>
  </nav>
  <LanguageMenu
    languages={languages}
    label={copy.language}
    homeOnly={copy.homeOnly}
    pageLang={languageTag[locale]}
  />
</header>
