---
import Brand from "./ui/Brand.astro";
import { license, siteLinks } from "../data/site";
import { href, localeOf, localizedPath } from "../i18n";
import { messages } from "../i18n/messages";

// The page's language comes from the header's language menu; the footer
// links to the same pages in this language.
const locale = localeOf(Astro.url.pathname);
const label = messages[locale].footer;
const home = messages[locale].header.home;
const links = [
  { href: siteLinks.source, label: "GitHub" },
  { href: siteLinks.build, label: label.build },
  { href: href("/pricing/", locale), label: label.pricing },
  { href: href("/guides/", locale), label: label.guides },
  { href: href("/support/", locale), label: label.support },
  { href: href("/changelog/", locale), label: label.changelog },
  { href: `${localizedPath("/", locale)}changelog.xml`, label: label.rss },
  { href: href("/privacy/", locale), label: label.privacy },
  ...(license ? [{ href: license.url, label: label.license }] : []),
];
---

<footer class="site-footer wrap">
  <a class="brand" href={localizedPath("/", locale)} aria-label={home}>
    <Brand size="sm" />
  </a>
  <nav class="footer-links" aria-label={label.nav}>
    {links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
</footer>
