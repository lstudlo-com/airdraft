---
import Brand from "./ui/Brand.astro";
import { license, siteLinks } from "../data/site";
import {
  href,
  languageName,
  languageTag,
  localeOf,
  localizedPath,
  switchTarget,
} from "../i18n";

const locale = localeOf(Astro.url.pathname);
const language = switchTarget(Astro.url.pathname);
const label = {
  en: {
    home: "Airdraft home",
    nav: "Footer",
    github: "GitHub",
    build: "Build instructions",
    pricing: "Pricing",
    guides: "Guides",
    support: "Support",
    donate: "Donate",
    changelog: "Changelog",
    rss: "RSS",
    privacy: "Privacy",
    license: license?.name ?? "",
  },
  "zh-tw": {
    home: "Airdraft 首頁",
    nav: "頁尾",
    github: "GitHub",
    build: "自行編譯說明",
    pricing: "價格",
    guides: "指南（英文）",
    support: "支援",
    donate: "贊助",
    changelog: "更新紀錄",
    rss: "RSS",
    privacy: "隱私",
    license: "授權條款",
  },
}[locale];
const links = [
  { href: siteLinks.source, label: label.github },
  { href: siteLinks.build, label: label.build },
  { href: href("/pricing/", locale), label: label.pricing },
  { href: "/guides/", label: label.guides },
  { href: "/support/", label: label.support },
  { href: "/support/#fund", label: label.donate },
  { href: "/changelog/", label: label.changelog },
  { href: "/changelog.xml", label: label.rss },
  { href: "/privacy/", label: label.privacy },
  ...(license ? [{ href: license.url, label: label.license }] : []),
];
---

<footer class="site-footer wrap">
  <a class="brand" href={localizedPath("/", locale)} aria-label={label.home}>
    <Brand size="sm" />
  </a>
  <nav class="footer-links" aria-label={label.nav}>
    {links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
    <a
      href={language.path}
      hreflang={languageTag[language.locale]}
      lang={languageTag[language.locale]}
    >
      {languageName[language.locale]}
    </a>
  </nav>
</footer>
