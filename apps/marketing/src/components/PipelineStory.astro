---
import Section from "./ui/Section.astro";
import type { Locale } from "../i18n";

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const zh = locale === "zh-tw";

/**
 * "You choose where each step runs": the dictation pipeline as one raised
 * board with three columns, Speech, Refinement and Insertion. Speech and
 * Refinement each hold a segmented choice of where they run
 * (SoftSegmentedPicker); the choice swaps that column's one-line consequence
 * and its provider table, so every step's choice is visible at once and
 * independent of the others. The table is a settings table: rows divided by
 * grooves, the first resting in the sidebar's recessed selection well with a
 * raised check island. Insertion always happens at the cursor; its column
 * shows the vocabulary fix (story.ts loops it while on screen).
 *
 * The choices are native radio groups and CSS `:has()` swaps the columns, so
 * the section works without JavaScript; src/scripts/segmented.ts only adds the
 * sliding thumb. The board stacks into rows below 1000px.
 *
 * Provider lists mirror ASRProviderKind, LLMProviderKind and the local engines
 * in the root CLAUDE.md; update them together.
 */
type Place = "mac" | "cloud" | "plan";
interface Option {
  place: Place;
  label: string;
  line: string;
  items: string[];
}
interface Stage {
  id: string;
  title: string;
  options: Option[];
}

const stages: Stage[] = [
  {
    id: "speech",
    title: zh ? "語音辨識" : "Speech",
    options: [
      {
        place: "mac",
        label: zh ? "這台 Mac" : "This Mac",
        line: zh ? "音訊不會離開你的 Mac。" : "Audio never leaves your Mac.",
        items: [
          "Qwen3-ASR",
          "Whisper",
          "SenseVoice",
          "FireRedASR2",
          "Cohere Transcribe",
          "Parakeet TDT v3",
          "Apple SpeechAnalyzer",
        ],
      },
      {
        place: "cloud",
        label: zh ? "雲端" : "Cloud",
        line: zh
          ? "音訊會送到服務商，使用你自己的 API 金鑰。"
          : "Audio goes to the provider, on your own API key.",
        items: [
          "Soniox",
          "Groq",
          "ElevenLabs",
          "OpenAI",
          "Deepgram",
          "OpenRouter",
        ],
      },
    ],
  },
  {
    id: "refinement",
    title: zh ? "潤稿" : "Refinement",
    options: [
      {
        place: "mac",
        label: zh ? "這台 Mac" : "This Mac",
        line: zh
          ? "本機模型整理逐字稿，文字留在這裡。"
          : "A local model cleans up the transcript. It stays here.",
        items: [
          "Apple Intelligence",
          "LM Studio",
          "Ollama",
          "OpenAI-compatible",
        ],
      },
      {
        place: "cloud",
        label: zh ? "雲端" : "Cloud",
        line: zh
          ? "逐字稿會送到你選的服務商。"
          : "The transcript goes to the provider you pick.",
        items: [
          "OpenAI",
          "Anthropic",
          "Gemini",
          "OpenRouter",
          "Groq",
          "Cerebras",
        ],
      },
      {
        place: "plan",
        label: zh ? "訂閱方案" : "Subscription",
        line: zh
          ? "使用你已經付費的 Claude 或 ChatGPT 方案。"
          : "Uses the Claude or ChatGPT plan you already pay for.",
        items: ["Claude Code", "Codex"],
      },
    ],
  },
];

// The direction of flow, on the groove before each later column.
const arrow = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="m9.5 6.5 5.5 5.5-5.5 5.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const check = "m5 12.5 4.5 4.5L19 7.5";
---

<Section
  id="how-it-works"
  title={
    zh ? "每個步驟在哪裡執行，由你決定" : "You choose where each step runs"
  }
  intro={
    zh
      ? "語音辨識和潤稿分開執行，各自選本機或雲端。"
      : "Speech and refinement run separately. Pick local or cloud for each."
  }
>
  <div class="pipeline panel" data-reveal>
    {stages.map((stage, index) => (
      <div
        class="pipe-stage"
        role="group"
        aria-labelledby={`stage-${stage.id}`}
      >
        {index > 0 && (
          <span class="pipe-arrow" aria-hidden="true" set:html={arrow} />
        )}
        <h3 id={`stage-${stage.id}`}>{stage.title}</h3>
        <div
          class="segmented"
          role="radiogroup"
          aria-label={
            zh
              ? `${stage.title}在哪裡執行`
              : `Where ${stage.title.toLowerCase()} runs`
          }
        >
          {stage.options.map((option, choice) => (
            <label>
              <input
                type="radio"
                name={`pipeline-${stage.id}`}
                value={option.place}
                checked={choice === 0}
              />
              {option.label}
            </label>
          ))}
        </div>
        <div class="pipe-swap">
          {stage.options.map((option) => (
            <div class="pipe-option" data-place={option.place}>
              <p class="pipe-line">{option.line}</p>
              <ul class="choices">
                {option.items.map((item, position) => (
                  <li class:list={[position === 0 && "is-selected"]}>
                    {item}
                    {position === 0 && (
                      <span class="choice-island" aria-hidden="true">
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                        >
                          <path
                            d={check}
                            stroke="currentColor"
                            stroke-width="2.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    ))}
    <div class="pipe-stage" role="group" aria-labelledby="stage-insertion">
      <span class="pipe-arrow" aria-hidden="true" set:html={arrow} />
      <h3 id="stage-insertion">{zh ? "貼上" : "Insertion"}</h3>
      <p class="pipe-fixed">{zh ? "在游標位置" : "At your cursor"}</p>
      <p class="pipe-line">
        {zh
          ? "最後由你的詞彙表修正名稱，再把文字貼進你正在打字的 App。"
          : "Your vocabulary fixes names last. Then the text goes into the app you’re typing in."}
      </p>
      <div class="fix-field" data-art="fix">
        {zh ? (
          <p>
            九點在{" "}
            <span class="fix">
              <del class="fix-wrong">cooper tino</del>
              <ins class="fix-right">Cupertino</ins>
            </span>{" "}
            碰面。
            <span class="caret" aria-hidden="true" />
          </p>
        ) : (
          <p>
            Meet me in{" "}
            <span class="fix">
              <del class="fix-wrong">cooper tino</del>
              <ins class="fix-right">Cupertino</ins>
            </span>{" "}
            at nine.
            <span class="caret" aria-hidden="true" />
          </p>
        )}
      </div>
    </div>
  </div>
</Section>
