---
import Section from "./ui/Section.astro";
import type { Locale } from "../i18n";
import { messages } from "../i18n/messages";

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const copy = messages[locale].pipeline;

/**
 * "You choose where each step runs": the dictation pipeline as one raised
 * board with three columns, Speech, Refinement and Insertion. Speech and
 * Refinement each hold a segmented choice of where they run
 * (SoftSegmentedPicker); the choice swaps that column's one-line consequence
 * and its provider table, so every step's choice is visible at once and
 * independent of the others. The table is a settings table: rows divided by
 * grooves, the first resting in the sidebar's recessed selection well with a
 * raised check island. Insertion always happens at the cursor; its column
 * shows the vocabulary fix (story.ts loops it while on screen).
 *
 * The choices are native radio groups and CSS `:has()` swaps the columns, so
 * the section works without JavaScript; src/scripts/segmented.ts only adds the
 * sliding thumb. The board stacks into rows below 1000px.
 *
 * Provider lists mirror ASRProviderKind, LLMProviderKind and the local engines
 * in the root CLAUDE.md; update them together.
 */
type Place = "mac" | "cloud" | "plan";
interface Option {
  place: Place;
  label: string;
  line: string;
  items: string[];
}
interface Stage {
  id: string;
  title: string;
  options: Option[];
}

const stages: Stage[] = [
  {
    id: "speech",
    title: copy.speech,
    options: [
      {
        place: "mac",
        label: copy.mac,
        line: copy.speechMac,
        items: [
          "Qwen3-ASR",
          "Whisper",
          "SenseVoice",
          "FireRedASR2",
          "Cohere Transcribe",
          "Parakeet TDT v3",
          "Apple SpeechAnalyzer",
        ],
      },
      {
        place: "cloud",
        label: copy.cloud,
        line: copy.speechCloud,
        items: [
          "Soniox",
          "Groq",
          "ElevenLabs",
          "OpenAI",
          "Deepgram",
          "OpenRouter",
        ],
      },
    ],
  },
  {
    id: "refinement",
    title: copy.refinement,
    options: [
      {
        place: "mac",
        label: copy.mac,
        line: copy.refinementMac,
        items: [
          "Apple Intelligence",
          "LM Studio",
          "Ollama",
          "OpenAI-compatible",
        ],
      },
      {
        place: "cloud",
        label: copy.cloud,
        line: copy.refinementCloud,
        items: [
          "OpenAI",
          "Anthropic",
          "Gemini",
          "OpenRouter",
          "Groq",
          "Cerebras",
        ],
      },
      {
        place: "plan",
        label: copy.plan,
        line: copy.refinementPlan,
        items: ["Claude Code", "Codex"],
      },
    ],
  },
];

// The direction of flow, on the groove before each later column.
const arrow = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="m9.5 6.5 5.5 5.5-5.5 5.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const check = "m5 12.5 4.5 4.5L19 7.5";
---

<Section id="how-it-works" title={copy.title} intro={copy.intro}>
  <div class="pipeline panel" data-reveal>
    {stages.map((stage, index) => (
      <div
        class="pipe-stage"
        role="group"
        aria-labelledby={`stage-${stage.id}`}
      >
        {index > 0 && (
          <span class="pipe-arrow" aria-hidden="true" set:html={arrow} />
        )}
        <h3 id={`stage-${stage.id}`}>{stage.title}</h3>
        <div
          class="segmented"
          role="radiogroup"
          aria-label={copy.where(stage.title)}
        >
          {stage.options.map((option, choice) => (
            <label>
              <input
                type="radio"
                name={`pipeline-${stage.id}`}
                value={option.place}
                checked={choice === 0}
              />
              {option.label}
            </label>
          ))}
        </div>
        <div class="pipe-swap">
          {stage.options.map((option) => (
            <div class="pipe-option" data-place={option.place}>
              <p class="pipe-line">{option.line}</p>
              <ul class="choices">
                {option.items.map((item, position) => (
                  <li class:list={[position === 0 && "is-selected"]}>
                    {item}
                    {position === 0 && (
                      <span class="choice-island" aria-hidden="true">
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                        >
                          <path
                            d={check}
                            stroke="currentColor"
                            stroke-width="2.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    ))}
    <div class="pipe-stage" role="group" aria-labelledby="stage-insertion">
      <span class="pipe-arrow" aria-hidden="true" set:html={arrow} />
      <h3 id="stage-insertion">{copy.insertion}</h3>
      <p class="pipe-fixed">{copy.atCursor}</p>
      <p class="pipe-line">{copy.insertionLine}</p>
      <div class="fix-field" data-art="fix">
        <p>
          {copy.fix[0]}{" "}
          <span class="fix">
            <del class="fix-wrong">cooper tino</del>
            <ins class="fix-right">Cupertino</ins>
          </span>{" "}
          {copy.fix[1]}
          <span class="caret" aria-hidden="true" />
        </p>
      </div>
    </div>
  </div>
</Section>
