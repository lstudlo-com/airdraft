---
/**
 * A page section: a heading, an optional one-line intro, then content.
 * `level={1}` with `first` makes it a page header (no section gap above): every
 * subpage (Pricing, Support, Changelog) opens with one, so their titles share
 * one size, one top inset and the same content width.
 *
 * `sticky` (homepage stories) holds the title one header height below the
 * site header while the section's content scrolls up under it, through the
 * same progressive blur as the header (global.css, src/scripts/sticky.ts).
 * Content marked `data-follow` arrives after the title, one item at a time.
 *
 * `titleMotion` makes a held title leave as the visitor leaves the section,
 * when the next section's title comes up into the window, instead of being
 * pushed up with the section's end (motion.css, src/scripts/sticky.ts):
 *   "fade"   it holds while the content plays, then fades, opening and
 *            blurring as it goes.
 *   "cycle"  it names each item (`data-cycle`, the items' titles) as the
 *            item passes under it, then fades the same way
 *            (src/scripts/cycle.ts).
 *
 * `slow` (a share of the scroll's speed, such as 0.5) slows the content
 * after the heading once its first item starts to rise, easing down to that
 * speed and back up to the scroll's own before the visitor leaves the
 * section (src/scripts/sticky.ts).
 */
interface Props {
  id?: string;
  title: string;
  intro?: string;
  level?: 1 | 2;
  first?: boolean;
  sticky?: boolean;
  titleMotion?: "fade" | "cycle";
  cycle?: string;
  slow?: number;
  class?: string;
}

const {
  id,
  title,
  intro,
  level = 2,
  first = false,
  sticky = false,
  titleMotion,
  cycle,
  slow,
  class: className,
} = Astro.props;
const headingId = `${
  id ??
  title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "")
}-heading`;
const Heading = level === 1 ? "h1" : "h2";
---

<section
  class:list={[
    "section",
    "wrap",
    first ? "section-first" : "section-space",
    sticky && "section-sticky",
    className,
  ]}
  id={id}
  aria-labelledby={headingId}
  data-title={sticky ? titleMotion : undefined}
  data-cycle={sticky && titleMotion === "cycle" ? cycle : undefined}
  data-slow={sticky && slow ? slow : undefined}
>
  <div class="section-heading">
    {sticky && (
      <div class="header-blur heading-blur" aria-hidden="true">
        <i />
        <i />
        <i />
        <i />
        <i />
        <i />
      </div>
    )}
    <Heading id={headingId} class:list={[level === 1 && "page-title"]}>
      {title}
    </Heading>
    {intro && <p>{intro}</p>}
  </div>
  <slot />
</section>
