---
/**
 * The Airdraft mark: the app sidebar's `SidebarBrandMark`
 * (Sources/App/Views/MainWindow.swift), translated value for value. A capsule
 * whose face is the surface it sits on, lifted only by a soft shade down-right
 * and light up-left (outer shadows never paint inside the face), with five
 * waveform strokes and a separate caret carved into it as grooves. No
 * lettering, as in the app. Static: it is a mark, not a meter.
 *
 * Geometry is in the icon's 364-point capsule height: bars 38 wide, 190 × level
 * tall, 30 apart; the caret is 208 tall with 20 more space before it. `size`
 * sets the height: `md` 34px in the header, `sm` 28px (the sidebar's own size)
 * in the footer. Shadow depth scales with the height, as in the app.
 */
interface Props {
  size?: "md" | "sm";
}

const { size = "md" } = Astro.props;
const height = size === "md" ? 34 : 28;
const levels = [0.36, 0.66, 1, 0.72, 0.48];
---

<span
  class="brand-mark"
  style={`--mark-h: ${height}px; --mark-d: ${(height / 28).toFixed(3)};`}
  role="img"
  aria-label="Airdraft"
>
  {levels.map((level) => (
    <span class="brand-groove" style={`--level: ${level}`} />
  ))}
  <span class="brand-groove brand-caret"></span>
</span>
