---
interface Props {
  direction?: "right" | "down" | "external";
}
const { direction = "right" } = Astro.props;
---

<svg
  class:list={["arrow", direction]}
  width="18"
  height="18"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  <path
    d="M5 12h14m-6-6 6 6-6 6"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
