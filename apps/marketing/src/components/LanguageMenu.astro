---
import { languageTag, type Locale } from "../i18n";

/**
 * The language menu: a native popover (no JavaScript needed) opened by the
 * header's globe key or the phone menu's Language row. Each language is
 * named in itself and leads to this page in that language; every page
 * exists in every language. The menu is as wide as its longest name plus
 * the row insets. The current language rests in the recessed well, like the
 * current page in the header.
 */
interface Props {
  languages: {
    locale: Locale;
    path: string;
    current: boolean;
    label: string;
  }[];
  label: string;
}
const { languages, label } = Astro.props;
---

<nav id="language-menu" class="language-menu panel" popover aria-label={label}>
  <ul>
    {languages.map((language) => (
      <li>
        <a
          class="language-option"
          href={language.path}
          hreflang={languageTag[language.locale]}
          lang={languageTag[language.locale]}
          aria-current={language.current ? "true" : undefined}
        >
          {language.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
