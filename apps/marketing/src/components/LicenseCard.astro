---
import Button from "./ui/Button.astro";
import Surface from "./ui/Surface.astro";
import { licenseLabelsZh, licenses, siteLinks } from "../data/site";
import { href, type Locale } from "../i18n";

/**
 * The homepage close's license offer, as one raised card: a segmented choice
 * of how many Macs (SoftSegmentedPicker), then that license's price and use,
 * and "See pricing". The pricing page lists each license as its own plan.
 *
 * The choice is a native radio group, and CSS `:has()` shows the chosen
 * license's price, so it works without JavaScript; src/scripts/segmented.ts
 * only adds the sliding thumb.
 */
interface Props {
  name: string;
  locale?: Locale;
}

const { name, locale = "en" } = Astro.props;
const zh = locale === "zh-tw";
// Until checkout opens there is no official build to try, so the trial is
// described as part of the license once it is on sale.
const onSale = Boolean(siteLinks.checkout);
const plans = licenses.map((plan) =>
  zh ? { ...plan, ...licenseLabelsZh[plan.id] } : plan,
);
const copy = zh
  ? {
      title: "官方版 App",
      count: "Mac 數量",
      once: "一次買斷",
      use: (macs: string) => `可在${macs} 上個人使用。`,
      rest: onSale
        ? "全功能，可先試用 14 天。"
        : "全功能；開賣後可先試用 14 天。",
      see: "查看價格",
    }
  : {
      title: "Ready-to-run app",
      count: "Number of Macs",
      once: "one-time",
      use: (macs: string) => `Personal use on ${macs}.`,
      rest: onSale
        ? " Every feature, with a 14-day trial first."
        : " Every feature, with a 14-day trial once it’s on sale.",
      see: "See pricing",
    };
---

<Surface as="article" class="license offer offer-featured" data-offer="">
  <div class="offer-head">
    <h3>{copy.title}</h3>
    <div class="segmented" role="radiogroup" aria-label={copy.count}>
      {plans.map((plan, index) => (
        <label>
          <input
            type="radio"
            name={name}
            value={plan.id}
            data-analytics-plan={plan.id}
            checked={index === 0}
          />
          {plan.name}
        </label>
      ))}
    </div>
  </div>
  <p class="offer-price">
    <span class="license-swap">
      {plans.map((plan) => (
        <span data-plan={plan.id}>{plan.price}</span>
      ))}
    </span>
    <span class="price-unit">{copy.once}</span>
  </p>
  <p class="offer-note">
    <span class="license-swap">
      {plans.map((plan) => (
        <span data-plan={plan.id}>{copy.use(plan.macs)}</span>
      ))}
    </span>
    {copy.rest}
  </p>
  <div class="offer-foot">
    <Button
      href={href("/pricing/", locale)}
      variant="primary"
      size="lg"
      icon="right"
    >
      {copy.see}
    </Button>
  </div>
</Surface>
