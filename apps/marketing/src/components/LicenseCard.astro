---
import Button from "./ui/Button.astro";
import Surface from "./ui/Surface.astro";
import { licenses } from "../data/site";

/**
 * The homepage close's license offer, as one raised card: a segmented choice
 * of how many Macs (SoftSegmentedPicker), then that license's price and use,
 * and "See pricing". The pricing page lists each license as its own plan.
 *
 * The choice is a native radio group, and CSS `:has()` shows the chosen
 * license's price, so it works without JavaScript; src/scripts/segmented.ts
 * only adds the sliding thumb.
 */
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<Surface as="article" class="license offer offer-featured" data-offer="">
  <div class="license-head">
    <h3>Ready-to-run app</h3>
    <div class="segmented" role="radiogroup" aria-label="Number of Macs">
      {licenses.map((plan, index) => (
        <label>
          <input
            type="radio"
            name={name}
            value={plan.id}
            checked={index === 0}
          />
          {plan.name}
        </label>
      ))}
    </div>
  </div>
  <p class="offer-price">
    <span class="license-swap">
      {licenses.map((plan) => (
        <span data-plan={plan.id}>{plan.price}</span>
      ))}
    </span>
    <span class="price-unit">one-time</span>
  </p>
  <p class="offer-note">
    <span class="license-swap">
      {licenses.map((plan) => (
        <span data-plan={plan.id}>Personal use on {plan.macs}.</span>
      ))}
    </span>
    {" Every feature, with a 14-day trial first."}
  </p>
  <Button
    href="/pricing/"
    variant="primary"
    size="lg"
    icon="right"
    class="offer-action"
  >
    See pricing
  </Button>
</Surface>
