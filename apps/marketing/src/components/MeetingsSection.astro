---
import Button from "./ui/Button.astro";
import Section from "./ui/Section.astro";
import Surface from "./ui/Surface.astro";
import { appLabels } from "../data/app";
import { href, isTranslated, type Locale } from "../i18n";
import { messages } from "../i18n/messages";
import "../styles/meetings.css";

/**
 * Meetings on the homepage: a transcript card built from the app's Meetings
 * page parts (title, one metadata line, a status dot, the player row, then
 * speaker turns with their timestamps), beside what the feature does. The
 * transcript is authored sample text, not a recording or a model benchmark.
 * Speaker labels are the app's own in the page's language (src/data/app.ts).
 *
 * Every point matches docs/meeting-recording.md and
 * docs/media-transcription.md: ScreenCaptureKit app audio plus an optional
 * microphone with no screen frames, single-track files up to two hours,
 * optional local speaker estimates, Soniox only after Upload and Transcribe,
 * and TXT, JSON, SRT and VTT export.
 *
 * The player works like the app's (src/scripts/meetings.ts): it plays the
 * sample once as the card arrives, the play key toggles playback and a
 * timestamp plays from that point. It never plays sound, and it marks no
 * passage as current: the app doesn't.
 */
interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;

const copy = messages[locale].meetings;
const app = appLabels[locale];
const turns = copy.turns.map(
  ([speaker, time, text]) => [app.speaker(speaker), time, text] as const,
);
// The meeting guide is in English and Traditional Chinese.
const guideHref = href("/guides/private-meeting-transcription/", locale);
const guideInEnglish = !isTranslated(
  "/guides/private-meeting-transcription/",
  locale,
);
---

<Section id="meetings" title={copy.title} intro={copy.intro}>
  <div class="meetings" data-reveal>
    <Surface as="article" class="meeting-card" aria-label={copy.sample}>
      <div class="meeting-head">
        <span class="status-dot" aria-hidden="true"></span>
        <div>
          <p class="meeting-title">{copy.meeting}</p>
          <p class="meeting-meta">{copy.meta}</p>
        </div>
      </div>
      <div class="meeting-player" aria-hidden="true" data-meeting-player>
        <span class="meeting-play" data-meeting-play>
          <svg
            class="meeting-glyph-play"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M8 5.8a1 1 0 0 1 1.52-.85l9.24 5.7a1.58 1.58 0 0 1 0 2.7l-9.24 5.7A1 1 0 0 1 8 18.2Z"></path>
          </svg>
          <svg
            class="meeting-glyph-pause"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <rect x="6.5" y="5" width="4" height="14" rx="1.2"></rect>
            <rect x="13.5" y="5" width="4" height="14" rx="1.2"></rect>
          </svg>
        </span>
        <span class="meeting-track" data-meeting-track>
          <b></b>
        </span>
        <span class="meeting-time" data-meeting-time>
          0:31
        </span>
      </div>
      <ol class="meeting-turns">
        {turns.map(([speaker, time, text]) => (
          <li>
            <span class="meeting-speaker">
              <span class="chip-muted">{speaker}</span>
              <span class="meeting-stamp" data-seek={time}>
                {time}
              </span>
            </span>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </Surface>

    <Surface class="meeting-points">
      <dl>
        {copy.points.map(([title, line]) => (
          <div>
            <dt>{title}</dt>
            <dd>{line}</dd>
          </div>
        ))}
      </dl>
      <Button
        href={guideHref}
        variant="quiet"
        icon="right"
        hreflang={guideInEnglish ? "en" : undefined}
      >
        {copy.guide}
        {guideInEnglish && messages[locale].english}
      </Button>
    </Surface>
  </div>
</Section>

<script>
  import "../scripts/meetings";
</script>
