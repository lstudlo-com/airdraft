---
import Button from "./ui/Button.astro";
import Section from "./ui/Section.astro";
import Surface from "./ui/Surface.astro";
import { appLabels } from "../data/app";
import { href, type Locale } from "../i18n";
import "../styles/meetings.css";

/**
 * Meetings on the homepage: a transcript card built from the app's Meetings
 * page parts (title, one metadata line, a status dot, the player row, then
 * speaker turns with their timestamps), beside what the feature does. The
 * transcript is authored sample text, not a recording or a model benchmark.
 * Speaker labels are the app's own in the page's language (src/data/app.ts).
 *
 * Every point matches docs/meeting-recording.md and
 * docs/media-transcription.md: ScreenCaptureKit app audio plus an optional
 * microphone with no screen frames, single-track files up to two hours,
 * optional local speaker estimates, Soniox only after Upload and Transcribe,
 * and TXT, JSON, SRT and VTT export.
 *
 * The player works like the app's (src/scripts/meetings.ts): it plays the
 * sample once as the card arrives, the play key toggles playback and a
 * timestamp plays from that point ("Play from this timestamp"). It never
 * plays sound, and it marks no passage as current: the app doesn't.
 */
interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;

const copy = {
  en: {
    title: "Meetings, transcribed on your Mac",
    intro:
      "Record a call or import a file, then turn it into a transcript with speakers.",
    sample: "Sample meeting transcript",
    meeting: "Design review",
    meta: "Oct 21 · 32:14 · Whisper Large v3 Turbo",
    turns: [
      [
        appLabels.en.speaker(1),
        "0:12",
        "Let’s ship the onboarding changes on Thursday.",
      ],
      [
        appLabels.en.speaker(2),
        "0:31",
        "Then I’ll update the screenshots before the release.",
      ],
    ],
    points: [
      [
        "Record any app",
        "One app or all apps, plus your microphone. No screen video.",
      ],
      [
        "Or import a file",
        "Audio or video up to two hours, with one audio track.",
      ],
      [
        "Speakers, estimated locally",
        "Optional speaker labels you can rename and reassign.",
      ],
      [
        "Local unless you choose cloud",
        "A local model keeps the audio here; Soniox uploads only after you confirm.",
      ],
      [
        "Edit, then export",
        "Keep the original beside your edits. Export TXT, JSON, SRT or VTT.",
      ],
    ],
    guide: "Read the Meeting Guide",
  },
  "zh-tw": {
    title: "會議錄音，在 Mac 上轉成逐字稿",
    intro: "錄下通話或匯入檔案，整理成標出講者的逐字稿。",
    sample: "會議逐字稿範例",
    meeting: "設計週會",
    meta: "10 月 21 日 · 32:14 · Qwen3-ASR 1.7B",
    turns: [
      [appLabels["zh-tw"].speaker(1), "0:12", "onboarding 的改動週四上線。"],
      [
        appLabels["zh-tw"].speaker(2),
        "0:31",
        "那我 release 前先把 screenshot 更新好。",
      ],
    ],
    points: [
      ["錄下任何 App 的聲音", "單一或所有 App，可加錄麥克風；不錄畫面。"],
      ["也能匯入檔案", "音訊或影片，最長兩小時、單一音軌。"],
      ["在本機估算講者", "講者標籤可選用，能改名或重新指派。"],
      ["用本機模型就不上傳", "選 Soniox 雲端轉錄時，經你確認才上傳。"],
      ["編輯後匯出", "保留原文，可匯出 TXT、JSON、SRT 或 VTT。"],
    ],
    guide: "會議逐字稿指南",
  },
}[locale];
---

<Section id="meetings" title={copy.title} intro={copy.intro}>
  <div class="meetings" data-reveal>
    <Surface as="article" class="meeting-card" aria-label={copy.sample}>
      <div class="meeting-head">
        <span class="status-dot" aria-hidden="true"></span>
        <div>
          <p class="meeting-title">{copy.meeting}</p>
          <p class="meeting-meta">{copy.meta}</p>
        </div>
      </div>
      <div class="meeting-player" aria-hidden="true" data-meeting-player>
        <span class="meeting-play" data-meeting-play>
          <svg
            class="meeting-glyph-play"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M8 5.8a1 1 0 0 1 1.52-.85l9.24 5.7a1.58 1.58 0 0 1 0 2.7l-9.24 5.7A1 1 0 0 1 8 18.2Z"></path>
          </svg>
          <svg
            class="meeting-glyph-pause"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <rect x="6.5" y="5" width="4" height="14" rx="1.2"></rect>
            <rect x="13.5" y="5" width="4" height="14" rx="1.2"></rect>
          </svg>
        </span>
        <span class="meeting-track" data-meeting-track>
          <b></b>
        </span>
        <span class="meeting-time" data-meeting-time>
          0:31
        </span>
      </div>
      <ol class="meeting-turns">
        {copy.turns.map(([speaker, time, text]) => (
          <li>
            <span class="meeting-speaker">
              <span class="chip-muted">{speaker}</span>
              <span class="meeting-stamp" data-seek={time}>
                {time}
              </span>
            </span>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </Surface>

    <Surface class="meeting-points">
      <dl>
        {copy.points.map(([title, line]) => (
          <div>
            <dt>{title}</dt>
            <dd>{line}</dd>
          </div>
        ))}
      </dl>
      <Button
        href={href("/guides/private-meeting-transcription/", locale)}
        variant="quiet"
        icon="right"
      >
        {copy.guide}
      </Button>
    </Surface>
  </div>
</Section>

<script>
  import "../scripts/meetings";
</script>
