---
import Arrow from "./Arrow.astro";
import Button from "./ui/Button.astro";
import Hud from "./ui/Hud.astro";
import { appLabels } from "../data/app";
import type { Locale } from "../i18n";
import { messages } from "../i18n/messages";

/**
 * The authored sample dictation (src/scripts/preview.ts). Each language has
 * its own spoken line and profile results (src/i18n/messages); the script
 * reads them from data attributes. Profile names and HUD states are the
 * app's own labels in the page's language (src/data/app.ts).
 */
interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const copy = messages[locale].preview;
const app = appLabels[locale];
const labels = {
  stop: copy.stop,
  again: copy.again,
  run: copy.run,
  placeholder: copy.placeholder,
  listening: app.listening,
  transcribing: app.transcribing,
  refining: app.refining,
};
const profiles = [
  ["clean", app.clean],
  ["concise", app.concise],
  ["summary", app.summary],
] as const;
---

<section
  class="preview panel"
  id="try"
  aria-label={copy.name}
  data-preview
  data-examples={JSON.stringify(copy.examples)}
  data-labels={JSON.stringify(labels)}
>
  <div class="preview-stage">
    <div class="spoken well">
      <span class="field-label">{copy.said}</span>
      <p data-spoken>
        {copy.spoken.map((part) =>
          typeof part === "string" ? (
            part
          ) : (
            <span class="filler struck">{part.filler}</span>
          ),
        )}
      </p>
    </div>
    <span class="stage-arrow" aria-hidden="true">
      <Arrow />
    </span>
    <div class="written" data-written>
      <span class="field-label">{copy.inserts}</span>
      <div class="result-copy" aria-live="polite" data-result>
        <p>
          {copy.examples.clean}
          <span class="caret" aria-hidden="true"></span>
        </p>
      </div>
      <div
        class="segmented"
        role="group"
        aria-label={copy.picker}
        data-profile-picker
        hidden
      >
        {profiles.map(([id, name], index) => (
          <button
            type="button"
            data-profile={id}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {name}
          </button>
        ))}
      </div>
    </div>
  </div>
  <div class="preview-controls">
    <Button class="run-button" data-play hidden>
      <svg
        slot="icon"
        class="play-symbol"
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M8 5.8a1 1 0 0 1 1.52-.85l9.24 5.7a1.58 1.58 0 0 1 0 2.7l-9.24 5.7A1 1 0 0 1 8 18.2Z"></path>
      </svg>
      <span slot="icon" class="stop-symbol" aria-hidden="true"></span>
      <span data-play-label>{copy.run}</span>
    </Button>
    <Hud locale={locale} />
    <p class="preview-status" aria-live="polite" data-status></p>
  </div>
  <noscript>
    <p class="no-script-note">{copy.noscript}</p>
  </noscript>
</section>

<script>
  import "../scripts/preview";
</script>
