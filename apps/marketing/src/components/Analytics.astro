---
import Button from "./ui/Button.astro";
import "../styles/analytics.css";
import { localizedPath, type Locale } from "../i18n";
import { messages } from "../i18n/messages";

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
// The notice in the page's language, linking to the privacy page in it.
const text = messages[locale];
const copy = { ...text.analytics, gap: text.gap };

if (import.meta.env.PUBLIC_POSTHOG_ENABLED === "true") {
  if (
    !/^phc_[a-zA-Z0-9]+$/.test(import.meta.env.PUBLIC_POSTHOG_KEY?.trim() || "")
  ) {
    throw new Error(
      "PostHog requires a public phc_ project token when enabled.",
    );
  }
  if (
    !["https://us.i.posthog.com", "https://eu.i.posthog.com"].includes(
      import.meta.env.PUBLIC_POSTHOG_HOST?.trim() || "",
    )
  ) {
    throw new Error(
      "PUBLIC_POSTHOG_HOST must be the US or EU PostHog ingestion origin.",
    );
  }
}
---

<aside
  class="analytics-notice panel"
  aria-labelledby="analytics-title"
  data-analytics-notice
  hidden
>
  <div>
    <h2 id="analytics-title">{copy.title}</h2>
    <p>
      {copy.body}
      {copy.gap}
      <a href={localizedPath("/privacy/", locale)}>{copy.privacy}</a>
    </p>
  </div>
  <div class="analytics-actions">
    <Button data-analytics-choice="denied">{copy.decline}</Button>
    <Button data-analytics-choice="granted">{copy.allow}</Button>
  </div>
</aside>
<script>
  import "../scripts/analytics";
</script>
