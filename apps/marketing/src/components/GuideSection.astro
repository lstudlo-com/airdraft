---
/**
 * One section of a guide or a text page: a numbered heading on the island,
 * then its content on the island at a reading measure. The section gives no
 * box of its own; what it holds brings its material (guides.css): steps
 * become a numbered rail, choices and labelled lists raised cards, tables
 * and troubleshooting rows a raised panel. `aside` makes the section a
 * raised side card beside the others (Support's "Still stuck?").
 */
interface Props {
  id: string;
  title: string;
  aside?: boolean;
  class?: string;
}
const { id, title, aside = false, class: className } = Astro.props;
---

<section
  class:list={["guide-section", aside && "guide-aside", className]}
  aria-labelledby={id}
>
  <h2 id={id}>{title}</h2>
  <div class="guide-body">
    <slot />
  </div>
</section>
