---
import Button from "./ui/Button.astro";
import Surface from "./ui/Surface.astro";
import { guidesFor } from "../data/guides";
import type { Locale } from "../i18n";
import "../styles/guides.css";

interface Props {
  exclude?: string;
  headingLevel?: 2 | 3;
  locale?: Locale;
}

const { exclude, headingLevel = 3, locale = "en" } = Astro.props;
const read = locale === "zh-tw" ? "閱讀指南" : "Read Guide";
const readLabel = locale === "zh-tw" ? "閱讀指南：" : "Read guide: ";
const Heading = headingLevel === 2 ? "h2" : "h3";
const entries = guidesFor(locale).filter((guide) => guide.slug !== exclude);
---

<ul class="guide-links">
  {entries.map((guide) => (
    <Surface as="li" class="guide-link-card">
      <Heading>
        <a href={guide.href}>{guide.title}</a>
      </Heading>
      <p>{guide.summary}</p>
      <Button
        href={guide.href}
        variant="quiet"
        icon="right"
        aria-label={`${readLabel}${guide.title}`}
      >
        {read}
      </Button>
    </Surface>
  ))}
</ul>
