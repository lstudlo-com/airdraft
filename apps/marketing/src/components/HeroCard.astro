---
import Hud from "./ui/Hud.astro";
import Keys from "./ui/Keys.astro";
import Waveform from "./ui/Waveform.astro";
import type { Locale } from "../i18n";
import { appLabels } from "../data/app";

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const app = appLabels[locale];

/**
 * The hero object: Home's hero card from the app, without its metrics (the
 * site never shows usage counts). In the app each bar is one dictation; here
 * the forty bars are decorative and their heights are a fixed pattern, not
 * data. The card is only the well, with equal insets on every side. The
 * app's own first-run instruction (src/data/app.ts) stays for assistive
 * technology only, and it works: holding ⌃⌥ (or pressing and holding the
 * waveform) plays a pretend dictation that adds a bar, while the recording
 * pill floats under the card (src/scripts/dictate.ts).
 */
const count = 40;
const levels = Array.from({ length: count }, (_, index) => {
  // A deterministic spread of dictation lengths, shaped like the app's
  // 0.26 + 0.74 × √share mapping.
  const noise = Math.abs(Math.sin((index + 1) * 12.9898) * 43758.5453) % 1;
  const swell = 0.5 + 0.5 * Math.sin(index * 0.45);
  const share = Math.min(1, 0.15 + 0.55 * noise + 0.3 * swell);
  return 0.26 + 0.74 * Math.sqrt(share);
});
---

<div class="hero-card" data-dictate>
  <Waveform levels={levels} />
  <p class="visually-hidden">
    {app.hold} <Keys keys={["⌃", "⌥"]} label="Control Option" /> {app.holdAfter}
  </p>
  <Hud class="hero-hud" locale={locale} />
</div>

<script>
  import "../scripts/dictate";
</script>
