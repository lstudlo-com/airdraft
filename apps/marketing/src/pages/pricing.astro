---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Button from "../components/ui/Button.astro";
import Disclosure from "../components/ui/Disclosure.astro";
import Section from "../components/ui/Section.astro";
import Surface from "../components/ui/Surface.astro";
import Check from "../components/Check.astro";
import {
  licenseIncludes,
  licenses,
  siteLinks,
  sourceIncludes,
} from "../data/site";
import "../styles/pricing.css";
import {
  costRows,
  formatUSD,
  pricesCheckedOn,
  totalAfter,
  workload,
  workloadSummary,
} from "../data/pricing";

// One primary key per page: the one-Mac license once checkout is open, until
// then the source build, which is the path available today.
const onSale = Boolean(siteLinks.checkout);

const n = (value: number) => value.toLocaleString("en-US");
// Each setup's three-year total as a share of the most expensive, for the
// bar under it.
const mostInThreeYears = Math.max(...costRows.map((row) => totalAfter(row, 3)));
const costGroups = [
  { label: "Airdraft", rows: costRows.filter((row) => row.airdraft) },
  { label: "Subscriptions", rows: costRows.filter((row) => !row.airdraft) },
];
// Row order across both groups, for the rows' staggered entrance (motion.css).
const rowIndex = (row: (typeof costRows)[number]) => costRows.indexOf(row);
---

<Layout
  title="Pricing — Airdraft"
  description="Airdraft is free to build from source. The ready-to-run app is a one-time license: $29 for one Mac or $49 for up to three."
>
  <SiteHeader />
  <main id="main" class="island subpage">
    <Section
      level={1}
      first
      title="Pricing"
      intro="Build it free, or buy the ready-to-run app once."
    >
      <div class="plans">
        <Surface as="article" class="plan plan-source">
          <h2>Open source</h2>
          <div class="tier">
            <h3>Build it yourself</h3>
            <p class="plan-price">$0</p>
            <Button
              href={siteLinks.build}
              variant={onSale ? "secondary" : "primary"}
              icon="external"
            >
              Build instructions
            </Button>
          </div>
          <ul class="plan-includes" aria-label="The source build includes">
            {sourceIncludes.map((feature) => (
              <li>
                <Check />
                {feature}
              </li>
            ))}
          </ul>
        </Surface>

        <Surface as="article" class="plan plan-app">
          <h2>Ready-to-run app</h2>
          <div class="tiers">
            {licenses.map((plan, index) => (
              <div class="tier">
                <h3>{plan.title}</h3>
                <p class="plan-price">
                  {plan.price}
                  <span class="price-unit">one-time</span>
                </p>
                {onSale ? (
                  <Button
                    href={siteLinks.checkout}
                    data-analytics-plan={plan.id}
                    variant={index === 0 ? "primary" : "secondary"}
                    icon="external"
                  >
                    Buy for {plan.macs}
                  </Button>
                ) : (
                  <Button disabled>Not on sale yet</Button>
                )}
              </div>
            ))}
          </div>
          <ul class="plan-includes" aria-label="Every license includes">
            {licenseIncludes.map((feature) => (
              <li>
                <Check />
                {feature}
              </li>
            ))}
          </ul>
        </Surface>
      </div>
      <p class="pricing-note">US dollars, before tax.</p>
    </Section>

    <Section
      id="provider-costs"
      title="What a year of dictation costs"
      intro={`The same ${n(workloadSummary.dictationsPerMonth)} dictations a month, five ways.`}
    >
      <Surface class="cost-table-wrap">
        <table class="cost-table">
          <thead>
            <tr>
              <th scope="col">Setup</th>
              <th scope="col" class="cost-optional">
                Per month
              </th>
              <th scope="col">First year</th>
              <th scope="col">Three years</th>
            </tr>
          </thead>
          {costGroups.map((group) => (
            <tbody
              class:list={[
                group.rows[0]?.airdraft === false && "cost-subscription",
              ]}
            >
              <tr
                class="cost-group"
                style={`--row: ${rowIndex(group.rows[0])}`}
              >
                <th scope="colgroup" colspan="4">
                  {group.label}
                </th>
              </tr>
              {group.rows.map((row) => (
                <tr style={`--row: ${rowIndex(row)}`}>
                  <th scope="row">
                    {row.name}
                    <span class="cost-detail">{row.detail}</span>
                  </th>
                  <td class="cost-optional">{formatUSD(row.monthly)}</td>
                  <td>{formatUSD(totalAfter(row, 1))}</td>
                  <td>
                    {formatUSD(totalAfter(row, 3))}
                    <span
                      class="cost-bar"
                      style={`--share: ${totalAfter(row, 3) / mostInThreeYears}`}
                      aria-hidden="true"
                    >
                      <b />
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </Surface>
      <p class="pricing-note">
        {workload.dictationsPerDay} dictations a workday,{" "}
        {workload.secondsPerDictation} seconds each, with the one-Mac license.
        Speech: Parakeet or Groq Whisper Large v3 Turbo. Refinement: Apple
        Intelligence, LM Studio or Qwen 3.8 27B on Cerebras (
        {n(workload.inputTokens)} tokens in, {workload.outputTokens} out). List
        prices, {pricesCheckedOn}.
      </p>
    </Section>

    <Section id="pricing-questions" title="Questions">
      <div class="question-list panel">
        <Disclosure summary="Is it a subscription?">
          <p>
            No. A license is a one-time purchase and doesn’t expire. Updates to
            the version you buy are included.
          </p>
        </Disclosure>
        <Disclosure summary="What’s the difference between the licenses?">
          <p>
            Only how many Macs can use it at once. To move a license, deactivate
            the old Mac.
          </p>
        </Disclosure>
        <Disclosure summary="Can I try it first?">
          <p>
            Yes. The app has a 14-day trial with every feature, starting when
            you choose, not when you install.
          </p>
        </Disclosure>
        <Disclosure summary="What do cloud providers cost?">
          <p>
            They bill you directly, per use, with your own API key kept in the
            Keychain. Local models are free; Claude Code and Codex use your
            existing subscription.
          </p>
        </Disclosure>
      </div>
    </Section>
  </main>
  <SiteFooter />
</Layout>
