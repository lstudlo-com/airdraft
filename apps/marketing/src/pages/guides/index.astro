---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import GuideLinks from "../../components/GuideLinks.astro";
import Section from "../../components/ui/Section.astro";
import Button from "../../components/ui/Button.astro";
import "../../styles/guides.css";
---

<Layout
  title="Mac dictation setup and model guides | Airdraft"
  description="Practical Airdraft guides for offline Mac dictation in your language, mixed Chinese and English, dictating into Claude Code and terminals, local and cloud models, private meeting transcription, comparisons with other apps, and the free source build or official app."
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Guides", path: "/guides/" },
  ]}
>
  <SiteHeader />
  <main id="main" class="island subpage">
    <Section
      level={1}
      first
      title="Dictation guides"
      intro="Airdraft is an open-source Mac app: hold a shortcut, speak and release to insert text at your cursor, or turn meeting recordings into transcripts. Pick the setup that fits your languages, your Mac and your data."
    >
      <GuideLinks headingLevel={2} detail />
      <p class="guide-hub-note">
        Already set up and something is wrong?{" "}
        <a href="/support/">
          Check permissions, shortcuts and common problems.
        </a>
      </p>
      <div class="guide-actions">
        <Button href="/pricing/" variant="quiet" icon="right">
          Compare Pricing
        </Button>
        <Button href="/changelog/" variant="quiet" icon="right">
          See What Changed
        </Button>
      </div>
    </Section>
  </main>
  <SiteFooter />
</Layout>
