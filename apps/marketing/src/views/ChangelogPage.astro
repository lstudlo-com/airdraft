---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Arrow from "../components/Arrow.astro";
import Section from "../components/ui/Section.astro";
import Surface from "../components/ui/Surface.astro";
import { changelogFor } from "../data/changelogs";
import { href, languageTag, type Locale } from "../i18n";
import { pages } from "../locales";
import "../styles/changelog.css";

/** The release history, in each language. */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = pages[locale].changelog;
const changelog = changelogFor(locale);
const tag = languageTag[locale];

const formatDate = (date: string) =>
  new Intl.DateTimeFormat(tag, {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${date}T00:00:00Z`));
const shortDate = (date: string) =>
  new Intl.DateTimeFormat(tag, {
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${date}T00:00:00Z`));
// The English data names its links "Release notes" or "Initial source".
const sourceLabel = (label: string) =>
  label === "Initial source" ? copy.initialSource : copy.releaseNotes;

// Navigate by release family; patch releases remain readable in the timeline.
const series = (version?: string) =>
  version?.split(".").slice(0, 2).join(".") ?? copy.source;
const milestones = changelog.filter(
  (entry, index) =>
    index === 0 ||
    series(entry.version) !== series(changelog[index - 1].version),
);
---

<Layout title={copy.title} description={copy.description}>
  <SiteHeader />
  <main id="main" class="island subpage">
    <Section level={1} first title={copy.heading}>
      <div class="release-layout" data-changelog>
        <nav class="release-nav" aria-label={copy.nav}>
          <div class="release-nav-links">
            <span class="release-nav-thumb" aria-hidden="true"></span>
            {milestones.map((entry) => (
              <a href={`#${entry.id}`} data-release-link>
                <span>{series(entry.version)}</span>
                <span class="release-nav-date">{shortDate(entry.date)}</span>
              </a>
            ))}
          </div>
        </nav>
        <div class="release-timeline">
          <div class="release-track" aria-hidden="true">
            <span></span>
          </div>
          {changelog.map((entry, index) => (
            <article
              class="release-entry"
              aria-labelledby={`${entry.id}-title`}
              id={entry.id}
              tabindex="-1"
              data-release
            >
              <span class="release-stud" aria-hidden="true"></span>
              <div class="release-meta">
                <span class="release-version">
                  {entry.version ?? copy.source}
                </span>
                <time datetime={entry.date}>{formatDate(entry.date)}</time>
                {index === 0 && <span class="tag">{copy.latest}</span>}
              </div>
              <Surface class="release-card">
                <h2 id={`${entry.id}-title`}>
                  <a href={`#${entry.id}`}>{entry.title}</a>
                </h2>
                <ul class="release-changes">
                  {entry.changes.map((change) => (
                    <li>
                      <h3>{change.title}</h3>
                      <p>{change.description}</p>
                    </li>
                  ))}
                </ul>
                <a
                  class="text-link release-source"
                  href={entry.source.url}
                  aria-label={copy.sourceFor(
                    sourceLabel(entry.source.label),
                    entry.version ?? copy.firstBuild,
                  )}
                >
                  {sourceLabel(entry.source.label)}{" "}
                  <Arrow direction="external" />
                </a>
              </Surface>
            </article>
          ))}
          <p class="release-availability">
            {copy.availability[0]}
            <a class="text-link" href={href("/support/", locale)}>
              {copy.availability[1]}
            </a>
            {copy.availability[2]}
          </p>
        </div>
      </div>
    </Section>
  </main>
  <SiteFooter />
  <script>
    import "../scripts/changelog";
  </script>
</Layout>
