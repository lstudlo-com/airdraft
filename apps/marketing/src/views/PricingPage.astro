---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Button from "../components/ui/Button.astro";
import Disclosure from "../components/ui/Disclosure.astro";
import Section from "../components/ui/Section.astro";
import Surface from "../components/ui/Surface.astro";
import Check from "../components/Check.astro";
import NotifyRow from "../components/NotifyRow.astro";
import Rich from "../components/Rich.astro";
import { licenses, siteLinks } from "../data/site";
import "../styles/pricing.css";
import {
  costRows,
  formatUSD,
  pricesCheckedOn,
  totalAfter,
  workload,
  workloadSummary,
} from "../data/pricing";
import { languageTag, localizedPath, type Locale } from "../i18n";
import { pages } from "../locales";
import { messages } from "../i18n/messages";

/**
 * The pricing page, in each language (src/pages/pricing.astro and
 * src/pages/<language>/pricing.astro). Prices, license terms and the cost
 * comparison come from src/data; the wording comes from src/i18n/messages.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = messages[locale].pricing;
const planNames = messages[locale].license.plans;
const breadcrumbs = [
  { name: pages[locale].chrome.home, path: localizedPath("/", locale) },
  { name: copy.heading, path: localizedPath("/pricing/", locale) },
];

// One primary key per page: the one-Mac license once checkout is open, until
// then the source build, which is the path available today.
const onSale = Boolean(siteLinks.checkout);

// Western digits in every language, grouped the language's way.
const numbers = new Intl.NumberFormat(languageTag[locale]);
const n = (value: number) =>
  locale === "en" || locale === "zh-tw"
    ? value.toLocaleString("en-US")
    : numbers.format(value);
// Each setup's three-year total as a share of the most expensive, for the
// bar under it.
const mostInThreeYears = Math.max(...costRows.map((row) => totalAfter(row, 3)));
const plans = licenses.map((plan) => ({ ...plan, ...planNames[plan.id] }));
const rowLabel = (row: (typeof costRows)[number]) => copy.rows[row.id];
const note = copy.note({
  checked: copy.checked(pricesCheckedOn),
  perDay: workload.dictationsPerDay,
  seconds: workload.secondsPerDictation,
  inputTokens: n(workload.inputTokens),
  outputTokens: workload.outputTokens,
});
const questions = [
  copy.faq.subscription,
  copy.faq.licenses,
  onSale ? copy.faq.trial : copy.faq.trialNotOnSale,
  copy.faq.editions,
  copy.faq.providers,
  copy.faq.compare,
];

const costGroups = [
  { label: copy.groups[0], rows: costRows.filter((row) => row.airdraft) },
  { label: copy.groups[1], rows: costRows.filter((row) => !row.airdraft) },
];
// Row order across both groups, for the rows' staggered entrance (motion.css).
const rowIndex = (row: (typeof costRows)[number]) => costRows.indexOf(row);
---

<Layout
  title={copy.title}
  description={copy.description}
  breadcrumbs={breadcrumbs}
>
  <SiteHeader />
  <main id="main" class="island subpage">
    <Section
      id="pricing"
      level={1}
      first
      title={copy.heading}
      intro={copy.intro}
    >
      <div class="plans">
        <Surface as="article" class="plan plan-source">
          <h2>{copy.source}</h2>
          <div class="tier">
            <h3>{copy.build}</h3>
            <p class="price">$0</p>
            <Button
              href={siteLinks.build}
              variant={onSale ? "secondary" : "primary"}
              icon="external"
            >
              {copy.buildAction}
            </Button>
          </div>
          <ul class="plan-includes" aria-label={copy.sourceList}>
            {copy.sourceIncludes.map((feature) => (
              <li>
                <Check />
                {feature}
              </li>
            ))}
          </ul>
        </Surface>

        <Surface as="article" class="plan plan-app">
          <h2>{copy.app}</h2>
          <div class="tiers">
            {plans.map((plan, index) => (
              <div class="tier">
                <h3>{plan.title}</h3>
                <p class="price">
                  {plan.price}
                  <span class="price-unit">{copy.once}</span>
                </p>
                {onSale ? (
                  <Button
                    href={siteLinks.checkout}
                    data-analytics-plan={plan.id}
                    variant={index === 0 ? "primary" : "secondary"}
                    icon="external"
                  >
                    {copy.buy(plan.macs)}
                  </Button>
                ) : (
                  <Button disabled>{copy.notOnSale}</Button>
                )}
              </div>
            ))}
          </div>
          <ul class="plan-includes" aria-label={copy.appList}>
            {copy.licenseIncludes.map((feature) => (
              <li>
                <Check />
                {feature}
              </li>
            ))}
          </ul>
        </Surface>
      </div>
      <p class="pricing-note">{copy.currency}</p>
      <NotifyRow locale={locale} />
    </Section>

    <Section
      id="provider-costs"
      title={copy.costTitle}
      intro={copy.costIntro(n(workloadSummary.dictationsPerMonth))}
    >
      <Surface class="cost-table-wrap">
        <table class="cost-table">
          <thead>
            <tr>
              <th scope="col">{copy.columns[0]}</th>
              <th scope="col" class="cost-optional">
                {copy.columns[1]}
              </th>
              <th scope="col">{copy.columns[2]}</th>
              <th scope="col">{copy.columns[3]}</th>
            </tr>
          </thead>
          {costGroups.map((group) => (
            <tbody
              class:list={[
                group.rows[0]?.airdraft === false && "cost-subscription",
              ]}
            >
              <tr
                class="cost-group"
                style={`--row: ${rowIndex(group.rows[0])}`}
              >
                <th scope="colgroup" colspan="4">
                  {group.label}
                </th>
              </tr>
              {group.rows.map((row) => (
                <tr style={`--row: ${rowIndex(row)}`}>
                  <th scope="row">
                    {rowLabel(row).name}
                    <span class="cost-detail">{rowLabel(row).detail}</span>
                  </th>
                  <td class="cost-optional">{formatUSD(row.monthly)}</td>
                  <td>{formatUSD(totalAfter(row, 1))}</td>
                  <td>
                    {formatUSD(totalAfter(row, 3))}
                    <span
                      class="cost-bar"
                      style={`--share: ${totalAfter(row, 3) / mostInThreeYears}`}
                      aria-hidden="true"
                    >
                      <b />
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </Surface>
      <p class="pricing-note">{note}</p>
    </Section>

    <Section id="pricing-questions" title={copy.questions}>
      <div class="question-list panel">
        {questions.map(([question, answer]) => (
          <Disclosure summary={question}>
            <p>
              <Rich parts={answer} locale={locale} />
            </p>
          </Disclosure>
        ))}
      </div>
    </Section>
  </main>
  <SiteFooter />
</Layout>
