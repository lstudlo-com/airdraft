---
import Layout from "../layouts/Layout.astro";
import Arrow from "../components/Arrow.astro";
import DictationPreview from "../components/DictationPreview.astro";
import GetAirdraft from "../components/GetAirdraft.astro";
import HeroCard from "../components/HeroCard.astro";
import InterfaceShowcase from "../components/InterfaceShowcase.astro";
import MeetingsSection from "../components/MeetingsSection.astro";
import PipelineStory from "../components/PipelineStory.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import GuideLinks from "../components/GuideLinks.astro";
import BentoTile from "../components/ui/BentoTile.astro";
import Button from "../components/ui/Button.astro";
import Chip from "../components/ui/Chip.astro";
import Disclosure from "../components/ui/Disclosure.astro";
import Rich from "../components/Rich.astro";
import Hud from "../components/ui/Hud.astro";
import Keys from "../components/ui/Keys.astro";
import Section from "../components/ui/Section.astro";
import { appLabels } from "../data/app";
import { siteLinks } from "../data/site";
import { href, type Locale } from "../i18n";
import { messages } from "../i18n/messages";

// Language names for the mixed-language tile, each in itself.
const sampleLanguage: Record<string, string> = {
  es: "Español",
  ja: "日本語",
  "zh-Hant": "繁體中文",
  "zh-Hans": "简体中文",
  fr: "Français",
  "pt-BR": "Português",
  ru: "Русский",
  ar: "العربية",
  hi: "हिन्दी",
  id: "Indonesia",
};

/**
 * The homepage, in each language (src/pages/index.astro and
 * src/pages/<language>/index.astro). Copy differs (src/i18n/messages);
 * structure, components and motion are shared. App UI labels (HUD states,
 * Refined/Original, status lines, profile names) use the app's own labels in
 * the page's language (src/data/app.ts).
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const app = appLabels[locale];

const copy = messages[locale].home;
// Until checkout opens, the hero's key leads to Get Airdraft on this page,
// which offers the free source build and how to hear about the app.
const onSale = Boolean(siteLinks.checkout);
const questions = [
  onSale ? copy.faq.price : copy.faq.priceNotOnSale,
  copy.faq.macs,
  copy.faq.offline,
  copy.faq.data,
  copy.faq.apple,
];

const outputs = [...copy.outputs, copy.spoken];
// The app's built-in profile names, as it shows them in this language.
const profiles = [app.clean, app.concise, app.summary, app.verbatim];
// The mixed-language tile: the app's Chinese script picker over one
// sentence, or one sentence per language with English terms in it.
const mixed =
  copy.mixed.kind === "script"
    ? {
        choices: [
          { label: "繁體中文", lang: "zh-Hant" },
          { label: "简体中文", lang: "zh-Hans" },
        ],
        sentences: copy.mixed.sentences.map((sentence, index) => ({
          sentence,
          lang: index === 0 ? "zh-Hant" : "zh-Hans",
        })),
      }
    : {
        choices: copy.mixed.samples.map((sample) => ({
          label: sampleLanguage[sample.lang],
          lang: sample.lang,
        })),
        sentences: copy.mixed.samples,
      };
const hudLevels = [0.2, 0.45, 0.8, 0.55, 1, 0.7, 0.35, 0.6, 0.9, 0.5, 0.3, 0.2];
---

<Layout title={copy.title} description={copy.description} home>
  <SiteHeader />

  <main id="main" class="island home">
    <section class="hero wrap" aria-labelledby="hero-heading">
      <!-- Exactly one screen tall at every size: the first view is the copy
           and Home's waveform card, nothing else. -->
      <div class="hero-stage">
        <div class="hero-copy">
          <h1 id="hero-heading">
            {copy.headline.map((line, index) => (
              <>
                {index > 0 && copy.headlineGap}
                <span class="hero-line" style={`--line: ${index}`}>
                  <span>{line}</span>
                </span>
              </>
            ))}
          </h1>
          <p class="hero-lede">{copy.lede}</p>
          <div class="hero-actions">
            <Button
              href={onSale ? href("/pricing/", locale) : "#get-airdraft"}
              variant="primary"
              size="lg"
              icon={onSale ? "right" : "down"}
            >
              {copy.get}
            </Button>
            <Button href={siteLinks.source} size="lg" icon="external">
              {copy.source}
            </Button>
            <Button href="#try" variant="quiet" icon="down">
              {copy.sample}
            </Button>
          </div>
          <ul class="hero-meta">
            {copy.facts.map((fact) => (
              <li>{fact}</li>
            ))}
          </ul>
        </div>
        <HeroCard locale={locale} />
      </div>
    </section>

    <DictationPreview locale={locale} />

    <Section id="features" title={copy.featuresTitle} sticky>
      <div class="bento">
        <BentoTile
          wide
          art="cursor"
          title={copy.tiles.cursor[0]}
          caption={copy.tiles.cursor[1]}
        >
          <div class="art-cursor">
            <div class="art-field">
              <p data-typed>
                {copy.typed}
                <span class="caret"></span>
              </p>
            </div>
            <Hud
              label={app.hudRefining}
              levels={hudLevels}
              class="art-hud"
              locale={locale}
            />
          </div>
        </BentoTile>

        <BentoTile
          art="shortcut"
          title={copy.tiles.shortcut[0]}
          caption={copy.tiles.shortcut[1]}
        >
          <Keys keys={["⌃", "⌥"]} size="xl" />
        </BentoTile>

        <BentoTile
          art="profiles"
          title={copy.tiles.profiles[0]}
          caption={copy.tiles.profiles[1]}
        >
          <div class="art-profiles" data-outputs={JSON.stringify(outputs)}>
            <ul class="segmented">
              {profiles.map((profile, index) => (
                <li class:list={[index === 0 && "is-selected"]}>{profile}</li>
              ))}
            </ul>
            <p class="art-output" data-output>
              {outputs[0]}
            </p>
          </div>
        </BentoTile>

        <BentoTile
          art="vocabulary"
          title={copy.tiles.vocabulary[0]}
          caption={copy.tiles.vocabulary[1]}
        >
          <div class="art-vocab">
            <span class="art-wrong" data-wrong>
              cooper tino
            </span>
            <Arrow direction="down" />
            <Chip tone="strong" class="art-right" data-right>
              Cupertino
            </Chip>
          </div>
        </BentoTile>

        <BentoTile
          art="history"
          title={copy.tiles.history[0]}
          caption={copy.tiles.history[1]}
        >
          <div
            class="art-deck"
            data-texts={JSON.stringify([outputs[0], copy.spoken])}
          >
            <span class="art-card art-card-back"></span>
            <span class="art-card art-card-mid"></span>
            <div class="art-card art-card-front">
              <ul class="segmented art-toggle">
                <li class="is-selected">{app.refined}</li>
                <li>{app.original}</li>
              </ul>
              <p data-history>{outputs[0]}</p>
            </div>
          </div>
        </BentoTile>

        <BentoTile
          art="fallback"
          title={copy.tiles.fallback[0]}
          caption={copy.tiles.fallback[1]}
        >
          <div class="art-fallback">
            <Chip dot="attention">
              <span
                data-status
                data-busy={app.refining}
                data-failed={app.refinementFailed}
              >
                {app.refinementFailed}
              </span>
            </Chip>
            <div class="art-field">
              <p data-typed>
                {copy.spoken}
                <span class="caret"></span>
              </p>
            </div>
          </div>
        </BentoTile>

        <BentoTile
          wide
          art="privacy"
          id="privacy"
          title={copy.tiles.privacy[0]}
          caption={copy.tiles.privacy[1]}
        >
          <div class="art-privacy">
            <div class="art-mac">
              <span class="art-mac-label">{copy.privacyArt.mac}</span>
              <div class="art-flow">
                <span class="art-node">
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3Zm-6.5 9a6.5 6.5 0 0 0 13 0M12 18.5V21"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                    ></path>
                  </svg>
                </span>
                <span class="art-link">
                  <i data-dot></i>
                </span>
                <span class="art-node">{copy.privacyArt.speech}</span>
                <span class="art-link">
                  <i data-dot></i>
                </span>
                <span class="art-node">{copy.privacyArt.refinement}</span>
                <span class="art-link">
                  <i data-dot></i>
                </span>
                <span class="art-node">
                  <span class="caret"></span>
                </span>
              </div>
            </div>
            <div class="art-cloud">
              <span class="art-cloud-link"></span>
              <Chip>{copy.privacyArt.cloud}</Chip>
            </div>
          </div>
        </BentoTile>

        <BentoTile
          wide
          art="script"
          id="mixed-language"
          title={copy.tiles.mixed[0]}
          caption={copy.tiles.mixed[1]}
        >
          <div
            class="art-profiles"
            data-outputs={JSON.stringify(
              mixed.sentences.map((entry) => entry.sentence),
            )}
            data-langs={JSON.stringify(
              mixed.sentences.map((entry) => entry.lang),
            )}
          >
            <ul class="segmented">
              {mixed.choices.map((choice, index) => (
                <li
                  class:list={[index === 0 && "is-selected"]}
                  lang={choice.lang}
                >
                  {choice.label}
                </li>
              ))}
            </ul>
            <p
              class="art-output art-mixed"
              data-output
              lang={mixed.sentences[0].lang}
            >
              {mixed.sentences[0].sentence}
            </p>
          </div>
        </BentoTile>

        <BentoTile
          art="plan"
          title={copy.tiles.plan[0]}
          caption={copy.tiles.plan[1]}
        >
          <ul class="art-plans">
            <Chip as="li" tone="strong" dot="ok">
              Claude Code
            </Chip>
            <Chip as="li" dot="inactive">
              Codex
            </Chip>
          </ul>
        </BentoTile>
      </div>
    </Section>

    <MeetingsSection locale={locale} />

    <PipelineStory locale={locale} />

    <InterfaceShowcase locale={locale} />

    <Section id="guides" title={copy.guidesTitle}>
      <GuideLinks locale={locale} />
    </Section>

    <Section id="questions" title={copy.faqTitle}>
      <div class="question-list panel">
        {questions.map(([question, answer]) => (
          <Disclosure summary={question}>
            <p>
              <Rich parts={answer} locale={locale} />
            </p>
          </Disclosure>
        ))}
      </div>
    </Section>

    <GetAirdraft locale={locale} />
  </main>

  <SiteFooter />
</Layout>

<script>
  import "../scripts/story";
  import "../scripts/sticky";
</script>
