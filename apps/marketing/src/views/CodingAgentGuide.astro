---
import GuideLayout from "../layouts/GuideLayout.astro";
import Surface from "../components/ui/Surface.astro";
import Button from "../components/ui/Button.astro";
import { guidesFor } from "../data/guides";
import { ejaAsrResults } from "../data/eja-asr";
import { href, type GuideLocale } from "../i18n";

/**
 * Dictating prompts into Claude Code, Codex and terminals, in each language.
 * Delivery follows TextInserter (selfDrawingEditorBundlePrefixes, read-back
 * confirmation, explicit-retry copy), destination rules follow AppFamily and
 * the app-context setting, and CLI refinement follows CLIRefiner and the root
 * README. Behavior described is 0.11.0's, plus the AD-083 speech
 * recommendation; 0.11.0, 0.10.2 and earlier are named only where they differ.
 * Speech numbers come from src/data/eja-asr.ts (eval/eja-asr). App labels in the zh-TW page are the app's
 * zh-Hant catalog values, quoted with 「」; labels without a catalog entry
 * (Verbatim, Claude Code, Codex) stay as the app shows them.
 */
interface Props {
  locale: GuideLocale;
}
const { locale } = Astro.props;
const guide = guidesFor(locale).find(
  (entry) => entry.slug === "dictate-to-claude-code-and-terminals",
)!;
const zh = locale === "zh-tw";
const english = ejaAsrResults.en;
const parakeet = english.find((row) => row.model === "Parakeet TDT v2")!;
const qwen = english.find((row) => row.model === "Qwen3-ASR 1.7B")!;
const percent = (value: number) => `${value.toFixed(1)}%`;
const about = (ms: number) => `${Math.round(ms / 10) * 10} ms`;
---

{zh ? (
  <GuideLayout
    guide={guide}
    intro="在 Claude Code、Codex 或任何終端機裡按住快速鍵、說出提示詞再放開，Airdraft 會把文字貼到提示列，但不會按 Return，送出前你可以先檢查。潤稿也可以透過 Claude Code 或 Codex CLI，沿用你已付費的方案。App 介面從 0.11.0 起支援繁體中文，跟隨 macOS 的語言設定；0.10.2 及更早的版本只顯示英文。下文的名稱照繁體中文介面書寫。"
  >
    <Surface class="guide-section">
      <h2 id="delivery">文字怎麼進到終端機？</h2>
      <ul>
        <li>
          Airdraft 回到你開始聽寫的那個視窗，貼上一次文字，不會按 Return。
        </li>
        <li>
          Terminal 和 iTerm2 會提供游標與文字，Airdraft
          讀回剛貼上的內容來確認送達，和其他編輯器一樣。
        </li>
        <li>
          Warp、Ghostty、kitty、Alacritty、WezTerm 與 Zed
          編輯器自己繪製文字，沒有可以讀回的內容。Airdraft 會確認仍是同一個 App
          和視窗，只貼上一次，絕不重貼。
        </li>
        <li>
          從 0.11.0
          起，這類聽寫在「記錄」中標為「已貼上，未確認」，不會顯示錯誤，剪貼簿會稍晚才還原成原本的內容。0.10.2
          即使文字已經出現，也會顯示「Paste couldn't be
          confirmed」並把文字留在剪貼簿。
        </li>
        <li>
          錄音後你切換了視窗或輸入欄位時，Airdraft
          改為拷貝，不會貼到別的地方。重試保留的錄音時，這些 App
          也會改為拷貝，因為沒有辦法確認文字會落在哪裡。
        </li>
      </ul>
    </Surface>

    <Surface class="guide-section">
      <h2 id="cli-refinement">用你的方案潤稿</h2>
      <ol class="guide-steps">
        <li>
          <h3>安裝並登入 CLI</h3>
          <p>
            Airdraft 會在
            ~/.local/bin、/opt/homebrew/bin、/usr/local/bin、~/.bun/bin 或
            ~/.npm-global/bin 找 claude 或 codex
            指令，並使用你已登入的帳號，不需要 API 金鑰。
          </p>
        </li>
        <li>
          <h3>在「模型」選擇它</h3>
          <p>
            在「模型」的「潤稿」選 Claude Code 或 Codex。模型清單來自你安裝的
            CLI，「思考強度」就在旁邊；越低越快，用量也越少。
          </p>
        </li>
        <li>
          <h3>說話，放開</h3>
          <p>
            Claude Code 會在你說話時先啟動，藏起它的啟動時間；Codex
            在你說完後才啟動，所以比較慢。潤稿失敗或逾時，照樣貼上原始文字。
          </p>
        </li>
      </ol>
      <p>
        Airdraft 以非互動模式、在暫存資料夾裡執行 CLI，不提供工具、MCP
        伺服器、斜線指令或保存的工作階段，所以它只能回傳文字。它不會修改你的 CLI
        登入或設定。用量計入你方案的額度。
      </p>
    </Surface>

    <Surface class="guide-section">
      <h2 id="prompt-style">讓提示詞保持原樣</h2>
      <p>
        在「設定」的「行為」開啟「讀取 App 情境」後，Airdraft 會把
        Terminal、iTerm2、Warp、Ghostty 與 kitty
        當成終端機：你說的話保持一般文句，不加
        Markdown；只有你明確念出指令時，才會原樣保留旗標與路徑。在 VS
        Code、Cursor、Xcode、JetBrains IDE 與 Zed
        等程式編輯器裡，它會修正技術名稱的拼寫，並保留識別字與路徑。
      </p>
      <p>
        「讀取 App 情境」預設關閉；關閉時 Airdraft
        不知道目的地，使用一般規則。要逐字保留時，請用 Verbatim
        模式，它完全不潤稿。專案名稱與術語可以加到「詞彙」。
      </p>
    </Surface>

    <Surface class="guide-section">
      <h2 id="privacy">什麼會離開你的 Mac？</h2>
      <div
        class="guide-table-scroll"
        tabindex="0"
        role="region"
        aria-label="提示詞聽寫的資料去向"
      >
        <table class="guide-table">
          <caption>每個步驟送出的資料</caption>
          <thead>
            <tr>
              <th scope="col">步驟</th>
              <th scope="col">送出的資料</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">本機語音模型</th>
              <td>不送出。錄音留在這台 Mac。</td>
            </tr>
            <tr>
              <th scope="row">雲端語音辨識</th>
              <td>音訊送到你選的服務商。</td>
            </tr>
            <tr>
              <th scope="row">Claude Code 或 Codex 潤稿</th>
              <td>
                逐字稿、模式指示與詞彙，透過你的 CLI 帳號送到 Anthropic 或
                OpenAI；開啟「讀取 App 情境」時，還包括 App
                名稱、視窗標題、選取的文字、游標附近的文字，以及同一個 App
                最近聽寫的詞。CLI 在你的 Mac 上執行，不代表模型在本機。
              </td>
            </tr>
            <tr>
              <th scope="row">本機潤稿</th>
              <td>
                Apple Intelligence，或在這台 Mac 上執行的 LM
                Studio、Ollama：不送出。
              </td>
            </tr>
            <tr>
              <th scope="row">在提示列按 Return</th>
              <td>
                和打字一樣，由 Claude Code 或 Codex
                把提示詞送到它的服務商；Airdraft 不參與。
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p>
        部分 Codex 版本仍會把你的全域 AGENTS.md 加進潤稿請求。介意的話，請改用
        Claude
        Code、本機潤稿，或關閉這個模式的「潤飾逐字稿」。每種組合的完整資料去向，請看
        <a href="/guides/local-vs-cloud-dictation/" hreflang="en">
          本機或雲端聽寫指南
        </a>
        （英文）。
      </p>
    </Surface>

    <Surface class="guide-section">
      <h2 id="speech">語音模型怎麼選？</h2>
      <p>
        只說英文時，選 Parakeet TDT v2：系統語言為英文的
        Mac，首次設定會推薦它。它只辨識英文。在 Airdraft
        自己以朗讀英文做的測量中，它的詞錯誤率是 {percent(parakeet.auto.value)}
        ，每段約 {about(parakeet.medianMs)}，和 Qwen3-ASR 1.7B 的{" "}
        {percent(qwen.auto.value)} 在誤差範圍內；Qwen3-ASR 1.7B
        也能辨識其他語言，使用約 3 GB
        記憶體。測量用的是朗讀的維基百科句子，不是提示詞，方法與限制請看
        <a href="/guides/offline-dictation-on-mac/#measured" hreflang="en">
          離線聽寫指南
        </a>
        （英文）。0.11.0 及更早的版本推薦當時安裝的
        SenseVoice，那是粵語微調版本，現在顯示為 SenseVoice Cantonese。
      </p>
      <p>
        Parakeet TDT v3 支援英文與 24
        種其他歐洲語言，但不支援中文。提示詞裡中英混說時，請看
        <a href={href("/guides/mixed-chinese-english-dictation/", locale)}>
          中英混說的模型測量
        </a>
        。
      </p>
      <div class="guide-actions">
        <Button href={href("/pricing/", locale)} icon="right">
          查看價格
        </Button>
      </div>
    </Surface>
  </GuideLayout>
) : (
  <GuideLayout
    guide={guide}
    intro="In Claude Code, Codex or any terminal, hold the shortcut, speak your prompt and release. Airdraft pastes it at the prompt and never presses Return, so you can check it before sending. Refinement can run through the Claude Code or Codex CLI on the plan you already pay for."
  >
    <Surface class="guide-section">
      <h2 id="delivery">How does text reach a terminal?</h2>
      <ul>
        <li>
          Airdraft returns to the window you dictated into, pastes the text once
          and does not press Return.
        </li>
        <li>
          Terminal and iTerm2 expose their cursor and text, so Airdraft reads
          the paste back to confirm it, as in other editors.
        </li>
        <li>
          Warp, Ghostty, kitty, Alacritty, WezTerm and the Zed editor draw their
          own text and expose none to read back. Airdraft checks that the same
          app and window are still in front, pastes once and never repeats it.
        </li>
        <li>
          From 0.11.0, History marks these dictations “Pasted, unconfirmed”
          without an error, and your clipboard is restored a little later than
          usual. In 0.10.2, Airdraft says “Paste couldn’t be confirmed” and
          keeps the text on the clipboard even when it arrived.
        </li>
        <li>
          If the window or field changed after recording, Airdraft copies the
          text instead of pasting it somewhere else. An explicit retry of a kept
          recording also copies instead of pasting into these apps, because
          nothing could confirm where the text would land.
        </li>
      </ul>
    </Surface>

    <Surface class="guide-section">
      <h2 id="cli-refinement">Refine on the plan you already pay for</h2>
      <ol class="guide-steps">
        <li>
          <h3>Install and sign in to the CLI</h3>
          <p>
            Airdraft looks for the claude or codex command in ~/.local/bin,
            /opt/homebrew/bin, /usr/local/bin, ~/.bun/bin or ~/.npm-global/bin
            and uses the account you are signed in with. No API key is needed.
          </p>
        </li>
        <li>
          <h3>Choose it in Models</h3>
          <p>
            In Models → Refinement, choose Claude Code or Codex. The model list
            comes from your installed CLI, with Thinking effort beside it; lower
            is faster and uses less of your plan.
          </p>
        </li>
        <li>
          <h3>Speak and release</h3>
          <p>
            Claude Code starts while you are still speaking, which hides its
            startup time. Codex starts after you finish, so it takes longer. If
            refinement fails or times out, the raw transcript is inserted.
          </p>
        </li>
      </ol>
      <p>
        Airdraft runs the CLI non-interactively in a temporary folder, without
        tools, MCP servers, slash commands or a saved session, so it can only
        return text. It does not change your CLI login or settings. Usage counts
        toward your plan’s limits.
      </p>
    </Surface>

    <Surface class="guide-section">
      <h2 id="prompt-style">Keep prompts as prompts</h2>
      <p>
        With Read app context on in Settings → Behavior, Airdraft treats
        Terminal, iTerm2, Warp, Ghostty and kitty as terminals: your speech
        stays prose without Markdown, and flags and paths are kept exactly only
        when you dictate a command. In code editors such as VS Code, Cursor,
        Xcode, JetBrains IDEs and Zed, it restores technical-name spelling and
        keeps identifiers and paths.
      </p>
      <p>
        Read app context is off by default; then Airdraft does not know the
        destination and uses general rules. For exact wording, use the Verbatim
        profile, which skips refinement. Add project names and terms to
        Vocabulary.
      </p>
    </Surface>

    <Surface class="guide-section">
      <h2 id="privacy">What leaves your Mac?</h2>
      <div
        class="guide-table-scroll"
        tabindex="0"
        role="region"
        aria-label="Where prompt dictation data goes"
      >
        <table class="guide-table">
          <caption>What each step sends</caption>
          <thead>
            <tr>
              <th scope="col">Step</th>
              <th scope="col">What is sent</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Local speech model</th>
              <td>Nothing. The recording stays on this Mac.</td>
            </tr>
            <tr>
              <th scope="row">Cloud speech</th>
              <td>Audio goes to the provider you chose.</td>
            </tr>
            <tr>
              <th scope="row">Claude Code or Codex refinement</th>
              <td>
                The transcript, profile instructions and vocabulary go to
                Anthropic or OpenAI through your CLI account. With Read app
                context on, so do the app name, window title, selected text,
                text near the cursor and terms from recent dictations in the
                same app. The CLI runs on your Mac; its model does not.
              </td>
            </tr>
            <tr>
              <th scope="row">Local refinement</th>
              <td>
                Apple Intelligence, or LM Studio or Ollama running on this Mac:
                nothing.
              </td>
            </tr>
            <tr>
              <th scope="row">Pressing Return at the prompt</th>
              <td>
                As with typing, Claude Code or Codex sends your prompt to its
                provider. Airdraft is not involved.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p>
        Some Codex versions still add your global AGENTS.md to the refinement
        request. If that matters, use Claude Code or local refinement, or turn
        off Refine transcript for that profile.
      </p>
    </Surface>

    <Surface class="guide-section">
      <h2 id="speech">Which speech model?</h2>
      <p>
        For English-only prompts, choose Parakeet TDT v2: first-run setup
        recommends it on a Mac set to English. It recognizes English only. In
        Airdraft’s own measurement on read English it made{" "}
        {percent(parakeet.auto.value)} word errors at about{" "}
        {about(parakeet.medianMs)} per clip, within the margin of Qwen3-ASR
        1.7B’s {percent(qwen.auto.value)}; Qwen3-ASR 1.7B also recognizes other
        languages and uses about 3 GB of memory. The clips were read Wikipedia
        sentences, not prompts; see the{" "}
        <a href="/guides/offline-dictation-on-mac/#measured">
          offline setup guide
        </a>{" "}
        for the method and limits. 0.11.0 and earlier recommended the SenseVoice
        they installed, a Cantonese fine-tune now shown as SenseVoice Cantonese.
      </p>
      <p>
        Parakeet TDT v3 supports English and 24 other European languages, but
        not Chinese. If your prompts mix Chinese and English, see the{" "}
        <a href={href("/guides/mixed-chinese-english-dictation/", locale)}>
          mixed-language model measurements
        </a>
        .
      </p>
      <div class="guide-actions">
        <Button href={href("/pricing/", locale)} icon="right">
          See Pricing
        </Button>
        <Button
          href="/guides/local-vs-cloud-dictation/"
          variant="quiet"
          icon="right"
        >
          Compare Local and Cloud
        </Button>
      </div>
    </Surface>
  </GuideLayout>
)}
