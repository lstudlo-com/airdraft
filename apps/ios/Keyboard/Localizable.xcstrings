{
  "sourceLanguage" : "en",
  "strings" : {
    "Airdraft didn't answer. Start a keyboard session in Airdraft again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft no respondió. Vuelve a iniciar una sesión de teclado en Airdraft."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft から応答がありませんでした。Airdraft でキーボードセッションをもう一度開始してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 没有响应。请在 Airdraft 中重新开始键盘会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 沒有回應。請在 Airdraft 中重新開始鍵盤工作階段。"
          }
        }
      }
    },
    "Allow Full Access for Airdraft in Settings to dictate." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso total para Airdraft en Ajustes para dictar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力するには、「設定」で Airdraft の「フルアクセスを許可」をオンにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中为 Airdraft 打开“允许完全访问”后再听写。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」中為 Airdraft 開啟「允許完整取用」後再聽寫。"
          }
        }
      }
    },
