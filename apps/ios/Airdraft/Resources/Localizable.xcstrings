    "Models download only when you tap Download, and stay on this iPhone. Speed and accuracy have not been measured on iPhone yet." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos solo se descargan cuando tocas Descargar y se quedan en este iPhone. Aún no se ha medido su velocidad ni su precisión en iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルは「ダウンロード」をタップしたときにだけダウンロードされ、この iPhone に保存されます。iPhone での速度と精度はまだ測定していません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你轻点“下载”时才会下载模型，模型保存在这台 iPhone 上。尚未在 iPhone 上测量速度和准确度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在你點一下「下載」時才會下載模型，模型保留在這部 iPhone 上。尚未在 iPhone 上測量速度與準確度。"
          }
        }
      }
    },
    "Names and terms Airdraft should always spell your way." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombres y términos que Airdraft debe escribir siempre a tu manera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft に常にあなたの表記で書かせたい名前や用語です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 应始终按你的写法拼写的名称和术语。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 應一律依你的寫法拼寫的名稱與術語。"
          }
        }
