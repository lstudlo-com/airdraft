    "Record in Airdraft or with the Airdraft keyboard in any app. Airdraft turns your voice into clean text you can paste anywhere." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba en Airdraft o con el teclado Airdraft en cualquier app. Airdraft convierte tu voz en un texto limpio que puedes pegar donde quieras."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft で録音するか、どのアプリでも Airdraft キーボードを使えます。Airdraft が音声を整ったテキストに変換するので、どこにでもペーストできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Airdraft 中录音，或在任何 App 中使用 Airdraft 键盘。Airdraft 会把你的语音转换为干净的文字，可以粘贴到任何地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Airdraft 中錄音，或在任何 App 中使用 Airdraft 鍵盤。Airdraft 會把你的語音轉換成乾淨的文字，可以貼到任何地方。"
          }
        }
      }
    },
