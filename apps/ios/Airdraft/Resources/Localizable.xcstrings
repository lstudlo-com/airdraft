          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションを開始すると、どのアプリでも Airdraft キーボードを使えます。マイクは %lld 分間待機します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
