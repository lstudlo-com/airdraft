    "A server you run, such as LM Studio on your network." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un servidor que tú gestionas, como LM Studio en tu red."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LM Studio など、ネットワーク上で自分で運用するサーバです。"
