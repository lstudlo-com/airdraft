    "Add names and terms Airdraft should always spell your way." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade nombres y términos que Airdraft debe escribir siempre a tu manera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft に常にあなたの表記で書かせたい名前や用語を追加してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加 Airdraft 应始终按你的写法拼写的名称和术语。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入 Airdraft 應一律依你的寫法拼寫的名稱與術語。"
          }
        }
      }
    },
    "Airdraft didn't answer. Start a keyboard session in Airdraft again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft no respondió. Vuelve a iniciar una sesión de teclado en Airdraft."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft から応答がありませんでした。Airdraft でキーボードセッションをもう一度開始してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 没有响应。请在 Airdraft 中重新开始键盘会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 沒有回應。請在 Airdraft 中重新開始鍵盤工作階段。"
          }
        }
      }
    },
    "Airdraft is turning your voice into text." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft está convirtiendo tu voz en texto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft が音声をテキストに変換しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 正在把你的语音转换为文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 正在把你的語音轉換成文字。"
          }
        }
      }
    },
    "Airdraft listens only while you record or while a keyboard session is on." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft solo escucha mientras grabas o mientras hay una sesión de teclado activa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft が音声を聞き取るのは、録音中とキーボードセッション中だけです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 只在你录音或键盘会话开启时收听。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 只在你錄音或鍵盤工作階段開啟時聆聽。"
          }
        }
      }
    },
    "Airdraft starts with the speech recognition built into iOS. You can download a model or add an online service with your own key in Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft empieza con el reconocimiento de voz integrado en iOS. En Ajustes puedes descargar un modelo o añadir un servicio en línea con tu propia clave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft は iOS 内蔵の音声認識で始まります。「設定」でモデルをダウンロードしたり、自分のキーでオンラインサービスを追加したりできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 默认使用 iOS 内置的语音识别。你可以在“设置”中下载模型，或使用自己的密钥添加在线服务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 預設使用 iOS 內建的語音辨識。你可以在「設定」中下載模型，或用自己的密鑰加入線上服務。"
          }
        }
      }
    },
    "Airdraft turns your voice into text. Recordings and transcripts stay on this iPhone unless you choose an online speech or refinement service, which receives the audio or text it processes." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft convierte tu voz en texto. Las grabaciones y transcripciones se quedan en este iPhone, salvo que elijas un servicio en línea de voz o de refinamiento, que recibe el audio o el texto que procesa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft は音声をテキストに変換します。録音と文字起こしはこの iPhone に保存されます。ただし、オンラインの音声認識や整形サービスを選んだ場合は、そのサービスが処理する音声やテキストを受け取ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 会把你的语音转换为文字。录音和转录内容保存在这台 iPhone 上；如果你选择在线语音或润色服务，该服务会收到它处理的音频或文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 會把你的語音轉換成文字。錄音和轉錄內容保留在這部 iPhone 上；如果你選擇線上語音或潤稿服務，該服務會收到它處理的音訊或文字。"
          }
        }
      }
    },
    "Allow Full Access for Airdraft in Settings to dictate." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso total para Airdraft en Ajustes para dictar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力するには、「設定」で Airdraft の「フルアクセスを許可」をオンにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中为 Airdraft 打开“允许完全访问”后再听写。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」中為 Airdraft 開啟「允許完整取用」後再聽寫。"
          }
        }
      }
    },
