    "Full Access lets the keyboard receive your dictation from the Airdraft app. Airdraft never records what you type." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso total permite que el teclado reciba tu dictado desde la app Airdraft. Airdraft nunca registra lo que escribes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルアクセスを許可すると、キーボードが Airdraft アプリから音声入力の結果を受け取れます。Airdraft が入力内容を記録することはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“完全访问”让键盘能从 Airdraft App 接收你的听写内容。Airdraft 绝不会记录你输入的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「完整取用」讓鍵盤能從 Airdraft App 接收你的聽寫內容。Airdraft 絕不會記錄你輸入的內容。"
          }
        }
      }
