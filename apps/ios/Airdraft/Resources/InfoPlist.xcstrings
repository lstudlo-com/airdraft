  "strings" : {
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft records your voice to turn it into text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft graba tu voz para convertirla en texto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft は音声をテキストに変換するために録音します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 会录下你的语音，把它转换为文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 會錄下你的語音，把它轉換成文字。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft can use Apple's on-device speech recognition to turn your voice into text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft puede usar el reconocimiento de voz de Apple en el dispositivo para convertir tu voz en texto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft は Apple のデバイス上の音声認識を使って、音声をテキストに変換できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 可以使用 Apple 的设备端语音识别，把你的语音转换为文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airdraft 可以使用 Apple 的裝置端語音辨識，把你的語音轉換成文字。"
          }
        }
      }
