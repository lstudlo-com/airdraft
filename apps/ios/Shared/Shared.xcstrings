    "Keeps Airdraft listening for the Airdraft keyboard for a while." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene Airdraft escuchando un rato para el teclado Airdraft."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しばらくの間、Airdraft キーボードのために Airdraft が聞き取りを待機します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让 Airdraft 在一段时间内为 Airdraft 键盘保持收听。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓 Airdraft 在一段時間內為 Airdraft 鍵盤保持聆聽。"
          }
        }
      }
    },
