    },
    "%@ needs an explicit speech language. Choose a supported language on Models or select a model that detects the language automatically." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ necesita un idioma de voz explícito. Elige un idioma compatible en Modelos o un modelo que detecte el idioma automáticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ では音声の言語を指定する必要があります。「モデル」で対応している言語を選択するか、言語を自動検出するモデルを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要指定语音语言。请在“模型”中选择支持的语言，或选择能自动检测语言的模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要指定語音語言。請在「模型」中選擇支援的語言，或選擇能自動偵測語言的模型。"
          }
        }
      }
