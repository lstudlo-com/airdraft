    "Profiles could not be read or backed up. Saving is blocked to protect the original. Check the data folder permissions and reopen Airdraft." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer ni copiar los perfiles. Se bloqueó el guardado para proteger el original. Revisa los permisos de la carpeta de datos y vuelve a abrir Airdraft."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルを読み込むこともバックアップすることもできませんでした。元のファイルを保護するため、保存を停止しています。データフォルダの権限を確認してから Airdraft を開き直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取或备份模式。为保护原始文件，已暂停保存。请检查数据文件夹权限并重新打开 Airdraft。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取或備份模式。為保護原始檔案，已暫停儲存。請檢查資料夾權限並重新打開 Airdraft。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil tidak dapat dibaca atau dicadangkan. Penyimpanan diblokir untuk melindungi aslinya. Periksa izin folder data dan buka kembali Airdraft."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать или сохранить резервную копию профилей. Сохранение заблокировано, чтобы защитить оригинал. Проверьте права доступа к папке данных и снова откройте Airdraft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler nem fazer backup dos perfis. O salvamento está bloqueado para proteger o original. Verifique as permissões da pasta de dados e abra o Airdraft novamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire ou de sauvegarder les profils. La sauvegarde est bloquée pour protéger l’original. Vérifiez les autorisations du dossier de données et rouvrez Airdraft."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोफ़ाइल पढ़ी या बैकअप नहीं की जा सकीं। मूल फ़ाइल की सुरक्षा के लिए सहेजना रोका गया है। डेटा फ़ोल्डर की अनुमतियाँ जाँचें और Airdraft फिर से खोलें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة الأنماط أو نسخها احتياطيًا. الحفظ ممنوع لحماية الأصل. تحقق من أذونات مجلد البيانات وأعد فتح Airdraft."
          }
        }
      }
    },
    "Profiles could not be read. The original is preserved as %@ in the data folder. Defaults are shown until you restore your file." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer los perfiles. El original se conserva como %@ en la carpeta de datos. Se muestran los valores predeterminados hasta que restaures tu archivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルを読み込めませんでした。元のファイルはデータフォルダに %@ として保存されています。ファイルを復元するまではデフォルトが表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取模式。原始文件已在数据文件夹中保留为 %@。在你恢复该文件之前，会先显示默认设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取模式。原始檔案已在資料夾中保留為 %@。在你復原該檔案前，會先顯示預設值。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil tidak dapat dibaca. Aslinya disimpan sebagai %@ di folder data. Default ditampilkan sampai Anda memulihkan file Anda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать профили. Оригинал сохранён как %@ в папке данных. Пока вы не восстановите файл, показаны значения по умолчанию."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler os perfis. O original foi preservado como %@ na pasta de dados. Os padrões são mostrados até você restaurar seu arquivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire les profils. L’original est conservé sous le nom %@ dans le dossier de données. Les valeurs par défaut sont affichées jusqu’à ce que vous restauriez votre fichier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोफ़ाइल पढ़ी नहीं जा सकीं। मूल फ़ाइल डेटा फ़ोल्डर में %@ के रूप में सुरक्षित है। आपकी फ़ाइल वापस लाने तक डिफ़ॉल्ट दिखाए जाते हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة الأنماط. حُفظ الأصل باسم %@ في مجلد البيانات. تُعرض الإعدادات الافتراضية حتى تستعيد ملفك."
          }
        }
      }
    },
    "Published base API rate. Paid keyterm and entity-detection add-ons are off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarifa básica publicada de la API. Los complementos de pago de términos clave y detección de entidades están desactivados."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開されている API の基本料金です。有料のキーワードとエンティティ検出のアドオンはオフです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公布的基础 API 费率。付费的关键词和实体检测附加功能已关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公布的基本 API 費率。付費的關鍵詞與實體偵測附加功能已關閉。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarif API dasar yang dipublikasikan. Add-on istilah kunci dan deteksi entitas berbayar nonaktif."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опубликованный базовый тариф API. Платные опции ключевых слов и распознавания сущностей выключены."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarifa base publicada da API. Complementos pagos de termos-chave e detecção de entidades desativados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarif API de base publié. Les options payantes de mots-clés et de détection d’entités sont désactivées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रकाशित बेस API दर। सशुल्क कीटर्म और एंटिटी-डिटेक्शन ऐड-ऑन बंद हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سعر API الأساسي المنشور. إضافات المصطلحات الرئيسية واكتشاف الكيانات المدفوعة متوقفة."
          }
        }
      }
    },
