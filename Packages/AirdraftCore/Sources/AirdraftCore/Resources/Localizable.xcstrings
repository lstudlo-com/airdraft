{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" is not a valid speech language code. Choose a language on Models." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no es un código de idioma de voz válido. Elige un idioma en Modelos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は有効な音声言語コードではありません。「モデル」で言語を選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是有效的语音语言代码。请在“模型”中选择语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」不是有效的語音語言代碼。請在「模型」中選擇語言。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” bukan kode bahasa ucapan yang valid. Pilih bahasa di Model."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — недопустимый код языка речи. Выберите язык в «Моделях»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não é um código de idioma de fala válido. Escolha um idioma em Modelos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est pas un code de langue parlée valide. Choisissez une langue dans Modèles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" मान्य स्पीच भाषा कोड नहीं है। मॉडल में कोई भाषा चुनें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ليس رمز لغة كلام صالحًا. اختر لغة في النماذج."
          }
        }
      }
    },
