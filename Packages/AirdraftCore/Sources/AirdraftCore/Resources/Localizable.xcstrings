    "There is not enough available memory to identify speakers in this recording. Close other apps and retry, or choose Without Speakers." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay suficiente memoria disponible para identificar a los hablantes en esta grabación. Cierra otras apps y reintenta, o elige Sin hablantes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この録音の話者を識別するのに十分なメモリがありません。ほかのアプリを閉じて再試行するか、「話者なし」を選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用内存不足，无法识别此录音中的发言人。请关闭其他 App 后重试，或选择“不识别发言人”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用記憶體不足，無法辨識此錄音的講者。請關閉其他 App 後重試，或選擇「不辨識講者」。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memori yang tersedia tidak cukup untuk mengenali pembicara dalam rekaman ini. Tutup app lain dan coba lagi, atau pilih Tanpa pembicara."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недостаточно свободной памяти для определения спикеров в этой записи. Закройте другие приложения и повторите или выберите «Без спикеров»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há memória disponível suficiente para identificar os falantes nesta gravação. Feche outros apps e tente novamente, ou escolha Sem falantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mémoire disponible est insuffisante pour identifier les intervenants de cet enregistrement. Fermez d’autres apps et réessayez, ou choisissez Sans intervenants."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस रिकॉर्डिंग में वक्ताओं की पहचान के लिए पर्याप्त मेमोरी उपलब्ध नहीं है। दूसरे ऐप बंद करके फिर से कोशिश करें, या वक्ताओं के बिना चुनें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتوفر ذاكرة كافية لتحديد المتحدثين في هذا التسجيل. أغلق التطبيقات الأخرى وأعد المحاولة، أو اختر «دون متحدثين»."
          }
        }
      }
    },
    "This Mac does not support Apple Intelligence." : {
