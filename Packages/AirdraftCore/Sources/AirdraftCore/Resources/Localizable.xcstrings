{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" is not a valid speech language code. Choose a language on Models." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no es un código de idioma de voz válido. Elige un idioma en Modelos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は有効な音声言語コードではありません。「モデル」で言語を選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是有效的语音语言代码。请在“模型”中选择语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」不是有效的語音語言代碼。請在「模型」中選擇語言。"
          }
        }
      }
    },
    "$0.0045 per audio minute." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0,0045 USD por minuto de audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声 1 分あたり 0.0045 USD。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每分钟音频 0.0045 美元。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每分鐘音訊 0.0045 美元。"
          }
        }
      }
    },
    "$0.0045 per audio minute. Replaces the older GPT-4o transcription preset." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0,0045 USD por minuto de audio. Sustituye al preajuste anterior de transcripción GPT-4o."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声 1 分あたり 0.0045 USD。以前の GPT-4o 文字起こしのプリセットを置き換えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每分钟音频 0.0045 美元。替代旧的 GPT-4o 转录预设。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每分鐘音訊 0.0045 美元。取代舊的 GPT-4o 轉錄預設組合。"
          }
        }
      }
    },
    "%@ Audio cleanup also failed: %@. Retry clearing saved audio." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Audio cleanup also failed: %2$@. Retry clearing saved audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ La limpieza de audio también falló: %2$@. Vuelve a intentar borrar el audio guardado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 音声のクリーンアップにも失敗しました：%2$@。保存された音声の消去を再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 音频清理也失败了：%2$@。请重试清除已保存的音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 音訊清理也失敗：%2$@。請重試清除已儲存的音訊。"
          }
        }
      }
    },
    "%@ and %lld more" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$lld more"
          }
        },
