    "Your license needs Keychain access. Choose Allow Access in License to restore it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu licencia necesita acceso al Llavero. Elige Permitir acceso en Licencia para restaurarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライセンスにはキーチェーンへのアクセスが必要です。「ライセンス」で「アクセスを許可」を選択して復元してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的许可证需要访问钥匙串。请在“许可证”中选择“允许访问”以恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的授權需要鑰匙圈存取權。請在「授權」中選擇「允許存取」以還原。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisensi Anda memerlukan akses Rantai Kunci. Pilih Izinkan akses di Lisensi untuk memulihkannya."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лицензии нужен доступ к Связке ключей. Нажмите «Разрешить доступ» в «Лицензии», чтобы восстановить его."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua licença precisa de acesso às Chaves do macOS. Escolha Permitir acesso em Licença para restaurá-la."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre licence nécessite l’accès au trousseau. Choisissez Autoriser l’accès dans Licence pour la restaurer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके लाइसेंस को कीचेन ऐक्सेस चाहिए। इसे वापस पाने के लिए लाइसेंस में ऐक्सेस की अनुमति दें चुनें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج ترخيصك إلى الوصول إلى سلسلة المفاتيح. اختر «السماح بالوصول» في «الترخيص» لاستعادته."
          }
        }
      }
    },
    "Your saved API key needs access approval. Open Models and choose Allow access for this provider." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave de API guardada necesita aprobación de acceso. Abre Modelos y elige Permitir acceso para este proveedor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した API キーにはアクセスの許可が必要です。「モデル」を開き、このプロバイダで「アクセスを許可」を選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你保存的 API 密钥需要批准访问。请打开“模型”并为此提供商选择“允许访问”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你儲存的 API 金鑰需要核准存取。請打開「模型」並為此供應商選擇「允許存取」。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci API tersimpan Anda memerlukan persetujuan akses. Buka Model dan pilih Izinkan akses untuk penyedia ini."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённому ключу API нужно одобрение доступа. Откройте «Модели» и выберите «Разрешить доступ» для этого провайдера."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua chave de API salva precisa de aprovação de acesso. Abra Modelos e escolha Permitir acesso para este provedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé API enregistrée doit être autorisée. Ouvrez Modèles et choisissez Autoriser l’accès pour ce fournisseur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सहेजी गई API की को ऐक्सेस की मंज़ूरी चाहिए। मॉडल खोलें और इस प्रदाता के लिए ऐक्सेस की अनुमति दें चुनें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج مفتاح API المحفوظ إلى موافقة على الوصول. افتح النماذج واختر «السماح بالوصول» لهذا المزوّد."
          }
        }
      }
    },
