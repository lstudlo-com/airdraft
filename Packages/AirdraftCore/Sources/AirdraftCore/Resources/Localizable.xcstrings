    "Live preview stopped because the speech model was too slow. Final transcription is unaffected." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vista previa en directo se detuvo porque el modelo de voz era demasiado lento. La transcripción final no se ve afectada."
          }
