    "System capture stopped unexpectedly. The saved tail may be incomplete." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La captura del sistema se detuvo inesperadamente. Puede que el final guardado esté incompleto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムの取り込みが予期せず停止しました。最後に保存された部分が欠けている可能性があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统采集意外停止。最后保存的部分可能不完整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統擷取意外停止。最後儲存的部分可能不完整。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perekaman sistem berhenti tiba-tiba. Bagian akhir yang tersimpan mungkin tidak lengkap."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
