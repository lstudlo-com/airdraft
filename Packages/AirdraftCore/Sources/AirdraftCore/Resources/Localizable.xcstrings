    "Microphone access denied. Enable it in System Settings > Privacy & Security > Microphone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se denegó el acceso al micrófono. Actívalo en Ajustes del Sistema > Privacidad y seguridad > Micrófono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクへのアクセスが拒否されました。システム設定 >「プライバシーとセキュリティ」>「マイク」でオンにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风访问被拒绝。请在“系统设置”>“隐私与安全性”>“麦克风”中启用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麥克風取用權限遭拒。請在「系統設定」>「隱私權與安全性」>「麥克風」中啟用。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses mikrofon ditolak. Aktifkan di Pengaturan Sistem > Privasi & Keamanan > Mikrofon."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к микрофону запрещён. Включите его в разделе «Системные настройки» > «Конфиденциальность и безопасность» > «Микрофон»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acesso ao microfone negado. Ative-o em Ajustes do Sistema > Privacidade e Segurança > Microfone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accès au micro refusé. Activez-le dans Réglages Système > Confidentialité et sécurité > Micro."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माइक्रोफ़ोन ऐक्सेस अस्वीकृत। इसे सिस्टम सेटिंग्ज़ > गोपनीयता और सुरक्षा > माइक्रोफ़ोन में चालू करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رُفض الوصول إلى الميكروفون. فعّله في إعدادات النظام > الخصوصية والأمن > الميكروفون."
          }
        }
      }
    },
