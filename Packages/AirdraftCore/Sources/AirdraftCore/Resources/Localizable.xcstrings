    "Some provider keys could not be removed (Keychain status %d). Completed removals stay removed; unlock Keychain and retry." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron eliminar algunas claves de proveedores (estado del Llavero %d). Las eliminaciones completadas se mantienen; desbloquea el Llavero y vuelve a intentarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のプロバイダのキーを削除できませんでした（キーチェーンの状態 %d）。削除済みのキーは元に戻りません。キーチェーンのロックを解除してから再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分提供商密钥无法移除（钥匙串状态 %d）。已完成的移除不会恢复；请解锁钥匙串后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分供應商金鑰無法移除（鑰匙圈狀態 %d）。已完成的移除不會還原；請解鎖鑰匙圈後重試。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa kunci penyedia tidak dapat dihapus (status Rantai Kunci %d). Yang sudah dihapus tetap terhapus; buka Rantai Kunci dan coba lagi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые ключи провайдеров не удалось удалить (статус Связки ключей %d). Уже удалённые ключи не вернутся; разблокируйте Связку ключей и повторите."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível remover algumas chaves de provedores (status das Chaves do macOS: %d). As remoções concluídas continuam valendo; desbloqueie as Chaves do macOS e tente novamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines clés de fournisseur n’ont pas pu être supprimées (état du trousseau %d). Les suppressions effectuées sont définitives ; déverrouillez le trousseau et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ प्रदाता की हटाई नहीं जा सकीं (कीचेन स्थिति %d)। जो हट चुकी हैं वे हटी रहेंगी; कीचेन अनलॉक करें और फिर से कोशिश करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت إزالة بعض مفاتيح المزوّدين (حالة سلسلة المفاتيح %d). تبقى المفاتيح التي أُزيلت محذوفة؛ افتح قفل سلسلة المفاتيح وأعد المحاولة."
          }
        }
      }
    },
