          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 不支持 Apple Intelligence。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台 Mac 不支援 Apple Intelligence。"
          }
        }
      }
    },
    "This document changed in another operation. Reopen it to load the latest version." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este documento cambió en otra operación. Vuelve a abrirlo para cargar la versión más reciente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この書類は別の操作で変更されました。開き直して最新のバージョンを読み込んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文档已在其他操作中更改。请重新打开以加载最新版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件已在其他作業中變更。請重新打開以載入最新版本。"
          }
        }
      }
    },
    "This file contains multiple audio tracks. Export the track you want as a separate audio file, then import it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo contiene varias pistas de audio. Exporta la pista que quieras como archivo de audio aparte e impórtala."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルには複数のオーディオトラックが含まれています。必要なトラックを別の音声ファイルとして書き出してから読み込んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件包含多个音轨。请将需要的音轨导出为单独的音频文件，然后再导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案包含多個音軌。請將想要的音軌匯出成獨立的音訊檔案，再匯入。"
          }
        }
      }
    },
    "This file has no decodable audio. Try a WAV, M4A, MP3, MP4 or MOV file." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo no tiene audio decodificable. Prueba con un archivo WAV, M4A, MP3, MP4 o MOV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルにはデコードできる音声がありません。WAV、M4A、MP3、MP4、MOV のいずれかのファイルを試してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件没有可解码的音频。请尝试 WAV、M4A、MP3、MP4 或 MOV 文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案沒有可解碼的音訊。請試試 WAV、M4A、MP3、MP4 或 MOV 檔案。"
          }
        }
      }
    },
    "This key cannot run the connection check. Check account or model-read permissions in the provider console; speech access is separate." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta clave no puede ejecutar la comprobación de conexión. Revisa los permisos de cuenta o de lectura de modelos en la consola del proveedor; el acceso de voz es aparte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このキーでは接続チェックを実行できません。プロバイダのコンソールでアカウントまたはモデル読み取りの権限を確認してください。音声認識へのアクセスは別に管理されています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此密钥无法执行连接检查。请在提供商控制台中检查账户或模型读取权限；语音访问权限是单独的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此金鑰無法執行連線檢查。請在供應商主控台檢查帳號或模型讀取權限；語音存取權是分開的。"
          }
        }
      }
    },
    "This license or device activation is no longer valid. Check your key and devices in the customer portal." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta licencia o activación del dispositivo ya no es válida. Revisa tu clave y tus dispositivos en el portal de cliente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このライセンスまたはデバイスのアクティベーションは無効になりました。カスタマーポータルでキーとデバイスを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此许可证或设备激活已失效。请在客户门户中检查你的密钥和设备。"
          }
