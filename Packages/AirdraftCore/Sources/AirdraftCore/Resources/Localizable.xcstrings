        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В активации отказано. Проверьте лицензию и свободные слоты устройств на портале клиента."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ativação foi recusada. Verifique a licença e as vagas de dispositivo disponíveis no portal do cliente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’activation a été refusée. Vérifiez la licence et les emplacements d’appareil disponibles dans le portail client."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्रियण अस्वीकार हुआ। ग्राहक पोर्टल में लाइसेंस और उपलब्ध डिवाइस स्लॉट जाँचें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رُفض التفعيل. تحقق من الترخيص وخانات الأجهزة المتاحة في بوابة العملاء."
          }
        }
      }
    },
