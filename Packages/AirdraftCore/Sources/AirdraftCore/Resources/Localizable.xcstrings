          }
        }
      }
    },
    "This shortcut's profile was deleted. Choose another profile in Settings > Keyboard shortcuts." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminó el perfil de este atajo. Elige otro perfil en Ajustes > Atajos de teclado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このショートカットのモードは削除されました。「設定」>「キーボードショートカット」で別のモードを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此快捷键的模式已删除。请在“设置”>“键盘快捷键”中另选一个模式。"
          }
        },
        "zh-Hant" : {
