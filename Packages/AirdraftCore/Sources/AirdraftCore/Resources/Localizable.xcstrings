    "This document changed in another operation. Reopen it to load the latest version." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este documento cambió en otra operación. Vuelve a abrirlo para cargar la versión más reciente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この書類は別の操作で変更されました。開き直して最新のバージョンを読み込んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文档已在其他操作中更改。请重新打开以加载最新版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件已在其他作業中變更。請重新打開以載入最新版本。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumen ini diubah oleh operasi lain. Buka kembali untuk memuat versi terbaru."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот документ изменён другой операцией. Откройте его снова, чтобы загрузить последнюю версию."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este documento foi alterado em outra operação. Abra-o novamente para carregar a versão mais recente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce document a été modifié par une autre opération. Rouvrez-le pour charger la dernière version."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह दस्तावेज़ किसी दूसरी कार्रवाई में बदल गया। नवीनतम संस्करण लोड करने के लिए इसे फिर से खोलें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر هذا المستند في عملية أخرى. أعد فتحه لتحميل أحدث إصدار."
          }
        }
      }
    },
    "This file contains multiple audio tracks. Export the track you want as a separate audio file, then import it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo contiene varias pistas de audio. Exporta la pista que quieras como archivo de audio aparte e impórtala."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルには複数のオーディオトラックが含まれています。必要なトラックを別の音声ファイルとして書き出してから読み込んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件包含多个音轨。请将需要的音轨导出为单独的音频文件，然后再导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案包含多個音軌。請將想要的音軌匯出成獨立的音訊檔案，再匯入。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File ini berisi beberapa trek audio. Ekspor trek yang Anda inginkan sebagai file audio terpisah, lalu impor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В файле несколько звуковых дорожек. Экспортируйте нужную дорожку отдельным аудиофайлом и импортируйте её."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este arquivo contém várias faixas de áudio. Exporte a faixa desejada como um arquivo de áudio separado e importe-a."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier contient plusieurs pistes audio. Exportez la piste souhaitée dans un fichier audio distinct, puis importez-le."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस फ़ाइल में कई ऑडियो ट्रैक हैं। जो ट्रैक चाहिए उसे अलग ऑडियो फ़ाइल के रूप में एक्सपोर्ट करें, फिर इंपोर्ट करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي هذا الملف على عدة مسارات صوتية. صدّر المسار الذي تريده كملف صوتي منفصل، ثم استورده."
          }
        }
      }
    },
    "This file has no decodable audio. Try a WAV, M4A, MP3, MP4 or MOV file." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo no tiene audio decodificable. Prueba con un archivo WAV, M4A, MP3, MP4 o MOV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルにはデコードできる音声がありません。WAV、M4A、MP3、MP4、MOV のいずれかのファイルを試してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件没有可解码的音频。请尝试 WAV、M4A、MP3、MP4 或 MOV 文件。"
