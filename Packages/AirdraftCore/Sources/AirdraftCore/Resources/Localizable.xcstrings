    "Live preview audio conversion failed. Start another recording to retry." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error en la conversión de audio de la vista previa en directo. Inicia otra grabación para reintentar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブプレビューの音声変換に失敗しました。新しい録音を開始して再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时预览的音频转换失败。请开始新的录音以重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時預覽的音訊轉換失敗。請開始新的錄音以重試。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konversi audio pratinjau langsung gagal. Mulai rekaman lain untuk mencoba lagi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось преобразовать аудио для предпросмотра. Начните новую запись, чтобы повторить."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha na conversão de áudio da prévia ao vivo. Inicie outra gravação para tentar novamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la conversion audio de l’aperçu en direct. Lancez un nouvel enregistrement pour réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइव प्रीव्यू का ऑडियो रूपांतरण विफल रहा। फिर से कोशिश करने के लिए नई रिकॉर्डिंग शुरू करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل تحويل صوت المعاينة المباشرة. ابدأ تسجيلًا آخر لإعادة المحاولة."
          }
        }
      }
    },
    "Live preview could not allocate an audio buffer. Start another recording to retry." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vista previa en directo no pudo reservar un búfer de audio. Inicia otra grabación para reintentar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブプレビューで音声バッファを確保できませんでした。新しい録音を開始して再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时预览无法分配音频缓冲区。请开始新的录音以重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
