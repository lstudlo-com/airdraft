    "Uses Voxtral Mini Latest. Dictionary substitutions still apply after transcription." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Voxtral Mini Latest. Las sustituciones del diccionario siguen aplicándose después de la transcripción."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voxtral Mini Latest を使用します。文字起こしの後も辞書による置き換えが適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Voxtral Mini Latest。转录后仍会应用词汇替换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Voxtral Mini Latest。轉錄後仍會套用詞彙替換。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memakai Voxtral Mini Latest. Substitusi kamus tetap berlaku setelah transkripsi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует Voxtral Mini Latest. Замены из словаря по-прежнему применяются после расшифровки."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o Voxtral Mini Latest. As substituições do dicionário continuam valendo após a transcrição."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise Voxtral Mini Latest. Les substitutions du dictionnaire s’appliquent toujours après la transcription."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voxtral Mini Latest का उपयोग करता है। ट्रांसक्रिप्शन के बाद शब्दकोश के बदलाव फिर भी लागू होते हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Voxtral Mini Latest. لا تزال استبدالات القاموس تُطبَّق بعد التحويل إلى نص."
          }
        }
      }
    },
    "Uses a separate speech key. Interaction storage is off; uploaded-file deletion is attempted after use." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa una clave de voz aparte. El almacenamiento de interacciones está desactivado; se intenta eliminar los archivos subidos después de usarlos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声認識用の別のキーを使用します。インタラクションの保存はオフで、使用後にアップロードしたファイルの削除を試みます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用单独的语音密钥。交互存储已关闭；使用后会尝试删除上传的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用獨立的語音金鑰。互動儲存已關閉；使用後會嘗試刪除上傳的檔案。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memakai kunci ucapan terpisah. Penyimpanan interaksi nonaktif; penghapusan file yang diunggah dicoba setelah dipakai."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует отдельный ключ речи. Хранение взаимодействий выключено; после использования выполняется попытка удалить отправленный файл."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa uma chave de API de fala separada. O armazenamento de interações está desativado; a exclusão dos arquivos enviados é tentada após o uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise une clé de reconnaissance distincte. Le stockage des interactions est désactivé ; la suppression des fichiers envoyés est tentée après usage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अलग स्पीच की का उपयोग करता है। इंटरैक्शन स्टोरेज बंद है; इस्तेमाल के बाद अपलोड की गई फ़ाइल डिलीट करने की कोशिश की जाती है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم مفتاح كلام منفصلًا. تخزين التفاعلات متوقف؛ ويُحاول حذف الملفات المرفوعة بعد الاستخدام."
          }
        }
      }
    },
    "Uses the EU batch endpoint. Job and audio deletion are attempted after use. Automatic detection works best with at least 60 seconds of speech." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el punto de acceso por lotes de la UE. Se intenta eliminar la tarea y el audio después de usarlos. La detección automática funciona mejor con al menos 60 segundos de voz."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EU のバッチエンドポイントを使用します。使用後にジョブと音声の削除を試みます。自動検出は 60 秒以上の発話があると最も正確です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用欧盟批量端点。使用后会尝试删除任务和音频。语音至少 60 秒时，自动检测效果最佳。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用歐盟批次端點。使用後會嘗試刪除工作與音訊。語音至少 60 秒時，自動偵測效果最佳。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memakai endpoint batch UE. Penghapusan tugas dan audio dicoba setelah dipakai. Deteksi otomatis paling baik dengan setidaknya 60 detik ucapan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует пакетный эндпоинт в ЕС. После использования выполняется попытка удалить задание и аудио. Автоопределение лучше работает с 60 секундами речи и более."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o endpoint em lote da UE. A exclusão de tarefas e áudio é tentada após o uso. A detecção automática funciona melhor com pelo menos 60 segundos de fala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise le point de terminaison par lots de l’UE. La suppression des tâches et de l’audio est tentée après usage. La détection automatique fonctionne mieux avec au moins 60 secondes de parole."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EU बैच एंडपॉइंट का उपयोग करता है। इस्तेमाल के बाद जॉब और ऑडियो डिलीट करने की कोशिश की जाती है। स्वतः पहचान कम से कम 60 सेकंड की बोली के साथ सबसे अच्छा काम करती है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم نقطة النهاية الدفعية في الاتحاد الأوروبي. يُحاول حذف المهمة والصوت بعد الاستخدام. يعمل الاكتشاف التلقائي بشكل أفضل مع 60 ثانية من الكلام على الأقل."
          }
        }
      }
    },
    "Uses the selected Apple Speech locale; automatic detection is unavailable." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la configuración regional de Apple Speech seleccionada; la detección automática no está disponible."
