          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ terminó %2$@ segundos antes de que se detuviera la grabación."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は録音停止の %2$@ 秒前に終了しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
