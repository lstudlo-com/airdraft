          }
        }
      }
    },
    "The provider does not publish comparable file-transcription latency. Upload and network time also affect your wait." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proveedor no publica una latencia comparable de transcripción de archivos. Los tiempos de subida y de red también afectan a la espera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダはファイルの文字起こしについて比較できる遅延を公開していません。待ち時間はアップロードとネットワークの時間にも左右されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供商未公布可比较的文件转录延迟。上传和网络时间也会影响等待时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供應商未公布可比較的檔案轉錄延遲。上傳與網路時間也會影響等待時間。"
          }
        }
      }
    },
    "The provider returned HTTP %lld. Try again later." : {
