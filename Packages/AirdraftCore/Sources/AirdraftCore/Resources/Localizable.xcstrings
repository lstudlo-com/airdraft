    "This saved transcription uses an unsupported model. Start a new transcription with a model listed in Meetings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta transcripción guardada usa un modelo no compatible. Inicia una nueva transcripción con un modelo de la lista de Reuniones."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この保存された文字起こしは非対応のモデルを使用しています。「会議」に一覧表示されているモデルで新しく文字起こししてください。"
          }
        },
        "zh-Hans" : {
