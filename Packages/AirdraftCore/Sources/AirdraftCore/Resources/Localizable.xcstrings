    "Token-based estimate of $0.003 per minute; actual cost varies with audio and output." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimación por tokens de 0,003 USD por minuto; el coste real varía según el audio y la salida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークンに基づく推定で 1 分あたり 0.003 USD。実際の料金は音声と出力によって異なります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 token 估算每分钟 0.003 美元；实际费用因音频和输出而异。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依 token 估算每分鐘 0.003 美元；實際費用依音訊與輸出而異。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkiraan berbasis token sebesar $0,003 per menit; biaya sebenarnya bervariasi menurut audio dan output."
          }
        },
