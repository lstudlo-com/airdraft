          }
        }
      }
    },
    "Recording startup timed out. Open Airdraft to check the selected model and permissions." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se agotó el tiempo de inicio de la grabación. Abre Airdraft para revisar el modelo seleccionado y los permisos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音の開始がタイムアウトしました。Airdraft を開いて、選択したモデルと権限を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音启动超时。请打开 Airdraft 检查所选模型和权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄音啟動逾時。請打開 Airdraft 檢查所選模型與權限。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu mulai rekaman habis. Buka Airdraft untuk memeriksa model terpilih dan izin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время запуска записи истекло. Откройте Airdraft и проверьте выбранную модель и разрешения."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A inicialização da gravação expirou. Abra o Airdraft para verificar o modelo selecionado e as permissões."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le démarrage de l’enregistrement a expiré. Ouvrez Airdraft pour vérifier le modèle sélectionné et les autorisations."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिकॉर्डिंग शुरू होने का समय समाप्त हो गया। चुना गया मॉडल और अनुमतियाँ जाँचने के लिए Airdraft खोलें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت مهلة بدء التسجيل. افتح Airdraft للتحقق من النموذج المحدد والأذونات."
          }
        }
      }
    },
    "Recording stopped at %@ because recordings waiting for retry use the rest of the memory limit. Retry or discard them in Airdraft for longer recordings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación se detuvo a los %@ porque las grabaciones que esperan un reintento usan el resto del límite de memoria. Reinténtalas o descártalas en Airdraft para grabar más tiempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再試行を待っている録音がメモリ上限の残りを使っているため、%@ で録音を停止しました。より長く録音するには、Airdraft でそれらを再試行するか破棄してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音已在 %@ 停止，因为等待重试的录音已用掉其余的内存上限。请在 Airdraft 中重试或丢弃这些录音，以便录制更长的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄音已在 %@ 停止，因為等待重試的錄音已用掉其餘的記憶體上限。請在 Airdraft 中重試或捨棄這些錄音，以便錄製更長的內容。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekaman berhenti pada %@ karena rekaman yang menunggu dicoba lagi memakai sisa batas memori. Coba lagi atau buang rekaman itu di Airdraft untuk rekaman yang lebih panjang."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись остановлена на %@: записи, ожидающие повтора, занимают остаток лимита памяти. Для более длинных записей повторите или отбросьте их в Airdraft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação parou em %@ porque as gravações aguardando nova tentativa usam o restante do limite de memória. Tente novamente ou descarte-as no Airdraft para gravar por mais tempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrement arrêté à %@ car les enregistrements en attente d’une nouvelle tentative occupent le reste de la limite de mémoire. Réessayez-les ou supprimez-les dans Airdraft pour des enregistrements plus longs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिकॉर्डिंग %@ पर रुक गई, क्योंकि फिर से कोशिश के लिए प्रतीक्षा में रखी रिकॉर्डिंग बाकी मेमोरी सीमा ले रही हैं। लंबी रिकॉर्डिंग के लिए Airdraft में उन्हें फिर से आज़माएँ या त्यागें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف التسجيل عند %@ لأن التسجيلات المنتظرة لإعادة المحاولة تستهلك بقية حد الذاكرة. أعد محاولتها أو تجاهلها في Airdraft لتسجيلات أطول."
          }
        }
      }
    },
    "Recording stopped because disk space is low. Free space, then recover the saved audio from Meetings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación se detuvo por falta de espacio en disco. Libera espacio y recupera el audio guardado desde Reuniones."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクの空き容量が不足しているため録音を停止しました。空き容量を確保してから、「会議」で保存された音声を復元してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于磁盘空间不足，录音已停止。请释放空间，然后从“会议”中恢复已保存的音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因磁碟空間不足，錄音已停止。請釋放空間，然後從「會議」中復原已儲存的音訊。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekaman berhenti karena ruang disk hampir habis. Kosongkan ruang, lalu pulihkan audio tersimpan dari Rapat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись остановлена: мало места на диске. Освободите место, затем восстановите сохранённое аудио во «Встречах»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação parou porque há pouco espaço em disco. Libere espaço e recupere o áudio salvo em Reuniões."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrement arrêté car l’espace disque est insuffisant. Libérez de l’espace, puis récupérez l’audio enregistré dans Réunions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क स्पेस कम होने से रिकॉर्डिंग रुक गई। जगह खाली करें, फिर मीटिंग्स से सहेजा गया ऑडियो रिकवर करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف التسجيل لأن مساحة القرص منخفضة. حرّر مساحة، ثم استرد الصوت المحفوظ من الاجتماعات."
          }
        }
      }
    },
