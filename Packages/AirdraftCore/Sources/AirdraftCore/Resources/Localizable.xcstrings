        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدير قائم على الرموز. قد يضيف سياق القاموس تكلفة. يُحذف الصوت والمهام بعد الاستخدام عندما تكون واجهة API متاحة."
          }
        }
      }
    },
