    "Deletes all dictation and meeting audio, including interrupted recordings. Saved text, settings and models stay." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todo el audio de dictados y reuniones, incluidas las grabaciones interrumpidas. El texto guardado, los ajustes y los modelos se conservan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中断された録音を含め、音声入力と会議の音声をすべて削除します。保存したテキスト、設定、モデルは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除所有听写和会议音频，包括中断的录音。已保存的文本、设置和模型会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除所有聽寫與會議音訊，包括中斷的錄音。已儲存的文字、設定與模型會保留。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus semua audio dikte dan rapat, termasuk rekaman yang terputus. Teks tersimpan, pengaturan, dan model tetap ada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет всё аудио диктовок и встреч, включая прерванные записи. Сохранённый текст, настройки и модели остаются."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga todo o áudio de ditados e reuniões, inclusive gravações interrompidas. O texto salvo, os ajustes e os modelos permanecem."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tout l’audio des dictées et des réunions, y compris les enregistrements interrompus. Le texte enregistré, les réglages et les modèles sont conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बीच में रुकी रिकॉर्डिंग सहित, सारा डिक्टेशन और मीटिंग ऑडियो डिलीट करता है। सहेजा गया टेक्स्ट, सेटिंग्ज़ और मॉडल रहते हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف كل صوت الإملاء والاجتماعات، بما في ذلك التسجيلات المتوقفة. يبقى النص المحفوظ والإعدادات والنماذج."
          }
        }
      }
    },
    "Deletes all dictation history, meeting transcripts, remembered speaker names, recordings and interrupted meetings. Settings and models stay." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todo el historial de dictados, las transcripciones de reuniones, los nombres de hablantes recordados, las grabaciones y las reuniones interrumpidas. Los ajustes y los modelos se conservan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力の履歴、会議の文字起こし、記憶した話者名、録音、中断された会議をすべて削除します。設定とモデルは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除所有听写历史记录、会议转录文本、记住的发言人名称、录音和中断的会议。设置和模型会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除所有聽寫記錄、會議逐字稿、記住的講者名稱、錄音與中斷的會議。設定與模型會保留。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus semua riwayat dikte, transkrip rapat, nama pembicara yang diingat, rekaman, dan rapat yang terputus. Pengaturan dan model tetap ada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет всю историю диктовок, расшифровки встреч, запомненные имена спикеров, записи и прерванные встречи. Настройки и модели остаются."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga todo o histórico de ditados, as transcrições de reuniões, os nomes de falantes memorizados, as gravações e as reuniões interrompidas. Ajustes e modelos permanecem."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tout l’historique de dictée, les transcriptions de réunions, les noms d’intervenants mémorisés, les enregistrements et les réunions interrompues. Les réglages et les modèles sont conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सारा डिक्टेशन इतिहास, मीटिंग ट्रांसक्रिप्ट, याद रखे गए वक्ता नाम, रिकॉर्डिंग और बीच में रुकी मीटिंग्स डिलीट करता है। सेटिंग्ज़ और मॉडल रहते हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف كل سجل الإملاء ونصوص الاجتماعات المكتوبة وأسماء المتحدثين المحفوظة والتسجيلات والاجتماعات المتوقفة. تبقى الإعدادات والنماذج."
          }
        }
      }
    },
    "Deletes app data, settings, profiles, vocabulary, provider keys and downloaded models. Resets this app’s permissions. Quit when finished to restart setup. License and trial records stay." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina los datos de la app, los ajustes, los perfiles, el vocabulario, las claves de proveedores y los modelos descargados. Restablece los permisos de esta app. Sal al terminar para volver a configurarla. La licencia y los registros de prueba se conservan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのデータ、設定、プロファイル、語彙、プロバイダのキー、ダウンロードしたモデルを削除し、このアプリの権限をリセットします。完了したら終了して、設定をやり直してください。ライセンスと試用の記録は残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 App 数据、设置、模式、词汇、提供商密钥和已下载的模型，并重置此 App 的权限。完成后请退出 App 以重新设置。许可证和试用记录会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除 App 資料、設定、模式、詞彙、供應商金鑰與已下載的模型，並重置此 App 的權限。完成後請結束 App 以重新設定。授權與試用記錄會保留。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus data app, pengaturan, profil, kosakata, kunci penyedia, dan model yang diunduh. Mengatur ulang izin app ini. Keluar setelah selesai untuk memulai ulang penyiapan. Catatan lisensi dan uji coba tetap ada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет данные приложения, настройки, профили, словарь, ключи провайдеров и скачанные модели. Сбрасывает разрешения этого приложения. По завершении выйдите, чтобы снова пройти настройку. Лицензия и данные пробного периода остаются."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga dados do app, ajustes, perfis, vocabulário, chaves de provedores e modelos baixados. Redefine as permissões deste app. Encerre ao terminar para recomeçar a configuração. A licença e os registros de teste permanecem."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les données de l’app, les réglages, les profils, le vocabulaire, les clés des fournisseurs et les modèles téléchargés. Réinitialise les autorisations de cette app. Quittez à la fin pour relancer la configuration. La licence et les données d’essai sont conservées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप डेटा, सेटिंग्ज़, प्रोफ़ाइल, शब्दावली, प्रदाता की और डाउनलोड किए गए मॉडल डिलीट करता है। इस ऐप की अनुमतियाँ रीसेट करता है। सेटअप फिर से शुरू करने के लिए पूरा होने पर बाहर निकलें। लाइसेंस और ट्रायल रिकॉर्ड रहते हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف بيانات التطبيق والإعدادات والأنماط والمفردات ومفاتيح المزوّدين والنماذج المنزَّلة. ويعيد تعيين أذونات هذا التطبيق. أنهِ التطبيق عند الانتهاء لإعادة بدء الإعداد. تبقى بيانات الترخيص والفترة التجريبية."
          }
        }
      }
    },
    "Deletes dictation history, all meeting transcripts and remembered speaker names. Recordings, settings and models stay." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina el historial de dictados, todas las transcripciones de reuniones y los nombres de hablantes recordados. Las grabaciones, los ajustes y los modelos se conservan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力の履歴、会議のすべての文字起こし、記憶した話者名を削除します。録音、設定、モデルは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除听写历史记录、所有会议转录文本和记住的发言人名称。录音、设置和模型会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除聽寫記錄、所有會議逐字稿與記住的講者名稱。錄音、設定與模型會保留。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus riwayat dikte, semua transkrip rapat, dan nama pembicara yang diingat. Rekaman, pengaturan, dan model tetap ada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет историю диктовок, все расшифровки встреч и запомненные имена спикеров. Записи, настройки и модели остаются."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga o histórico de ditados, todas as transcrições de reuniões e os nomes de falantes memorizados. Gravações, ajustes e modelos permanecem."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime l’historique de dictée, toutes les transcriptions de réunions et les noms d’intervenants mémorisés. Les enregistrements, réglages et modèles sont conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिक्टेशन इतिहास, सभी मीटिंग ट्रांसक्रिप्ट और याद रखे गए वक्ता नाम डिलीट करता है। रिकॉर्डिंग, सेटिंग्ज़ और मॉडल रहते हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف سجل الإملاء وكل نصوص الاجتماعات المكتوبة وأسماء المتحدثين المحفوظة. تبقى التسجيلات والإعدادات والنماذج."
          }
        }
      }
    },
    "Designed for noisy and far-field speech. Auto-detects one language." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diseñado para voz con ruido y a distancia. Detecta automáticamente un idioma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "騒がしい場所や離れた位置からの音声向け。言語を 1 つ自動検出します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
