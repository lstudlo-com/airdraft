          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В файле нет декодируемого аудио. Попробуйте файл WAV, M4A, MP3, MP4 или MOV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este arquivo não tem áudio decodificável. Tente um arquivo WAV, M4A, MP3, MP4 ou MOV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier ne contient aucun audio décodable. Essayez un fichier WAV, M4A, MP3, MP4 ou MOV."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस फ़ाइल में डिकोड होने लायक ऑडियो नहीं है। WAV, M4A, MP3, MP4 या MOV फ़ाइल आज़माएँ।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحتوي هذا الملف على صوت قابل للفك. جرّب ملف WAV أو M4A أو MP3 أو MP4 أو MOV."
          }
        }
      }
    },
    "This key cannot run the connection check. Check account or model-read permissions in the provider console; speech access is separate." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta clave no puede ejecutar la comprobación de conexión. Revisa los permisos de cuenta o de lectura de modelos en la consola del proveedor; el acceso de voz es aparte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このキーでは接続チェックを実行できません。プロバイダのコンソールでアカウントまたはモデル読み取りの権限を確認してください。音声認識へのアクセスは別に管理されています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此密钥无法执行连接检查。请在提供商控制台中检查账户或模型读取权限；语音访问权限是单独的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此金鑰無法執行連線檢查。請在供應商主控台檢查帳號或模型讀取權限；語音存取權是分開的。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci ini tidak dapat menjalankan pemeriksaan koneksi. Periksa izin akun atau izin membaca model di konsol penyedia; akses ucapan terpisah."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот ключ не может выполнить проверку подключения. Проверьте права аккаунта или чтения моделей в консоли провайдера; доступ к речи настраивается отдельно."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta chave não consegue executar a verificação de conexão. Verifique as permissões da conta ou de leitura de modelos no console do provedor; o acesso à fala é separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette clé ne peut pas effectuer le test de connexion. Vérifiez les autorisations du compte ou de lecture des modèles dans la console du fournisseur ; l’accès à la reconnaissance est distinct."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह की कनेक्शन जाँच नहीं चला सकती। प्रदाता कंसोल में खाते या मॉडल पढ़ने की अनुमतियाँ जाँचें; स्पीच ऐक्सेस अलग है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لهذا المفتاح إجراء فحص الاتصال. تحقق من أذونات الحساب أو قراءة النماذج في وحدة تحكم المزوّد؛ الوصول إلى الكلام منفصل."
          }
        }
      }
    },
    "This license or device activation is no longer valid. Check your key and devices in the customer portal." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta licencia o activación del dispositivo ya no es válida. Revisa tu clave y tus dispositivos en el portal de cliente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このライセンスまたはデバイスのアクティベーションは無効になりました。カスタマーポータルでキーとデバイスを確認してください。"
