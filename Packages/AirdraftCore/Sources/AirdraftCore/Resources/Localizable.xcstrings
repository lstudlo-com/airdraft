        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feito para fala com ruído e à distância. Detecta automaticamente um idioma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conçu pour la parole bruitée et lointaine. Détecte automatiquement une langue."
