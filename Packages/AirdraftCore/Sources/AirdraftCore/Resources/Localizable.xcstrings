          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratinjau langsung tidak dapat mengalokasikan buffer audio. Mulai rekaman lain untuk mencoba lagi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предпросмотру не удалось выделить аудиобуфер. Начните новую запись, чтобы повторить."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A prévia ao vivo não conseguiu alocar um buffer de áudio. Inicie outra gravação para tentar novamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aperçu en direct n’a pas pu allouer de tampon audio. Lancez un nouvel enregistrement pour réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइव प्रीव्यू ऑडियो बफ़र नहीं बना सका। फिर से कोशिश करने के लिए नई रिकॉर्डिंग शुरू करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على المعاينة المباشرة تخصيص مخزن صوتي مؤقت. ابدأ تسجيلًا آخر لإعادة المحاولة."
          }
        }
      }
    },
    "Live preview could not convert audio. Reload Apple Speech in Models and retry." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vista previa en directo no pudo convertir el audio. Vuelve a cargar Apple Speech en Modelos y reintenta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブプレビューで音声を変換できませんでした。「モデル」で Apple Speech を再読み込みしてから再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时预览无法转换音频。请在“模型”中重新加载 Apple 语音后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時預覽無法轉換音訊。請在「模型」中重新載入 Apple 語音後重試。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratinjau langsung tidak dapat mengonversi audio. Muat ulang Apple Speech di Model dan coba lagi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предпросмотру не удалось преобразовать аудио. Перезагрузите Apple Speech в «Моделях» и повторите."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A prévia ao vivo não conseguiu converter o áudio. Recarregue o Apple Speech em Modelos e tente novamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aperçu en direct n’a pas pu convertir l’audio. Rechargez Apple Speech dans Modèles et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइव प्रीव्यू ऑडियो रूपांतरित नहीं कर सका। मॉडल में Apple Speech फिर से लोड करें और फिर से कोशिश करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على المعاينة المباشرة تحويل الصوت. أعد تحميل Apple Speech في النماذج وأعد المحاولة."
          }
        }
      }
    },
    "Live preview could not keep up. Start another recording to retry, or turn off Live Preview. Final transcription is unaffected." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vista previa en directo no pudo seguir el ritmo. Inicia otra grabación para reintentar o desactiva la vista previa en directo. La transcripción final no se ve afectada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブプレビューが追いつけませんでした。新しい録音を開始して再試行するか、ライブプレビューをオフにしてください。最終的な文字起こしには影響しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时预览跟不上。请开始新的录音以重试，或关闭实时预览。最终转录不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時預覽跟不上。請開始新的錄音以重試，或關閉即時預覽。最終轉錄不受影響。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratinjau langsung tidak dapat mengimbangi. Mulai rekaman lain untuk mencoba lagi, atau nonaktifkan Pratinjau langsung. Transkripsi akhir tidak terpengaruh."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предпросмотр не успевал. Начните новую запись, чтобы повторить, или выключите предпросмотр. Итоговая расшифровка не затронута."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A prévia ao vivo não conseguiu acompanhar. Inicie outra gravação para tentar novamente ou desative a Prévia ao vivo. A transcrição final não é afetada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aperçu en direct n’a pas pu suivre. Lancez un nouvel enregistrement pour réessayer, ou désactivez l’aperçu en direct. La transcription finale n’est pas affectée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइव प्रीव्यू साथ नहीं चल सका। फिर से कोशिश करने के लिए नई रिकॉर्डिंग शुरू करें, या लाइव प्रीव्यू बंद करें। अंतिम ट्रांसक्रिप्शन पर असर नहीं पड़ता।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تستطع المعاينة المباشرة مواكبة الصوت. ابدأ تسجيلًا آخر لإعادة المحاولة، أو أوقف المعاينة المباشرة. لا يتأثر التحويل النهائي إلى نص."
          }
        }
      }
    },
    "Live preview could not prepare audio. Start another recording to retry." : {
