    "Airdraft's list of reviewed Core ML speech models is missing or damaged, so these models can't be downloaded or used. Reinstall Airdraft to restore it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta o está dañada la lista de Airdraft de modelos de voz Core ML revisados, por lo que no se pueden descargar ni usar. Reinstala Airdraft para restaurarla."
          }
        },
        "ja" : {
