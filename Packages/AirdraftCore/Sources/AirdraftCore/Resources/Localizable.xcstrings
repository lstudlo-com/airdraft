    "%@ Audio cleanup also failed: %@. Retry clearing saved audio." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Audio cleanup also failed: %2$@. Retry clearing saved audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ La limpieza de audio también falló: %2$@. Vuelve a intentar borrar el audio guardado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 音声のクリーンアップにも失敗しました：%2$@。保存された音声の消去を再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 音频清理也失败了：%2$@。请重试清除已保存的音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 音訊清理也失敗：%2$@。請重試清除已儲存的音訊。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Pembersihan audio juga gagal: %2$@. Coba hapus audio tersimpan lagi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Очистка аудио тоже не удалась: %2$@. Повторите удаление сохранённого аудио."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ A limpeza do áudio também falhou: %2$@. Tente limpar o áudio salvo novamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Le nettoyage de l’audio a aussi échoué : %2$@. Réessayez d’effacer l’audio enregistré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ऑडियो की सफ़ाई भी विफल रही: %2$@। सहेजा गया ऑडियो फिर से साफ़ करने की कोशिश करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ فشل تنظيف الصوت أيضًا: %2$@. أعد محاولة مسح الصوت المحفوظ."
          }
        }
      }
    },
