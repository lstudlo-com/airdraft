{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" is not a valid speech language code. Choose a language on Models." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」不是有效的語音語言代碼。請在「模型」中選擇語言。"
          }
        }
      }
    },
    "$0.0045 per audio minute." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每分鐘音訊 0.0045 美元。"
          }
        }
      }
    },
    "$0.0045 per audio minute. Replaces the older GPT-4o transcription preset." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每分鐘音訊 0.0045 美元。取代舊的 GPT-4o 轉錄預設組合。"
          }
        }
      }
    },
    "%@ Audio cleanup also failed: %@. Retry clearing saved audio." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Audio cleanup also failed: %2$@. Retry clearing saved audio."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 音訊清理也失敗：%2$@。請重試清除已儲存的音訊。"
          }
        }
      }
    },
    "%@ copy" : {
      "comment" : "Name of a duplicated profile",
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 副本"
          }
        }
      }
    },
    "%@ does not support %@. Choose a supported language on Models or another speech model." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ does not support %2$@. Choose a supported language on Models or another speech model."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 不支援%2$@。請在「模型」中選擇支援的語言或其他語音模型。"
          }
        }
      }
    },
    "%@ ended %@ seconds before the recording stopped." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ ended %2$@ seconds before the recording stopped."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@在錄音停止前 %2$@ 秒結束。"
          }
        }
      }
    },
    "%@ format changed during recording." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄音期間%@格式已變更。"
          }
        }
      }
    },
    "%@ gap at %@ seconds (%@ seconds)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ gap at %2$@ seconds (%3$@ seconds)."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@在 %2$@ 秒處中斷（%3$@ 秒）。"
          }
        }
      }
    },
    "%@ has no reviewed download. Choose a model from the Models list." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 沒有經過審核的下載來源。請從「模型」清單中選擇模型。"
          }
        }
      }
    },
    "%@ is unavailable on this Mac. Choose a supported locale in Models." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這台 Mac 無法使用 %@。請在「模型」中選擇支援的地區語言。"
          }
        }
      }
    },
    "%@ is unavailable. Reconnect it or choose another microphone." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」無法使用。請重新連接，或選擇其他麥克風。"
          }
        }
      }
    },
    "%@ needs an explicit speech language. Choose a supported language on Models or select a model with Auto Detect." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要指定語音語言。請在「模型」中選擇支援的語言，或選擇具備自動偵測的模型。"
          }
        }
      }
    },
    "%@ received" : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已接收 %@"
          }
        }
      }
    },
    "%@; raw text inserted." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@；已插入原始文字。"
