            "value" : "音声認識プロバイダが予期しない応答を返しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音提供商返回了意外的响应。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語音供應商回傳了非預期的回應。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyedia ucapan mengembalikan respons tak terduga."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдер речи вернул неожиданный ответ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O provedor de fala retornou uma resposta inesperada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fournisseur de reconnaissance a renvoyé une réponse inattendue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्पीच प्रदाता ने अनपेक्षित प्रतिक्रिया लौटाई।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرجع مزوّد الكلام استجابة غير متوقعة."
          }
        }
      }
    },
    "The system clock moved backwards. Correct the date and time to continue your trial." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reloj del sistema retrocedió. Corrige la fecha y la hora para continuar tu prueba."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムの時計が過去に戻りました。試用を続けるには日付と時刻を修正してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统时钟回退了。请校正日期和时间以继续试用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系統時鐘倒退了。請修正日期與時間以繼續試用。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jam sistem mundur. Perbaiki tanggal dan waktu untuk melanjutkan uji coba Anda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Системные часы переведены назад. Исправьте дату и время, чтобы продолжить пробный период."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relógio do sistema voltou no tempo. Corrija a data e a hora para continuar seu teste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’horloge système a reculé. Corrigez la date et l’heure pour poursuivre votre essai."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम घड़ी पीछे चली गई। अपना ट्रायल जारी रखने के लिए तारीख और समय ठीक करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عادت ساعة النظام إلى الوراء. صحّح التاريخ والوقت لمواصلة الفترة التجريبية."
          }
        }
      }
    },
