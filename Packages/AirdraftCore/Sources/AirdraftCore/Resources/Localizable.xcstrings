    "Job deletion is attempted after use. Uploads without a job follow provider retention." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se intenta eliminar la tarea después de usarla. Las subidas sin tarea siguen la retención del proveedor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用後にジョブの削除を試みます。ジョブのないアップロードはプロバイダの保存方針に従います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用后会尝试删除任务。没有任务的上传文件按提供商的保留政策处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用後會嘗試刪除工作。沒有工作的上傳檔案依供應商的保留政策處理。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penghapusan tugas dicoba setelah dipakai. Unggahan tanpa tugas mengikuti retensi penyedia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После использования выполняется попытка удалить задание. Отправленные файлы без задания хранятся по правилам провайдера."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A exclusão da tarefa é tentada após o uso. Envios sem tarefa seguem a retenção do provedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression de la tâche est tentée après usage. Les envois sans tâche suivent la politique de conservation du fournisseur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपयोग के बाद जॉब डिलीट करने की कोशिश की जाती है। बिना जॉब वाले अपलोड प्रदाता की रिटेंशन नीति के अनुसार रहते हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحاول حذف المهمة بعد الاستخدام. تخضع الملفات المرفوعة دون مهمة لسياسة الاحتفاظ لدى المزوّد."
          }
        }
      }
    },
    "Key accepted. Selected speech model is listed in OpenRouter's public catalog. Speech access and billing are not verified." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clave aceptada. El modelo de voz seleccionado aparece en el catálogo público de OpenRouter. El acceso de voz y la facturación no están verificados."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーが承認されました。選択した音声モデルは OpenRouter の公開カタログにあります。音声認識へのアクセスと課金は未検証です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥已被接受。所选语音模型在 OpenRouter 的公开目录中。语音访问权限和计费尚未验证。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已接受金鑰。所選語音模型列於 OpenRouter 的公開目錄中。語音存取權與計費尚未驗證。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci diterima. Model ucapan terpilih tercantum di katalog publik OpenRouter. Akses ucapan dan penagihan belum terverifikasi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ принят. Выбранная модель речи есть в публичном каталоге OpenRouter. Доступ к речи и оплата не проверены."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chave aceita. O modelo de fala selecionado está no catálogo público do OpenRouter. O acesso à fala e a cobrança não foram verificados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clé acceptée. Le modèle vocal sélectionné figure dans le catalogue public d’OpenRouter. L’accès à la reconnaissance et la facturation ne sont pas vérifiés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "की स्वीकार की गई। चुना गया स्पीच मॉडल OpenRouter के सार्वजनिक कैटलॉग में सूचीबद्ध है। स्पीच ऐक्सेस और बिलिंग सत्यापित नहीं हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قُبل المفتاح. نموذج الكلام المحدد مدرج في الكتالوج العام لـ OpenRouter. لم يُتحقق من الوصول إلى الكلام والفوترة."
          }
        }
      }
    },
    "Keyword hints from your dictionary and mixed-language recognition." : {
