    "Preserves fillers and repetitions; supports native custom vocabulary. Refinement remains independent." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva muletillas y repeticiones; admite vocabulario personalizado nativo. El refinamiento sigue siendo independiente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィラーや繰り返しを残し、ネイティブのカスタム語彙に対応しています。整形はこれとは別に行われます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留口头禅和重复；支持原生自定义词汇。润色仍独立进行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留贅字與重複；支援原生自訂詞彙。潤稿仍獨立進行。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mempertahankan kata pengisi dan pengulangan; mendukung kosakata khusus bawaan. Penyempurnaan tetap terpisah."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняет слова-паразиты и повторы; поддерживает встроенный свой словарь. Доработка остаётся независимой."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preserva hesitações e repetições; suporta vocabulário personalizado nativo. O refinamento continua independente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve les mots de remplissage et les répétitions ; prend en charge le vocabulaire personnalisé natif. L’affinage reste indépendant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भराव शब्द और दोहराव बनाए रखता है; नेटिव कस्टम शब्दावली का समर्थन करता है। सुधार अलग से रहता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحافظ على كلمات الحشو والتكرارات؛ ويدعم المفردات المخصصة الأصلية. يبقى التحسين مستقلًا."
          }
        }
      }
    },
