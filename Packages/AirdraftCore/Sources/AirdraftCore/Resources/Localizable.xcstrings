    "Groq's benchmark. Faster and cheaper than Large v3, with a higher error rate." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba de Groq. Más rápido y barato que Large v3, con una tasa de error mayor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groq のベンチマーク。Large v3 より高速で安価ですが、誤り率は高めです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groq 的基准测试。比 Large v3 更快更便宜，但错误率更高。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groq 的基準測試。比 Large v3 更快更便宜，但錯誤率較高。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tolok ukur Groq. Lebih cepat dan lebih murah daripada Large v3, dengan tingkat kesalahan lebih tinggi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тест Groq. Быстрее и дешевле Large v3, но с бо́льшим числом ошибок."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benchmark da Groq. Mais rápido e barato que o Large v3, com taxa de erro maior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure de Groq. Plus rapide et moins cher que Large v3, avec un taux d’erreur plus élevé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groq का बेंचमार्क। Large v3 से तेज़ और सस्ता, लेकिन ज़्यादा त्रुटि दर।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقياس Groq. أسرع وأرخص من Large v3، مع معدل خطأ أعلى."
          }
        }
      }
    },
    "Groq's benchmark. Lower error rate than Turbo; costs more per hour." : {
