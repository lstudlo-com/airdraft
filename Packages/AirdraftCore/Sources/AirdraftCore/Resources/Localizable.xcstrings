      }
    },
    "Deletes all dictation audio and recordings, including interrupted ones. Saved text, settings and models stay." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todo el audio de dictados y las grabaciones, incluidas las interrumpidas. El texto guardado, los ajustes y los modelos se conservan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中断されたものを含め、音声入力の音声と録音をすべて削除します。保存したテキスト、設定、モデルは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除所有听写音频和录音，包括中断的录音。已保存的文本、设置和模型会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除所有聽寫音訊與錄音，包括中斷的錄音。已儲存的文字、設定與模型會保留。"
          }
        }
      }
    },
    "Deletes all dictation history, transcripts, remembered speaker names and recordings, including interrupted ones. Settings and models stay." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todo el historial de dictados, las transcripciones, los nombres de hablantes recordados y las grabaciones, incluidas las interrumpidas. Los ajustes y los modelos se conservan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力の履歴、文字起こし、記憶した話者名、中断されたものを含む録音をすべて削除します。設定とモデルは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除所有听写历史记录、转录文本、记住的发言人名称和录音，包括中断的录音。设置和模型会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除所有聽寫記錄、逐字稿、記住的講者名稱與錄音，包括中斷的錄音。設定與模型會保留。"
          }
        }
      }
    },
    "Deletes app data, settings, profiles, vocabulary, provider keys and downloaded models. Resets this app’s permissions. Quit when finished to restart setup. License and trial records stay." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina los datos de la app, los ajustes, los perfiles, el vocabulario, las claves de proveedores y los modelos descargados. Restablece los permisos de esta app. Sal al terminar para volver a configurarla. La licencia y los registros de prueba se conservan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのデータ、設定、モード、語彙、プロバイダのキー、ダウンロードしたモデルを削除し、このアプリの権限をリセットします。完了したら終了して、設定をやり直してください。ライセンスと試用の記録は残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 App 数据、设置、模式、词汇、提供商密钥和已下载的模型，并重置此 App 的权限。完成后请退出 App 以重新设置。许可证和试用记录会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除 App 資料、設定、模式、詞彙、供應商金鑰與已下載的模型，並重置此 App 的權限。完成後請結束 App 以重新設定。授權與試用記錄會保留。"
          }
        }
      }
    },
    "Deletes dictation history, all transcripts and remembered speaker names. Recordings, settings and models stay." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina el historial de dictados, todas las transcripciones y los nombres de hablantes recordados. Las grabaciones, los ajustes y los modelos se conservan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力の履歴、すべての文字起こし、記憶した話者名を削除します。録音、設定、モデルは残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除听写历史记录、所有转录文本和记住的发言人名称。录音、设置和模型会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除聽寫記錄、所有逐字稿與記住的講者名稱。錄音、設定與模型會保留。"
          }
        }
      }
    },
    "Designed for noisy and far-field speech. Auto-detects one language." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diseñado para voz con ruido y a distancia. Detecta automáticamente un idioma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "騒がしい場所や離れた位置からの音声向け。言語を 1 つ自動検出します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专为嘈杂和远场语音设计。会自动检测一种语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專為吵雜與遠距語音設計。會自動偵測一種語言。"
          }
        }
      }
    },
