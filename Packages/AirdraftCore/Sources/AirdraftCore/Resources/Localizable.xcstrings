          }
        }
      }
    },
    "The provider does not publish comparable file-transcription latency. Upload and network time also affect your wait." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proveedor no publica una latencia comparable de transcripción de archivos. Los tiempos de subida y de red también afectan a la espera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダはファイルの文字起こしについて比較できる遅延を公開していません。待ち時間はアップロードとネットワークの時間にも左右されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供商未公布可比较的文件转录延迟。上传和网络时间也会影响等待时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供應商未公布可比較的檔案轉錄延遲。上傳與網路時間也會影響等待時間。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyedia tidak memublikasikan latensi transkripsi file pembanding. Waktu unggah dan jaringan juga memengaruhi waktu tunggu Anda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провайдер не публикует сопоставимые данные о задержке расшифровки файлов. Время ожидания также зависит от отправки файла и сети."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O provedor não publica latência de transcrição de arquivos comparável. O envio e o tempo de rede também afetam sua espera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fournisseur ne publie pas de latence comparable pour la transcription de fichiers. L’envoi et le temps réseau influent aussi sur votre attente."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रदाता तुलना योग्य फ़ाइल-ट्रांसक्रिप्शन लेटेंसी प्रकाशित नहीं करता। अपलोड और नेटवर्क समय से भी आपकी प्रतीक्षा पर असर पड़ता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا ينشر المزوّد زمن استجابة قابلًا للمقارنة لتحويل الملفات إلى نص. يؤثر وقت الرفع والشبكة أيضًا في مدة انتظارك."
          }
        }
      }
    },
    "The provider returned HTTP %lld. Try again later." : {
      "localizations" : {
        "es" : {
