    "Includes Mandarin and English code-switching; uses dictionary keyterms." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye cambios de código entre mandarín e inglés; usa términos clave del diccionario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標準中国語と英語の混在に対応し、辞書のキーワードを使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持普通话与英语混说；使用词汇中的关键词。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支援華語與英文夾雜；使用詞彙中的關鍵詞。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencakup peralihan kode Mandarin dan Inggris; memakai istilah kunci kamus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддерживает смешение мандаринского и английского; использует ключевые слова из словаря."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui alternância entre mandarim e inglês; usa termos-chave do dicionário."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gère l’alternance mandarin-anglais ; utilise les mots-clés du dictionnaire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैंडरिन और अंग्रेज़ी के बीच बदलाव शामिल; शब्दकोश के कीटर्म का उपयोग करता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشمل التبديل بين الماندرين والإنجليزية؛ ويستخدم المصطلحات الرئيسية من القاموس."
          }
        }
      }
    },
    "Ink-Whisper is the file model. Automatic detection and streaming Ink-2 are unavailable here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ink-Whisper es el modelo de archivos. La detección automática y el streaming de Ink-2 no están disponibles aquí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ink-Whisper はファイル用のモデルです。ここでは自動検出とストリーミングの Ink-2 は使用できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ink-Whisper 是文件模型。这里无法使用自动检测和流式 Ink-2。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ink-Whisper 是檔案模型。這裡無法使用自動偵測與串流 Ink-2。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ink-Whisper adalah model file. Deteksi otomatis dan Ink-2 streaming tidak tersedia di sini."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ink-Whisper — модель для файлов. Автоопределение и потоковая Ink-2 здесь недоступны."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ink-Whisper é o modelo de arquivos. A detecção automática e o Ink-2 em streaming não estão disponíveis aqui."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ink-Whisper est le modèle pour fichiers. La détection automatique et Ink-2 en streaming ne sont pas disponibles ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ink-Whisper फ़ाइल मॉडल है। स्वतः पहचान और स्ट्रीमिंग Ink-2 यहाँ उपलब्ध नहीं हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعد Ink-Whisper نموذج الملفات. الاكتشاف التلقائي وبث Ink-2 غير متاحين هنا."
          }
        }
      }
    },
    "Input %lld is unavailable on this microphone. Choose an input channel in Settings." : {
      "localizations" : {
        "es" : {
