    "Text delivery has started and cannot be cancelled safely." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La entrega del texto ya empezó y no se puede cancelar de forma segura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキストの入力が始まっているため、安全にキャンセルできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本发送已开始，无法安全取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字傳送已開始，無法安全取消。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengiriman teks sudah dimulai dan tidak dapat dibatalkan dengan aman."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставка текста началась, и её нельзя безопасно отменить."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A entrega do texto já começou e não pode ser cancelada com segurança."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’envoi du texte a commencé et ne peut pas être annulé sans risque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेक्स्ट भेजना शुरू हो चुका है और इसे सुरक्षित रूप से रद्द नहीं किया जा सकता।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدأ تسليم النص ولا يمكن إلغاؤه بأمان."
          }
        }
      }
    },
    "The API key was rejected. Check the key and its permissions in the provider console." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se rechazó la clave de API. Revisa la clave y sus permisos en la consola del proveedor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API キーが拒否されました。プロバイダのコンソールでキーとその権限を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 密钥被拒绝。请在提供商控制台中检查密钥及其权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 金鑰遭拒。請在供應商主控台檢查金鑰及其權限。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci API ditolak. Periksa kunci dan izinnya di konsol penyedia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ API отклонён. Проверьте ключ и его права в консоли провайдера."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave de API foi recusada. Verifique a chave e suas permissões no console do provedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé API a été refusée. Vérifiez la clé et ses autorisations dans la console du fournisseur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API की अस्वीकार कर दी गई। प्रदाता कंसोल में की और उसकी अनुमतियाँ जाँचें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رُفض مفتاح API. تحقق من المفتاح وأذوناته في وحدة تحكم المزوّد."
          }
        }
      }
    },
    "The OpenRouter key is valid, but this model is not in the current public speech catalog. Refresh the catalog or choose another model." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave de OpenRouter es válida, pero este modelo no está en el catálogo público de voz actual. Actualiza el catálogo o elige otro modelo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenRouter のキーは有効ですが、このモデルは現在の公開音声カタログにありません。カタログを更新するか、別のモデルを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenRouter 密钥有效，但此模型不在当前的公开语音目录中。请刷新目录或选择其他模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenRouter 金鑰有效，但此模型不在目前的公開語音目錄中。請重新整理目錄或選擇其他模型。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci OpenRouter valid, tetapi model ini tidak ada di katalog ucapan publik saat ini. Segarkan katalog atau pilih model lain."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ OpenRouter действителен, но этой модели нет в текущем публичном каталоге речи. Обновите каталог или выберите другую модель."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave do OpenRouter é válida, mas este modelo não está no catálogo público de fala atual. Atualize o catálogo ou escolha outro modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé OpenRouter est valide, mais ce modèle ne figure pas dans le catalogue vocal public actuel. Actualisez le catalogue ou choisissez un autre modèle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenRouter की मान्य है, लेकिन यह मॉडल मौजूदा सार्वजनिक स्पीच कैटलॉग में नहीं है। कैटलॉग रिफ़्रेश करें या दूसरा मॉडल चुनें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح OpenRouter صالح، لكن هذا النموذج ليس في كتالوج الكلام العام الحالي. حدّث الكتالوج أو اختر نموذجًا آخر."
          }
        }
      }
    },
    "The app data folder is not a regular local directory. Cleanup stopped without following its link." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta de datos de la app no es un directorio local normal. La limpieza se detuvo sin seguir su enlace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのデータフォルダが通常のローカルディレクトリではありません。リンク先をたどらずにクリーンアップを停止しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 数据文件夹不是普通的本地目录。清理已停止，未跟随其链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 資料夾不是一般的本機目錄。清理已停止，並未追蹤其連結。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder data app bukan direktori lokal biasa. Pembersihan dihentikan tanpa mengikuti tautannya."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка данных приложения не является обычной локальной папкой. Очистка остановлена, ссылка не открыта."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta de dados do app não é um diretório local comum. A limpeza parou sem seguir o link."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier de données de l’app n’est pas un dossier local standard. Le nettoyage s’est arrêté sans suivre son lien."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप डेटा फ़ोल्डर सामान्य लोकल डायरेक्टरी नहीं है। सफ़ाई उसके लिंक का अनुसरण किए बिना रुक गई।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجلد بيانات التطبيق ليس دليلًا محليًا عاديًا. توقف التنظيف دون اتباع رابطه."
          }
        }
      }
    },
    "The audio clock changed. Recording stopped to preserve the saved timeline." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reloj de audio cambió. La grabación se detuvo para conservar la cronología guardada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声のクロックが変わりました。保存したタイムラインを保持するため、録音を停止しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频时钟已更改。为保留已保存的时间线，录音已停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音訊時鐘已變更。為保留已儲存的時間軸，錄音已停止。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jam audio berubah. Rekaman dihentikan untuk menjaga lini masa yang tersimpan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аудиочасы изменились. Запись остановлена, чтобы сохранить временную шкалу."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relógio de áudio mudou. A gravação parou para preservar a linha do tempo salva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’horloge audio a changé. L’enregistrement s’est arrêté pour préserver la chronologie enregistrée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑडियो क्लॉक बदल गई। सहेजी गई टाइमलाइन सुरक्षित रखने के लिए रिकॉर्डिंग रोक दी गई।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت ساعة الصوت. توقف التسجيل للحفاظ على المخطط الزمني المحفوظ."
          }
        }
      }
    },
    "The cleanup record could not be read. Keep Airdraft closed and check its data folder before removing anything." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer el registro de limpieza. Mantén Airdraft cerrado y revisa su carpeta de datos antes de eliminar nada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリーンアップの記録を読み込めませんでした。何かを削除する前に、Airdraft を閉じたままデータフォルダを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取清理记录。移除任何内容前，请保持 Airdraft 关闭并检查其数据文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
