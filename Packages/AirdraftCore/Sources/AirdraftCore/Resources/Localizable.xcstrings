          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A captura do sistema parou inesperadamente. O trecho final salvo pode estar incompleto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capture du système s’est arrêtée de façon inattendue. La fin enregistrée peut être incomplète."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम कैप्चर अचानक रुक गया। सहेजा गया आख़िरी हिस्सा अधूरा हो सकता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
