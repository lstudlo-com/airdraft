    "Dedicated transcription in verbatim mode, with automatic language detection." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transcripción dedicada en modo literal, con detección automática del idioma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐語モードの専用文字起こし。言語は自動検出されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以逐字模式专门转录，并自动检测语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以逐字模式專門轉錄，並自動偵測語言。"
          }
        }
      }
    },
    "Deepgram states its non-Whisper models return results faster than its Whisper models. No comparable latency is published." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deepgram afirma que sus modelos que no son Whisper devuelven resultados más rápido que sus modelos Whisper. No se publica una latencia comparable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deepgram によると、Whisper 以外のモデルは Whisper モデルより速く結果を返します。比較できる遅延は公開されていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deepgram 表示其非 Whisper 模型返回结果比 Whisper 模型更快。未公布可比较的延迟数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deepgram 表示其非 Whisper 模型回傳結果比 Whisper 模型更快。未公布可比較的延遲。"
          }
        }
      }
    },
    "Default model" : {
