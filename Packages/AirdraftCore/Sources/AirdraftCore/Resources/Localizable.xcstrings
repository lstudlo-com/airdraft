          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用后会尝试删除任务。没有任务的上传文件按提供商的保留政策处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
