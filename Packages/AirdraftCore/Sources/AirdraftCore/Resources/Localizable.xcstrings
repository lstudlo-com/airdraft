    "Media files can be up to two hours long. Split this recording before importing it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos multimedia pueden durar hasta dos horas. Divide esta grabación antes de importarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メディアファイルは最長 2 時間です。読み込む前にこの録音を分割してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "媒体文件最长两小时。请先分割此录音再导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "媒體檔案最長兩小時。請先分割此錄音再匯入。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File media dapat berdurasi hingga dua jam. Pisahkan rekaman ini sebelum mengimpornya."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медиафайлы могут длиться до двух часов. Разделите эту запись перед импортом."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos de mídia podem ter até duas horas. Divida esta gravação antes de importá-la."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers média peuvent durer jusqu’à deux heures. Divisez cet enregistrement avant de l’importer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मीडिया फ़ाइलें दो घंटे तक लंबी हो सकती हैं। इंपोर्ट करने से पहले इस रिकॉर्डिंग को बाँटें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن تصل مدة ملفات الوسائط إلى ساعتين. قسّم هذا التسجيل قبل استيراده."
          }
        }
      }
    },
