        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ には確認済みのダウンロード元がありません。「モデル」の一覧からモデルを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
