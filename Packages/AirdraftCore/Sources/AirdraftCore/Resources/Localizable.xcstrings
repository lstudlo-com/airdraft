    "%@ does not support %@. Choose a supported language on Models or another speech model." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ does not support %2$@. Choose a supported language on Models or another speech model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no admite %2$@. Elige un idioma compatible en Modelos u otro modelo de voz."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は%2$@に対応していません。「モデル」で対応している言語か、別の音声モデルを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 不支持%2$@。请在“模型”中选择支持的语言，或选择其他语音模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 不支援%2$@。請在「模型」中選擇支援的語言或其他語音模型。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tidak mendukung %2$@. Pilih bahasa yang didukung di Model atau model ucapan lain."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ не поддерживает %2$@. Выберите поддерживаемый язык в «Моделях» или другую модель речи."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ não suporta %2$@. Escolha um idioma suportado em Modelos ou outro modelo de fala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne prend pas en charge cette langue (%2$@). Choisissez une langue prise en charge dans Modèles ou un autre modèle vocal."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ का समर्थन नहीं करता। मॉडल में कोई समर्थित भाषा या दूसरा स्पीच मॉडल चुनें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يدعم %1$@ اللغة %2$@. اختر لغة مدعومة في النماذج أو نموذج كلام آخر."
          }
        }
      }
    },
