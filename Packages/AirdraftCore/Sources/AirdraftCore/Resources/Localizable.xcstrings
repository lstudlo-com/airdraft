    "Asynchronous processing adds job scheduling and polling." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El procesamiento asíncrono añade programación de tareas y sondeo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非同期処理のため、ジョブのスケジュールとポーリングの時間が加わります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "异步处理会增加任务调度和轮询时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非同步處理會增加工作排程與輪詢時間。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemrosesan asinkron menambah penjadwalan tugas dan polling."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Асинхронная обработка добавляет постановку задания в очередь и опрос."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O processamento assíncrono adiciona agendamento e consulta de tarefas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le traitement asynchrone ajoute la planification de tâches et l’interrogation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एसिंक्रोनस प्रोसेसिंग में जॉब शेड्यूलिंग और पोलिंग जुड़ जाती है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تضيف المعالجة غير المتزامنة جدولة المهام والاستطلاع."
          }
        }
      }
    },
    "Audio capture fell behind. Recording stopped; the saved audio can be recovered from Meetings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La captura de audio se quedó atrás. La grabación se detuvo; el audio guardado se puede recuperar desde Reuniones."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声の取り込みが追いつかなくなったため、録音を停止しました。保存された音声は「会議」から復元できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频采集跟不上。录音已停止；已保存的音频可从“会议”中恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音訊擷取跟不上。錄音已停止；已儲存的音訊可從「會議」中復原。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perekaman audio tertinggal. Rekaman dihentikan; audio yang tersimpan dapat dipulihkan dari Rapat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захват аудио не успевал. Запись остановлена; сохранённое аудио можно восстановить во «Встречах»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A captura de áudio ficou para trás. A gravação parou; o áudio salvo pode ser recuperado em Reuniões."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capture audio a pris du retard. L’enregistrement s’est arrêté ; l’audio enregistré peut être récupéré dans Réunions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑडियो कैप्चर पीछे रह गया। रिकॉर्डिंग रुक गई; सहेजा गया ऑडियो मीटिंग्स से रिकवर किया जा सकता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأخر التقاط الصوت. توقف التسجيل؛ ويمكن استرداد الصوت المحفوظ من الاجتماعات."
          }
        }
      }
    },
    "Audio is sent to xAI. Check current model pricing and account limits before use." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio se envía a xAI. Revisa los precios actuales del modelo y los límites de la cuenta antes de usarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声は xAI に送信されます。使用する前に、現在のモデルの価格とアカウントの制限を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频会发送到 xAI。使用前请确认当前的模型定价和账户限制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音訊會傳送到 xAI。使用前請確認目前的模型定價與帳號限制。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio dikirim ke xAI. Periksa harga model terkini dan batas akun sebelum digunakan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аудио отправляется в xAI. Перед использованием проверьте актуальные цены модели и лимиты аккаунта."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O áudio é enviado à xAI. Verifique os preços atuais do modelo e os limites da conta antes de usar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’audio est envoyé à xAI. Vérifiez les tarifs actuels du modèle et les limites de votre compte avant utilisation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑडियो xAI को भेजा जाता है। इस्तेमाल से पहले मॉडल की मौजूदा कीमतें और खाते की सीमाएँ जाँचें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُرسل الصوت إلى xAI. تحقق من أسعار النموذج الحالية وحدود الحساب قبل الاستخدام."
          }
        }
      }
    },
    "Auto" : {
