    "Improved recognition over original Whisper; accepts dictionary context as a text prompt." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconocimiento mejorado respecto al Whisper original; acepta el contexto del diccionario como prompt de texto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元の Whisper より認識が向上しています。辞書のコンテキストをテキストプロンプトとして受け付けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "识别效果优于原版 Whisper；可接受词汇上下文作为文本提示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辨識效果優於原始 Whisper；可接受詞彙情境作為文字提示。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengenalan lebih baik daripada Whisper asli; menerima konteks kamus sebagai prompt teks."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Улучшенное распознавание по сравнению с исходным Whisper; принимает контекст словаря как текстовый промпт."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconhecimento melhor que o Whisper original; aceita contexto do dicionário como prompt de texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnaissance améliorée par rapport au Whisper original ; accepte le contexte du dictionnaire sous forme de prompt texte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मूल Whisper से बेहतर पहचान; शब्दकोश संदर्भ को टेक्स्ट प्रॉम्प्ट के रूप में लेता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرّف محسَّن مقارنةً بـ Whisper الأصلي؛ يقبل سياق القاموس كموجّه نصي."
          }
        }
      }
    },
