    "The previous model load is still stopping. Choose another model, or restart Airdraft to retry this one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga anterior del modelo aún se está deteniendo. Elige otro modelo o reinicia Airdraft para reintentar este."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前回のモデルの読み込みをまだ停止しています。別のモデルを選択するか、Airdraft を再起動してこのモデルを再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之前的模型加载仍在停止中。请选择其他模型，或重新启动 Airdraft 以重试此模型。"
