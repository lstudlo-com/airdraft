    "Removal could not be confirmed. Update a rotated key, or remove this device in the customer portal before forgetting it here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo confirmar la eliminación. Actualiza la clave si la cambiaste o elimina este dispositivo en el portal de cliente antes de olvidarlo aquí."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除を確認できませんでした。キーを変更した場合は更新するか、ここで消去する前にカスタマーポータルでこのデバイスを削除してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认是否已移除。请更新已更换的密钥，或先在客户门户中移除此设备，再在这里忘记它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法確認是否已移除。請更新已更換的授權碼，或先在客戶入口網站移除此裝置，再於此處忘記它。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penghapusan tidak dapat dikonfirmasi. Perbarui kunci yang diganti, atau hapus perangkat ini di portal pelanggan sebelum melupakannya di sini."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление не подтверждено. Обновите сменённый ключ или удалите это устройство на портале клиента, прежде чем забыть его здесь."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível confirmar a remoção. Atualize uma chave trocada ou remova este dispositivo no portal do cliente antes de esquecê-lo aqui."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de confirmer la suppression. Mettez à jour une clé changée, ou supprimez cet appareil dans le portail client avant de l’oublier ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हटाने की पुष्टि नहीं हो सकी। यहाँ भूलने से पहले बदली गई की अपडेट करें, या ग्राहक पोर्टल में यह डिवाइस हटाएँ।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تأكيد الإزالة. حدّث المفتاح المتغيّر، أو أزل هذا الجهاز من بوابة العملاء قبل نسيانه هنا."
          }
        }
      }
    },
