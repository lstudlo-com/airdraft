          }
        }
      }
    },
    "Recording stopped at %@ because recordings waiting for retry use the rest of the memory limit. Retry or discard them in Airdraft for longer recordings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación se detuvo a los %@ porque las grabaciones que esperan un reintento usan el resto del límite de memoria. Reinténtalas o descártalas en Airdraft para grabar más tiempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再試行を待っている録音がメモリ上限の残りを使っているため、%@ で録音を停止しました。より長く録音するには、Airdraft でそれらを再試行するか破棄してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音已在 %@ 停止，因为等待重试的录音已用掉其余的内存上限。请在 Airdraft 中重试或丢弃这些录音，以便录制更长的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄音已在 %@ 停止，因為等待重試的錄音已用掉其餘的記憶體上限。請在 Airdraft 中重試或捨棄這些錄音，以便錄製更長的內容。"
          }
        }
      }
    },
    "Recording stopped because disk space is low. Free space, then recover the saved audio from Transcribe." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación se detuvo por falta de espacio en disco. Libera espacio y recupera el audio guardado desde Transcribir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクの空き容量が不足しているため録音を停止しました。空き容量を確保してから、「文字起こし」で保存された音声を復元してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于磁盘空间不足，录音已停止。请释放空间，然后从“转录”中恢复已保存的音频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
