    "Paste couldn't be confirmed. Clipboard changed; recover your text from History." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo confirmar el pegado. El portapapeles cambió; recupera tu texto desde el Historial."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペーストを確認できませんでした。クリップボードが変更されたため、「履歴」からテキストを復元してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法确认是否已粘贴。剪贴板已更改；请从“历史记录”中找回你的文本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法確認是否已貼上。剪貼簿已變更；請從「記錄」中找回你的文字。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penempelan tidak dapat dikonfirmasi. Papan Klip berubah; pulihkan teks Anda dari Riwayat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставку не удалось подтвердить. Буфер обмена изменился; восстановите текст из «Истории»."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível confirmar a colagem. A Área de Transferência mudou; recupere seu texto no Histórico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le collage n’a pas pu être confirmé. Le presse-papiers a changé ; récupérez votre texte dans Historique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पेस्ट की पुष्टि नहीं हो सकी। क्लिपबोर्ड बदल गया; अपना टेक्स्ट इतिहास से रिकवर करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تأكيد اللصق. تغيّرت الحافظة؛ استرد نصك من السجل."
          }
        }
      }
    },
    "Paste couldn't be confirmed. Text kept on clipboard; check the destination before pasting again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo confirmar el pegado. El texto sigue en el portapapeles; revisa el destino antes de volver a pegar."
