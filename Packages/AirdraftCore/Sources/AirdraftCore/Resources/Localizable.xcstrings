          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценка по токенам: $0,003 за минуту; реальная стоимость зависит от аудио и вывода."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimativa baseada em tokens de US$ 0,003 por minuto; o custo real varia com o áudio e a saída."
