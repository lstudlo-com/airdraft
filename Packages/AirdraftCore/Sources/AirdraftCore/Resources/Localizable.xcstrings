          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "US$ 0,0045 por minuto de áudio. Substitui a predefinição de transcrição GPT-4o mais antiga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
