    "History could not be saved. Your unsaved dictations remain in memory." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar el historial. Tus dictados sin guardar siguen en memoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴を保存できませんでした。保存していない音声入力はメモリに残っています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存历史记录。未保存的听写仍保留在内存中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法儲存記錄。未儲存的聽寫仍保留在記憶體中。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riwayat tidak dapat disimpan. Dikte Anda yang belum disimpan tetap ada di memori."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить историю. Несохранённые диктовки остаются в памяти."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível salvar o histórico. Seus ditados não salvos continuam na memória."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de sauvegarder l’historique. Vos dictées non sauvegardées restent en mémoire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इतिहास सहेजा नहीं जा सका। आपके बिना सहेजे डिक्टेशन मेमोरी में रहते हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر حفظ السجل. تبقى إملاءاتك غير المحفوظة في الذاكرة."
          }
        }
      }
    },
    "History is unavailable. Dictations stay in memory until saved. Retry saving or check the data folder." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial no está disponible. Los dictados permanecen en memoria hasta guardarse. Reintenta guardar o revisa la carpeta de datos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴を使用できません。音声入力は保存されるまでメモリに残ります。保存を再試行するか、データフォルダを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "历史记录不可用。听写会保留在内存中直到保存。请重新保存或检查数据文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法使用記錄。聽寫會保留在記憶體中直到儲存。請重新儲存或檢查資料夾。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riwayat tidak tersedia. Dikte tetap di memori sampai disimpan. Coba simpan lagi atau periksa folder data."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История недоступна. Диктовки хранятся в памяти до сохранения. Повторите сохранение или проверьте папку данных."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O histórico está indisponível. Os ditados ficam na memória até serem salvos. Tente salvar novamente ou verifique a pasta de dados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique est indisponible. Les dictées restent en mémoire jusqu’à leur sauvegarde. Réessayez la sauvegarde ou vérifiez le dossier de données."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इतिहास उपलब्ध नहीं है। सहेजे जाने तक डिक्टेशन मेमोरी में रहते हैं। फिर से सहेजने की कोशिश करें या डेटा फ़ोल्डर जाँचें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السجل غير متاح. تبقى الإملاءات في الذاكرة حتى تُحفظ. أعد محاولة الحفظ أو تحقق من مجلد البيانات."
          }
        }
      }
    },
    "History storage is unavailable. Check available disk space and reopen Airdraft." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El almacenamiento del historial no está disponible. Revisa el espacio libre en disco y vuelve a abrir Airdraft."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴の保存場所を使用できません。ディスクの空き容量を確認してから Airdraft を開き直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "历史记录存储不可用。请检查可用磁盘空间并重新打开 Airdraft。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法使用記錄儲存空間。請檢查可用磁碟空間並重新打開 Airdraft。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penyimpanan riwayat tidak tersedia. Periksa ruang disk yang tersedia dan buka kembali Airdraft."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранилище истории недоступно. Проверьте свободное место на диске и снова откройте Airdraft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O armazenamento do histórico está indisponível. Verifique o espaço livre em disco e abra o Airdraft novamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stockage de l’historique est indisponible. Vérifiez l’espace disque disponible et rouvrez Airdraft."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इतिहास स्टोरेज उपलब्ध नहीं है। उपलब्ध डिस्क स्पेस जाँचें और Airdraft फिर से खोलें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخزين السجل غير متاح. تحقق من المساحة المتوفرة على القرص وأعد فتح Airdraft."
          }
        }
      }
    },
