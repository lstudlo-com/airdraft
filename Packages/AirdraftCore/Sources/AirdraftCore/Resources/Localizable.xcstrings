          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेस API दर। सशुल्क कीटर्म प्रॉम्प्टिंग और ऑडियो-इवेंट टैग बंद हैं; सुधार के बाद आपका शब्दकोश फिर भी लागू होता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
