    "10-second minimum billed per request. Inference speed does not include upload or network time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mínimo de 10 segundos facturado por solicitud. La velocidad de inferencia no incluye el tiempo de subida ni de red."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 リクエストにつき最低 10 秒分が課金されます。推論速度にアップロードやネットワークの時間は含まれません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次请求最少按 10 秒计费。推理速度不含上传或网络时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次請求最少以 10 秒計費。推論速度不含上傳或網路時間。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimal 10 detik ditagih per permintaan. Kecepatan inferensi tidak termasuk waktu unggah atau jaringan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Минимум 10 секунд оплачивается за каждый запрос. Скорость инференса не учитывает отправку файла и сеть."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cobrança mínima de 10 segundos por requisição. A velocidade de inferência não inclui o envio nem o tempo de rede."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimum de 10 secondes facturé par requête. La vitesse d’inférence n’inclut pas l’envoi ni le temps réseau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर अनुरोध पर कम से कम 10 सेकंड का बिल। इनफ़रेंस गति में अपलोड या नेटवर्क समय शामिल नहीं है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحتسب 10 ثوانٍ كحد أدنى لكل طلب. لا تشمل سرعة الاستدلال وقت الرفع أو الشبكة."
          }
        }
      }
    },
