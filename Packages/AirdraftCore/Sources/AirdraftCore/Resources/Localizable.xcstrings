    "Several recordings are waiting for retry. Open Airdraft to retry or discard one before recording again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varias grabaciones esperan un reintento. Abre Airdraft para reintentar o descartar una antes de volver a grabar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再試行を待っている録音が複数あります。もう一度録音する前に、Airdraft を開いていずれかを再試行または破棄してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有多段录音正在等待重试。请先打开 Airdraft 重试或丢弃其中一段，再重新录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有數段錄音正在等待重試。請先打開 Airdraft 重試或捨棄其中一段，再重新錄音。"
