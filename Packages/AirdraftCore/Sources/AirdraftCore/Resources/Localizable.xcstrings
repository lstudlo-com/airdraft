    "No comparable file-transcription latency is published. Upload and network time affect your wait." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se publica una latencia comparable de transcripción de archivos. Los tiempos de subida y de red afectan a la espera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルの文字起こしについて比較できる遅延は公開されていません。待ち時間はアップロードとネットワークの時間に左右されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未公布可比较的文件转录延迟。上传和网络时间会影响等待时间。"
