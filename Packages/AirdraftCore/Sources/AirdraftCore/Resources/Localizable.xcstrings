        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कई रिकॉर्डिंग फिर से कोशिश के लिए प्रतीक्षा में हैं। फिर से रिकॉर्ड करने से पहले Airdraft खोलकर किसी एक को फिर से आज़माएँ या त्यागें।"
          }
        },
        "ar" : {
          "stringUnit" : {
