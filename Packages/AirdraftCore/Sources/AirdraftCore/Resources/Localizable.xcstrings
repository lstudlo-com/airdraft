        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 副本"
          }
        }
      }
    },
    "%@ does not support %@. Choose a supported language on Models or another speech model." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ does not support %2$@. Choose a supported language on Models or another speech model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ no admite %2$@. Elige un idioma compatible en Modelos u otro modelo de voz."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は%2$@に対応していません。「モデル」で対応している言語か、別の音声モデルを選択してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 不支持%2$@。请在“模型”中选择支持的语言，或选择其他语音模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 不支援%2$@。請在「模型」中選擇支援的語言或其他語音模型。"
          }
        }
      }
    },
    "%@ doesn’t support live text" : {
      "comment" : "Recording window notice, shown for two seconds when the speech model (%@) cannot show live text while recording.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no admite texto en directo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はライブテキストに対応していません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不支持实时文字"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不支援即時文字"
          }
        }
